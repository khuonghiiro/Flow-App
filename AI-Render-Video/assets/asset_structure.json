{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.0.0",
  "description": "Tệp cấu hình duy nhất quản lý toàn bộ danh mục, tên tab Tiếng Việt, Icon và quy tắc lọc giới tính cho FlowMy AI Render Video. Người dùng có thể chỉnh sửa trực tiếp tệp này để đổi tên tab, icon hoặc thêm folder mới.",
  "settings": {
    "auto_discover_new_folders": true,
    "leaf_folder_max_depth_mode": true,
    "standalone_images_at_root_only": true,
    "subfolder_companion_preview_only": true,
    "scanning_rules_explanation": "Khi quét từ folder gốc C: Chỉ load ảnh đứng độc lập nếu ảnh nằm trực tiếp tại folder C (depth 0). Đối với các folder con (depth > 0), ảnh chỉ được dùng làm preview nếu trùng tên với file 3D model cùng cấp, các ảnh khác tên trong folder con sẽ không được load lên.",
    "supported_model_formats": [".glb", ".gltf", ".vrm", ".fbx", ".obj", ".dae"],
    "supported_image_formats": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp"]
  },
  "gender_rules": {
    "filter_enabled": true,
    "options": [
      {
        "id": "male",
        "key": "nam",
        "label": "Nam",
        "icon": "♂",
        "folder_aliases": ["nam", "male", "man"]
      },
      {
        "id": "female",
        "key": "nu",
        "label": "Nữ",
        "icon": "♀",
        "folder_aliases": ["nu", "female", "woman"]
      },
      {
        "id": "unisex",
        "key": "chung",
        "label": "Dùng Chung",
        "icon": "⚧",
        "folder_aliases": ["chung", "unisex", "all"]
      }
    ]
  },
  "character_structure": {
    "root_folders": ["nhan_vat", "characters"],
    "gender_folders": ["nam", "nu", "chung"],
    "categories": [
      { "id": "than_co_ban", "folder": "than_co_ban", "label": "Thân Cơ Bản", "icon": "🧍", "supports_gender": true, "default_gender": "male" },
