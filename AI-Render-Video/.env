# AI Background Removal Server URL (BiRefNet, ISNet-Anime on RTX 3060)
VITE_AI_MATTING_URL=http://127.0.0.1:5000
AI_MATTING_PORT=5000

# Antigravity AI Sidecar & Vectorizer URL
VITE_SIDECAR_URL=http://127.0.0.1:5050
SIDECAR_PORT=5050

# FFmpeg 8.0.1 Executable Path (System PATH or custom binary file path)
# Example: D:/UngDung_PC/auto_click_v2/Ffmpeg/ffmpeg.exe or ffmpeg
VITE_FFMPEG_PATH= D:/_Library/ffmpeg-8.0.1-full_build/bin/ffmpeg.exe
FFMPEG_PATH= D:/_Library/ffmpeg-8.0.1-full_build/bin/ffmpeg.exe
