<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  SOFT LIGHT — Warm cream paper + teal sage                   ║
    ║  Background: #F0EDE8  Surface: #FAF8F4  Accent: #3D8A7C     ║
    ╚══════════════════════════════════════════════════════════════╝
    -->

    <RadialGradientBrush x:Key="CardRadialBackground"
                     RadiusX="1" RadiusY="1"
                     Center="0.5,0.5"
                     GradientOrigin="0.5,0.5">
        <GradientStop Color="#FFFCFBF7" Offset="0"/>
        <GradientStop Color="#FFE9EFE6" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="BorderBrush" Color="#FFCCD8C7"/>
    <SolidColorBrush x:Key="CardColor" Color="#FFFCFBF7"/>
    <SolidColorBrush x:Key="BorderColor" Color="#FFB6C5AF"/>

    <!-- Header — warm cream -->
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFF8FAF4"/>

    <!-- Overlay -->
    <SolidColorBrush x:Key="OverlayBackground" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBackgroundReverse" Color="#80000000"/>
    <SolidColorBrush x:Key="BackgroundAll" Color="#FFF3F6F1"/>

    <!-- ===== PRIMARY — teal sage (deeper, more readable) ===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2F7D6D"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#276B5F"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1F5A50"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <!-- ===== SECONDARY ===== -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#69716B"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#586258"/>
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#475146"/>
    <SolidColorBrush x:Key="TextOnSecondaryBrush" Color="White"/>

    <!-- ===== SUCCESS ===== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3F8C5F"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#32764F"/>
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="#285F40"/>
    <SolidColorBrush x:Key="TextOnSuccessBrush" Color="White"/>

    <!-- ===== DANGER ===== -->
    <SolidColorBrush x:Key="DangerBrush" Color="#B94A48"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#A23E3C"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#8A3432"/>
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="White"/>

    <!-- ===== WARNING ===== -->
    <SolidColorBrush x:Key="WarningBrush" Color="#B7791F"/>
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#975F18"/>
    <SolidColorBrush x:Key="WarningPressedBrush" Color="#7C4F14"/>
    <SolidColorBrush x:Key="TextOnWarningBrush" Color="White"/>

    <!-- ===== INFO ===== -->
    <SolidColorBrush x:Key="InfoBrush" Color="#3D7F95"/>
    <SolidColorBrush x:Key="InfoHoverBrush" Color="#326C80"/>
    <SolidColorBrush x:Key="InfoPressedBrush" Color="#285768"/>
    <SolidColorBrush x:Key="TextOnInfoBrush" Color="White"/>

    <!-- ===== LIGHT / DARK variants ===== -->
    <SolidColorBrush x:Key="LightBrush" Color="#E9EFE6"/>
    <SolidColorBrush x:Key="LightHoverBrush" Color="#DDE7D8"/>
    <SolidColorBrush x:Key="LightPressedBrush" Color="#D0DCCA"/>
    <SolidColorBrush x:Key="TextOnLightBrush" Color="#25312B"/>

    <SolidColorBrush x:Key="DarkBrush" Color="#25312B"/>
    <SolidColorBrush x:Key="DarkHoverBrush" Color="#1D2722"/>
    <SolidColorBrush x:Key="DarkPressedBrush" Color="#141D18"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="White"/>

    <!-- ===== WINDOW BACKGROUNDS ===== -->
    <SolidColorBrush x:Key="WindowBodyBackground" Color="#FFF3F6F1"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#FFF3F6F1"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F6F1"/>

    <!-- ===== TEXT ===== -->
    <SolidColorBrush x:Key="TextBrush" Color="#FF25312B"/>
    <SolidColorBrush x:Key="TextBrushReverse" Color="#FFF8FAF4"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TransparentHoverBrush" Color="#2625312B"/>
    <SolidColorBrush x:Key="TransparentPressedBrush" Color="#4D25312B"/>
    <SolidColorBrush x:Key="TransparentFocusBrush" Color="#4D25312B"/>
    <SolidColorBrush x:Key="TextOnTransparentBrush" Color="#FF25312B"/>

    <!-- ===== INPUT BACKGROUNDS ===== -->
    <SolidColorBrush x:Key="TextBoxBackground" Color="#FFFCFBF7"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFB6C5AF"/>
    <SolidColorBrush x:Key="TextBoxHoverBackground" Color="#FFF8FAF4"/>
    <SolidColorBrush x:Key="TextBoxFocusBackground" Color="#FFFCFBF7"/>
    <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#FFE7EDE3"/>
    <SolidColorBrush x:Key="TextBoxReadOnlyBackground" Color="#FFF2F6EF"/>

    <!-- ===== BORDER COLORS ===== -->
    <SolidColorBrush x:Key="TextBoxHoverBorderBrush" Color="#FF8FA488"/>
    <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#FF2F7D6D"/>

    <!-- ===== TEXT STATES ===== -->
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#FF7D8A78"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#FF8E998A"/>
    <SolidColorBrush x:Key="DisabledBackground" Color="#FFE7EDE3"/>
    <SolidColorBrush x:Key="ReadOnlyTextBrush" Color="#FF526158"/>

    <!-- ===== GLOW EFFECTS ===== -->
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="#222F7D6D"/>
    <SolidColorBrush x:Key="HoverGlowBrush" Color="#152F7D6D"/>

    <!-- ===== READONLY ===== -->
    <SolidColorBrush x:Key="ReadOnlyBackground" Color="#FFF2F6EF"/>
    <SolidColorBrush x:Key="ReadOnlyForeground" Color="#FF526158"/>
    <SolidColorBrush x:Key="BorderInverseColor">#60526158</SolidColorBrush>
    <SolidColorBrush x:Key="ControlBorderColor">#FFCCD8C7</SolidColorBrush>
    <SolidColorBrush x:Key="ReadOnlyBorderBrush">#408FA488</SolidColorBrush>

    <!-- ===== BUTTON BRUSHES ===== -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFEAF0E7"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FFEAF0E7"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFDDE7D8"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FFD0DCCA"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFB6C5AF"/>

    <!-- ===== SCROLLBAR ===== -->
    <Color x:Key="ScrollBarThumbColor">#902F7D6D</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#B02F7D6D</Color>
    <Color x:Key="ScrollBarThumbPressedColor">#D02F7D6D</Color>
    <Color x:Key="ScrollBarTrackColor">Transparent</Color>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="{StaticResource ScrollBarThumbPressedColor}"/>
    <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="{StaticResource ScrollBarTrackColor}"/>

    <!-- ===== PROGRESS ===== -->
    <SolidColorBrush x:Key="ProgressBackground">#FFDDE7D8</SolidColorBrush>
    <SolidColorBrush x:Key="ProgressFill">#FF2F7D6D</SolidColorBrush>

    <!-- ===== SHADOW ===== -->
    <Color x:Key="ShadowColor">#24000000</Color>
    <Color x:Key="PopupShadowColor">#18000000</Color>
    <Color x:Key="PrimaryShadowColor">#18000000</Color>

    <!-- ===== RADIO OPTIONS ===== -->
    <SolidColorBrush x:Key="OptionHoverBrush" Color="#FFE4EDE0"/>
    <SolidColorBrush x:Key="OptionSelectedBrush" Color="#FF2F7D6D"/>

    <!-- ===== MISC ===== -->
    <SolidColorBrush x:Key="TitleBackgroundBrush" Color="#FFF8FAF4"/>
    <SolidColorBrush x:Key="TextNoteBrush" Color="#FF637167"/>

    <!-- ===== DATAGRID ===== -->
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#FF25312B"/>
    <SolidColorBrush x:Key="DataGridRowBackground">#08FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridAltRowBackground">#FFF8FAF4</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridHeaderBackground">#FFE4EDE0</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridBorderBrush">#FFCCD8C7</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridRowHoverBackground">#202F7D6D</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridSelectionBackground">#582F7D6D</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridSelectedCellBackground">#582F7D6D</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridSelectedTextBrush">#FFFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridHoverCellBackground" Color="#382F7D6D"/>

    <!-- ===== COMBOBOX ===== -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFE4EDE0"/>
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#FF276B5F"/>

    <!-- ===== CARD ===== -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFCFBF7"/>

    <!-- ===== SEMANTIC ALIASES ===== -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#FF2F7D6D"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FF276B5F"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#FF3F8C5F"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FF7A5C99"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7A5C99"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#FFF3F6F1"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="#FFFCFBF7"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FF25312B"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF4E5D52"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF637167"/>
    <SolidColorBrush x:Key="DangerColor" Color="#FFB94A48"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#FF3F8C5F"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFB7791F"/>

    <!-- ===== POPUP ===== -->
    <SolidColorBrush x:Key="PopupHoverBrush" Color="#FFE4EDE0"/>
    <SolidColorBrush x:Key="PopupSelectedBackground" Color="Transparent"/>

    <!-- ===== LAVENDER (ComboBox selection highlight) ===== -->
    <SolidColorBrush x:Key="LavenderHoverBrush"   Color="#202F7D6D"/>
    <SolidColorBrush x:Key="LavenderPressedBrush" Color="#582F7D6D"/>
    <SolidColorBrush x:Key="TextOnLavenderBrush"  Color="#FF1F5A50"/>

    <!-- ===== COMBOBOX ===== -->
    <SolidColorBrush x:Key="ComboBoxFieldBackground" Color="#FFFCFBF7"/>
    <SolidColorBrush x:Key="ComboBoxFieldBorderBrush" Color="#FF9CAD96"/>
    <SolidColorBrush x:Key="ComboBoxFieldHoverBackground" Color="#FFF8FAF4"/>
    <SolidColorBrush x:Key="ComboBoxFieldHoverBorderBrush" Color="#FF7F9678"/>
    <SolidColorBrush x:Key="ComboBoxFieldFocusBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxFieldFocusBorderBrush" Color="#FF2F7D6D"/>
    <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#FFFCFBF7"/>
    <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#FFB6C5AF"/>
    <SolidColorBrush x:Key="ComboBoxGlyphBrush" Color="#FF4E5D52"/>
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#FFE4EDE0"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#FFCBE0D4"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedHoverBrush" Color="#FFB7D2C4"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedForegroundBrush" Color="#FF183028"/>

    <!-- ===== LISTVIEW HEADER ===== -->
    <SolidColorBrush x:Key="ListViewHeaderBrush"  Color="#FF2F7D6D"/>
    <SolidColorBrush x:Key="ListViewItemBrush"    Color="#FF25312B"/>
    <SolidColorBrush x:Key="HoverBackground"      Color="#E4EDE0"/>

    <!-- ===== CANVAS ===== -->
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FFEEF2EA"/>
    <SolidColorBrush x:Key="CanvasGridBrush" Color="#C0AEBDA8"/>
    <SolidColorBrush x:Key="ExecutionTraceGuideBrush" Color="#A082927C"/>
    <Color x:Key="NodeShadowColor">#20000000</Color>

    <!-- ===== FOCUS & INTERACTION ===== -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#442F7D6D"/>
    <SolidColorBrush x:Key="CardHoverBackground" Color="#FFEAF0E7"/>
    <Color x:Key="ButtonShadowColor">#182F7D6D</Color>
    <SolidColorBrush x:Key="TabIndicatorBrush" Color="#FF2F7D6D"/>
    <SolidColorBrush x:Key="DataGridHeaderHoverBackground" Color="#FFEAF0E7"/>
    <SolidColorBrush x:Key="MenuItemHoverBackgroundBrush" Color="#FFEAF0E7"/>
    <!-- Toolbar / editor header — deep teal-brown for SoftLight -->
    <SolidColorBrush x:Key="HeaderBackgroundMainBrush" Color="#FF183A32"/>

    <!-- Common palette overrides -->
    <SolidColorBrush x:Key="OceanBrush" Color="#2A7898"/>
    <SolidColorBrush x:Key="OceanHoverBrush" Color="#226888"/>
    <SolidColorBrush x:Key="OceanPressedBrush" Color="#1A5878"/>
    <SolidColorBrush x:Key="TextOnOceanBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BrightPowerBrush" Color="#D81858"/>
    <SolidColorBrush x:Key="BrightPowerHoverBrush" Color="#C0144C"/>
    <SolidColorBrush x:Key="BrightPowerPressedBrush" Color="#A81040"/>
    <SolidColorBrush x:Key="TextOnBrightPowerBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="MagentaBloomBrush" Color="#A820B8"/>
    <SolidColorBrush x:Key="MagentaBloomHoverBrush" Color="#901CA0"/>
    <SolidColorBrush x:Key="MagentaBloomPressedBrush" Color="#781888"/>
    <SolidColorBrush x:Key="TextOnMagentaBloomBrush" Color="#FFFFFF"/>

</ResourceDictionary>
