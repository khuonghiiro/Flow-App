<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  MODERN THEME — Clean web-inspired light palette             ║
    ║  Background: #F8FAFF  Surface: #FFFFFF  Accent: #2563EB     ║
    ╚══════════════════════════════════════════════════════════════╝
    -->

    <RadialGradientBrush x:Key="CardRadialBackground"
                     RadiusX="1" RadiusY="1"
                     Center="0.5,0.5"
                     GradientOrigin="0.5,0.5">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFEEF2FF" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="BorderBrush" Color="#FFD3DCEF"/>
    <SolidColorBrush x:Key="CardColor" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#FFB8C5DD"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFBFCFF"/>

    <SolidColorBrush x:Key="OverlayBackground" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBackgroundReverse" Color="#80000000"/>
    <SolidColorBrush x:Key="BackgroundAll" Color="#FFF7F8FF"/>

    <!-- PRIMARY — Tailwind blue-600 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#3730A3"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SecondaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#475569"/>
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextOnSecondaryBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#059669"/>
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="#047857"/>
    <SolidColorBrush x:Key="TextOnSuccessBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#991B1B"/>
