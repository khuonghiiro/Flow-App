    <SolidColorBrush x:Key="SuccessColor" Color="#FF10B981"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFB7791F"/>

    <SolidColorBrush x:Key="PopupHoverBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="PopupSelectedBackground" Color="Transparent"/>

    <!-- LAVENDER (ComboBox selection highlight) -->
    <SolidColorBrush x:Key="LavenderHoverBrush"   Color="#1A4F46E5"/>
    <SolidColorBrush x:Key="LavenderPressedBrush" Color="#484F46E5"/>
    <SolidColorBrush x:Key="TextOnLavenderBrush"  Color="#FF4338CA"/>

    <!-- ComboBox -->
    <SolidColorBrush x:Key="ComboBoxFieldBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxFieldBorderBrush" Color="#FF94A8C0"/>
    <SolidColorBrush x:Key="ComboBoxFieldHoverBackground" Color="#FFEEF4FC"/>
    <SolidColorBrush x:Key="ComboBoxFieldHoverBorderBrush" Color="#FF7090AC"/>
    <SolidColorBrush x:Key="ComboBoxFieldFocusBackground" Color="#FFF8FAFF"/>
