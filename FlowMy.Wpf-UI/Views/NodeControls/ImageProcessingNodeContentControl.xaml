<!-- 
========================================================================================
IMPORTANT FOR AI CODING ASSISTANTS & DEVELOPERS:
This is the UI markup file for ImageProcessingNodeContentControl.
For code-behind logic, please note that any C# code file exceeding ~1500 lines must be split
into smaller partial class files to maintain readability and ease of maintenance.
========================================================================================
-->
<UserControl x:Class="FlowMy.Views.NodeControls.ImageProcessingNodeContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:FlowMy.Models.Nodes;assembly=FlowMy.Core"
             xmlns:controls="clr-namespace:FlowMy.Controls"
             xmlns:local="clr-namespace:FlowMy.Views.NodeControls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:FlowMy.Converters"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="640"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             ToolTipService.InitialShowDelay="100"
             ToolTipService.BetweenShowDelay="50">
    <UserControl.Resources>
        <!-- ═══ IP PALETTE ═══ -->
        <SolidColorBrush x:Key="ipBg" Color="#0a0c10"/>
        <SolidColorBrush x:Key="ipSurface" Color="#111318"/>
        <SolidColorBrush x:Key="ipSurface2" Color="#181c24"/>
        <SolidColorBrush x:Key="ipBorder" Color="#252932"/>
        <SolidColorBrush x:Key="ipBorderLight" Color="#2a2e3a"/>
        <SolidColorBrush x:Key="ipText" Color="#dde3ef"/>
        <SolidColorBrush x:Key="ipMuted" Color="#5a6072"/>
        <SolidColorBrush x:Key="ipAccent" Color="#4fffb0"/>
        <SolidColorBrush x:Key="ipAccent2" Color="#00cfff"/>
        <SolidColorBrush x:Key="ipHover" Color="#1e222c"/>
        <SolidColorBrush x:Key="ipActiveItem" Color="#1a4fffb0"/>

        <!-- Photoshop light checkered brush for transparency -->
        <VisualBrush x:Key="PsCheckeredBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="16" Height="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="8"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="8"/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#cbcbcb"/>
                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#ffffff"/>
                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#ffffff"/>
                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#cbcbcb"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- ═══ MINI ICON BUTTON ═══ -->
        <Style x:Key="IpMiniBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ipMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource ipText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ipText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2,8,2"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipSurface2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#111318"/>
            <Setter Property="BorderBrush" Value="#252932"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="2"
                                UseLayoutRounding="True" SnapsToDevicePixels="True"
                                RenderOptions.ClearTypeHint="Enabled"
                                TextOptions.TextFormattingMode="Ideal"
                                TextOptions.TextRenderingMode="Auto"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                LayoutTransform="{Binding Path=PlacementTarget.LayoutTransform, RelativeSource={RelativeSource Self}}">
                            <ScrollViewer x:Name="MenuScrollViewer" CanContentScroll="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ COMBOBOX STYLE ═══ -->
        <Style x:Key="IpComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource ipSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource ipText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,0,20,0"
                                              VerticalAlignment="Center"/>
                            <TextBlock Text="▾"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ipMuted}"
                                       FontSize="10"/>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource ipSurface2}"
                                        BorderBrush="{StaticResource ipBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        UseLayoutRounding="True" SnapsToDevicePixels="True"
                                        RenderOptions.ClearTypeHint="Enabled"
                                        TextOptions.TextFormattingMode="Ideal"
                                        TextOptions.TextRenderingMode="Auto"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        LayoutTransform="{Binding Path=LayoutTransform, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ipAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource ipText}"/>
                        <Setter Property="Background" Value="{StaticResource ipSurface2}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontSize" Value="9"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource ipHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource ipActiveItem}"/>
                                            <Setter Property="Foreground" Value="{StaticResource ipAccent}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ADJUSTMENT BUTTON STYLE ═══ -->
        <Style x:Key="IpAdjBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Background" Value="{StaticResource ipSurface2}"/>
            <Setter Property="Foreground" Value="{StaticResource ipText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ipAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource ipAccent}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ipAccent2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ipAccent2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:IntToHashLabelConverter x:Key="IntToHashLabelConverter"/>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
        <sys:Double x:Key="WidgetCropOrderFontSize">10</sys:Double>
        <sys:Double x:Key="WidgetCropCheckFontSize">8</sys:Double>
        <sys:Double x:Key="WidgetCropDeleteFontSize">9</sys:Double>
        <sys:Double x:Key="WidgetRenderGroupTitleFontSize">9</sys:Double>

        <!-- Một dòng trong danh sách crop -->
        <DataTemplate x:Key="CropListItemTemplate" DataType="{x:Type models:ImageCropRegion}">
            <StackPanel Margin="1,0,1,4" Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Margin="0,0,4,0"
                           VerticalAlignment="Center" Opacity="0.7"
                           FontSize="{DynamicResource WidgetCropOrderFontSize}" FontWeight="Bold" Foreground="White"
                           Text="{Binding Order}"/>
                <Border Width="64" Margin="0,0,0,1"
                        Cursor="Hand" ToolTip="Click để mở Image Processor"
                        BorderThickness="2" CornerRadius="3"
                        Background="#1E000000"
                        BorderBrush="{Binding StrokeBrush}"
                        MouseLeftButtonDown="CropThumbBorder_MouseLeftButtonDown">
                    <Image MaxHeight="64" Stretch="Uniform" HorizontalAlignment="Left"
                           Source="{Binding Thumbnail}"/>
                </Border>
                <StackPanel Margin="4,0,0,0" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                    <CheckBox Margin="0,0,3,0" VerticalAlignment="Center"
                              FontSize="{DynamicResource WidgetCropCheckFontSize}" Foreground="Gold" ToolTip="Bật/tắt hiển thị vùng crop"
                              IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
                    <CheckBox Margin="0,0,3,0" VerticalAlignment="Center"
                              FontSize="{DynamicResource WidgetCropCheckFontSize}" Foreground="{DynamicResource PrimaryBrush}"
                              ToolTip="Ẩn nền polygon, đổi viền sang nét đứt"
                              IsChecked="{Binding IsOutlineOnly, Mode=TwoWay}"/>
                    <Button Content="X" Style="{DynamicResource DangerButton}"
                            Width="18" Height="18" FontSize="{DynamicResource WidgetCropDeleteFontSize}" Padding="0" Margin="0"
                            VerticalAlignment="Center" ToolTip="Xoá vùng crop này"
                            PreviewMouseLeftButtonUp="DeleteCropButton_PreviewMouseLeftButtonUp"
                            Click="DeleteCropButton_Click"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Nhóm ảnh render theo crop -->
        <DataTemplate x:Key="RenderGroupTemplate">
            <StackPanel Margin="0,0,0,6" Orientation="Vertical">
                <TextBlock Margin="0,0,0,2" FontSize="{DynamicResource WidgetRenderGroupTitleFontSize}" FontWeight="Bold" Foreground="White"
                           Text="{Binding Order, Converter={StaticResource IntToHashLabelConverter}}"/>
                <ItemsControl ItemsSource="{Binding RenderedImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="55" Margin="0,2,4,2"
                                    BorderBrush="#789CA3B8" BorderThickness="1" CornerRadius="3">
                                <Image MaxHeight="55" Stretch="Uniform" Source="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <!-- ═══ TEXTBOX STYLE ═══ -->
        <Style x:Key="IpTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="{StaticResource ipSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource ipText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource ipText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ipAccent}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ipAccent2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="TopOptionsBarRow" Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="IpColumnDefinition" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <Border x:Name="TopMenuBorder" Grid.Row="0" Grid.ColumnSpan="4"
                Background="#2DFFFFFF" Padding="8,4,8,4" Panel.ZIndex="10">
            <Border Background="Transparent" IsHitTestVisible="True">
                <DockPanel LastChildFill="True">
                    <Button x:Name="IpToggleButton" DockPanel.Dock="Right" Visibility="Collapsed"
                            ToolTip="Ẩn/hiện Image Processor"
                            Width="28" Height="22" Padding="0"
                            Cursor="Hand" VerticalAlignment="Center"
                            Style="{DynamicResource DangerButton}"
                            Click="IpToggleButton_Click">
                        <controls:SvgViewboxEx x:Name="IpToggleIcon"
                                                Width="14" Height="14"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Fill="{DynamicResource WhiteBrush}"/>
                    </Button>

                    <!-- Right Aligned Project Buttons -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <!-- Import Project Button -->
                        <Button x:Name="BtnImportProjectQuick" Width="24" Height="22" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Style="{StaticResource IpMiniBtn}"
                                ToolTip="Import dự án (.iep)" Click="BtnImportProjectQuick_Click">
                            <controls:SvgViewboxEx Width="13" Height="13"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='file-import duotone-light'}"
                                Fill="{DynamicResource WhiteBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Button>

                        <!-- Export Project Button -->
                        <Button x:Name="BtnExportProjectQuick" Width="24" Height="22" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Style="{StaticResource IpMiniBtn}"
                                ToolTip="Export dự án (.iep)" Click="BtnExportProjectQuick_Click">
                            <controls:SvgViewboxEx Width="13" Height="13"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='file-export duotone-light'}"
                                Fill="{DynamicResource WhiteBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Button>

                        <!-- Save Project Button -->
                        <Button x:Name="BtnSaveProjectQuick" Width="24" Height="22" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Style="{StaticResource IpMiniBtn}"
                                ToolTip="Lưu dự án (Save project)" Click="BtnSaveProjectQuick_Click">
                            <controls:SvgViewboxEx Width="13" Height="13"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='floppy-disk duotone-light'}"
                                Fill="{DynamicResource WhiteBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Button>
                    </StackPanel>

                    <!-- Left Aligned Menu and Icons -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <!-- File Menu Button -->
                        <Button x:Name="BtnFileMenu" Content="File" 
                                Style="{StaticResource MenuBarButtonStyle}"
                                Click="BtnFileMenu_Click" Margin="0,0,6,0">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}">
                                    <ContextMenu.Resources>
                                        <!-- Custom style for dark menu items -->
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Foreground" Value="#dde3ef"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="Border" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" CornerRadius="2">
                                                            <Grid Margin="10,5,10,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                                                    <ColumnDefinition Width="*" SharedSizeGroup="Text"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ContentPresenter x:Name="Icon" Margin="0,0,8,0" VerticalAlignment="Center" ContentSource="Icon"/>
                                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#252932"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="Separator">
                                            <Setter Property="Background" Value="#252932"/>
                                            <Setter Property="Height" Value="1"/>
                                            <Setter Property="Margin" Value="0,4,0,4"/>
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem Header="📁 Mở ảnh hoặc Dự án..." Click="MenuItemOpen_Click"/>
                                    <MenuItem Header="💾 Lưu dự án (Save)" Click="MenuItemSaveProject_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📥 Import ảnh vào Layer..." Click="MenuItemImport_Click"/>
                                    <MenuItem Header="⚡ Xuất ảnh PNG..." Click="MenuItemQuickExportPng_Click"/>
                                    <MenuItem Header="🖼️ Xuất ảnh JPG..." Click="MenuItemQuickExportJpg_Click"/>
                                    <MenuItem Header="🖼️ Xuất ảnh dạng khác (Export As)..." Click="MenuItemExportAs_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📂 Import dự án (.iep)..." Click="MenuItemOpenProject_Click"/>
                                    <MenuItem Header="📦 Export dự án (.iep)..." Click="MenuItemExportProject_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- Separator line -->
                        <Rectangle Width="1" Height="14" Fill="#3Fffffff" Margin="4,0,8,0" VerticalAlignment="Center"/>

                        <!-- Open Image or Project button -->
                        <Button x:Name="BtnOpenImageQuick" Width="24" Height="22" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Style="{StaticResource IpMiniBtn}"
                                ToolTip="Mở ảnh hoặc Dự án (Open Image/Project)" Click="BtnOpenImageQuick_Click">
                            <controls:SvgViewboxEx Width="13" Height="13"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder-open duotone-light'}"
                                Fill="{DynamicResource WhiteBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Button>

                        <!-- Save PNG button -->
                        <Button x:Name="BtnSavePngQuick" Width="24" Height="22" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Style="{StaticResource IpMiniBtn}"
                                ToolTip="Xuất ảnh PNG (Save PNG)" Click="BtnSavePngQuick_Click">
                            <controls:SvgViewboxEx Width="13" Height="13"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='file-png duotone-light'}"
                                Fill="{DynamicResource WhiteBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Button>

                        <!-- Save JPG button -->
                        <Button x:Name="BtnSaveJpgQuick" Width="24" Height="22" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Style="{StaticResource IpMiniBtn}"
                                ToolTip="Xuất ảnh JPG (Save JPG)" Click="BtnSaveJpgQuick_Click">
                            <controls:SvgViewboxEx Width="13" Height="13"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='file-jpg duotone-light'}"
                                Fill="{DynamicResource WhiteBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Button>
                    </StackPanel>

                    <!-- Spacer -->
                    <Grid/>
                </DockPanel>
            </Border>
        </Border>

        <!-- Hidden: used by UpdatePreviewAsync to pass title, tab system reads from it -->
        <TextBlock x:Name="ImageTitleTextBlock" Visibility="Collapsed" Text="Chưa có ảnh"/>

        <!-- Top Options Bar: Tool-specific controls (Photoshop style) -->
        <Border x:Name="TopOptionsBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                Background="#0e1218" BorderBrush="#252932" BorderThickness="0,0,0,1"
                Padding="12,4,12,4" Visibility="Visible" Panel.ZIndex="5">
            <Grid Height="24">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="OptBrushPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="🖌️ Brush" FontSize="9" FontWeight="Bold" Foreground="#4fffb0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    
                    <!-- Size Input TextBox -->
                    <TextBlock Text="Size:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="OptBrushSizeInput" Width="36" Height="18" FontSize="9" 
                             Style="{StaticResource IpTextBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Text="50" LostFocus="OptBrushSizeInput_LostFocus" KeyDown="OptBrushSizeInput_KeyDown"/>
                    <TextBlock Text="px" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="2,0,12,0"/>

                    <!-- Brush Preview Button/Border that opens Popup -->
                    <TextBlock Text="Preview:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Border x:Name="BtnBrushPreviewDropdown" Width="26" Height="22" CornerRadius="3"
                            Background="#1c202a" BorderBrush="#353945" BorderThickness="1"
                            Cursor="Hand" PreviewMouseLeftButtonDown="BtnBrushPreviewDropdown_PreviewMouseLeftButtonDown"
                            ToolTip="Click để xem &amp; thay đổi cấu hình cọ (Click to adjust brush settings)"
                            VerticalAlignment="Center">
                        <Grid ClipToBounds="True">
                            <!-- Checkerboard background -->
                            <Grid.Background>
                                <VisualBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                                    <VisualBrush.Visual>
                                        <Grid Width="6" Height="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="3"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="3"/>
                                                <RowDefinition Height="3"/>
                                            </Grid.RowDefinitions>
                                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#1c202a"/>
                                            <Rectangle Grid.Row="0" Grid.Column="1" Fill="#111318"/>
                                            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#111318"/>
                                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#1c202a"/>
                                        </Grid>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Grid.Background>
                            <ContentControl x:Name="BrushBarPreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Popup for Brush Settings (Photoshop style) -->
                    <Popup x:Name="BrushSettingsPopup" PlacementTarget="{Binding ElementName=BtnBrushPreviewDropdown}" 
                           Placement="Bottom" StaysOpen="True" PopupAnimation="Fade" Closed="BrushSettingsPopup_Closed">
                        <Border Background="#111318" BorderBrush="#353945" BorderThickness="1" CornerRadius="6" Padding="10" Width="260"
                                UseLayoutRounding="True" SnapsToDevicePixels="True"
                                RenderOptions.ClearTypeHint="Enabled"
                                TextOptions.TextFormattingMode="Ideal"
                                TextOptions.TextRenderingMode="Auto"
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <StackPanel>
                                <!-- Header row: title + preview -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Brush Settings" FontSize="10" FontWeight="SemiBold" Foreground="#b0b8c8" VerticalAlignment="Center"/>
                                    <!-- Preview box inline with title -->
                                    <Border DockPanel.Dock="Right" Width="42" Height="42"
                                            Background="#0a0c10" BorderBrush="#252932" BorderThickness="1"
                                            CornerRadius="4" ToolTip="Brush Preview">
                                        <Grid ClipToBounds="True">
                                            <Grid.Background>
                                                <VisualBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                                                    <VisualBrush.Visual>
                                                        <Grid Width="6" Height="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3"/>
                                                                <ColumnDefinition Width="3"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="3"/>
                                                                <RowDefinition Height="3"/>
                                                            </Grid.RowDefinitions>
                                                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#151821"/>
                                                            <Rectangle Grid.Row="0" Grid.Column="1" Fill="#0c0e14"/>
                                                            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#0c0e14"/>
                                                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#151821"/>
                                                        </Grid>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Grid.Background>
                                            <ContentControl x:Name="BrushPopupPreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Path Data="M0,6 L12,6 M6,0 L6,12" 
                                                  Stroke="#20FFFFFF" StrokeThickness="0.5" 
                                                  Width="12" Height="12"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </DockPanel>

                                <!-- Separator -->
                                <Rectangle Height="1" Fill="#1e222c" Margin="0,0,0,6"/>

                                <!-- Preset Grid -->
                                <TextBlock Text="PRESETS" Foreground="#454b5a" FontSize="8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ListBox x:Name="PopupBrushPreset" Margin="0,0,0,8" SelectionChanged="PopupBrushPreset_SelectionChanged"
                                         Background="Transparent" BorderThickness="0" Padding="0" 
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="1"/>
                                            <Setter Property="Margin" Value="1"/>
                                            <Setter Property="Width" Value="32"/>
                                            <Setter Property="Height" Value="32"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1c2028"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2a3040"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#12283a"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00b8e6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- Separator -->
                                <Rectangle Height="1" Fill="#1e222c" Margin="0,0,0,6"/>

                                <!-- Sliders Section -->
                                <TextBlock Text="PROPERTIES" Foreground="#454b5a" FontSize="8" FontWeight="SemiBold" Margin="0,0,0,5"/>

                                <!-- Size -->
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Left" Text="Size" Foreground="#6a7080" FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" Background="#181c24" CornerRadius="2" Padding="3,1" MinWidth="28" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPopupBrushSize" Text="50" FontSize="9" FontFamily="Consolas" Foreground="#00cfff" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Slider x:Name="PopupBrushSize" Minimum="1" Maximum="5000" Value="50" VerticalAlignment="Center" ValueChanged="PopupBrushSize_ValueChanged"/>
                                </DockPanel>

                                <!-- Hardness -->
                                <DockPanel x:Name="PopupHardnessPanel" Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Left" Text="Hard" Foreground="#6a7080" FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" Background="#181c24" CornerRadius="2" Padding="3,1" MinWidth="28" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPopupBrushHardness" Text="100%" FontSize="9" FontFamily="Consolas" Foreground="#00cfff" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Slider x:Name="PopupBrushHardness" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="PopupBrushHardness_ValueChanged"/>
                                </DockPanel>

                                <!-- Flow -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock DockPanel.Dock="Left" Text="Flow" Foreground="#6a7080" FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" Background="#181c24" CornerRadius="2" Padding="3,1" MinWidth="28" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPopupBrushFlow" Text="100%" FontSize="9" FontFamily="Consolas" Foreground="#00cfff" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Slider x:Name="PopupBrushFlow" Minimum="1" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="PopupBrushFlow_ValueChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- ═══ COLOR OPTIONS (Photoshop style) ═══ -->
                <StackPanel x:Name="OptColorPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="12,0,0,0">
                    <TextBlock Text="🎨 Color:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="OptColorHexInput" Width="55" Height="18" FontSize="9"
                             Style="{StaticResource IpTextBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Text="#FFFFFF" LostFocus="OptColorHexInput_LostFocus" KeyDown="OptColorHexInput_KeyDown"/>
                    
                    <Border x:Name="OptFgColorSwatch" Width="18" Height="18" Margin="6,0,6,0" CornerRadius="3"
                            BorderBrush="#dde3ef" BorderThickness="1" Cursor="Hand"
                            ToolTip="Foreground Color"
                            MouseLeftButtonDown="OptFgColorSwatch_MouseLeftButtonDown"/>
                    
                    <Button Content="⇄" Style="{StaticResource IpMiniBtn}"
                            Width="16" Height="16" FontSize="11" Margin="2,0,2,0"
                            Cursor="Hand" ToolTip="Swap Colors (X)"
                            Click="EditorToolbox_SwapColors_Click"/>
                    
                    <Border x:Name="OptBgColorSwatch" Width="18" Height="18" Margin="6,0,12,0" CornerRadius="3"
                            BorderBrush="#252932" BorderThickness="1" Cursor="Hand"
                            ToolTip="Background Color"
                            MouseLeftButtonDown="OptBgColorSwatch_MouseLeftButtonDown"/>
                </StackPanel>
            </StackPanel>

            <!-- ═══ TEXT OPTIONS ═══ -->
                <StackPanel x:Name="OptTextPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="🔤 Text" FontSize="9" FontWeight="Bold" Foreground="#4fffb0" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <TextBlock Text="Font:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="OptFontFamily" Height="18" Width="100" FontSize="9" Style="{StaticResource IpComboBoxStyle}" VerticalContentAlignment="Center" SelectionChanged="OptFontFamily_SelectionChanged">
                        <ComboBoxItem Content="Arial" IsSelected="True"/>
                        <ComboBoxItem Content="Times New Roman"/>
                        <ComboBoxItem Content="Courier New"/>
                        <ComboBoxItem Content="Segoe UI"/>
                        <ComboBoxItem Content="Verdana"/>
                        <ComboBoxItem Content="Consolas"/>
                    </ComboBox>
                    
                    <TextBlock Text="Style:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <ComboBox x:Name="OptFontStyle" Height="18" Width="70" FontSize="9" Style="{StaticResource IpComboBoxStyle}" VerticalContentAlignment="Center" SelectionChanged="OptFontStyle_SelectionChanged">
                        <ComboBoxItem Content="Bold" IsSelected="True"/>
                        <ComboBoxItem Content="Regular"/>
                        <ComboBoxItem Content="Italic"/>
                    </ComboBox>

                    <TextBlock Text="Size:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <Slider x:Name="OptTextSize" Minimum="6" Maximum="200" Value="24" Width="80" VerticalAlignment="Center" ValueChanged="OptTextSize_ValueChanged"/>
                    <TextBox x:Name="OptTextSizeInput" Width="26" Height="18" FontSize="9" 
                             Style="{StaticResource IpTextBoxStyle}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Text="24" LostFocus="OptTextSizeInput_LostFocus" KeyDown="OptTextSizeInput_KeyDown" Margin="4,0,12,0"/>

                    <TextBlock Text="Align:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border x:Name="BtnTextAlignLeft" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="#00cfff" Background="#3000cfff" Cursor="Hand" ToolTip="Align Left" MouseLeftButtonDown="TextAlign_Click" Tag="Left" Margin="0,0,2,0">
                            <TextBlock Text="▤" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="BtnTextAlignCenter" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="#353945" Background="Transparent" Cursor="Hand" ToolTip="Align Center" MouseLeftButtonDown="TextAlign_Click" Tag="Center" Margin="0,0,2,0">
                            <TextBlock Text="▧" FontSize="10" Foreground="#dde3ef" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="BtnTextAlignRight" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="#353945" Background="Transparent" Cursor="Hand" ToolTip="Align Right" MouseLeftButtonDown="TextAlign_Click" Tag="Right">
                            <TextBlock Text="▥" FontSize="10" Foreground="#dde3ef" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Color:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Border x:Name="OptTextColorSwatch" Background="White" BorderBrush="#252932" BorderThickness="1" CornerRadius="2" Height="12" Width="12" VerticalAlignment="Center" MouseLeftButtonDown="OptTextColorSwatch_MouseLeftButtonDown" Cursor="Hand"/>
                    <TextBlock x:Name="OptBtnTextColor" Text="#FFFFFF" FontSize="9" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OptBtnTextColor_Click"/>
                </StackPanel>

                <!-- ═══ SELECTION OPTIONS ═══ -->
                <StackPanel x:Name="OptSelectionPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="⬜ Selection" FontSize="9" FontWeight="Bold" Foreground="#4fffb0" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <TextBlock Text="Mode:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- Mode New -->
                        <Border x:Name="BtnSelModeNew" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="#00cfff" Background="#3000cfff" Cursor="Hand" ToolTip="New Selection (Tạo vùng chọn mới)" MouseLeftButtonDown="SelMode_Click" Tag="New" Margin="0,0,4,0">
                            <TextBlock Text="⬜" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <!-- Mode Add -->
                        <Border x:Name="BtnSelModeAdd" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="#353945" Background="Transparent" Cursor="Hand" ToolTip="Add to Selection (Cộng thêm vùng chọn)" MouseLeftButtonDown="SelMode_Click" Tag="Add" Margin="0,0,4,0">
                            <TextBlock Text="➕" FontSize="8" Foreground="#dde3ef" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Mode Subtract -->
                        <Border x:Name="BtnSelModeSubtract" Width="18" Height="18" CornerRadius="2" BorderThickness="1" BorderBrush="#353945" Background="Transparent" Cursor="Hand" ToolTip="Subtract from Selection (Trừ bớt vùng chọn)" MouseLeftButtonDown="SelMode_Click" Tag="Subtract">
                            <TextBlock Text="➖" FontSize="8" Foreground="#dde3ef" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <Button Content="Deselect (Ctrl+D)" Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" Click="OptDeselect_Click"/>
                    <Button Content="Copy (Ctrl+C)" Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" Click="OptCopy_Click"/>
                    <Button Content="Paste (Ctrl+V)" Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" Click="OptPaste_Click"/>
                    <Button Content="Delete (Del)" Style="{StaticResource IpAdjBtn}" Click="OptDelete_Click"/>
                </StackPanel>

                <!-- ═══ CROP OPTIONS ═══ -->
                <StackPanel x:Name="OptCropPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="✂️ Crop Canvas" FontSize="9" FontWeight="Bold" Foreground="#4fffb0" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <TextBlock Text="Ratio:" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="OptCropRatioCombo" Height="18" Width="100" FontSize="9" Style="{StaticResource IpComboBoxStyle}" VerticalContentAlignment="Center" SelectionChanged="OptCropRatioCombo_SelectionChanged" Margin="0,0,12,0">
                        <ComboBoxItem Content="Tự do" Tag="Free" IsSelected="True"/>
                        <ComboBoxItem Content="1:1 (Square)" Tag="1:1"/>
                        <ComboBoxItem Content="16:9 (Widescreen)" Tag="16:9"/>
                        <ComboBoxItem Content="4:3 (Standard)" Tag="4:3"/>
                        <ComboBoxItem Content="Tỉ lệ tự nhập" Tag="Custom"/>
                    </ComboBox>

                    <StackPanel x:Name="OptCropCustomInputs" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,12,0">
                        <TextBox x:Name="OptCropCustomW" Width="25" Height="18" FontSize="9" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#353945" Background="#12141c" Foreground="White" TextChanged="OptCropCustomRatio_TextChanged"/>
                        <TextBlock Text=":" FontSize="9" Foreground="#5a6072" VerticalAlignment="Center" Margin="4,0,4,0"/>
                        <TextBox x:Name="OptCropCustomH" Width="25" Height="18" FontSize="9" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" BorderBrush="#353945" Background="#12141c" Foreground="White" TextChanged="OptCropCustomRatio_TextChanged"/>
                    </StackPanel>

                    <Button Content="Crop (Enter)" Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" Click="OptCropApply_Click"/>
                    <Button Content="Cancel (Esc)" Style="{StaticResource IpAdjBtn}" Click="OptCropCancel_Click"/>
                </StackPanel>

                <!-- ═══ SLICE OPTIONS ═══ -->
                <StackPanel x:Name="OptSlicePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="🍕 Slices" FontSize="9" FontWeight="Bold" Foreground="#4fffb0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Clear All Slices" Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" Click="OptSliceClearAll_Click"/>
                    <Button Content="Export Slices as Images" Style="{StaticResource IpAdjBtn}" Click="OptSliceExport_Click"/>
                </StackPanel>

                <!-- ═══ MOVE / TRANSFORM OPTIONS ═══ -->
                <!-- ═══ MOVE OPTIONS ═══ -->
                <StackPanel x:Name="OptMovePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="✋ Move Layer" FontSize="9" FontWeight="Bold" Foreground="#4fffb0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ═══ TRANSFORM OPTIONS ═══ -->
                <StackPanel x:Name="OptTransformPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="📐 Free Transform" FontSize="9" FontWeight="Bold" Foreground="#4fffb0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    
                    <!-- Rotation Buttons -->
                    <Button Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" ToolTip="Xoay trái 90 độ" Click="OptMoveRotate90Left_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="10" Height="10" Fill="White" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='rotate-left solid'}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="-90°" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" ToolTip="Xoay phải 90 độ" Click="OptMoveRotate90Right_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="10" Height="10" Fill="White" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='rotate-right solid'}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="+90°" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" ToolTip="Xoay phải 45 độ" Click="OptMoveRotate45_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="10" Height="10" Fill="White" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='rotate-right solid'}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="+45°" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" ToolTip="Xoay 180 độ" Click="OptMoveRotate180_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="10" Height="10" Fill="White" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='rotate-right solid'}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="180°" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="12" Width="1" Background="#353945" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <!-- Flip Buttons -->
                    <Button Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" ToolTip="Lật Ngang" Click="OptMoveFlipH_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="10" Height="10" Fill="White" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='arrows-left-right duotone'}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Flip H" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" ToolTip="Lật Dọc" Click="OptMoveFlipV_Click">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="10" Height="10" Fill="White" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='arrows-up-down duotone'}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Flip V" FontSize="9" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="12" Width="1" Background="#353945" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <!-- Apply / Cancel Session -->
                    <Button Content="Apply (Enter)" Style="{StaticResource IpAdjBtn}" Margin="0,0,6,0" Click="OptMoveApply_Click"/>
                    <Button Content="Cancel (Esc)" Style="{StaticResource IpAdjBtn}" Click="OptMoveCancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left toolbar (Đã được thay đổi sang LayerAiDialog, comment lại không sử dụng) -->
        <!--
        <Border x:Name="LeftMenuBorder" Grid.Row="2" Grid.Column="0"
                Background="#28FFFFFF" Padding="4,0,4,6"
