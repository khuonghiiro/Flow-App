        <!-- Left vertical/horizontal wrap toolbox: Editor mode (Photoshop-style) -->
        <Border x:Name="EditorToolbox" Grid.Row="2" Grid.Column="0"
                Background="#0a0c10" Padding="3,6,3,4"
                Visibility="Visible">
            <Border.Resources>
                <!-- ═══ Shared hover/active style cho tất cả FX buttons ═══ -->
                <Style x:Key="FxToolBtnStyle" TargetType="Border">
                    <Setter Property="Width" Value="32"/>
                    <Setter Property="Height" Value="32"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#20FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0" Margin="0">
                <!-- WrapPanel với Orientation=Horizontal: xếp vừa đẹp theo icon và tự cuộn dọc khi chiều cao node thu nhỏ -->
                <WrapPanel Orientation="Horizontal" Margin="2,0,2,0">
                    
                    <!-- ══════ GROUP 1: DRAWING TOOLS ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock Text="DRAW" FontSize="7" FontWeight="Bold" Foreground="#5a6072"
                                   HorizontalAlignment="Center" Margin="0,1,0,3"/>

                        <Border x:Name="TbxMove" Tag="Move" ToolTip="Move (V)"
         Style="{StaticResource FxToolBtnStyle}"
         MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
         Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='arrows-up-down-left-right duotone'}"
         HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        
                        <Border x:Name="TbxSelectionActive" Tag="Lasso" ToolTip="Lasso Tool (L)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="SelectionGroupBtn_LeftClick"
                                MouseRightButtonUp="SelectionGroupBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='pen-swirl duotone'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="3" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        
                        <Border x:Name="TbxSmartSelectionActive" Tag="MagicWand" ToolTip="Smart Selection (W)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="SelectionGroupBtn_LeftClick"
                                MouseRightButtonUp="SmartSelectionGroupBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='wand-magic-sparkles sharp-duotone-solid'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="3" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Border x:Name="TbxCropActive" Tag="CropCanvas" ToolTip="Crop Tool (C)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="SelectionGroupBtn_LeftClick"
                                MouseRightButtonUp="CropGroupBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='crop duotone'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="4" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Border x:Name="TbxBrush" Tag="Brush" ToolTip="Brush (B)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='paintbrush-fine duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="TbxEraser" Tag="Eraser" ToolTip="Eraser (E)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='eraser duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="TbxFill" Tag="Fill" ToolTip="Fill (G)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='fill-drip duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="TbxEyedropper" Tag="Eyedropper" ToolTip="Eyedropper (I)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='eye-dropper duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                       
                        <Border x:Name="TbxText" Tag="Text" ToolTip="Text (T)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='font duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        
                        <Rectangle Height="1" Fill="#252932" Margin="2,4,2,4"/>
                        <Grid Width="32" Height="32" Margin="0,0,0,2">
                            <Border x:Name="TbxBgColor" Width="18" Height="18"
                                    Background="White" CornerRadius="3"
                                    BorderBrush="#252932" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Cursor="Hand" ToolTip="Background color"
                                    MouseLeftButtonDown="EditorToolbox_BgColor_Click"/>
                            <Border x:Name="TbxFgColor" Width="18" Height="18"
                                    Background="Black" CornerRadius="3"
                                    BorderBrush="#dde3ef" BorderThickness="1"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Cursor="Hand" ToolTip="Foreground color"
                                    MouseLeftButtonDown="EditorToolbox_FgColor_Click"/>
                            <Button Content="⇄" Style="{StaticResource IpMiniBtn}" 
                                    Width="13" Height="13" FontSize="12" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-4,-2,0" Cursor="Hand" ToolTip="Swap Colors (X)"
                                    Click="EditorToolbox_SwapColors_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- ══════ GROUP 2: EFFECTS (FX) ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="FX" FontSize="7" FontWeight="Bold" Foreground="#5a6072"
                                   HorizontalAlignment="Center" Margin="0,1,0,3"/>
                        
                        <!-- Blur Active Button -->
                        <Border x:Name="TbxBlurActive" Tag="GaussianBlur" ToolTip="Gaussian Blur (Làm mịn ảnh, giảm nhiễu hạt độ chi tiết cao)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="MagickEffect_Click"
                                MouseRightButtonUp="GroupToolBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='droplet duotone'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="" Foreground="#dde3ef" FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="9" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                                <Ellipse x:Name="TbxBlurActive_ConfigDot" Width="3.5" Height="3.5" Fill="#ff4f4f"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Margin="1.5,0,0,1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Artistic Active Button -->
                        <Border x:Name="TbxArtActive" Tag="OilPaint" ToolTip="Oil Paint (Hiệu ứng tranh sơn dầu nghệ thuật)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="MagickEffect_Click"
                                MouseRightButtonUp="GroupToolBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="" Foreground="#dde3ef" FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="15" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                                <Ellipse x:Name="TbxArtActive_ConfigDot" Width="3.5" Height="3.5" Fill="#ff4f4f"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Margin="1.5,0,0,1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Edge Active Button -->
                        <Border x:Name="TbxEdgeActive" Tag="EdgeDetect" ToolTip="Edge Detect (Phát hiện biên ảnh cơ bản)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="MagickEffect_Click"
                                MouseRightButtonUp="GroupToolBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='object-group duotone'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="" Foreground="#dde3ef" FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="5" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                                <Ellipse x:Name="TbxEdgeActive_ConfigDot" Width="3.5" Height="3.5" Fill="#ff4f4f"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Margin="1.5,0,0,1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Color Active Button -->
                        <Border x:Name="TbxColorActive" Tag="AutoLevel" ToolTip="Auto Level (Tự động cân bằng histogram của ảnh)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="MagickEffect_Click"
                                MouseRightButtonUp="GroupToolBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='sliders duotone'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="" Foreground="#dde3ef" FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="21" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                                <Ellipse x:Name="TbxColorActive_ConfigDot" Width="3.5" Height="3.5" Fill="#ff4f4f"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Margin="1.5,0,0,1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Noise Active Button -->
                        <Border x:Name="TbxNoiseActive" Tag="AddNoiseGaussian" ToolTip="Noise (Gaussian) (Thêm nhiễu ngẫu nhiên Gauss hạt mịn)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="MagickEffect_Click"
                                MouseRightButtonUp="GroupToolBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='signal duotone'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="" Foreground="#dde3ef" FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="6" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                                <Ellipse x:Name="TbxNoiseActive_ConfigDot" Width="3.5" Height="3.5" Fill="#ff4f4f"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Margin="1.5,0,0,1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Morphology Active Button -->
                        <Border x:Name="TbxMorphActive" Tag="Dilate" ToolTip="Dilate (Giãn nở vùng sáng của ảnh)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="MagickEffect_Click"
                                MouseRightButtonUp="GroupToolBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='expand duotone'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="" Foreground="#dde3ef" FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="8" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                                <Ellipse x:Name="TbxMorphActive_ConfigDot" Width="3.5" Height="3.5" Fill="#ff4f4f"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Margin="1.5,0,0,1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Transform Active Button -->
                        <Border x:Name="TbxXFormActive" Tag="Deskew" ToolTip="Deskew (Tự động chỉnh ảnh bị nghiêng thẳng lại)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="MagickEffect_Click"
                                MouseRightButtonUp="GroupToolBtn_RightClick">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='rotate duotone'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Text="" Foreground="#dde3ef" FontSize="9.5" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="13" FontSize="7.5" FontWeight="Bold" Foreground="#a0dde3ef"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,0,1,1" IsHitTestVisible="False"/>
                                <Ellipse x:Name="TbxXFormActive_ConfigDot" Width="3.5" Height="3.5" Fill="#ff4f4f"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Margin="1.5,0,0,1.5" IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                </WrapPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ LOADING OVERLAY (during FX processing) ═══ -->
        <Border x:Name="FxLoadingOverlay" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                Background="#B0000000" Panel.ZIndex="200"
                Visibility="Collapsed" IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="FxLoadingText" Text="Đang xử lý..."
                           Foreground="#dde3ef" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,6,0,4"/>
                <TextBlock x:Name="FxLoadingCancelHint" Text="Nhấn ESC để huỷ" Foreground="#5a6072" FontSize="10"
                           HorizontalAlignment="Center" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Center: tab strip + image area -->
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ IMAGE TAB STRIP (Photoshop-style) ═══ -->
            <Border Grid.Row="0" Background="#14FFFFFF" BorderBrush="#252932" BorderThickness="0,0,0,1" Padding="2,0,2,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center" Padding="0">
                    <StackPanel x:Name="ImageTabStrip" Orientation="Horizontal" VerticalAlignment="Center"/>
                </ScrollViewer>
            </Border>

            <!-- Image viewer: infinite canvas with RenderTransform pan/zoom -->
            <Border x:Name="MainScrollViewer" Grid.Row="1" ClipToBounds="True"
                    Focusable="True" Background="#0a0c10">
            <Canvas x:Name="InfiniteCanvas" Width="10000" Height="10000" Background="Transparent"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ClipToBounds="False">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageZoomScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Grid x:Name="ImageAreaGrid"
                      HorizontalAlignment="Left" VerticalAlignment="Top">
                    
                    <!-- Image container with checkered transparency pattern and selection overlay -->
                    <Grid x:Name="ImageContainer" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <!-- Canvas Background representing the actual document bounds (Photoshop style) -->
                        <Rectangle Width="{Binding ElementName=MainImage, Path=Width}"
                                   Height="{Binding ElementName=MainImage, Path=Height}"
                                   Fill="{StaticResource PsCheckeredBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   IsHitTestVisible="False"/>
                        
                        <Image x:Name="MainImage" Stretch="Uniform"
                               HorizontalAlignment="Left" VerticalAlignment="Top"/>

                        <Image x:Name="ActiveLayerDrawingOverlay" Stretch="Uniform"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Visibility="Collapsed" IsHitTestVisible="False"/>

                        <!-- Brush cursor preview (Photoshop style) -->
                        <Canvas x:Name="BrushCursorCanvas" IsHitTestVisible="False" Panel.ZIndex="150"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Ellipse x:Name="BrushPreviewCursor" Stroke="White" StrokeThickness="1"
                                     Visibility="Collapsed" IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="1" ShadowDepth="0" Color="Black" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Canvas x:Name="BrushCrosshairCursor" Visibility="Collapsed" IsHitTestVisible="False">
                                <Canvas.RenderTransform>
                                    <ScaleTransform x:Name="CrosshairScale" ScaleX="1" ScaleY="1"/>
                                </Canvas.RenderTransform>
                                
                                <Line X1="-8" Y1="0" X2="8" Y2="0" Stroke="White" StrokeThickness="3"/>
                                <Line X1="-8" Y1="0" X2="8" Y2="0" Stroke="Black" StrokeThickness="1"/>
                                <Line X1="0" Y1="-8" X2="0" Y2="8" Stroke="White" StrokeThickness="3"/>
                                <Line X1="0" Y1="-8" X2="0" Y2="8" Stroke="Black" StrokeThickness="1"/>
                            </Canvas>
                        </Canvas>

                        <!-- Eyedropper cursor preview (split square & hex text) -->
                        <Canvas x:Name="EyedropperCursorCanvas" IsHitTestVisible="False" Panel.ZIndex="155"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid x:Name="EyedropperPreviewContainer" Visibility="Collapsed" RenderTransformOrigin="0,0">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="EyedropperScaleTransform" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <StackPanel Orientation="Horizontal" Margin="-18,-51,0,0">
                                    <!-- Split preview square -->
                                    <Border Width="36" Height="36" CornerRadius="3" ClipToBounds="True" BorderBrush="#353945" BorderThickness="1" Background="{StaticResource PsCheckeredBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.5" Color="Black"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <!-- Top: sampled color under cursor -->
                                            <Border Grid.Row="0" x:Name="EyedropperNewColorBorder" Background="Transparent"/>
                                            <!-- Bottom: current active color -->
                                            <Border Grid.Row="1" x:Name="EyedropperOldColorBorder" Background="Transparent"/>
                                        </Grid>
                                    </Border>
                                    <!-- Hex text tooltip -->
                                    <Border Margin="6,0,0,0" Padding="5,2" Background="#DD111318" BorderBrush="#353945" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                        <TextBlock x:Name="EyedropperHexText" Text="#FFFFFF" FontSize="8.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#4fffb0" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Canvas>

                        <!-- Selection Overlay (marching ants: black solid bg + white dashed with offset animation) -->
                        <!-- Marquee Black background stroke -->
                        <Rectangle x:Name="SelectionBoxRectBg"
                                   Stroke="Black" StrokeThickness="1"
                                   Fill="Transparent"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- Marquee White dashed foreground stroke (no animation during draw) -->
                        <Rectangle x:Name="SelectionBoxRect"
                                   Stroke="White" StrokeThickness="1"
                                   StrokeDashArray="2 2"
                                   Fill="Transparent"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Visibility="Collapsed" IsHitTestVisible="False"/>

                        <!-- Committed Selection Polygon Background (Black solid) -->
                        <Path x:Name="SelectionPolygonBg"
                              Stroke="Black" StrokeThickness="1"
                              Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- Committed Selection Polygon Foreground (White dashed + marching ants) -->
                        <Path x:Name="SelectionPolygon"
                              Stroke="White" StrokeThickness="1"
                              StrokeDashArray="2 2"
                              Fill="Transparent"
                              Visibility="Collapsed" IsHitTestVisible="False"/>

                        <!-- Selection Preview Background (Black solid, static) -->
                        <Path x:Name="SelectionPreviewPolygonBg"
                              Stroke="Black" StrokeThickness="1"
                              Fill="Transparent"
                              Visibility="Collapsed" IsHitTestVisible="False"/>
                        <!-- Selection Preview Foreground (White dashed, static) -->
                        <Path x:Name="SelectionPreviewPolygon"
                              Stroke="White" StrokeThickness="1"
                              StrokeDashArray="2 2"
                              Fill="Transparent"
                              Visibility="Collapsed" IsHitTestVisible="False"/>

                        <!-- Slices Overlay Canvas -->
                        <Canvas x:Name="SlicesCanvas" IsHitTestVisible="False" Panel.ZIndex="140"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>

                         <!-- Transform Preview Image for smooth real-time GPU scaling/rotation -->
                        <Image x:Name="TransformPreviewImage" Stretch="Fill"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Visibility="Collapsed" Panel.ZIndex="143"
                               RenderTransformOrigin="0.5,0.5"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TransformGroup x:Name="TransformPreviewGroup">
                                    <ScaleTransform x:Name="TransformPreviewScale" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="TransformPreviewRotate" Angle="0"/>
                                    <TranslateTransform x:Name="TransformPreviewTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Transform interactive overlay bounds and handles (Photoshop Ctrl+T style) -->
                        <Canvas x:Name="TransformOverlayCanvas" IsHitTestVisible="True" Panel.ZIndex="144"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
                                Background="Transparent"
                                MouseLeftButtonDown="TransformOverlay_MouseDown"
                                MouseMove="TransformOverlay_MouseMove"
                                MouseLeftButtonUp="TransformOverlay_MouseUp">
                            <Canvas x:Name="TransformBoxVisual" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <TransformGroup x:Name="TransformBoxGroup">
                                        <ScaleTransform x:Name="TransformBoxScale" ScaleX="1" ScaleY="1"/>
                                        <RotateTransform x:Name="TransformBoxRotate" Angle="0"/>
                                        <TranslateTransform x:Name="TransformBoxTranslate" X="0" Y="0"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <!-- Bounding Border -->
                                <Path x:Name="TransformBoxBorderPath" Stroke="#00cfff" StrokeThickness="2.5" StrokeDashArray="3 3"/>
                                <!-- Handles (8 resize markers) -->
                                <Canvas x:Name="TransformHandlesCanvas">
                                    <Rectangle x:Name="TransHandle_TL" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNWSE" Tag="TL"/>
                                    <Rectangle x:Name="TransHandle_T" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNS" Tag="T"/>
                                    <Rectangle x:Name="TransHandle_TR" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNESW" Tag="TR"/>
                                    <Rectangle x:Name="TransHandle_R" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeWE" Tag="R"/>
                                    <Rectangle x:Name="TransHandle_BR" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNWSE" Tag="BR"/>
                                    <Rectangle x:Name="TransHandle_B" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNS" Tag="B"/>
                                    <Rectangle x:Name="TransHandle_BL" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNESW" Tag="BL"/>
                                    <Rectangle x:Name="TransHandle_L" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeWE" Tag="L"/>
                                </Canvas>
                            </Canvas>

                            <!-- Custom Floating Rotate Cursor -->
                            <Canvas x:Name="RotateCursorCanvas" IsHitTestVisible="False" Panel.ZIndex="999" Visibility="Collapsed">
                                <controls:SvgViewboxEx x:Name="RotateCursorIconOutline" Width="18" Height="18" Fill="Black" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='rotate-right solid'}" Canvas.Left="-1" Canvas.Top="-1"/>
                                <controls:SvgViewboxEx x:Name="RotateCursorIcon" Width="16" Height="16" Fill="White" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='rotate-right solid'}"/>
                            </Canvas>
                        </Canvas>

                        <!-- Crop Overlay Canvas (Photoshop style) -->
                        <Canvas x:Name="CropOverlayCanvas" IsHitTestVisible="True" Panel.ZIndex="145"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"
                                Background="Transparent"
                                MouseLeftButtonDown="CropOverlay_MouseDown"
                                MouseMove="CropOverlay_MouseMove"
                                MouseLeftButtonUp="CropOverlay_MouseUp">
                            <!-- Shield: Darkened area outside crop box -->
                            <Path x:Name="CropShieldPath" Fill="#B0000000"/>
                            <!-- Crop Box Border -->
                            <Path x:Name="CropBoxBorderPath" Stroke="#00cfff" StrokeThickness="1.5"/>
                            <!-- Rule of Thirds Grid Lines -->
                            <Path x:Name="CropGridLinesPath" Stroke="#aa00cfff" StrokeThickness="1" StrokeDashArray="3 3"/>
                            
                            <!-- Handles (8 resize markers) -->
                            <Canvas x:Name="CropHandlesCanvas">
                                <Rectangle x:Name="Handle_TL" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNWSE" Tag="TL"/>
                                <Rectangle x:Name="Handle_T" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNS" Tag="T"/>
                                <Rectangle x:Name="Handle_TR" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNESW" Tag="TR"/>
                                <Rectangle x:Name="Handle_R" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeWE" Tag="R"/>
                                <Rectangle x:Name="Handle_BR" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNWSE" Tag="BR"/>
                                <Rectangle x:Name="Handle_B" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNS" Tag="B"/>
                                <Rectangle x:Name="Handle_BL" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeNESW" Tag="BL"/>
                                <Rectangle x:Name="Handle_L" Width="8" Height="8" Fill="White" Stroke="#12141c" StrokeThickness="1.5" Cursor="SizeWE" Tag="L"/>
                            </Canvas>
                        </Canvas>

                        <!-- Text Tool Interactive Box Overlay -->
                        <Grid x:Name="TextMoveContainer" HorizontalAlignment="Left" VerticalAlignment="Top"
                              Visibility="Collapsed" Margin="0,0,0,0">
                            <Grid x:Name="TextBoundingBorder" MinWidth="100" MinHeight="40"
                                  Background="#01000000"
                                  MouseLeftButtonDown="TextToolbar_MouseLeftButtonDown"
                                  MouseMove="TextToolbar_MouseMove"
                                  MouseLeftButtonUp="TextToolbar_MouseLeftButtonUp"
                                  Cursor="SizeAll">
                                <Rectangle Stroke="#00cfff" StrokeThickness="1"
                                           StrokeDashArray="3 3" Fill="#1500cfff" RadiusX="2" RadiusY="2"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="TextEditorBox" Background="Transparent" Foreground="White"
                                         BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontSize="24" FontFamily="Arial" FontWeight="Bold"
                                         CaretBrush="White" Padding="4"
                                         VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                         Text="Nhập chữ..."
                                         PreviewKeyDown="TextEditorBox_PreviewKeyDown"
                                         TextChanged="TextEditorBox_TextChanged"/>
                            </Grid>

                            <!-- Resize Thumb at bottom-right corner -->
                            <Thumb x:Name="TextResizeThumb" Width="8" Height="8" Background="White" BorderBrush="#00cfff"
                                   BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Cursor="SizeNWSE" Margin="0,0,-4,-4" DragDelta="TextResizeThumb_DragDelta"/>
                        </Grid>
                    </Grid>
                    
                    <TextBlock x:Name="PlaceholderTextBlock"
                               Text="Chưa có ảnh. Mở dialog (chuột phải hoặc nút Mở) để dán link/base64."
                               Foreground="#B0BEC5" FontSize="16" TextWrapping="Wrap"
                               Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Opacity="0.85"/>
                </Grid>
            </Canvas>
        </Border>
        </Grid> <!-- end center tab+image Grid -->

        <!-- Right panel: AI mode (crops + renders) (Đã được thay đổi sang LayerAiDialog, comment lại không sử dụng) -->
        <!--
        <Border x:Name="RightMenuBorder" Grid.Row="2" Grid.Column="2"
                Background="#28000000" Padding="4"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="CropsLabelText" Text="Danh sách ảnh cắt"
                                   Foreground="White" FontSize="11" Opacity="0.7"
                                   Margin="0,0,0,4" HorizontalAlignment="Left"/>
                        <ItemsControl x:Name="CropsListControl"
                                      ItemTemplate="{StaticResource CropListItemTemplate}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="RenderLabelText" Text="Ảnh render"
                                   Foreground="White" FontSize="11" Opacity="0.7"
                                   Margin="0,4,0,4" HorizontalAlignment="Left"/>
                        <ItemsControl x:Name="RenderGroupsControl"
                                      ItemTemplate="{StaticResource RenderGroupTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        -->

        <!-- Right panel: Editor mode (layers, tools, colors) -->
        <local:ImageEditorPanel x:Name="EditorPanel" Grid.Row="2" Grid.Column="2"
                                Width="240" Visibility="Visible"/>

        <!-- Magnifier (Alt), same cell as image -->
        <Grid x:Name="MagOverlayPanel" Grid.Row="2" Grid.Column="1"
              Width="124" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,8,8" Panel.ZIndex="100"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Width="124" Height="124"
                    BorderBrush="#FFFFD700" BorderThickness="2"
                    Background="#CC1E1E2E" CornerRadius="4"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid Width="120" Height="120" ClipToBounds="True" IsHitTestVisible="False">
                    <Image x:Name="MagZoomImage" Width="120" Height="120"
                           Stretch="Uniform" IsHitTestVisible="False"/>
                    <Line X1="0" Y1="60" X2="120" Y2="60" StrokeThickness="0.8"
                          IsHitTestVisible="False" Stroke="#78FF0000"/>
                    <Line X1="60" Y1="0" X2="60" Y2="120" StrokeThickness="0.8"
                          IsHitTestVisible="False" Stroke="#78FF0000"/>
                    <Ellipse Width="10" Height="10" Stroke="Red" StrokeThickness="1.5"
                             Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <TextBlock x:Name="MagCoordTextBlock" Grid.Row="1"
                       Foreground="White" FontSize="9"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,2" IsHitTestVisible="False"/>
        </Grid>

        <!-- Image Processor (code gán Content từ BuildImageProcessorColumn) -->
        <ContentControl x:Name="IpProcessorHost" Grid.Row="0" Grid.Column="3"
                        Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- ═══ SLEEK PHOTOSHOP-STYLE TOOL VARIANT POPUP (ICON GRID) ═══ -->
        <Popup x:Name="FxGroupPopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Right" HorizontalOffset="6" VerticalOffset="-4"
               PopupAnimation="Fade" Closed="FxGroupPopup_Closed">
            <Border Background="#12141c" BorderBrush="#2a2e3d" BorderThickness="1.2"
                    CornerRadius="6" Padding="4" SnapsToDevicePixels="True" MaxWidth="136"
                    UseLayoutRounding="True"
                    RenderOptions.ClearTypeHint="Enabled"
                    TextOptions.TextFormattingMode="Ideal"
                    TextOptions.TextRenderingMode="Auto"
                    RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <ItemsControl x:Name="FxPopupItemsControl" MaxWidth="128">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Mỗi công cụ con chỉ hiển thị Icon ô vuông hoặc Text có ToolTip -->
                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" 
                                    Width="28" Height="28" Margin="2" Cursor="Hand"
                                    BorderBrush="Transparent" BorderThickness="0.5"
                                    ToolTip="{Binding ToolTipText}"
                                    MouseLeftButtonDown="FxPopupItem_Click">
                                <Grid>
                                    <!-- Icon Svg -->
                                    <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                                          Source="{Binding IconKey, Converter={StaticResource IconKeyToPathConverter}}"
                                                          Visibility="{Binding SvgVisibility}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <!-- Text Icon (ví dụ: 90°) -->
                                    <TextBlock Text="{Binding TextIcon}" Foreground="#dde3ef" FontSize="9.5" FontWeight="Bold"
                                               Visibility="{Binding TextVisibility}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <!-- SkiaSharp badge: chấm xanh nhỏ góc dưới-phải -->
                                    <Ellipse Width="5" Height="5" Fill="#4fffb0"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,1,1" IsHitTestVisible="False"
                                             Visibility="{Binding SkiaBadgeVisibility}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- Hover effect: Viền xanh ngọc nhẹ và nền tối sáng -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#202533"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#404fffb0"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>

        <!-- ═══ PHOTOSHOP-STYLE SELECTION TOOL VARIANT POPUP ═══ -->
        <Popup x:Name="SelectionGroupPopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Right" HorizontalOffset="6" VerticalOffset="-4"
               PopupAnimation="Fade" Closed="SelectionGroupPopup_Closed">
            <Border Background="#12141c" BorderBrush="#2a2e3d" BorderThickness="1.2"
                    CornerRadius="6" Padding="6,4" SnapsToDevicePixels="True" MinWidth="180"
                    UseLayoutRounding="True"
                    RenderOptions.ClearTypeHint="Enabled"
                    TextOptions.TextFormattingMode="Ideal"
                    TextOptions.TextRenderingMode="Auto"
                    RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <ItemsControl x:Name="SelectionPopupItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" 
                                    Padding="6,5" Cursor="Hand" Margin="0,1"
                                    BorderBrush="Transparent" BorderThickness="0.5"
                                    ToolTip="{Binding ToolTipText}"
                                    MouseLeftButtonDown="SelectionPopupItem_Click">
                                <DockPanel LastChildFill="True">
                                    <controls:SvgViewboxEx Width="14" Height="14" Fill="#dde3ef" Margin="0,0,8,0" DockPanel.Dock="Left"
                                                          Source="{Binding IconKey, Converter={StaticResource IconKeyToPathConverter}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#788296" FontSize="8" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#202533"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#404fffb0"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
