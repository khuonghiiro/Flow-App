                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:SvgViewboxEx Width="11" Height="11" Margin="0,0,4,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='bolt duotone-light'}"/>
