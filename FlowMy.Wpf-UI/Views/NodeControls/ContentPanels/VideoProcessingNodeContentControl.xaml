                                <Button x:Name="ResetSubtitleSettingsButton" Content="Đặt lại mặc định" Height="30" Width="120" Padding="0" HorizontalAlignment="Right" Style="{StaticResource VideoChromeResetButtonStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 6: LỒNG TIẾNG (DUBBING & AI TTS STUDIO) -->
