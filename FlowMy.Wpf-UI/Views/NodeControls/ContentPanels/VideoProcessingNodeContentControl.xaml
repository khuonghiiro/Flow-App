                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <Grid Margin="0,0,0,2">
                                                            <TextBlock Text="Độ trễ mượt vào (Attack)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
