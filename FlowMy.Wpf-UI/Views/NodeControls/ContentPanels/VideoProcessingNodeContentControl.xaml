                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- RAM Memory badge -->
                                                <Border Background="{DynamicResource ThemeBadgeBackgroundBrush}" CornerRadius="8" Padding="6,2" Margin="0,0,8,0">
