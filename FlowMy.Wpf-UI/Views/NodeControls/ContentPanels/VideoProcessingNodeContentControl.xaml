                                        <controls:SvgViewboxEx x:Name="VideoLoopIcon" Width="14" Height="14"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='repeat regular'}"/>
                                    </Button>
                                    <Button x:Name="MuteButton" Grid.Column="12" Width="30" Height="30" Padding="0" Style="{StaticResource IconButtonStyle}" FontSize="11" ToolTip="Bật/Tắt âm">
                                        <controls:SvgViewboxEx Width="14" Height="14"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='volume-high duotone-light'}"/>
                                    </Button>
                                    <Slider x:Name="VolumeSlider" Grid.Column="13" Minimum="0" Maximum="1" Value="0.7" VerticalAlignment="Center" Margin="2,0" Style="{StaticResource ModernSliderStyle}"/>
                                    <!-- Player Speed Dropdown (Synchronized with AudioSpeedSlider) -->
                                    <ComboBox x:Name="PlayerSpeedCombo" Grid.Column="15" Height="26" Width="65" FontSize="10.5" Style="{StaticResource DarkComboBoxStyle}" VerticalAlignment="Center" ToolTip="Tốc độ phát Video &amp; Audio">
                                        <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                        <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                        <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True"/>
                                        <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                        <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                        <ComboBoxItem Content="1.75x" Tag="1.75"/>
                                        <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                    </ComboBox>
                                    <!-- FFplay Hardware DSP Player Button -->
                                    <Button Visibility="Collapsed" x:Name="LaunchFfplayPreviewButton" Grid.Column="15" Width="30" Height="28" Padding="0" Style="{StaticResource IconButtonStyle}" ToolTip="Phát thử trực tiếp bằng FFplay (GPU Hardware Acceleration + Full Filter)">
                                        <controls:SvgViewboxEx Width="14" Height="14"
                                                               Fill="{DynamicResource ThemeAccentBrush}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='play-circle duotone-light'}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Console & Progress Log Card -->
                <Border x:Name="LogPanelBorder" Grid.Row="3" Margin="10,8,10,10" Background="{DynamicResource ThemeLogContainerBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource ThemePanelHeaderBrush}" CornerRadius="10,10,0,0" Padding="12,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProgressStatusText" Text="Chưa chạy" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock x:Name="ProgressPercentText" Margin="8,0,0,0" FontSize="11" FontFamily="Consolas" Opacity="0.9" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ClearLogButton" Content="Xóa" Height="24" Padding="10,0" FontSize="10" Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                                    <Button x:Name="CopyLogButton" Content="Copy" Height="24" Padding="10,0" FontSize="10" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="2">
                            <Grid>
                                <Border Background="{DynamicResource ThemeTrackBackgroundBrush}"/>
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="{DynamicResource ThemeAccentBrush}" Width="0"/>
                            </Grid>
                        </Border>

                        <!-- Quick Action Bar on Successful Export -->
                        <Border x:Name="LogSuccessActionBar" Grid.Row="1" Visibility="Collapsed" Background="#2016A34A" BorderBrush="#4422C55E" BorderThickness="0,0,0,1" Padding="10,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎉 ĐÃ XUẤT XONG:" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="LogOpenFolderButton" Content="📁 Mở Thư Mục" Height="24" Padding="10,0" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#15803D"/>
                                                <Setter Property="BorderBrush" Value="#22C55E"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#16A34A"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4ADE80"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#14532D"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#22C55E"/>
                                                                    <Setter Property="Foreground" Value="#E2E8F0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="LogOpenFileButton" Content="🎬 Mở Video" Height="24" Padding="10,0" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#2563EB"/>
                                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#3B82F6"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                                                    <Setter Property="Foreground" Value="#E2E8F0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="LogOpenAudioButton" Content="🎵 Mở Audio" Height="24" Padding="10,0" FontSize="11" FontWeight="Bold" Visibility="Collapsed" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#7C3AED"/>
                                                <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#8B5CF6"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#A78BFA"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#5B21B6"/>
                                                                    <Setter Property="Foreground" Value="#E2E8F0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button x:Name="LogOpenFramesButton" Content="🖼 Mở Frames" Height="24" Padding="10,0" FontSize="11" FontWeight="Bold" Visibility="Collapsed" Margin="0,0,6,0" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#D97706"/>
                                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#F59E0B"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FCD34D"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#92400E"/>
                                                                    <Setter Property="Foreground" Value="#E2E8F0"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <Button x:Name="LogDismissActionBannerButton" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Width="20" Height="20" Padding="0" FontSize="10" FontWeight="Bold" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#334155"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#475569"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <RichTextBox x:Name="LogRichTextBox"
                                         IsReadOnly="True"
                                         IsDocumentEnabled="True"
                                         Focusable="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="12,10"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         CaretBrush="{DynamicResource ThemeTextPrimaryBrush}"
                                         Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                        </ScrollViewer>
                        <Grid Grid.Row="3" Margin="12,6,12,8">
                            <TextBlock x:Name="ElapsedTimeText" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Elapsed: --"/>
                            <TextBlock x:Name="EstimatedTimeText" HorizontalAlignment="Right" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="ETA: --"/>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <TabControl x:Name="PortraitVideoLogTabControl"
                            Style="{StaticResource VideoPortraitEqualTabControlStyle}"
                            Visibility="Collapsed"
                            Margin="0">
                    <TabItem Header="Video">
                        <Grid x:Name="PortraitVideoHostPanel" Margin="0,2,0,0"/>
                    </TabItem>
                    <TabItem Header="Log">
                        <Grid x:Name="PortraitLogHostPanel" Margin="0,2,0,0"/>
                    </TabItem>
                </TabControl>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Tab Navigation & Control Panels -->
            <Grid x:Name="RightPanelGrid" Grid.Column="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Horizontal Pill Tabs Navigation Header -->
            <Border Grid.Row="0" x:Name="TabNavBorder" Margin="0,0,0,10" Padding="12,10" Background="{DynamicResource ThemeTabNavBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Thiết lập Video &amp; Tiến trình" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    <ListBox x:Name="TabNavList" Margin="0,8,0,0" Style="{StaticResource PillTabNavStyle}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem Content="Tổng quan" Tag="General"/>
                        <ListBoxItem Content="Bộ lọc" Tag="Grading"/>
                        <ListBoxItem Content="Chèn ảnh video" Tag="Filters"/>
                        <ListBoxItem Content="Audio" Tag="Audio"/>
                        <ListBoxItem Content="Phụ đề" Tag="Subtitles"/>
                        <ListBoxItem Content="Lồng tiếng" Tag="Dubbing"/>
                        <ListBoxItem Content="Cắt ghép" Tag="TrimConcat"/>
                        <ListBoxItem Content="Đầu ra" Tag="Outputs"/>
                        <ListBoxItem Content="Cài đặt" Tag="Settings"/>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Tab Content Cards Host -->
            <Border Grid.Row="1" x:Name="TabContentBorder" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                <Grid>
                    <!-- TAB 1: TỔNG QUAN (GENERAL) -->
                    <Grid x:Name="GeneralTabContent" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Card 1: Stats summary badges -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="RESOLUTION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <TextBlock x:Name="StatResolutionText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="FPS NGUỒN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <TextBlock x:Name="StatFpsText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="THỜI LƯỢNG" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <TextBlock x:Name="StatDurationText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,10" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock x:Name="CodecInfoText" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                        <TextBlock x:Name="AudioSummaryText" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Hidden: slider removed from UI but kept for code-behind reference -->
                                <Grid Visibility="Collapsed">
                                    <Slider x:Name="SecondsPerFrameSlider" Minimum="1" Maximum="60" Value="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock x:Name="SecondsPerFrameValueText"/>
                                </Grid>

                                <!-- Frame Extraction Control Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Cấu hình Tách Frame" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Theo FPS (frame/s)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ToggleButton x:Name="ExtractByFpsToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" ToolTip="Bật: Tách theo số frame mỗi giây (FPS) | Tắt: Tách theo tổng số lượng frame"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Mode 1: Theo FPS (1s lấy bao nhiêu frame) - Visible when Toggle is ON -->
                                        <StackPanel x:Name="ExtractByFpsContainer" Visibility="Visible" Margin="0,0,0,10">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Số frame lấy trong mỗi giây (FPS)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <TextBlock x:Name="ExtractFpsRateLabel" Text="1 frame/s" FontSize="11" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="54"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="ExtractFpsRateSlider"
                                                        Minimum="1"
                                                        Maximum="30"
                                                        Value="1"
                                                        TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Kéo để chọn 1 giây muốn lấy bao nhiêu frame."/>
                                                <TextBox Grid.Column="1"
                                                         x:Name="ExtractFpsRateBox"
                                                         Height="26"
                                                         Margin="6,0,0,0"
                                                         FontSize="11"
                                                         FontFamily="Consolas"
                                                         FontWeight="Bold"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                         BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                         Foreground="{DynamicResource ThemeInputForegroundBrush}"
                                                         Text="1"
                                                         ToolTip="Nhập số frame cần lấy trong 1 giây"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Mode 2: Theo Tổng số frame cần lấy - Visible when Toggle is OFF -->
                                        <StackPanel x:Name="ExtractByCountContainer" Visibility="Collapsed" Margin="0,0,0,10">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Tổng số lượng frame cần lấy" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <TextBlock x:Name="FpsValueText" Text="10" FontSize="11" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="54"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="FpsSlider"
                                                        Minimum="1"
                                                        Maximum="300"
                                                        Value="10"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Tổng số lượng frame cần trích xuất trên toàn bộ video."/>
                                                <TextBox Grid.Column="1"
                                                         x:Name="FpsValueBox"
                                                         Height="26"
                                                         Margin="6,0,0,0"
                                                         FontSize="11"
                                                         FontFamily="Consolas"
                                                         FontWeight="Bold"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                         BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                         Foreground="{DynamicResource ThemeInputForegroundBrush}"
                                                         Text="10"
                                                         ToolTip="Nhập tổng số frame cần lấy"/>
                                            </Grid>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="FrameFormatCombo" Height="28" Margin="0,0,8,0" Style="{StaticResource DarkComboBoxStyle}" ToolTip="PNG: lossless, JPEG: nhẹ hơn, WebP: cân bằng.">
                                                <ComboBoxItem Content="PNG" Tag="png" IsSelected="True"/>
                                                <ComboBoxItem Content="JPEG" Tag="jpg"/>
                                                <ComboBoxItem Content="WebP" Tag="webp"/>
                                            </ComboBox>
                                            <Slider Grid.Column="1" x:Name="JpegQualitySlider" Minimum="0" Maximum="100" Value="100" Style="{StaticResource ModernSliderStyle}" ToolTip="Chất lượng JPEG 0-100. 85-95 phù hợp cho AI vision." VerticalAlignment="Center"/>
                                            <TextBlock x:Name="JpegQualityLabel" Grid.Column="2"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                       Margin="8,4,0,0"
                                                       HorizontalAlignment="Right"
                                                       Visibility="Collapsed"
                                                       Text="Quality: 100/100"/>
                                        </Grid>
                                        
                                        <TextBlock Text="Resize output frames"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   Margin="0,4,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="FrameResizeSlider"
                                                    Minimum="0.4"
                                                    Maximum="1.0"
                                                    Value="1.0"
                                                    Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="FrameResizeLabel"
                                                           FontSize="10"
                                                           FontFamily="Consolas"
                                                           HorizontalAlignment="Center"
                                                           Text="1920×1080"/>
                                            </Border>
                                        </Grid>

                                        <CheckBox x:Name="ExtractAllFramesCheckBox" Content="Tách tất cả frame" Style="{StaticResource ReadableCheckBoxStyle}" Margin="0,2,0,8" ToolTip="Lấy toàn bộ frame theo FPS gốc của video."/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Extract song song" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <ComboBox x:Name="ExtractParallelJobsCombo" Grid.Column="2" Height="26" Style="{StaticResource DarkComboBoxStyle}" ToolTip="Số tiến trình FFmpeg chạy đồng thời khi tách frame.">
                                                <ComboBoxItem Content="1 luồng" Tag="1" IsSelected="True"/>
                                                <ComboBoxItem Content="2 luồng" Tag="2"/>
                                                <ComboBoxItem Content="4 luồng" Tag="4"/>
                                                <ComboBoxItem Content="6 luồng" Tag="6"/>
                                                <ComboBoxItem Content="8 luồng" Tag="8"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Estimation Badges Card -->
                                        <Border Style="{StaticResource InnerCardStyle}" Margin="0,4,0,0" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="FRAME/GIÂY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="EstFramePerSecText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="TỔNG FRAME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="EstimatedFrameCountText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                        <TextBlock x:Name="ExcludedFrameBadge" FontSize="11" FontWeight="Bold" Foreground="OrangeRed" Margin="4,1,0,0" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="KHOẢNG CÁCH" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="EstFrameIntervalText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Frame Exclusion Card -->
                                        <Border x:Name="FrameStripPanel" Style="{StaticResource InnerCardStyle}" Margin="0,10,0,10" Padding="12,10">
                                            <StackPanel>
                                                <!-- Header with Toggle -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <controls:SvgViewboxEx Width="14" Height="14" Margin="0,0,6,0" Fill="#FF9F43" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='film-canister duotone-light'}"/>
                                                        <TextBlock Text="Lọc Frame (Frame Exclusion)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                        <TextBlock Text="—" Margin="8,0,4,0" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="ExcludedCountText" Text="0" FontSize="10" FontWeight="SemiBold" Foreground="#FF9F43" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" frame bị loại" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button x:Name="SelectAllVisibleFramesButton"
                                                                Height="22" Padding="8,0" FontSize="10"
                                                                Style="{StaticResource VideoChromeSecondaryButtonStyle}"
                                                                Content="Chọn tất cả" Margin="0,0,4,0"/>
                                                        <Button x:Name="ClearExcludedFramesButton"
                                                                Height="22" Padding="8,0" FontSize="10"
                                                                Style="{StaticResource VideoChromeSecondaryButtonStyle}"
                                                                Content="Bỏ chọn tất cả" Margin="0,0,4,0"/>
                                                        <Button x:Name="RefreshFrameStripButton"
                                                                Height="22" Padding="8,0" FontSize="10"
                                                                Style="{StaticResource VideoChromeSecondaryButtonStyle}"
                                                                Content="Tải lại" Margin="0,0,4,0"/>
                                                        <ToggleButton x:Name="FrameExclusionToggle" Style="{StaticResource ToggleSwitchStyle}" ToolTip="Bật/Tắt hiển thị frame để lọc"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Frame Exclusion Content (Shown when Toggle is ON) -->
                                                <Grid x:Name="FrameExclusionContentGrid" Visibility="Collapsed" Margin="0,10,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Time Navigation Slider -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="FrameStripTimeLabel" Grid.Column="0"
                                                                   Text="00:00" FontSize="10" FontFamily="Consolas"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="#FF9F43"
                                                                   Margin="0,0,6,0"/>
                                                        <Slider x:Name="FrameStripTimeSlider" Grid.Column="1"
                                                                Minimum="0" Maximum="1" Value="0"
                                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                                Style="{StaticResource ModernSliderStyle}"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Kéo để chọn vị trí giây — chỉ load frame quanh đoạn này"/>
                                                        <TextBlock x:Name="FrameStripTimeEndLabel" Grid.Column="2"
                                                                   Text="00:00" FontSize="10" FontFamily="Consolas"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                   Margin="6,0,0,0"/>
                                                    </Grid>
                                                    <!-- Frame Thumbnails (Grid layout with vertical scroll) -->
                                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                                                  VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                                        <StackPanel x:Name="FrameStripContentPanel" Orientation="Vertical">
                                                            <WrapPanel x:Name="FrameStripWrapPanel"
                                                                       Orientation="Horizontal"/>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                    <!-- Pinned Excluded Frames -->
                                                    <Border x:Name="PinnedExcludedSection" Grid.Row="2"
                                                            Visibility="Collapsed" Margin="0,6,0,0"
                                                            Padding="6" CornerRadius="4"
                                                            Background="{DynamicResource ThemeOverlayBackgroundBrush}"
                                                            BorderBrush="OrangeRed" BorderThickness="1">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,3">
                                                                <TextBlock FontSize="9" FontWeight="SemiBold"
                                                                           Foreground="OrangeRed"
                                                                           Text="📌 Frame đã chọn loại bỏ (ngoài phạm vi giây đang xem)" VerticalAlignment="Center"/>
                                                                <Button x:Name="ClearPinnedExcludedButton"
                                                                        Height="20" Padding="6,0" FontSize="9"
                                                                        HorizontalAlignment="Right"
                                                                        Style="{StaticResource VideoChromeSecondaryButtonStyle}"
                                                                        Content="Bỏ chọn tất cả"/>
                                                            </Grid>
                                                            <WrapPanel x:Name="PinnedExcludedWrapPanel"
                                                                       Orientation="Horizontal"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Grid Collage / Contact Sheet Card -->
                                        <Border Style="{StaticResource InnerCardStyle}" Margin="0,10,0,10" Padding="12,10">
                                            <StackPanel>
                                                <!-- Header with Toggle -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <controls:SvgViewboxEx Width="14" Height="14" Margin="0,0,6,0" Fill="{DynamicResource ThemeTextPrimaryBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='grid-2 duotone-light'}"/>
                                                        <TextBlock Text="Ghép Frame vào 1 ảnh (Grid Collage)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1" x:Name="GridCollageToggle" Style="{StaticResource ToggleSwitchStyle}" ToolTip="Bật/Tắt tính năng ghép các frame video thành 1 ảnh canvas"/>
                                                </Grid>

                                                <!-- 2-Column Container (Shown when Toggle is ON) -->
                                                <Grid x:Name="GridCollageContainerGrid" Visibility="Collapsed" Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.15*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="0.85*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- COLUMN 1: Settings -->
                                                    <StackPanel Grid.Column="0">
                                                        <!-- Canvas Dimensions (Slider + Direct Input) -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Width (px)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="54"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Slider x:Name="GridCollageWidthSlider"
                                                                            Minimum="200"
                                                                            Maximum="4000"
                                                                            Value="1000"
                                                                            TickFrequency="50"
                                                                            IsSnapToTickEnabled="False"
                                                                            Style="{StaticResource ModernSliderStyle}"
                                                                            VerticalAlignment="Center"/>
                                                                    <TextBox Grid.Column="1"
                                                                             x:Name="GridCollageWidthBox"
                                                                             Height="26"
                                                                             Margin="6,0,0,0"
                                                                             FontSize="11"
                                                                             FontFamily="Consolas"
                                                                             FontWeight="Bold"
                                                                             TextAlignment="Center"
                                                                             VerticalContentAlignment="Center"
                                                                             Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                                             BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                                             Foreground="{DynamicResource ThemeInputForegroundBrush}"
                                                                             Text="1000"
                                                                             ToolTip="Nhập chiều rộng ảnh canvas (px)"/>
                                                                </Grid>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Height (px)" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="54"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Slider x:Name="GridCollageHeightSlider"
                                                                            Minimum="200"
                                                                            Maximum="4000"
                                                                            Value="1000"
                                                                            TickFrequency="50"
                                                                            IsSnapToTickEnabled="False"
                                                                            Style="{StaticResource ModernSliderStyle}"
                                                                            VerticalAlignment="Center"/>
                                                                    <TextBox Grid.Column="1"
                                                                             x:Name="GridCollageHeightBox"
                                                                             Height="26"
                                                                             Margin="6,0,0,0"
                                                                             FontSize="11"
                                                                             FontFamily="Consolas"
                                                                             FontWeight="Bold"
                                                                             TextAlignment="Center"
                                                                             VerticalContentAlignment="Center"
                                                                             Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                                             BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                                             Foreground="{DynamicResource ThemeInputForegroundBrush}"
                                                                             Text="1000"
                                                                             ToolTip="Nhập chiều cao ảnh canvas (px)"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Background Color & Frame Aspect Ratio -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Màu nền Canvas" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="26"/>
                                                                        <ColumnDefinition Width="30"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ComboBox x:Name="GridCollageColorCombo" Height="28" Style="{StaticResource DarkComboBoxStyle}">
                                                                        <ComboBoxItem Content="Trắng (#FFF)" Tag="white" IsSelected="True"/>
                                                                        <ComboBoxItem Content="Đen (#000)" Tag="black"/>
                                                                        <ComboBoxItem Content="Slate (#1E1E2E)" Tag="#1E1E2E"/>
                                                                        <ComboBoxItem Content="Xám (#F3F4F6)" Tag="#F3F4F6"/>
                                                                        <ComboBoxItem Content="Theme Canvas" Tag="ThemeCanvasBackgroundBrush"/>
                                                                        <ComboBoxItem Content="Tùy chỉnh..." Tag="custom"/>
                                                                    </ComboBox>
                                                                    <Border Grid.Column="1"
                                                                            x:Name="GridCollageColorPreviewBox"
                                                                            Width="18" Height="18"
                                                                            Margin="4,0,4,0"
                                                                            CornerRadius="3"
                                                                            Background="White"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="1"/>
                                                                    <Button Grid.Column="2"
                                                                            x:Name="PickGridCollageBgColorButton"
                                                                            Width="28" Height="28"
                                                                            Padding="0"
                                                                            Style="{StaticResource VideoChromeSecondaryButtonStyle}"
                                                                            ToolTip="Chọn màu nền tự do">
                                                                        <controls:SvgViewboxEx Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone-light'}"/>
                                                                    </Button>
                                                                </Grid>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Tỉ lệ frame con" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                                <ComboBox x:Name="GridCollageAspectCombo" Height="28" Style="{StaticResource DarkComboBoxStyle}" ToolTip="Tỉ lệ khung hình của mỗi frame con">
                                                                    <ComboBoxItem Content="Tự động (Video)" Tag="auto" IsSelected="True"/>
                                                                    <ComboBoxItem Content="16:9 (Ngang)" Tag="16:9"/>
                                                                    <ComboBoxItem Content="9:16 (Dọc Reels)" Tag="9:16"/>
                                                                    <ComboBoxItem Content="1:1 (Vuông)" Tag="1:1"/>
                                                                    <ComboBoxItem Content="4:3 (Chuẩn)" Tag="4:3"/>
                                                                    <ComboBoxItem Content="3:4 (Dọc)" Tag="3:4"/>
                                                                    <ComboBoxItem Content="2:3 (Dọc)" Tag="2:3"/>
                                                                    <ComboBoxItem Content="3:2 (Ngang)" Tag="3:2"/>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Padding & Margin -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Padding frame con" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                                <TextBox x:Name="GridCollagePaddingBox"
                                                                         Height="28"
                                                                         Text="10"
                                                                         Style="{StaticResource BaseTextBox}"
                                                                         ToolTip="Cú pháp: 1 số (vd: 10), 2 số (vd: 10,20) hoặc 4 số (vd: 10,20,10,20)"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Margin frame con" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                                <TextBox x:Name="GridCollageMarginBox"
                                                                         Height="28"
                                                                         Text="0"
                                                                         Style="{StaticResource BaseTextBox}"
                                                                         ToolTip="Cú pháp: 1 số (vd: 0), 2 số (vd: 5,10) hoặc 4 số (vd: 5,10,5,10)"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Child Frame Count Slider & Input (Supports both odd & even numbers) -->
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="Số lượng frame con / 1 ảnh cha" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="54"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Slider x:Name="GridCollageFrameCountSlider"
                                                                        Minimum="1"
                                                                        Maximum="128"
                                                                        Value="4"
                                                                        TickFrequency="1"
                                                                        IsSnapToTickEnabled="True"
                                                                        Style="{StaticResource ModernSliderStyle}"
                                                                        VerticalAlignment="Center"
                                                                        ToolTip="Số frame con trong 1 ảnh cha (hỗ trợ cả số chẵn và số lẻ)"/>
                                                                <TextBox Grid.Column="1"
                                                                         x:Name="GridCollageFrameCountBox"
                                                                         Height="26"
                                                                         Margin="6,0,0,0"
                                                                         FontSize="11"
                                                                         FontFamily="Consolas"
                                                                         FontWeight="Bold"
                                                                         TextAlignment="Center"
                                                                         VerticalContentAlignment="Center"
                                                                         Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                                         BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                                         Foreground="{DynamicResource ThemeInputForegroundBrush}"
                                                                         Text="4"
                                                                         ToolTip="Nhập số frame con (chẵn hoặc lẻ)"/>
                                                            </Grid>
                                                        </StackPanel>

                                                        <!-- Toggle Show Frame Index / AI Label Badge -->
                                                        <Border Margin="0,0,0,0" Padding="8,6" Background="{DynamicResource ThemeBackgroundMutedBrush}" CornerRadius="4" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <controls:SvgViewboxEx Width="12" Height="12" Margin="0,0,5,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='tag duotone-light'}"/>
                                                                        <TextBlock Text="Đánh số frame con (#1, #2...)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="Hiện số thứ tự trên đầu ảnh con để AI đọc tuần tự" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="17,2,0,0"/>
                                                                </StackPanel>
                                                                <ToggleButton Grid.Column="1" x:Name="GridCollageShowFrameIndexToggle" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" ToolTip="Bật/Tắt vẽ số thứ tự frame trên đầu mỗi ảnh con trong ảnh ghép"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- COLUMN 2: Live Interactive Preview -->
                                                    <Border Grid.Column="2"
                                                            Background="{DynamicResource ThemeSurfaceBackgroundBrush}"
                                                            BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                <TextBlock Text="👁️ Xem trước Bố cục" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                                <TextBlock x:Name="GridCollagePreviewBadge" Text="1000×1000" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                            <Border Grid.Row="1"
                                                                    Background="{DynamicResource ThemeTrackBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="4"
                                                                    Height="150">
                                                                <Viewbox Stretch="Uniform">
                                                                    <Canvas x:Name="GridCollagePreviewCanvas"
                                                                            Width="1000"
                                                                            Height="1000"
                                                                            Background="White"
                                                                            ClipToBounds="True"/>
                                                                </Viewbox>
                                                            </Border>
                                                            <TextBlock Grid.Row="2"
                                                                       x:Name="GridCollageMetricsText"
                                                                       Margin="0,6,0,0"
                                                                       FontSize="10"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="Lưới: 2×2 • 4 frame/ảnh"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="FrameIndexPreviewText"
                                                   Margin="0,6,0,0"
                                                   FontSize="10"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Bar Footer -->
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="ExtractFramesBase64Button" Content="Tách Frame (Base64)" Height="30" Padding="14,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Tách frame và trả về kết quả mã hóa Base64 string"/>
                                <Button x:Name="ExtractFramesLinkButton" Content="Tách Frame (Đường dẫn)" Height="30" Padding="14,0" Margin="8,0,0,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Tách frame và xuất ảnh vào thư mục (trả về đường dẫn file)"/>
                                <Button x:Name="SnapshotButton" Content="Chụp Snapshot" Height="30" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 2: BỘ LỌC (GRADING) -->
                    <Grid x:Name="GradingTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Preset Chips Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Preset màu sắc (Color Grading)" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <WrapPanel Margin="0,0,0,0">
                                            <Button x:Name="PresetNeutralButton" Content="Trung tính" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetVividButton" Content="Rực rỡ" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetCinematicButton" Content="Điện ảnh" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetBwButton" Content="B&amp;W" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetWarmButton" Content="Tông ấm" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetCoolButton" Content="Tông lạnh" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetFadeButton" Content="Phai màu" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="ResetGradingButton" Content="Đặt lại" Style="{StaticResource PresetChipResetStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="ApplyPreviewEffectButton" Content="👁️ Xem trước" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="ResetPreviewEffectButton" Content="✕ Hủy xem trước" Style="{StaticResource PresetChipResetStyle}" Margin="0,0,6,6"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Cân bằng màu sắc -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Cân bằng ánh sáng &amp; Màu sắc" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        
                                        <!-- Brightness -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Độ sáng" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="BrightnessSlider" Minimum="-1" Maximum="1" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="BrightnessLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Contrast -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Tương phản" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="ContrastSlider" Minimum="0.1" Maximum="3" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="ContrastLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Saturation -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Độ bão hòa" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="SaturationSlider" Minimum="0" Maximum="3" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="SaturationLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Hue -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Dịch Hue" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="HueSlider" Minimum="-180" Maximum="180" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="HueLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Gamma -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Gamma" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="GammaSlider" Minimum="0.1" Maximum="3" Value="1" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="GammaLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Hiệu ứng hình ảnh -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Hiệu ứng xử lý hình ảnh" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        
                                        <!-- Sharpen -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Làm nét (Sharpen)" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="SharpenToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SharpenSlider" Minimum="0" Maximum="5" Value="1" IsEnabled="False" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="SharpenLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Denoise -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Khử nhiễu (Denoise hqdn3d)" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="DenoiseToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="10" Value="3" IsEnabled="False" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="DenoiseLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Blur -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Làm mờ (Gaussian Blur)" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="BlurToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="BlurSlider" Minimum="1" Maximum="15" Value="3" IsEnabled="False" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="BlurLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Rotate & Flip -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Xoay &amp; Lật khung hình (Transform)" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <WrapPanel Margin="0,0,0,0">
                                            <Button x:Name="Rotate0Button" Content="0°" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="Rotate90Button" Content="90° ↻" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="Rotate180Button" Content="180°" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="Rotate270Button" Content="270° ↺" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="FlipHButton" Content="Lật ngang ↔" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="FlipVButton" Content="Lật dọc ↕" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Stabilize & Playback speed -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Chống rung &amp; Tốc độ phát (Stabilize &amp; Speed)" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Chống rung video (Stabilize)" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="StabilizeToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        <TextBlock Text="Tốc độ phát (Playback Speed)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="4" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="SpeedLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center" Text="1.0x"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ResetGradingButton2" Content="Đặt lại mặc định" Height="30" Padding="14,0" Style="{StaticResource VideoChromeResetButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 3: CHÈN ẢNH VIDEO (FILTERS & OVERLAY) -->
                    <Grid x:Name="FiltersTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Collapsed Legacy Controls to preserve code-behind bindings -->
                                <Border Visibility="Collapsed">
                                    <StackPanel>
                                        <ToggleButton x:Name="WatermarkToggle"/>
                                        <TextBox x:Name="WatermarkPathText"/>
                                        <Button x:Name="BrowseWatermarkButton"/>
                                        <ComboBox x:Name="WatermarkPositionCombo">
                                            <ComboBoxItem Content="Top Left" Tag="TL"/><ComboBoxItem Content="Top Center" Tag="TC"/><ComboBoxItem Content="Top Right" Tag="TR"/>
                                            <ComboBoxItem Content="Middle Left" Tag="ML"/><ComboBoxItem Content="Middle Center" Tag="MC"/><ComboBoxItem Content="Middle Right" Tag="MR"/>
                                            <ComboBoxItem Content="Bottom Left" Tag="BL"/><ComboBoxItem Content="Bottom Center" Tag="BC"/><ComboBoxItem Content="Bottom Right" Tag="BR" IsSelected="True"/>
                                        </ComboBox>
                                        <TextBlock x:Name="WatermarkPositionHintText"/>
                                        <Slider x:Name="WatermarkOpacitySlider"/>
                                        <TextBlock x:Name="WatermarkOpacityLabel"/>
                                        <Slider x:Name="WatermarkWidthPercentSlider"/>
                                        <TextBlock x:Name="WatermarkWidthPercentLabel"/>
                                        <Slider x:Name="WatermarkInsetPercentSlider"/>
                                        <TextBlock x:Name="WatermarkInsetPercentLabel"/>
                                        <Button x:Name="ApplyWatermarkToVideoButton"/>
                                        <ToggleButton x:Name="TextOverlayToggle"/>
                                        <TextBox x:Name="OverlayTextBox"/>
                                        <ComboBox x:Name="TextFontCombo"><ComboBoxItem Content="Arial"/></ComboBox>
                                        <Slider x:Name="TextSizeSlider"/>
                                        <TextBlock x:Name="TextSizeLabel"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 1: Nhãn Frame / Thời gian -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Nhãn Frame / Thời gian (Frame Label)" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="FrameLabelToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        
                                        <TextBlock Text="Mẫu hiển thị (Template)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FrameLabelTemplateTextBox" Height="28" FontSize="11" Padding="8,4" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="{}Frame {index} - {time}" ToolTip="{}Thẻ thay thế: {index}, {frame}, {time}"/>
                                        <TextBlock Margin="0,4,0,8" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="{}Cú pháp: {index}=thứ tự frame xuất, {frame}=số frame FPS nguồn, {time}=thời gian (MM:SS)"/>

                                        <!-- Position X & Y Sliders -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Vị trí X" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Slider x:Name="FrameLabelXSlider" Minimum="0" Maximum="1" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Vị trí Y" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Slider x:Name="FrameLabelYSlider" Minimum="0" Maximum="1" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="FrameLabelPosLabel" Margin="0,0,0,8" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="X 0.000 | Y 0.000"/>

                                        <!-- Font Size & Time Format -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Cỡ chữ (Font Size)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="FrameLabelFontSizeLabel" HorizontalAlignment="Right" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Text="18px"/>
                                                </Grid>
                                                <Slider x:Name="FrameLabelFontSizeSlider" Minimum="8" Maximum="60" Value="18" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Định dạng thời gian" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="FrameLabelTimeFormatCombo" Height="26" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="MM:SS" Tag="MMSS"/>
                                                    <ComboBoxItem Content="HH:MM:SS" Tag="HHMMSS" IsSelected="True"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Padding 4 direction sliders -->
                                        <TextBlock Text="Khoảng lề Padding (Trái / Trên / Phải / Dưới)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Slider x:Name="FrameLabelPaddingLeftSlider" Minimum="0" Maximum="50" Value="10" Style="{StaticResource ModernSliderStyle}" ToolTip="Trái"/>
                                                <TextBlock x:Name="FrameLabelPaddingLeftLabel" FontSize="9.5" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="10px"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Slider x:Name="FrameLabelPaddingTopSlider" Minimum="0" Maximum="50" Value="6" Style="{StaticResource ModernSliderStyle}" ToolTip="Trên"/>
                                                <TextBlock x:Name="FrameLabelPaddingTopLabel" FontSize="9.5" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="6px"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <Slider x:Name="FrameLabelPaddingRightSlider" Minimum="0" Maximum="50" Value="10" Style="{StaticResource ModernSliderStyle}" ToolTip="Phải"/>
                                                <TextBlock x:Name="FrameLabelPaddingRightLabel" FontSize="9.5" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="10px"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <Slider x:Name="FrameLabelPaddingBottomSlider" Minimum="0" Maximum="50" Value="6" Style="{StaticResource ModernSliderStyle}" ToolTip="Dưới"/>
                                                <TextBlock x:Name="FrameLabelPaddingBottomLabel" FontSize="9.5" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="6px"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Text & Background Color Input -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="FrameLabelTextColorTextBox" Height="26" FontSize="11" Padding="6,2" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="black" ToolTip="Màu chữ (VD: black, white, #FFFFFF)"/>
                                            <Button Grid.Column="1" Width="26" Height="26" Padding="0" Margin="4,0,0,0" ToolTip="Chọn màu chữ" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="PickFrameLabelTextColor_Click">
                                                <controls:SvgViewboxEx Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone-light'}"/>
                                            </Button>
                                            <TextBox x:Name="FrameLabelBackgroundColorTextBox" Grid.Column="3" Height="26" FontSize="11" Padding="6,2" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="white" ToolTip="Màu nền (VD: white, #00000088)"/>
                                            <Button Grid.Column="4" Width="26" Height="26" Padding="0" Margin="4,0,0,0" ToolTip="Chọn màu nền" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="PickFrameLabelBackgroundColor_Click">
                                                <controls:SvgViewboxEx Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone-light'}"/>
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="FrameLabelTextColorPreview" Height="10" CornerRadius="2" BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"/>
                                            <Border x:Name="FrameLabelBackgroundColorPreview" Grid.Column="2" Height="10" CornerRadius="2" BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"/>
                                        </Grid>
                                        <CheckBox x:Name="FrameLabelDebugSamplesCheckBox"
                                                  Margin="0,4,0,0"
                                                  FontSize="10"
                                                  Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                  Content="Ghi ảnh thẻ nhãn (debug) - lưu trong thư mục xuất frame"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Canvas Overlay Layer List -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Danh sách Layer Canvas Overlay" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="AddTextOverlayItemButton" Content="+ Chữ Text" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="AddImageOverlayItemButton" Content="+ Ảnh/Logo" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="RemoveSelectedOverlayItemButton" Content="Xóa chọn" Style="{StaticResource PresetChipResetStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="MoveOverlayUpButton" Content="Lên ⬆" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="MoveOverlayDownButton" Content="Xuống ⬇" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="ApplyOverlayToVideoButton" Content="Áp dụng Video" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                        </WrapPanel>
                                        <ListBox x:Name="OverlayLayerList"
                                                 Height="110"
                                                 Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                 BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource ThemeInputForegroundBrush}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                                        <Border Background="#336366F1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold" Foreground="#818CF8"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Source}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Layer Properties -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Thuộc tính Layer đang chọn" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Loại Layer" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <ComboBox x:Name="OverlayTypeCombo" Grid.Column="1" Height="26" Style="{StaticResource DarkComboBoxStyle}">
                                                <ComboBoxItem Content="text" Tag="text"/>
                                                <ComboBoxItem Content="image" Tag="image"/>
                                                <ComboBoxItem Content="logo" Tag="logo"/>
                                            </ComboBox>
                                        </Grid>

                                        <StackPanel x:Name="OverlayImageSourcePanel" Margin="0,0,0,6">
                                            <TextBlock Text="Đường dẫn ảnh" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="OverlaySourcePathTextBox" Height="26" FontSize="11" Padding="6,3" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" ToolTip="Đường dẫn file ảnh (image/logo)"/>
                                        </StackPanel>

                                        <StackPanel x:Name="OverlayTextPropsPanel" Margin="0,0,0,6">
                                            <TextBlock Text="Nội dung chữ Text" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="OverlaySourceTextArea"
                                                     Height="64"
                                                     FontSize="11"
                                                     Padding="6,4"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                     BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                     Foreground="{DynamicResource ThemeInputForegroundBrush}"
                                                     ToolTip="Nội dung text overlay"/>

                                            <Grid x:Name="OverlayTextAlignRow" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Căn lề" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <RadioButton x:Name="OverlayAlignLeftRadio" Content="Trái" GroupName="OverlayTextAlign" Margin="0,0,12,0" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                    <RadioButton x:Name="OverlayAlignCenterRadio" Content="Giữa" GroupName="OverlayTextAlign" Margin="0,0,12,0" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                    <RadioButton x:Name="OverlayAlignRightRadio" Content="Phải" GroupName="OverlayTextAlign" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Font chữ" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="OverlayFontFamilyCombo" Height="26" IsEditable="False" IsTextSearchEnabled="True" Style="{StaticResource DarkComboBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Màu chữ" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="OverlayFontColorTextBox" Height="26" FontSize="11" Padding="4,2" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}"/>
                                                        <Button x:Name="PickOverlayFontColorButton" Grid.Column="1" Width="26" Height="26" Padding="0" Margin="4,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="PickOverlayFontColor_Click">
                                                            <controls:SvgViewboxEx Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone-light'}"/>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,6,0,0">
                                                <TextBlock Text="Cỡ chữ (Font Size)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Slider x:Name="OverlayFontSizeSlider" Minimum="8" Maximum="200" Style="{StaticResource ModernSliderStyle}" Margin="0,16,0,0"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Position X & Y -->
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Vị trí X (0.0 - 1.0)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayXSlider" Minimum="0" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Vị trí Y (0.0 - 1.0)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayYSlider" Minimum="0" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Size W & H -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Chiều rộng W" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayWidthSlider" Minimum="0.01" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Chiều cao H" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayHeightSlider" Minimum="0.01" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Opacity & Rotation -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Độ trong suốt Opacity" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayOpacitySlider" Minimum="0" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Góc xoay Rotation (°)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayRotationSlider" Minimum="-180" Maximum="180" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <CheckBox x:Name="OverlayVisibleCheckBox" Content="Hiển thị (Visible)" Margin="0,0,16,0" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                            <CheckBox x:Name="OverlayLockedCheckBox" Content="Khóa vị trí (Locked)" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ResetFiltersTabButton" Content="Đặt lại cài đặt" Height="30" Padding="14,0" Style="{StaticResource VideoChromeResetButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 4: AUDIO -->
                    <Grid x:Name="AudioTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- ========================================================================= -->
                                <!-- MODULE 1: NGUỒN ÂM THANH GỐC & CẮT PHÂN ĐOẠN (Source & Trimming) -->
                                <!-- ========================================================================= -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:SvgViewboxEx Width="13" Height="13" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='speaker-high duotone-light'}"/>
                                                <TextBlock Text="Nguồn Âm Thanh Gốc &amp; Cắt Phân Đoạn (Source &amp; Trim)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="SourceAudioToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" ToolTip="Bật/tắt âm thanh gốc từ video"/>
                                        </Grid>

                                        <!-- Volume & Speed Controls (2-Column Grid) -->
                                        <Grid x:Name="SourceAudioVolumeGrid" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Source Volume Slider -->
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Âm lượng gốc" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="SourceAudioVolumeLabel" HorizontalAlignment="Right" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Text="100%"/>
                                                </Grid>
                                                <Slider x:Name="SourceAudioVolumeSlider" Minimum="0" Maximum="300" Value="100" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center" ToolTip="Âm lượng video gốc (0% = tắt âm, 100% = gốc, >100% = tăng âm thanh)"/>
                                            </StackPanel>

                                            <!-- Playback Speed Slider -->
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Tốc độ Audio" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="AudioSpeedLabel" HorizontalAlignment="Right" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Text="1.0x"/>
                                                </Grid>
                                                <Slider x:Name="AudioSpeedSlider" Minimum="0.5" Maximum="2.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center" ToolTip="Tăng/giảm tốc độ âm thanh (giữ nguyên tone giọng)"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Independent Audio Trim Section -->
                                        <Border Padding="10,8" Background="{DynamicResource ThemeInnerCardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="✂ Cắt riêng phân đoạn Audio (Audio Trimming)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <Border Margin="8,0,0,0" Background="{DynamicResource ThemeValueBadgeBackgroundBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <TextBlock x:Name="AudioTrimDurationLabel" Text="00:00.00 (0.0s)" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <ToggleButton x:Name="AudioTrimToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" ToolTip="Bật/tắt cắt riêng phân đoạn audio"/>
                                                </Grid>

                                                <StackPanel x:Name="AudioTrimContainer" Visibility="Collapsed" Margin="0,6,0,0">
                                                    <!-- 🌊 Bản đồ Sóng âm trực quan & Thanh điều khiển Zoom -->
                                                    <Border Background="{DynamicResource ThemeInnerCardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <!-- Waveform Zoom & Navigation Toolbar -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="🌊 Sóng âm phân đoạn (Kéo 2 cột hoặc Nhấn giữ &amp; Rê chuột để chọn):" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                </StackPanel>

                                                                <!-- Zoom Controls -->
                                                                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBlock x:Name="AudioWaveformZoomLabel" Text="🔍 1.0x (Toàn cảnh)" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource ThemeSliderActiveBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <Button x:Name="AudioWaveformZoomOutButton" Width="22" Height="22" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Content="➖" FontSize="9" ToolTip="Thu nhỏ sóng âm" Margin="0,0,2,0"/>
                                                                    <Slider x:Name="AudioWaveformZoomSlider" Width="70" Minimum="1" Maximum="50" Value="1" SmallChange="0.5" LargeChange="2" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center" ToolTip="Phóng to sóng âm để dãn rộng mốc giây/mili-giây"/>
                                                                    <Button x:Name="AudioWaveformZoomInButton" Width="22" Height="22" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Content="➕" FontSize="9" ToolTip="Phóng to sóng âm (chi tiết đến mili-giây)" Margin="2,0,4,0"/>
                                                                    <Button x:Name="AudioWaveformFitButton" Height="22" Padding="6,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Content="↔ Fit" FontSize="9" ToolTip="Xem toàn cảnh chiều dài bài"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Interactive Waveform Visualizer Canvas inside Horizontal ScrollViewer -->
                                                            <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ThemeTimelinePanelBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1">
                                                                <ScrollViewer x:Name="AudioWaveformScrollViewer" 
                                                                              HorizontalScrollBarVisibility="Auto" 
                                                                              VerticalScrollBarVisibility="Disabled" 
                                                                              Focusable="False"
                                                                              PanningMode="HorizontalOnly"
                                                                              CanContentScroll="False"
                                                                              Height="135">
                                                                    <controls:AudioTrimWaveformVisualizer x:Name="AudioTrimWaveformControl" Height="135" HorizontalAlignment="Left"/>
                                                                </ScrollViewer>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Start Time Control -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Margin="0,0,0,2">
                                                            <TextBlock Text="Mốc Bắt đầu (Start Time - Cột Trái 🟢)" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                            <TextBlock x:Name="AudioTrimStartSecLabel" Text="0.00s" HorizontalAlignment="Right" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                        </Grid>
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider x:Name="AudioTrimStartSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="0" SmallChange="0.1" LargeChange="1.0" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AudioTrimStartBox" Grid.Column="2" Height="24" FontSize="10" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="4,0" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="00:00.00"/>
                                                            <Button x:Name="SetAudioTrimStartFromPlayheadButton" Grid.Column="4" Height="24" Padding="5,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Content="📌 Playhead" FontSize="9.5"/>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- End Time Control -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Margin="0,0,0,2">
                                                            <TextBlock Text="Mốc Kết thúc (End Time - Cột Phải 🔴)" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                            <TextBlock x:Name="AudioTrimEndSecLabel" Text="0.00s" HorizontalAlignment="Right" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                        </Grid>
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="6"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Slider x:Name="AudioTrimEndSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="0" SmallChange="0.1" LargeChange="1.0" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AudioTrimEndBox" Grid.Column="2" Height="24" FontSize="10" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="4,0" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="00:00.00"/>
                                                            <Button x:Name="SetAudioTrimEndFromPlayheadButton" Grid.Column="4" Height="24" Padding="5,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Content="📌 Playhead" FontSize="9.5"/>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Actions: Nghe thử, Xuất Audio, Đặt lại -->
                                                    <Grid Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="6"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <Button x:Name="PreviewAudioTrimButton" Grid.Column="0" Height="28" Padding="10,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <controls:SvgViewboxEx Width="11" Height="11" Margin="0,0,5,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='play duotone-light'}"/>
                                                                <TextBlock Text="▶ Nghe thử khoảng cắt này" FontSize="10" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Button>
                                                        
                                                        <Button x:Name="ExportAudioTrimButton" Grid.Column="2" Height="28" Padding="10,0" Style="{DynamicResource PrimaryButton}">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <TextBlock Text="💾 Xuất Audio đã cắt" FontSize="10" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <Button x:Name="ResetAudioTrimButton" Grid.Column="4" Height="28" Padding="8,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Content="Đặt lại đoạn" FontSize="10"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ========================================================================= -->
                                <!-- MODULE 2: BIẾN ĐỔI GIỌNG NÓI & BẢN ĐỒ SÓNG ÂM (Voice Changer & Waveform) -->
                                <!-- ========================================================================= -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:SvgViewboxEx Width="13" Height="13" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='microphone duotone-light'}"/>
                                                <TextBlock Text="Biến Đổi Giọng Nói &amp; Định Hình Sóng (Voice &amp; Wave Shaper)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Voice Gender Presets WrapPanel -->
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="PresetVoiceMaleDeepButton" Content="👨 Nam trầm (-6st)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4" ToolTip="Hạ tông giọng nam trầm ấm áp"/>
                                            <Button x:Name="PresetVoiceMaleButton" Content="👨‍💼 Nam chuẩn (-3st)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4" ToolTip="Giọng nam trưởng thành, rõ ràng"/>
                                            <Button x:Name="PresetVoiceNaturalButton" Content="🧑 Tự nhiên (0st)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4" ToolTip="Giữ nguyên giọng nói tự nhiên"/>
                                            <Button x:Name="PresetVoiceFemaleButton" Content="👩 Nữ chuẩn (+4st)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4" ToolTip="Nâng tông giọng nữ tự nhiên, trong trẻo"/>
                                            <Button x:Name="PresetVoiceAnimeButton" Content="👧 Nữ cao (+8st)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4" ToolTip="Tông giọng nữ anime dễ thương"/>
                                            <Button x:Name="PresetVoiceChipmunkButton" Content="🐿️ Sóc chuột (+12st)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4" ToolTip="Hiệu ứng giọng sóc chuột hoạt hình"/>
                                            <Button x:Name="PresetVoiceMonsterButton" Content="👹 Quái vật (-12st)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4" ToolTip="Hiệu ứng giọng quái vật khổng lồ cực trầm"/>
                                        </WrapPanel>

                                        <!-- Voice Pitch & Tone Sliders (2-Column Grid) -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Pitch Shifter -->
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Độ lệch cao độ (Pitch)" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="AudioPitchLabel" HorizontalAlignment="Right" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0 st"/>
                                                </Grid>
                                                <Slider x:Name="AudioPitchSlider" Minimum="-12" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center" ToolTip="Kéo trái để đổi sang giọng Nam | Kéo phải sang giọng Nữ"/>
                                                <TextBlock x:Name="AudioPitchStatusLabel" Text="🧑 Tự nhiên (0 st)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Tone Clarity -->
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Âm sắc Trầm / Trong (Tone)" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="AudioToneClarityLabel" HorizontalAlignment="Right" FontSize="9.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0%"/>
                                                </Grid>
                                                <Slider x:Name="AudioToneClaritySlider" Minimum="-100" Maximum="100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center" ToolTip="Kéo trái: Trầm ấm | Kéo phải: Trong vắt, sáng rõ"/>
                                                <TextBlock x:Name="AudioToneClarityStatusLabel" Text="⚖️ Tự Nhiên (0%)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Tone Clarity Quick Presets -->
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button x:Name="PresetToneDeepButton" Content="📻 Rất Trầm (-80%)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="PresetToneWarmButton" Content="☕ Trầm Ấm (-40%)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="PresetToneNaturalButton" Content="⚖️ Tự Nhiên (0%)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="PresetToneBrightButton" Content="✨ Trong Trẻo (+50%)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="PresetToneCrispButton" Content="🎙️ Trong Vắt (+80%)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                        </WrapPanel>

                                        <!-- Waveform Visualizer & Shaper Sub-Studio (Collapsible) -->
                                        <Border Padding="10,8" Background="{DynamicResource ThemeInnerCardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🌊 Bản đồ Sóng âm &amp; Bộ Can thiệp Sóng (Live Shaper)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <ToggleButton x:Name="AudioWaveShaperToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" ToolTip="Bật/tắt bản đồ sóng âm thời gian thực và bộ định hình sóng"/>
                                                </Grid>

                                                <StackPanel x:Name="AudioWaveShaperContainer" Visibility="Collapsed" Margin="0,4,0,0">
                                                    <!-- Live Oscilloscope Screen -->
                                                    <Border Margin="0,2,0,6" Background="#0C1017" CornerRadius="6" BorderBrush="#2D3748" BorderThickness="1" Padding="8,6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="90"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Stats Badge -->
                                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Background="#1E293B" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                                        <TextBlock Text="LIVE OSCILLOSCOPE" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                                    </Border>
                                                                    <TextBlock x:Name="AudioWaveformSampleRateLabel" Text="48kHz • Stereo" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <TextBlock Text="RMS: " FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                    <TextBlock x:Name="AudioWaveformRmsLabel" Text="-inf dB" FontSize="8.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#4ADE80" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="PEAK: " FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                    <TextBlock x:Name="AudioWaveformPeakLabel" Text="-inf dB" FontSize="8.5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Canvas + VU Meter -->
                                                            <Grid Grid.Row="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="12"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Background="#06090E" CornerRadius="4" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Rectangle Height="1" Fill="#1E293B" VerticalAlignment="Center"/>
                                                                        <Rectangle Height="1" Fill="#0F172A" VerticalAlignment="Top" Margin="0,22,0,0"/>
                                                                        <Rectangle Height="1" Fill="#0F172A" VerticalAlignment="Bottom" Margin="0,0,0,22"/>
                                                                        <Canvas x:Name="AudioWaveformCanvas" ClipToBounds="True"/>
                                                                    </Grid>
                                                                </Border>

                                                                <Grid Grid.Column="2">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Background="#111827" CornerRadius="1" ClipToBounds="True">
                                                                        <Rectangle x:Name="AudioVuMeterBarL" Height="0" VerticalAlignment="Bottom">
                                                                            <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                                    <GradientStop Color="#22C55E" Offset="0.0"/>
                                                                                    <GradientStop Color="#EAB308" Offset="0.75"/>
                                                                                    <GradientStop Color="#EF4444" Offset="1.0"/>
                                                                                </LinearGradientBrush>
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                    </Border>
                                                                    <Border Grid.Column="2" Background="#111827" CornerRadius="1" ClipToBounds="True">
                                                                        <Rectangle x:Name="AudioVuMeterBarR" Height="0" VerticalAlignment="Bottom">
                                                                            <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                                                    <GradientStop Color="#22C55E" Offset="0.0"/>
                                                                                    <GradientStop Color="#EAB308" Offset="0.75"/>
                                                                                    <GradientStop Color="#EF4444" Offset="1.0"/>
                                                                                </LinearGradientBrush>
                                                                            </Rectangle.Fill>
                                                                        </Rectangle>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>

                                                            <!-- Frequency Axis Labels -->
                                                            <Grid Grid.Row="2" Margin="0,2,16,0">
                                                                <TextBlock Text="20Hz" FontSize="8" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Left"/>
                                                                <TextBlock Text="250Hz" FontSize="8.5" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Left" Margin="55,0,0,0"/>
                                                                <TextBlock Text="1kHz" FontSize="8" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="5kHz" FontSize="8" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,55,0"/>
                                                                <TextBlock Text="20kHz" FontSize="8" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Waveform Profiles -->
                                                    <WrapPanel Margin="0,0,0,6">
                                                        <Button x:Name="PresetWaveCleanButton" Content="🟢 Sin Gốc" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                                        <Button x:Name="PresetWaveTapeButton" Content="📻 Băng Từ (Tape)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                                        <Button x:Name="PresetWaveSoftButton" Content="⚡ Sóng Mềm (Soft)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                                        <Button x:Name="PresetWaveHardButton" Content="🔥 Cắt Sóng (Hard)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                                        <Button x:Name="PresetWaveFoldButton" Content="🌊 Đa Hài (Wave Fold)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                                    </WrapPanel>

                                                    <!-- Drive & Transient Punch (2-Column Grid) -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <Grid Margin="0,0,0,2">
                                                                <TextBlock Text="Cường độ uốn sóng" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                <TextBlock x:Name="AudioWaveShaperDriveLabel" HorizontalAlignment="Right" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0%"/>
                                                            </Grid>
                                                            <Slider x:Name="AudioWaveShaperDriveSlider" Minimum="0" Maximum="200" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                                            <TextBlock x:Name="AudioWaveShaperCurveStatusLabel" Text="Sin Gốc (Clean)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <Grid Margin="0,0,0,2">
                                                                <TextBlock Text="Độ nảy xung kích (Punch)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                <TextBlock x:Name="AudioTransientPunchLabel" HorizontalAlignment="Right" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0%"/>
                                                            </Grid>
                                                            <Slider x:Name="AudioTransientPunchSlider" Minimum="-100" Maximum="100" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                                            <TextBlock x:Name="AudioTransientPunchStatusLabel" Text="Cân bằng (0%)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Sub-Harmonics & Exciter & Phase Inversion -->
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <Grid Margin="0,0,0,2">
                                                                <TextBlock Text="Sóng hài trầm (Sub)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                <TextBlock x:Name="AudioSubHarmonicsLabel" HorizontalAlignment="Right" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0%"/>
                                                            </Grid>
                                                            <Slider x:Name="AudioSubHarmonicsSlider" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <Grid Margin="0,0,0,2">
                                                                <TextBlock Text="Kích sóng cao (Exciter)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                <TextBlock x:Name="AudioHarmonicExciterLabel" HorizontalAlignment="Right" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0%"/>
                                                            </Grid>
                                                            <Slider x:Name="AudioHarmonicExciterSlider" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                            <TextBlock Text="Đảo pha (Phase):" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ToggleButton x:Name="AudioPhaseInvertLToggle" Content="Ø L" Style="{StaticResource PresetChipToggleStyle}" Margin="0,0,4,0" ToolTip="Đảo pha 180° kênh Trái"/>
                                                                <ToggleButton x:Name="AudioPhaseInvertRToggle" Content="Ø R" Style="{StaticResource PresetChipToggleStyle}" ToolTip="Đảo pha 180° kênh Phải"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ========================================================================= -->
                                <!-- MODULE 3: CÂN BẰNG TẦN SỐ & PHÒNG THU HIỆU ỨNG (EQ 5-Band & Studio FX) -->
                                <!-- ========================================================================= -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:SvgViewboxEx Width="13" Height="13" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='sliders duotone-light'}"/>
                                                <TextBlock Text="Cân Bằng Âm Sắc (EQ 5-Band) &amp; Hiệu Ứng Không Gian (FX)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- EQ Presets WrapPanel -->
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="PresetAudioNeutralButton" Content="⚡ Mặc định" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="PresetAudioVocalButton" Content="🎙️ Rõ tiếng nói" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="PresetAudioBassButton" Content="🔊 Tăng Bass" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="PresetAudioTrebleButton" Content="✨ Tăng Treble" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="PresetAudioPodcastButton" Content="🎧 Podcast" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                        </WrapPanel>

                                        <!-- 5-Band Parametric Equalizer -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Bass 100Hz -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Bass (100Hz)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="AudioBassGainSlider" Minimum="-15" Maximum="15" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="2,0,0,0">
                                                        <TextBlock x:Name="AudioBassGainLabel" FontSize="8" FontFamily="Consolas" HorizontalAlignment="Center" Text="0dB"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Low-Mid 350Hz -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="L-Mid (350Hz)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="AudioLowMidGainSlider" Minimum="-15" Maximum="15" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="2,0,0,0">
                                                        <TextBlock x:Name="AudioLowMidGainLabel" FontSize="8" FontFamily="Consolas" HorizontalAlignment="Center" Text="0dB"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Mid 1.2kHz -->
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Mid (1.2kHz)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="AudioMidGainSlider" Minimum="-15" Maximum="15" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="2,0,0,0">
                                                        <TextBlock x:Name="AudioMidGainLabel" FontSize="8" FontFamily="Consolas" HorizontalAlignment="Center" Text="0dB"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>

                                            <!-- High-Mid 3.5kHz -->
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="H-Mid (3.5k)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="AudioHighMidGainSlider" Minimum="-15" Maximum="15" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="2,0,0,0">
                                                        <TextBlock x:Name="AudioHighMidGainLabel" FontSize="8" FontFamily="Consolas" HorizontalAlignment="Center" Text="0dB"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Treble 8kHz -->
                                            <StackPanel Grid.Column="8">
                                                <TextBlock Text="Treble (8kHz)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="AudioTrebleGainSlider" Minimum="-15" Maximum="15" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="2,0,0,0">
                                                        <TextBlock x:Name="AudioTrebleGainLabel" FontSize="8" FontFamily="Consolas" HorizontalAlignment="Center" Text="0dB"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Dynamic Frequency Cutoffs -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <CheckBox x:Name="AudioHighpassCheckBox" Content="Lọc ù gió (High-Pass)" FontSize="9.5" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                                </StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="AudioHighpassCutoffSlider" Minimum="20" Maximum="400" Value="80" TickFrequency="10" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                                    <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="4,0,0,0">
                                                        <TextBlock x:Name="AudioHighpassCutoffLabel" FontSize="8.5" FontFamily="Consolas" HorizontalAlignment="Center" Text="80Hz"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <CheckBox x:Name="AudioLowpassCheckBox" Content="Lọc chói (Low-Pass)" FontSize="9.5" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                                </StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="AudioLowpassCutoffSlider" Minimum="2000" Maximum="20000" Value="12000" TickFrequency="500" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                                    <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="4,0,0,0">
                                                        <TextBlock x:Name="AudioLowpassCutoffLabel" FontSize="8.5" FontFamily="Consolas" HorizontalAlignment="Center" Text="12.0kHz"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Spatial & Studio Reverb Sub-Panel -->
                                        <Border Padding="10,8" Background="{DynamicResource ThemeInnerCardBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                                            <StackPanel>
                                                <!-- Reverb Slider & Presets -->
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="🏛️ Vang phòng thu (Studio Reverb)" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                    <TextBlock x:Name="AudioReverbLabel" HorizontalAlignment="Right" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0%"/>
                                                </Grid>
                                                <Slider x:Name="AudioReverbSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" Margin="0,0,0,4"/>
                                                <WrapPanel Margin="0,0,0,6">
                                                    <Button x:Name="PresetReverbRoomButton" Content="Phòng nhỏ (15%)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                                    <Button x:Name="PresetReverbStageButton" Content="Sân khấu (35%)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                                    <Button x:Name="PresetReverbHallButton" Content="Nhà hát (60%)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                                    <Button x:Name="PresetReverbCaveButton" Content="Hang động (85%)" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                                </WrapPanel>

                                                <!-- Vocal Balance, Stereo Width, Analog Warmth (3-Column Grid) -->
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <Grid Margin="0,0,0,1">
                                                            <TextBlock Text="Tách giọng/Karaoke" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                            <TextBlock x:Name="AudioVocalBalanceLabel" HorizontalAlignment="Right" FontSize="8" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Text="0%"/>
                                                        </Grid>
                                                        <Slider x:Name="AudioVocalBalanceSlider" Minimum="-100" Maximum="100" Value="0" TickFrequency="10" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ToolTip="Trái: Karaoke | Phải: Tách giọng"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <Grid Margin="0,0,0,1">
                                                            <TextBlock Text="Độ rộng Stereo" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                            <TextBlock x:Name="AudioStereoWidthLabel" HorizontalAlignment="Right" FontSize="8" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Text="100%"/>
                                                        </Grid>
                                                        <Slider x:Name="AudioStereoWidthSlider" Minimum="0" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4">
                                                        <Grid Margin="0,0,0,1">
                                                            <TextBlock Text="Độ ấm Analog" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                            <TextBlock x:Name="AudioWarmthLabel" HorizontalAlignment="Right" FontSize="8" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Text="0%"/>
                                                        </Grid>
                                                        <Slider x:Name="AudioWarmthSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Special Creative Voice FX (Robot, Radio, Chorus) -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Padding="8,5" Background="{DynamicResource ThemeBackgroundMutedBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                                <CheckBox x:Name="AudioRobotVoiceCheckBox" Content="🤖 Robot" FontSize="9.5" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                            </Border>
                                            <Border Grid.Column="2" Padding="8,5" Background="{DynamicResource ThemeBackgroundMutedBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                                <CheckBox x:Name="AudioRadioVoiceCheckBox" Content="📻 Radio Lo-Fi" FontSize="9.5" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                            </Border>
                                            <Border Grid.Column="4" Padding="8,5" Background="{DynamicResource ThemeBackgroundMutedBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                                <CheckBox x:Name="AudioChorusCheckBox" Content="🎶 Đồng Ca (Chorus)" FontSize="9.5" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Echo & 8D Spatial FX -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Echo / Delay -->
                                            <Border Grid.Column="0" Padding="8,6" Background="{DynamicResource ThemeBackgroundMutedBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="📢 Tiếng Vọng (Echo)" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleButton x:Name="AudioEchoToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                                    </Grid>
                                                    <Grid x:Name="AudioEchoControlsGrid">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Delay" FontSize="8" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                            <Slider x:Name="AudioEchoDelaySlider" Minimum="50" Maximum="1000" Value="250" Style="{StaticResource ModernSliderStyle}"/>
                                                            <TextBlock x:Name="AudioEchoDelayLabel" FontSize="7.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="250ms"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Decay" FontSize="8" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                            <Slider x:Name="AudioEchoFeedbackSlider" Minimum="0" Maximum="90" Value="40" Style="{StaticResource ModernSliderStyle}"/>
                                                            <TextBlock x:Name="AudioEchoFeedbackLabel" FontSize="7.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="40%"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4">
                                                            <TextBlock Text="Mix" FontSize="8" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                            <Slider x:Name="AudioEchoMixSlider" Minimum="0" Maximum="100" Value="30" Style="{StaticResource ModernSliderStyle}"/>
                                                            <TextBlock x:Name="AudioEchoMixLabel" FontSize="7.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="30%"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- 8D Spatial Audio -->
                                            <Border Grid.Column="2" Padding="8,6" Background="{DynamicResource ThemeBackgroundMutedBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="🎧 Âm Thanh 8D Spatial" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleButton x:Name="Audio8DToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                                    </Grid>
                                                    <Grid x:Name="Audio8DControlsGrid">
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <Grid Margin="0,0,0,2">
                                                            <TextBlock Text="Tốc độ xoay vòng" FontSize="8" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                            <TextBlock x:Name="Audio8DSpeedLabel" HorizontalAlignment="Right" FontSize="8" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0.125 Hz"/>
                                                        </Grid>
                                                        <Slider Grid.Row="1" x:Name="Audio8DSpeedSlider" Minimum="0.05" Maximum="0.5" Value="0.125" TickFrequency="0.025" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ========================================================================= -->
                                <!-- MODULE 4: XỬ LÝ ĐỘNG HỌC, KHỬ NHIỄU & MASTERING (Dynamics & Mastering) -->
                                <!-- ========================================================================= -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:SvgViewboxEx Width="13" Height="13" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='waveform-path duotone-light'}"/>
                                                <TextBlock Text="Động Học, Khử Tạp Âm &amp; Mastering (Dynamics &amp; Noise Control)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Dynamics: Compressor, De-Esser, Noise Gate (3-Column Grid) -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Compressor -->
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Nén giọng (Comp)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="AudioCompressorLabel" HorizontalAlignment="Right" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0%"/>
                                                </Grid>
                                                <Slider x:Name="AudioCompressorSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ToolTip="Làm dày giọng nói, cân bằng to/nhỏ"/>
                                            </StackPanel>

                                            <!-- De-Esser -->
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Khử âm xì (De-Ess)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="AudioDeEsserLabel" HorizontalAlignment="Right" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0%"/>
                                                </Grid>
                                                <Slider x:Name="AudioDeEsserSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ToolTip="Khử âm chói tai s, x, ch"/>
                                            </StackPanel>

                                            <!-- Noise Gate -->
                                            <StackPanel Grid.Column="4">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Cổng ồn (Gate)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="AudioNoiseGateLabel" HorizontalAlignment="Right" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="0%"/>
                                                </Grid>
                                                <Slider x:Name="AudioNoiseGateSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" ToolTip="Ngắt tiếng ồn khi ngừng nói"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Fade In & Fade Out (2-Column Grid) -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Fade In (Độ mờ vào)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="AudioFadeInLabel" HorizontalAlignment="Right" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Text="0s"/>
                                                </Grid>
                                                <Slider x:Name="AudioFadeInSlider" Minimum="0" Maximum="10" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Fade Out (Độ mờ ra)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="AudioFadeOutLabel" HorizontalAlignment="Right" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Text="0s"/>
                                                </Grid>
                                                <Slider x:Name="AudioFadeOutSlider" Minimum="0" Maximum="10" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Loudness Normalize & Denoise Row -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="AudioNormalizeCheckBox" Content="Chuẩn hóa Loudnorm" FontSize="9.5" Style="{StaticResource ReadableCheckBoxStyle}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="AudioTargetLufsCombo" Grid.Column="1" Height="24" FontSize="9.5" Style="{StaticResource DarkComboBoxStyle}" VerticalAlignment="Center">
                                                <ComboBoxItem Content="-14 LUFS (YT/Reels)" Tag="-14" IsSelected="True"/>
                                                <ComboBoxItem Content="-16 LUFS (Podcast)" Tag="-16"/>
                                                <ComboBoxItem Content="-23 LUFS (TV/Broad)" Tag="-23"/>
                                            </ComboBox>
                                            <CheckBox x:Name="AudioDenoiseCheckBox" Grid.Column="3" Content="Khử nhiễu nền" FontSize="9.5" Style="{StaticResource ReadableCheckBoxStyle}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- DSP Live Preview Bar -->
                                        <Border Padding="8,6" Background="{DynamicResource ThemeBackgroundMutedBrush}" CornerRadius="6" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Grid Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <controls:SvgViewboxEx Width="12" Height="12" Margin="0,0,5,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='headphones duotone-light'}"/>
                                                        <TextBlock Text="Nghe thử Bộ lọc (Live DSP Preview)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="AudioDspStatusText" Text="🔊 Đang nghe audio gốc" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="ToggleDspAudioPreviewButton" Grid.Column="0" Height="26" Style="{StaticResource ToggleSwitchStyle}">
                                                        <TextBlock Text="🎧 Nghe thử DSP" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </ToggleButton>
                                                    <Button x:Name="QuickPreviewDsp15sButton" Grid.Column="2" Height="26" Padding="6,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <controls:SvgViewboxEx Width="11" Height="11" Margin="0,0,4,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='bolt duotone-light'}"/>
                                                            <TextBlock Text="⚡ Nghe nhanh 15s" FontSize="10" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- ========================================================================= -->
                                <!-- MODULE 5: LỒNG NHẠC NGOÀI & XUẤT FILE AUDIO (Multi-Track & Export) -->
                                <!-- ========================================================================= -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:SvgViewboxEx Width="13" Height="13" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='music duotone-light'}"/>
                                                <TextBlock Text="Lồng Ghép Nhạc Ngoài &amp; Xuất File (Multi-Track &amp; Export)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Multi-Track Audio List -->
                                        <ItemsControl x:Name="AudioTracksList" Margin="0,0,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,6" Padding="8,6" Background="{DynamicResource ThemeBackgroundMutedBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Track Name & Action Buttons -->
                                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                <TextBox Text="{Binding TrackName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="10.5" Height="22" Padding="4,1" Width="130" HorizontalAlignment="Left" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}"/>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Content="▶ Nghe lồng" Height="22" Padding="6,0" FontSize="9.5" Style="{StaticResource VideoChromePrimaryButtonStyle}" Margin="0,0,4,0" Tag="{Binding}" Click="PreviewMixAudio_Click"/>
                                                                    <Button Content="✕" Width="22" Height="22" Padding="0" FontSize="9.5" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="RemoveAudioTrack_Click"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- File Path & Browse -->
                                                            <Grid Grid.Row="1" Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBox Height="24" FontSize="10" Padding="4,2" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="{Binding SourceOutputKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}"/>
                                                                <Button Grid.Column="1" Width="26" Height="24" Padding="0" Margin="4,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="BrowseAudioTrack_Click">
                                                                    <controls:SvgViewboxEx Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder-open duotone-light'}"/>
                                                                </Button>
                                                            </Grid>

                                                            <!-- Volume & Sync Mode -->
                                                            <Grid Grid.Row="2" Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <Grid Margin="0,0,0,1">
                                                                        <TextBlock Text="Âm lượng track" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                        <TextBlock FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" HorizontalAlignment="Right" Text="{Binding VolumePercent, StringFormat='{}{0:0}%'}"/>
                                                                    </Grid>
                                                                    <Slider Minimum="0" Maximum="300" Value="{Binding VolumePercent, Mode=TwoWay}" Style="{StaticResource ModernSliderStyle}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="Khi ngắn hơn video" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,1"/>
                                                                    <ComboBox Height="22" FontSize="9.5" SelectedValue="{Binding ShorterMode, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource DarkComboBoxStyle}">
                                                                        <ComboBoxItem Content="Lặp lại (Loop)" Tag="{x:Static models:AudioSyncMode.Loop}"/>
                                                                        <ComboBoxItem Content="Chèn im lặng" Tag="{x:Static models:AudioSyncMode.PadSilence}"/>
                                                                        <ComboBoxItem Content="Kéo giãn" Tag="{x:Static models:AudioSyncMode.Stretch}"/>
                                                                        <ComboBoxItem Content="Cắt ngắn" Tag="{x:Static models:AudioSyncMode.Trim}"/>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Start At & Trim In/Out -->
                                                            <Grid Grid.Row="3">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="Chèn tại (s)" FontSize="8" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                    <TextBox Height="22" FontSize="9.5" FontFamily="Consolas" Padding="3,1" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="{Binding StartAtSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="Cắt từ (s)" FontSize="8" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                    <TextBox Height="22" FontSize="9.5" FontFamily="Consolas" Padding="3,1" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="{Binding TrimStartSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="4">
                                                                    <TextBlock Text="Đến (s)" FontSize="8" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                    <TextBox Height="22" FontSize="9.5" FontFamily="Consolas" Padding="3,1" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="{Binding TrimEndSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button x:Name="AddAudioTrackButton" Height="26" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Content="+ Thêm track nhạc chèn ngoài" Margin="0,0,0,8" FontSize="10"/>

                                        <!-- Audio Export Config Options -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Định dạng" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="AudioExportFormatCombo" Height="24" FontSize="9.5" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="MP3 (.mp3)" Tag="mp3" IsSelected="True"/>
                                                    <ComboBoxItem Content="WAV (.wav)" Tag="wav"/>
                                                    <ComboBoxItem Content="AAC (.m4a)" Tag="aac"/>
                                                    <ComboBoxItem Content="FLAC (.flac)" Tag="flac"/>
                                                    <ComboBoxItem Content="OGG (.ogg)" Tag="ogg"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Chất lượng" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="AudioExportBitrateCombo" Height="24" FontSize="9.5" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="320 kbps" Tag="320k" IsSelected="True"/>
                                                    <ComboBoxItem Content="256 kbps" Tag="256k"/>
                                                    <ComboBoxItem Content="192 kbps" Tag="192k"/>
                                                    <ComboBoxItem Content="128 kbps" Tag="128k"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Sample Rate" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="AudioExportSampleRateCombo" Height="24" FontSize="9.5" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="48 kHz" Tag="48000" IsSelected="True"/>
                                                    <ComboBoxItem Content="44.1 kHz" Tag="44100"/>
                                                    <ComboBoxItem Content="96 kHz" Tag="96000"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Kênh (Channels)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="AudioExportChannelsCombo" Height="24" FontSize="9.5" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="Stereo" Tag="stereo" IsSelected="True"/>
                                                    <ComboBoxItem Content="Mono" Tag="mono"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Output Directory -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="AudioOutputFolderPathText" Height="24" FontSize="10" Padding="5,2" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" ToolTip="Để trống để tự động lưu vào thư mục Downloads/flow-audio"/>
                                            <Button x:Name="BrowseAudioTabOutputFolderButton" Grid.Column="1" Width="26" Height="24" Padding="0" Margin="4,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Chọn thư mục lưu">
                                                <controls:SvgViewboxEx Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder-open duotone-light'}"/>
                                            </Button>
                                            <Button x:Name="OpenAudioTabOutputFolderButton" Grid.Column="2" Width="26" Height="24" Padding="0" Margin="4,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Mở thư mục xuất">
                                                <controls:SvgViewboxEx Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder regular'}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Bar Footer -->
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="ExtractFullAudioButton" Content="Trích xuất toàn bộ" Height="30" Padding="12,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Trích xuất toàn bộ file audio từ video nguồn"/>
                                    <Button x:Name="ExtractTrimmedAudioButton" Content="Cắt xuất đoạn chọn" Height="30" Padding="12,0" Margin="6,0,0,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Chỉ trích xuất phân đoạn audio theo mốc Start - End đã cấu hình"/>
                                    <Button x:Name="RunFlowAudioTabButton" Content="🚀 Chạy Workflow (Audio)" Height="30" Padding="12,0" Margin="6,0,0,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Trích xuất audio và chạy tiếp Workflow với key 'linkAudio'"/>
                                </StackPanel>
                                <Button x:Name="ResetAudioTabButton" Content="Đặt lại cài đặt" Height="30" Padding="12,0" HorizontalAlignment="Right" Style="{StaticResource VideoChromeResetButtonStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 5: PHỤ ĐỀ (SUBTITLE STUDIO) -->
                    <Grid x:Name="SubtitleTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Header Toolbar Card: Import / Export / Auto-Caption / Add Segment -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:SvgViewboxEx Width="14" Height="14" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='closed-captioning duotone-light'}"/>
                                                <TextBlock Text="Phụ Đề Video Chuyên Nghiệp (Subtitle Studio)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Bật phụ đề" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ToggleButton x:Name="SubtitleEnabledToggle" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Quick Toolbar -->
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button x:Name="ImportSubtitleButton" Height="26" Width="180" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,6,6" ToolTip="Nhập file phụ đề .json, .srt, .vtt, .ass">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:SvgViewboxEx Width="12" Height="12" Margin="0,0,4,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='file-import duotone-light'}"/>
                                                    <TextBlock Text="Nhập JSON / SRT / ASS / VTT" FontSize="10" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ExportSubtitleJsonButton" Height="26" Width="85" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,6,6" ToolTip="Xuất file phụ đề đa ngôn ngữ .json (WhisperX format)">
                                                <TextBlock Text="Xuất .JSON" FontSize="10" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button x:Name="ExportSubtitleSrtButton" Height="26" Width="80" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,6,6" ToolTip="Xuất file phụ đề ra định dạng .srt">
                                                <TextBlock Text="Xuất .SRT" FontSize="10" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button x:Name="ExportSubtitleAssButton" Height="26" Width="80" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,6,6" ToolTip="Xuất file phụ đề đầy đủ hiệu ứng style .ass">
                                                <TextBlock Text="Xuất .ASS" FontSize="10" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button x:Name="AutoGenerateSubtitleButton" Height="26" Width="145" Padding="0" Style="{StaticResource VideoChromePrimaryButtonStyle}" Margin="0,0,6,6" ToolTip="Tự động nhận diện giọng nói &amp; tạo câu phụ đề (Auto-Caption AI)">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:SvgViewboxEx Width="12" Height="12" Margin="0,0,4,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='wand-magic-sparkles duotone-light'}"/>
                                                    <TextBlock Text="✨ Tự động nhận diện AI" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AddSubtitleAtPlayheadButton" Height="26" Padding="8,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,6,6" ToolTip="Thêm câu phụ đề mới ngay tại vị trí Playhead hiện tại">
                                                <TextBlock Text="+ Thêm câu tại Playhead" FontSize="10" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button x:Name="ClearAllSubtitlesButton" Height="26" Padding="8,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,0,6" ToolTip="Xóa toàn bộ danh sách phụ đề">
                                                <TextBlock Text="Xóa hết" FontSize="10" Foreground="#FF6B6B"/>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Subtitle Segment List Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Danh sách Phân đoạn Phụ đề" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                <Border Background="{DynamicResource ThemeBadgeBackgroundBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock x:Name="SubtitleCountBadge" Text="0 câu" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeWarmAccentBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Global Time Offset Adjustment Buttons -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Lệch thời gian:" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Button x:Name="ShiftSubtitlesMinus100Button" Content="-0.1s" Height="20" Width="36" Padding="0" FontSize="8.5" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,2,0" ToolTip="Lùi tất cả phụ đề 100ms"/>
                                                <Button x:Name="ShiftSubtitlesPlus100Button" Content="+0.1s" Height="20" Width="36" Padding="0" FontSize="8.5" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,2,0" ToolTip="Tiến tất cả phụ đề 100ms"/>
                                                <Button x:Name="ShiftSubtitlesMinus1sButton" Content="-1s" Height="20" Width="30" Padding="0" FontSize="8.5" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,2,0" ToolTip="Lùi tất cả phụ đề 1 giây"/>
                                                <Button x:Name="ShiftSubtitlesPlus1sButton" Content="+1s" Height="20" Width="30" Padding="0" FontSize="8.5" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Tiến tất cả phụ đề 1 giây"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Language Filter & Toggle Bar -->
                                        <Border Background="{DynamicResource ThemeBackgroundCardBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,7">
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="Ngôn ngữ hiển thị:" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <ItemsControl x:Name="SubtitleLanguageTagsControl">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Height="20" Padding="6,0" Margin="0,0,5,0" Cursor="Hand" Click="LanguageTagToggle_Click" Background="{Binding BackgroundBrushDisplay}" BorderBrush="{Binding BorderBrushDisplay}" BorderThickness="1" ToolTip="Nhấn để Bật/Tắt hiển thị ngôn ngữ này trên Preview, Burn-in &amp; Xuất file">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Opacity="{Binding OpacityDisplay}">
                                                                        <TextBlock Text="{Binding DisplayText}" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" Foreground="{Binding ForegroundBrushDisplay}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Quick Toggles -->
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <Button Content="Chỉ Bản Gốc" Height="18" Padding="6,0" FontSize="8" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,3,0" Click="ShowOnlyOriginalLanguage_Click" ToolTip="Chỉ hiển thị phụ đề bản gốc"/>
                                                    <Button Content="Chỉ Bản Dịch" Height="18" Padding="6,0" FontSize="8" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,3,0" Click="ShowOnlyTranslatedLanguage_Click" ToolTip="Chỉ hiển thị các dòng bản dịch"/>
                                                    <Button Content="Hiện Tất Cả" Height="18" Padding="6,0" FontSize="8" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="ShowAllLanguages_Click" ToolTip="Bật hiển thị tất cả các ngôn ngữ"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Subtitle List Container with Loading Overlay -->
                                        <Grid MinHeight="140">
                                            <!-- Fully Virtualized Subtitle List (Zero UI Freeze on Play/Import) -->
                                            <ListBox x:Name="SubtitleItemsControl"
                                                     MaxHeight="270"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     Margin="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingStackPanel.IsVirtualizing="True"
                                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                     VirtualizingStackPanel.ScrollUnit="Pixel"
                                                     HorizontalContentAlignment="Stretch">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,5" Padding="8,6" Background="{DynamicResource ThemeBackgroundMutedBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="SubtitleCard_MouseLeftButtonDown">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <!-- Header Line: Badge showing hh:mm:ss.f ➔ hh:mm:ss.f (Duration) + Language summary + Quick Shift Stepper buttons -->
                                                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Border Background="{DynamicResource ThemeBackgroundCardBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,5,0">
                                                                            <TextBlock Text="{Binding FormattedTimeRange}" FontSize="9.5" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{DynamicResource ThemeWarmAccentBrush}"/>
                                                                        </Border>
                                                                        <!-- Bilingual / Multi-language Badge -->
                                                                        <Border Visibility="{Binding HasMultipleLines, Converter={StaticResource BoolToVisConverter}}" Background="{DynamicResource ThemeActionSubtitleBrush}" BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,5,0" ToolTip="Phụ đề song ngữ / đa bản dịch">
                                                                            <TextBlock Text="{Binding BilingualSummary}" FontSize="8.5" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                                                        </Border>
                                                                        <!-- Quick Segment Nudge: Shift whole segment -0.5s / +0.5s -->
                                                                        <Button Content="◀ -0.5s" Height="18" Width="40" Padding="0" FontSize="8" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,2,0" Tag="{Binding}" Click="ShiftSubSegmentMinus_Click" ToolTip="Lùi cả đoạn này 0.5s"/>
                                                                        <Button Content="+0.5s ▶" Height="18" Width="40" Padding="0" FontSize="8" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="ShiftSubSegmentPlus_Click" ToolTip="Tiến cả đoạn này 0.5s"/>
                                                                    </StackPanel>

                                                                    <!-- Top Right: + Dịch, Play snippet & Delete -->
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Content="+ Dịch" Height="18" Padding="6,0" FontSize="8" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="0,0,3,0" Tag="{Binding}" Click="AddSubtitleLine_Click" ToolTip="Thêm dòng bản dịch mới cho câu này"/>
                                                                        <Button Content="▶ Phát" Width="44" Height="18" Padding="0" FontSize="8.5" Style="{StaticResource VideoChromePrimaryButtonStyle}" Margin="0,0,3,0" Tag="{Binding}" Click="PlaySubtitleSegment_Click" ToolTip="Phát thử đoạn video khớp phụ đề này"/>
                                                                        <Button Content="✕" Width="20" Height="18" Padding="0" FontSize="9" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="RemoveSubtitle_Click" ToolTip="Xóa câu này"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Row 1: Time Controls & Multi-Line Translations -->
                                                                <Grid Grid.Row="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Time Steppers Panel -->
                                                                    <StackPanel Grid.Column="0" Orientation="Vertical" Width="170" Margin="0,0,8,0">
                                                                        <!-- Start Time Stepper -->
                                                                        <Grid Margin="0,0,0,3">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="Bắt đầu:" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Width="40"/>
                                                                            <Button Grid.Column="1" Content="-" Width="16" Height="19" Padding="0" FontSize="9" FontWeight="Bold" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="SubStartMinus_Click" ToolTip="Giảm 0.5s"/>
                                                                            <TextBox Grid.Column="2" Text="{Binding StartTimeHms, UpdateSourceTrigger=LostFocus}" FontSize="9.5" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" Margin="2,0" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeWarmAccentBrush}"/>
                                                                            <Button Grid.Column="3" Content="+" Width="16" Height="19" Padding="0" FontSize="9" FontWeight="Bold" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="SubStartPlus_Click" ToolTip="Tăng 0.5s" Margin="0,0,2,0"/>
                                                                            <Button Grid.Column="4" Content="📍" Width="18" Height="19" Padding="0" FontSize="8.5" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="2,0,0,0" Tag="{Binding}" Click="SetSubStartToPlayhead_Click" ToolTip="Ghim giây hiện tại của video vào mốc bắt đầu"/>
                                                                        </Grid>

                                                                        <!-- End Time Stepper -->
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="Kết thúc:" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Width="40"/>
                                                                            <Button Grid.Column="1" Content="-" Width="16" Height="19" Padding="0" FontSize="9" FontWeight="Bold" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="SubEndMinus_Click" ToolTip="Giảm 0.5s"/>
                                                                            <TextBox Grid.Column="2" Text="{Binding EndTimeHms, UpdateSourceTrigger=LostFocus}" FontSize="9.5" FontFamily="Consolas" TextAlignment="Center" VerticalContentAlignment="Center" Margin="2,0" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeWarmAccentBrush}"/>
                                                                            <Button Grid.Column="3" Content="+" Width="16" Height="19" Padding="0" FontSize="9" FontWeight="Bold" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="SubEndPlus_Click" ToolTip="Tăng 0.5s" Margin="0,0,2,0"/>
                                                                            <Button Grid.Column="4" Content="📍" Width="18" Height="19" Padding="0" FontSize="8.5" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="2,0,0,0" Tag="{Binding}" Click="SetSubEndToPlayhead_Click" ToolTip="Ghim giây hiện tại của video vào mốc kết thúc"/>
                                                                        </Grid>
                                                                    </StackPanel>

                                                                    <!-- Multi-Line Language Subtitles Editor List -->
                                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Lines}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,0,0,3" Opacity="{Binding OpacityDisplay}">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!-- Language Tag Pill (Click to toggle this line active/inactive) -->
                                                                                    <Border Grid.Column="0" 
                                                                                            Background="{Binding TagBackgroundBrush}" 
                                                                                            BorderBrush="{Binding TagBorderBrush}" 
                                                                                            BorderThickness="1" 
                                                                                            CornerRadius="4" 
                                                                                            Padding="5,1" 
                                                                                            Margin="0,0,5,0" 
                                                                                            VerticalAlignment="Center"
                                                                                            Cursor="Hand"
                                                                                            MouseLeftButtonDown="LineTag_Click"
                                                                                            ToolTip="Nhấn để Bật/Tắt dòng phụ đề này">
                                                                                        <TextBlock Text="{Binding Tag}" 
                                                                                                   FontSize="8.5" 
                                                                                                   FontWeight="Bold" 
                                                                                                   FontFamily="Consolas" 
                                                                                                   Foreground="{Binding TagForegroundBrush}"/>
                                                                                    </Border>

                                                                                    <!-- Subtitle Text for this Language Line -->
                                                                                    <TextBox Grid.Column="1" 
                                                                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                                             FontSize="9.5" 
                                                                                             Height="22" 
                                                                                             VerticalContentAlignment="Center" 
                                                                                             Padding="4,0" 
                                                                                             Background="{DynamicResource ThemeInputBackgroundBrush}" 
                                                                                             BorderBrush="{DynamicResource ThemeInputBorderBrush}" 
                                                                                             Foreground="{Binding TextColorBrush}"/>

                                                                                    <!-- Delete this translation line (if more than 1 line) -->
                                                                                    <Button Grid.Column="2" 
                                                                                            Content="✕" 
                                                                                            Width="18" 
                                                                                            Height="20" 
                                                                                            Padding="0" 
                                                                                            FontSize="8" 
                                                                                            Style="{StaticResource VideoChromeSecondaryButtonStyle}" 
                                                                                            Margin="3,0,0,0" 
                                                                                            Tag="{Binding}" 
                                                                                            Click="RemoveSubtitleLine_Click" 
                                                                                            ToolTip="Xóa dòng dịch này"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <!-- Simple & Clean Loading Overlay for Subtitle Import & Processing -->
                                            <Border x:Name="SubtitleLoadingOverlay"
                                                    Background="#8C0F111A"
                                                    CornerRadius="6"
                                                    Visibility="Collapsed"
                                                    Panel.ZIndex="100"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                <Border Background="{DynamicResource ThemeBackgroundCardBrush}"
                                                        BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="16,12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.5"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Simple Smooth Rotating Spinner -->
                                                        <Grid Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <!-- Subtle background ring -->
                                                            <Ellipse Width="20" Height="20" Stroke="{DynamicResource ThemeInputBorderBrush}" StrokeThickness="2" Opacity="0.4"/>
                                                            <!-- Spinning accent arc -->
                                                            <Ellipse Width="20" Height="20" Stroke="{DynamicResource ThemeAccentBrush}" StrokeThickness="2" StrokeDashArray="2,2" RenderTransformOrigin="0.5,0.5">
                                                                <Ellipse.RenderTransform>
                                                                    <RotateTransform x:Name="SubSimpleSpinnerRotate" Angle="0"/>
                                                                </Ellipse.RenderTransform>
                                                                <Ellipse.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="SubSimpleSpinnerRotate"
                                                                                                 Storyboard.TargetProperty="Angle"
                                                                                                 From="0" To="360"
                                                                                                 Duration="0:0:0.9"
                                                                                                 RepeatBehavior="Forever"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Ellipse.Triggers>
                                                            </Ellipse>
                                                        </Grid>

                                                        <!-- Text Information -->
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="SubtitleLoadingTitleText"
                                                                       Text="Đang nạp phụ đề..."
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                            <TextBlock x:Name="SubtitleLoadingSubText"
                                                                       Text="Vui lòng đợi trong giây lát..."
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                                       Margin="0,2,0,0"
                                                                       MaxWidth="260"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Typography & Styling Studio Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:SvgViewboxEx Width="13" Height="13" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone-light'}"/>
                                                <TextBlock Text="Thiết Kế Kiểu Chữ &amp; Hiệu Ứng (Typography &amp; FX)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Preset Chips -->
                                        <TextBlock Text="Preset mẫu thịnh hành (Trending Styles):" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button x:Name="SubPresetTikTokButton" Content="🔥 TikTok Viral Yellow" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="SubPresetNetflixButton" Content="🎬 Netflix Cinema" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="SubPresetMinimalButton" Content="✨ Clean Minimal" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="SubPresetGamingButton" Content="🎮 Gaming RGB Glow" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                            <Button x:Name="SubPresetNewsButton" Content="📰 Breaking News Banner" Style="{StaticResource PresetChipStyle}" Margin="0,0,4,4"/>
                                        </WrapPanel>

                                        <!-- Font & Size & Weight -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Font chữ" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
