                                                    <ComboBoxItem Content="Chính giữa (Center)" Tag="Center"/>
                                                    <ComboBoxItem Content="Trên cùng (Top-Center)" Tag="TopCenter"/>
                                                    <ComboBoxItem Content="Lệch trái (Bottom-Left)" Tag="BottomLeft"/>
                                                    <ComboBoxItem Content="Lệch phải (Bottom-Right)" Tag="BottomRight"/>
