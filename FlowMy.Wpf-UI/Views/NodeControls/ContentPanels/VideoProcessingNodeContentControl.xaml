                                                    <ComboBoxItem Content="Hardcode (Burn-in)" Tag="Hardcode" IsSelected="True"/>
                                                    <ComboBoxItem Content="Soft Subtitle (Track)" Tag="Soft"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Free Position Offsets & Custom Margins -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Dịch ngang (Offset X)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="SubOffsetXLabel" Text="0 px" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="SubOffsetXSlider" Minimum="-150" Maximum="150" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Dịch dọc (Offset Y)" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="SubOffsetYLabel" Text="0 px" FontSize="8.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider x:Name="SubOffsetYSlider" Minimum="-150" Maximum="150" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Khoảng cách đáy" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
