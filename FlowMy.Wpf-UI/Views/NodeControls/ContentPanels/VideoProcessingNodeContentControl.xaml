                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Subtitle Tab Footer Action -->
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
