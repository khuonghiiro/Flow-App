                                                        <controls:SvgViewboxEx Width="10" Height="10" Margin="0,0,3,0" Fill="#FF9F43" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='bolt duotone-light'}"/>
                                                        <TextBlock Text="⚡ Giải phóng RAM" FontSize="9" FontWeight="Bold" Foreground="#FF9F43"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Auto-Ducking Banner Card -->
                                        <Border Background="{DynamicResource ThemeBackgroundMutedBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1">
                                            <Grid>
