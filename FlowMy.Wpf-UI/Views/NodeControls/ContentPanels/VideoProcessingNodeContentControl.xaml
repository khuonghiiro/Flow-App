                                                </Grid>
                                                <Slider x:Name="SubBottomMarginSlider" Minimum="0" Maximum="150" Value="30" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Video Width Fit & Long Text Handling Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:SvgViewboxEx Width="13" Height="13" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='arrows-split duotone-light'}"/>
                                                <TextBlock Text="Căn Chỉnh Chiều Ngang Video &amp; Xử Lý Text Dài" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Auto-Wrap vs Split into Consecutive Seconds Toggle -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Tự động xuống dòng khi câu dài hơn chiều ngang video" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
