                                                    </StackPanel>
                                                    <ToggleButton x:Name="AutoDuckingToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" ToolTip="Tự động giảm âm lượng nhạc nền khi có giọng lồng tiếng phát lên"/>
