                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <controls:SvgViewboxEx Width="12" Height="12" Margin="0,0,4,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='volume-slash duotone-light'}"/>
