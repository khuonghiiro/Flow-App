                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Hộp nền phụ đề (Box)" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="SubBackgroundBoxCombo" Height="24" FontSize="9.5" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="Không dùng" Tag="None" IsSelected="True"/>
                                                    <ComboBoxItem Content="Đen mờ (50%)" Tag="BlackTrans"/>
                                                    <ComboBoxItem Content="Đen đặc (100%)" Tag="BlackSolid"/>
                                                    <ComboBoxItem Content="Vàng neon" Tag="YellowBox"/>
