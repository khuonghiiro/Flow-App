                                            </StackPanel>
                                            <ToggleButton x:Name="SubAutoWrapToggle" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" ToolTip="Bật: Tự động xuống dòng | Tắt: Tách thành nhiều câu phụ đề theo từng giây tiếp theo"/>
                                        </Grid>

                                        <!-- Max Characters per line and Auto-Fit action -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Độ dài tối đa 1 dòng (ký tự):" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
