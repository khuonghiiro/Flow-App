                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- AI Text-to-Speech (TTS Studio) Generator Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:SvgViewboxEx Width="13" Height="13" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='robot duotone-light'}"/>
