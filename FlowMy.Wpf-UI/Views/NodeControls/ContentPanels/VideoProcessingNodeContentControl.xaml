                                                    <Button x:Name="PickSubTextColorButton" Grid.Column="2" Content="🎨" Width="22" Height="22" Padding="0" Margin="3,0,0,0" FontSize="10" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Mở bảng chọn màu chữ"/>
