<Window x:Class="FlowMy.Views.Overlays.CanvasDisplaySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canvas Control Center"
        Width="980"
        Height="720"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP CARD: HEADER & PRESETS -->
        <Border Style="{DynamicResource DialogCardStyle}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙ Trung tâm cấu hình Canvas"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource PrimaryBrush}" 
                                Opacity="0.18" 
                                CornerRadius="10" 
                                Padding="8,2" 
                                Margin="10,0,0,0" 
                                VerticalAlignment="Center">
                            <TextBlock Text="Live Preview" 
                                       Foreground="{DynamicResource PrimaryBrush}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Debounce Speed Options -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Độ trễ apply:" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource TextBrush}" 
                                   Opacity="0.75" 
                                   FontSize="12"
                                   Margin="0,0,8,0"/>
                        <RadioButton x:Name="DebounceFastRadio" Content="30ms" Tag="30" GroupName="DebounceGroup" Margin="0,0,8,0" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                        <RadioButton x:Name="DebounceBalancedRadio" Content="70ms" Tag="70" GroupName="DebounceGroup" Margin="0,0,8,0" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                        <RadioButton x:Name="DebounceSmoothRadio" Content="120ms" Tag="120" GroupName="DebounceGroup" FontSize="11" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Status & Preset Row -->
                <DockPanel LastChildFill="False">
                    <WrapPanel VerticalAlignment="Center">
                        <ToggleButton x:Name="PresetLowButton" Content="⚡ Máy yếu" Tag="Low" Style="{DynamicResource PresetToggleButtonStyle}" Checked="PresetButton_Checked"/>
                        <ToggleButton x:Name="PresetNormalButton" Content="⚖ Máy TB" Tag="Normal" Style="{DynamicResource PresetToggleButtonStyle}" Checked="PresetButton_Checked"/>
                        <ToggleButton x:Name="PresetHighButton" Content="🚀 Máy mạnh" Tag="High" Style="{DynamicResource PresetToggleButtonStyle}" Checked="PresetButton_Checked"/>
                        <ToggleButton x:Name="PresetDebugButton" Content="🛠 Debug" Tag="Debug" Style="{DynamicResource PresetToggleButtonStyle}" Checked="PresetButton_Checked"/>
                        <ToggleButton x:Name="PresetUltraButton" Content="👑 Ultra" Tag="Ultra" Style="{DynamicResource PresetToggleButtonStyle}" Checked="PresetButton_Checked"/>
                        <ToggleButton x:Name="PresetCustomButton" Content="🎨 Tùy chỉnh" Tag="Custom" Style="{DynamicResource PresetToggleButtonStyle}" Checked="PresetButton_Checked"
                                      ToolTip="Tự động kích hoạt khi bạn điều chỉnh cấu hình khác với preset"/>
                    </WrapPanel>
                    
                    <TextBlock x:Name="DebounceStatusText"
                               DockPanel.Dock="Right"
                               Text="Apply debounce: 70ms (Balanced)"
                               Foreground="{DynamicResource TextBrush}"
                               Opacity="0.55"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT TAB CONTROL -->
        <TabControl Grid.Row="1" Style="{DynamicResource ModernTabControl}" Background="Transparent">
            
            <!-- TAB 1: CANVAS & GPU -->
            <TabItem Header="Canvas &amp; GPU" Style="{StaticResource HttpTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Canvas Display Settings -->
                        <Border Grid.Column="0" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="📐 Hiển thị Canvas" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                <TextBlock Text="Kiểu lưới nền (Grid type)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                <ComboBox x:Name="GridTypeComboBox" Style="{DynamicResource BaseComboBox}" Margin="0,4,0,10" Height="32">
                                    <ComboBoxItem Content="Không có lưới" Tag="None"/>
                                    <ComboBoxItem Content="Kẻ chấm (Dots)" Tag="Dots"/>
                                    <ComboBoxItem Content="Kẻ liền (Lines)" Tag="Lines"/>
                                </ComboBox>

                                <TextBlock Text="Chế độ hiển thị (Display mode)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                <WrapPanel Margin="0,4,0,10">
                                    <RadioButton x:Name="CanvasDisplayModeAllRadio" Content="Toàn bộ Canvas" Tag="ShowAll" GroupName="CanvasDisplayModeGroup" Margin="0,0,14,4" Foreground="{DynamicResource TextBrush}"/>
                                    <RadioButton x:Name="CanvasDisplayModeViewportRadio" Content="Theo khung nhìn (Viewport)" Tag="ViewportOnly" GroupName="CanvasDisplayModeGroup" Margin="0,0,14,4" Foreground="{DynamicResource TextBrush}"/>
                                </WrapPanel>

                                <TextBlock Text="Hiệu năng cắt tỉa (Culling profile)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                <WrapPanel Margin="0,4,0,10">
                                    <RadioButton x:Name="CullingProfileLowRadio" Content="Tiết kiệm (Low)" Tag="Low" GroupName="CullingProfileGroup" Margin="0,0,14,4" Foreground="{DynamicResource TextBrush}"/>
                                    <RadioButton x:Name="CullingProfileNormalRadio" Content="Tiêu chuẩn (Normal)" Tag="Normal" GroupName="CullingProfileGroup" Margin="0,0,14,4" Foreground="{DynamicResource TextBrush}"/>
                                    <RadioButton x:Name="CullingProfileHighRadio" Content="Mượt mà (High)" Tag="High" GroupName="CullingProfileGroup" Margin="0,0,14,4" Foreground="{DynamicResource TextBrush}"/>
                                </WrapPanel>

                                <!-- Node Appearance Mode -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Giao diện Node (Node Appearance)" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="NodeAppearanceModeComboBox" Style="{DynamicResource BaseComboBox}" Margin="0,2,0,4" Height="32">
                                            <ComboBoxItem Content="🎯 Màu đặc (Solid)" Tag="Solid"/>
                                            <ComboBoxItem Content="💎 Kính lỏng (Liquid Glass)" Tag="LiquidGlass"/>
                                            <ComboBoxItem Content="✨ Chuyển màu 3D (Modern Gradient)" Tag="ModernGradient"/>
                                        </ComboBox>
                                        <TextBlock x:Name="NodeAppearanceDescriptionText"
                                                   Text="Màu đặc: Nền màu đặc truyền thống, viền trắng nổi bật và đổ bóng tiêu chuẩn."
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.65" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Final Sync -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox Foreground="{DynamicResource TextBrush}" x:Name="StrictFinalSyncEnabledCheckBox" Content="Strict Final Sync (đồng bộ chốt kết thúc luồng)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="Ép đồng bộ UI ngay khi kết thúc luồng. Giúp trạng thái và dữ liệu đầu ra được hiển thị tức thì."
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right: GPU & Performance -->
                        <Border Grid.Column="1" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="⚡ GPU &amp; Tăng tốc phần cứng" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                <CheckBox Foreground="{DynamicResource TextBrush}" x:Name="GpuEnabledCheckBox" Content="Bật GPU rendering (Tăng tốc xử lý đồ họa)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                <CheckBox Foreground="{DynamicResource TextBrush}" x:Name="CacheNodeCheckBox" Content="Cache node bitmap (Tăng FPS, giảm tiêu thụ CPU)" FontSize="12" Margin="0,0,0,10"/>

                                <TextBlock Text="Chất lượng GPU (GPU Quality)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                <ComboBox x:Name="GpuQualityComboBox" Style="{DynamicResource BaseComboBox}" Margin="0,4,0,12" Height="32"/>

                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Hiệu ứng giao diện (UI Animations)" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        <CheckBox Foreground="{DynamicResource TextBrush}" x:Name="UiAnimationsEnabledCheckBox" Content="Bật Animation trên các nút &amp; controls" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="💡 Bật hiệu ứng chuyển động mượt mà cho nút bấm, checkbox, radio. Tắt đi trên các máy cấu hình thấp để tối đa hóa tốc độ phản hồi."
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: KẾT NỐI (CONNECTIONS) -->
            <TabItem Header="Đường kết nối" Style="{StaticResource HttpTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Line Style & Animation -->
                        <Border Grid.Column="0" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="〰 Kiểu đường nối &amp; Animation" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                <TextBlock Text="Kiểu đường nối (Line style)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                <ComboBox x:Name="LineStyleComboBox" Style="{DynamicResource BaseComboBox}" Margin="0,4,0,12" Height="32"/>

                                <TextBlock Text="Chế độ animation (Animation mode)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12"/>
                                <WrapPanel Margin="0,4,0,6">
                                    <RadioButton x:Name="AnimationModeAnimatedRadio" Content="Bật Animation" Tag="Animated" GroupName="AnimationModeGroup" Margin="0,0,14,4" Foreground="{DynamicResource TextBrush}"/>
                                    <RadioButton x:Name="AnimationModeOffRadio" Content="Tắt Animation" Tag="Off" GroupName="AnimationModeGroup" Margin="0,0,14,4" Foreground="{DynamicResource TextBrush}"/>
                                    <RadioButton x:Name="AnimationModeDashedRadio" Content="Nét đứt (Dashed)" Tag="Dashed" GroupName="AnimationModeGroup" Margin="0,0,14,4" Foreground="{DynamicResource TextBrush}"/>
                                </WrapPanel>

                                <!-- Cache node notice -->
                                <Border x:Name="AnimationDisabledNotice"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource CardColor}"
                                        BorderBrush="{DynamicResource WarningBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="⚠ Animation bị tắt vì 'Cache node' đang bật"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="Cache node raster sẵn node để tăng FPS nhưng không đồng bộ được line energy dot. Để bật lại: sang tab 'Canvas &amp; GPU' bỏ tích 'Cache node'."
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.75"
                                                   TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right: Connection Color -->
                        <Border Grid.Column="1" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🎨 Màu sắc đường kết nối" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center">
                                        <RadioButton x:Name="ConnectionColorModeNodeRadio" Content="Theo màu node" Tag="NodeColor" GroupName="ConnectionColorModeGroup" Margin="0,0,12,0" Foreground="{DynamicResource TextBrush}"/>
                                        <RadioButton x:Name="ConnectionColorModeCustomRadio" Content="Tùy chọn:" Tag="CustomColor" GroupName="ConnectionColorModeGroup" Foreground="{DynamicResource TextBrush}"/>
                                    </WrapPanel>
                                    <ComboBox Grid.Column="1" x:Name="CustomColorKeyComboBox" Style="{DynamicResource BaseComboBox}" Height="32"/>
                                </Grid>

                                <TextBlock Text="💡 Khi chọn 'Theo màu node', đường nối sẽ lấy màu phát ra từ cổng ra (Output Port) của node nguồn."
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: TIÊU ĐỀ & ENERGY -->
            <TabItem Header="Tiêu đề &amp; Energy" Style="{StaticResource HttpTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Bulk Title Color -->
                        <Border Grid.Column="0" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🏷 Màu tiêu đề hàng loạt" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center">
                                        <RadioButton x:Name="BulkTitleModeNodeRadio" Content="Theo node" Tag="NodeColor" GroupName="BulkTitleModeGroup" Margin="0,0,10,0" Foreground="{DynamicResource TextBrush}"/>
                                        <RadioButton x:Name="BulkTitleModeCustomRadio" Content="Tùy chọn:" Tag="CustomColor" GroupName="BulkTitleModeGroup" Foreground="{DynamicResource TextBrush}"/>
                                    </WrapPanel>
                                    <ComboBox Grid.Column="1" x:Name="BulkTitleColorKeyComboBox" Style="{DynamicResource BaseComboBox}" Height="32"/>
                                </Grid>

                                <TextBlock Text="💡 Cho phép áp dụng màu tiêu đề đồng nhất cho tất cả các node trên canvas."
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.6" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Execution Energy -->
                        <Border Grid.Column="1" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="⚡ Hiệu ứng năng lượng (Execution Energy)" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center">
                                        <RadioButton x:Name="EnergyColorModeFollowLineRadio" Content="Theo màu line" Tag="FollowLineColor" GroupName="EnergyColorModeGroup" Margin="0,0,10,0" Foreground="{DynamicResource TextBrush}"/>
                                        <RadioButton x:Name="EnergyColorModeCustomRadio" Content="Tùy chọn:" Tag="CustomColor" Foreground="{DynamicResource TextBrush}" GroupName="EnergyColorModeGroup"/>
                                    </WrapPanel>
                                    <ComboBox Grid.Column="1" x:Name="EnergyCustomColorKeyComboBox" Style="{DynamicResource BaseComboBox}" Height="32"/>
                                </Grid>

                                <!-- Slider: Gap -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Khoảng cách chấm (Gap)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="EnergyDotGapSlider" Minimum="2" Maximum="14" TickFrequency="0.5" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="EnergyDotGapValueText" Text="5.5" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Slider: Thickness -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Độ dày thêm (Thickness+)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="EnergyDotThicknessSlider" Minimum="0" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="EnergyDotThicknessValueText" Text="1.0" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Slider: Speed -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tốc độ chạy (Run speed)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="EnergyRunSpeedSlider" Minimum="0.4" Maximum="3.5" TickFrequency="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="EnergyRunSpeedValueText" Text="1.3" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Toggle Advanced Style -->
                                <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="AdvancedFlowStyleCheckBox" Content="Cấu hình nâng cao (Style node chạy)" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="💡 Bật để mở thêm tab 'Style node chạy' khi cần cấu hình vòng xoay viền và nháy nền."
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.55" FontSize="11" Margin="20,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: ENERGY NÂNG CAO (GLOW PULSE) - Hidden by default -->
            <TabItem Header="Energy nâng cao" Style="{StaticResource HttpTabItemStyle}" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <Border Margin="4" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Text thay cho chấm (để trống = chỉ chấm)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="EnergyDotTextTextBox" Style="{DynamicResource BaseTextBoxV2}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Giây/vòng xoay (Spin sec)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="EnergySpinSpeedSlider" Minimum="0.2" Maximum="6" TickFrequency="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                    <TextBlock x:Name="EnergySpinSpeedValueText" Text="0.7" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox Foreground="{DynamicResource TextBrush}" x:Name="EnergyDotRotateCheckBox" Content="Text xoay 360 độ" Margin="0,0,16,0"/>
                                <CheckBox Foreground="{DynamicResource TextBrush}" x:Name="EnergyMeteorModeCheckBox" Content="✨ Hiệu ứng phát sáng (Glow Pulse)" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Grid Margin="0,10,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Độ sáng glow" Foreground="{DynamicResource TextBrush}" Opacity="0.85" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="MeteorTailLengthSlider" Minimum="5" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                    <TextBlock x:Name="MeteorTailLengthValueText" Text="12" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bán kính glow" Foreground="{DynamicResource TextBrush}" Opacity="0.85" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="MeteorTailBlurSlider" Minimum="2" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                    <TextBlock x:Name="MeteorTailBlurValueText" Text="8" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tốc độ nhấp nháy" Foreground="{DynamicResource TextBrush}" Opacity="0.85" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="MeteorTailOpacitySlider" Minimum="0.2" Maximum="1.5" TickFrequency="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                    <TextBlock x:Name="MeteorTailOpacityValueText" Text="0.8" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Độ dày glow" Foreground="{DynamicResource TextBrush}" Opacity="0.85" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="MeteorTailThicknessSlider" Minimum="1" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                    <TextBlock x:Name="MeteorTailThicknessValueText" Text="2.5" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="⚡ Preset nhanh" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,8"/>
                            <WrapPanel>
                                <Button Content="Nhẹ" Tag="Light" Click="MeteorPresetButton_Click" MinWidth="60" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}"/>
                                <Button Content="Vừa" Tag="Medium" Click="MeteorPresetButton_Click" MinWidth="60" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}"/>
                                <Button Content="Mạnh" Tag="Strong" Click="MeteorPresetButton_Click" MinWidth="60" Margin="0,0,6,6" Style="{DynamicResource SecondaryButton}"/>
                                <Button Content="Rất mạnh" Tag="VeryStrong" Click="MeteorPresetButton_Click" MinWidth="70" Style="{DynamicResource SecondaryButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: STYLE NODE CHẠY (Enabled via AdvancedFlowStyleCheckBox) -->
            <TabItem Header="Style node chạy" Style="{StaticResource HttpTabItemStyle}" x:Name="StyleNodeRunningTabItem" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Spinner Shape & Motion -->
                        <Border Grid.Column="0" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="🔄 Vòng quay trạng thái (Spinner)" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                <CheckBox x:Name="NodeSpinnerArcModeCheckBox" Content="Vòng quay 1 góc (Arc mode)" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="NodeSpinnerMultiColorCheckBox" Content="Vòng quay nhiều màu sắc (Multi-color)" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Hình dáng vòng quay" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="NodeSpinnerShapeComboBox" Height="32" Style="{DynamicResource BaseComboBox}">
                                            <ComboBoxItem Tag="Circle" Content="Hình tròn"/>
                                            <ComboBoxItem Tag="Diamond" Content="Hình thoi"/>
                                            <ComboBoxItem Tag="Square" Content="Hình vuông"/>
                                            <ComboBoxItem Tag="RoundedSquare" Content="Vuông bo góc"/>
                                            <ComboBoxItem Tag="FollowNodeShape" Content="Theo viền node"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Vị trí vòng quay" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="NodeSpinnerPositionComboBox" Height="32" Style="{DynamicResource BaseComboBox}">
                                            <ComboBoxItem Tag="TopRight" Content="Góc phải trên"/>
                                            <ComboBoxItem Tag="TopLeft" Content="Góc trái trên"/>
                                            <ComboBoxItem Tag="BottomRight" Content="Góc phải dưới"/>
                                            <ComboBoxItem Tag="BottomLeft" Content="Góc trái dưới"/>
                                            <ComboBoxItem Tag="Center" Content="Tâm node"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Size -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Kích thước (px)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="NodeSpinnerSizeSlider" Minimum="14" Maximum="56" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="NodeSpinnerSizeValueText" Text="24.0" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Stroke Thickness -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Độ dày nét" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="NodeSpinnerStrokeThicknessSlider" Minimum="1.5" Maximum="5.0" TickFrequency="0.1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="NodeSpinnerStrokeThicknessValueText" Text="2.8" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Spin Speed -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tốc độ xoay (giây/vòng)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="NodeSpinnerSpinSecondsSlider" Minimum="0.4" Maximum="3.0" TickFrequency="0.1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="NodeSpinnerSpinSecondsValueText" Text="1.0" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <CheckBox x:Name="NodeSpinnerScaleWithNodeCheckBox" Content="Kích thước theo tỉ lệ node" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tỉ lệ kích thước" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="NodeSpinnerSizeRatioSlider" Minimum="0.15" Maximum="0.60" TickFrequency="0.01" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="NodeSpinnerSizeRatioValueText" Text="0.28" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Right: Blink Background -->
                        <Border Grid.Column="1" Background="{DynamicResource CardColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="✨ Hiệu ứng nháy nền (Blink Background)" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="NodeSpinnerBlinkBackgroundCheckBox" Grid.Column="0" Content="Bật nháy nền khi node chạy" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="NodeSpinnerBlinkBackgroundColorComboBox" Grid.Column="1" Height="32" Style="{DynamicResource BaseComboBox}">
                                        <ComboBoxItem Tag="WarningBrush" Content="Vàng nhạt"/>
                                        <ComboBoxItem Tag="InfoBrush" Content="Xanh cyan nhạt"/>
                                        <ComboBoxItem Tag="SuccessBrush" Content="Xanh lá nhạt"/>
                                        <ComboBoxItem Tag="PrimaryBrush" Content="Xanh dương nhạt"/>
                                        <ComboBoxItem Tag="LavenderBrush" Content="Tím nhạt"/>
                                        <ComboBoxItem Tag="CoralBrush" Content="Cam san hô nhạt"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Kiểu nháy" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="NodeSpinnerBlinkModeComboBox" Height="32" Style="{DynamicResource BaseComboBox}">
                                            <ComboBoxItem Tag="Soft" Content="Mềm (fade)"/>
                                            <ComboBoxItem Tag="Hard" Content="Gắt (on/off)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Preset nháy nhanh" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" Margin="0,0,0,4"/>
                                        <WrapPanel>
                                            <Button Content="Nhẹ" Tag="Light" Click="BlinkPresetButton_Click" MinWidth="48" Margin="0,0,4,4" Style="{DynamicResource SecondaryButton}"/>
                                            <Button Content="Vừa" Tag="Medium" Click="BlinkPresetButton_Click" MinWidth="48" Margin="0,0,4,4" Style="{DynamicResource SecondaryButton}"/>
                                            <Button Content="Mạnh" Tag="Strong" Click="BlinkPresetButton_Click" MinWidth="52" Style="{DynamicResource SecondaryButton}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Blink Intensity -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cường độ nháy" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="NodeSpinnerBlinkIntensitySlider" Minimum="0.10" Maximum="1.00" TickFrequency="0.01" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="NodeSpinnerBlinkIntensityValueText" Text="0.50" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Base Opacity -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Opacity nền cơ sở" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="NodeSpinnerBlinkBaseOpacitySlider" Minimum="0.00" Maximum="0.40" TickFrequency="0.01" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="NodeSpinnerBlinkBaseOpacityValueText" Text="0.10" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Peak Opacity -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Độ sáng đỉnh (Peak)" Foreground="{DynamicResource TextBrush}" Opacity="0.85" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="NodeSpinnerBlinkPeakOpacitySlider" Minimum="0.10" Maximum="0.80" TickFrequency="0.01" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="44">
                                        <TextBlock x:Name="NodeSpinnerBlinkPeakOpacityValueText" Text="0.50" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- BOTTOM BUTTON BAR -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,4,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="💡 Mọi thay đổi cấu hình sẽ được áp dụng trực tiếp lên Canvas." 
                           Foreground="{DynamicResource TextBrush}" 
                           Opacity="0.5" 
                           FontSize="12" 
                           VerticalAlignment="Center"/>
                <Button x:Name="CancelButton" 
                        DockPanel.Dock="Right" 
                        Content="Đóng" 
                        MinWidth="120" 
                        Height="34"
                        Style="{DynamicResource PrimaryButton}" 
                        Click="CancelButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
