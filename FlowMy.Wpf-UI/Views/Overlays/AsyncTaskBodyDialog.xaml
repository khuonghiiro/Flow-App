<local:BaseNodeDialog x:Class="FlowMy.Views.Overlays.AsyncTaskBodyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlowMy.Views.Overlays"
        xmlns:controls="clr-namespace:FlowMy.Controls"
        Title="Cấu hình Output Async Task Body"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="640"
        Height="540"
        MinWidth="520"
        MaxWidth="850"
        MinHeight="400">
    <Border CornerRadius="12" Padding="0" Style="{DynamicResource DialogOuterBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{DynamicResource DialogHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="⚙️ Cấu hình Output từ Node bên trong Async Task Body"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Chọn node bên trong body và gom item kết quả đẩy lên AsyncTask"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CloseButton" Padding="0,0,0,0" 
                                Width="24" Height="24"
                                Style="{DynamicResource DangerButton}"
                                Content="✕"
                                FontSize="12"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Margin="8,0,0,0"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Grid.Row="1">
                <StackPanel>
                    <!-- Checkbox Chế độ điều hướng luồng -->
                    <Border Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="⚙️ Điều hướng luồng ra" 
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                            <CheckBox x:Name="WaitForAllThreadsCheckBox"
                                      Content="Đợi tất cả luồng trong async task body chạy xong mới chạy node tiếp theo"
                                      IsChecked="{Binding WaitForAllThreads, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}"
                                      FontSize="11"/>
                        
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Section Output Mappings -->
                    <Border Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Expander IsExpanded="True" BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Expander}}" Margin="0,0,24,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding OutputMappingsHeader}"
                                               Grid.Column="0"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="1"
                                            Content="+ Thêm Output Mapping"
                                            Style="{DynamicResource PrimaryButton}"
                                            Height="30" Padding="10,0"
                                            Cursor="Hand"
                                            Command="{Binding AddMappingCommand}"/>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                <!-- ItemsControl list of target mappings -->
                                <ItemsControl ItemsSource="{Binding Mappings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource WindowBackground}"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <!-- Top Bar: Target Output Key & Remove Mapping -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Target Output Key -->
                                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                            <TextBlock Text="🔑 Target Output Key (AsyncTask)" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                                            <TextBox Height="30"
                                                                     Style="{DynamicResource BaseTextBoxV2}"
                                                                     Text="{Binding OutputKey, UpdateSourceTrigger=PropertyChanged}"
                                                                     VerticalContentAlignment="Center"
                                                                     Padding="6,0"/>
                                                        </StackPanel>

                                                        <!-- Gom Item Checkbox -->
                                                        <CheckBox Grid.Column="1"
                                                                  IsChecked="{Binding IsCollectArray, Mode=TwoWay}"
                                                                  VerticalAlignment="Bottom"
                                                                  Margin="0,0,8,6"
                                                                  Cursor="Hand"
                                                                  ToolTip="Checked = Gom kết quả các lượt chạy thành mảng JSON">
                                                            <TextBlock Text="Gom mảng JSON"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}"/>
                                                        </CheckBox>

                                                        <!-- Delete Mapping Button -->
                                                        <Button Grid.Column="2"
                                                                Width="28" Height="28" Padding="0"
                                                                VerticalAlignment="Bottom"
                                                                Style="{DynamicResource DangerButton}"
                                                                Content="🗑" FontSize="12"
                                                                Cursor="Hand"
                                                                ToolTip="Xóa Target Output Mapping này"
                                                                Command="{Binding DataContext.RemoveMappingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>

                                                    <!-- Dynamic Multi-Source List -->
                                                    <Border Background="{DynamicResource CardColor}" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="📍 Các Nguồn Dữ Liệu Gộp (Whichever node produces output)"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>

                                                            <ItemsControl ItemsSource="{Binding Sources}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="8"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="8"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Source Node -->
                                                                            <controls:NodeSearchComboBoxUserControl Grid.Column="0" Height="30"
                                                                                      ItemsSource="{Binding DataContext.InnerNodeOptions, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                                      DisplayMemberPath="Title"
                                                                                      SelectedValuePath="NodeId"
                                                                                      SelectedValue="{Binding SourceNodeId, Mode=TwoWay}"
                                                                                      PlaceholderText="Chọn node nguồn..."/>

                                                                            <!-- Source Output Key -->
                                                                            <ComboBox Grid.Column="2" Height="30"
                                                                                      Style="{DynamicResource BaseComboBox}"
                                                                                      ItemsSource="{Binding AvailableOutputKeys}"
                                                                                      DisplayMemberPath="DisplayName"
                                                                                      SelectedValuePath="Key"
                                                                                      SelectedValue="{Binding SourceOutputKey, Mode=TwoWay}"/>

                                                                            <!-- Remove Source Button -->
                                                                            <Button Grid.Column="4" Width="26" Height="26" Padding="0"
                                                                                    VerticalAlignment="Center"
                                                                                    Style="{DynamicResource DangerButton}"
                                                                                    Content="-" FontSize="16" FontWeight="Bold"
                                                                                    Cursor="Hand"
                                                                                    ToolTip="Xóa nguồn gộp này"
                                                                                    Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Add Source Button (+ Gộp value) -->
                                                            <Button Content="+ Gộp value (Thêm nguồn dữ liệu)"
                                                                    Height="26" Padding="8,0"
                                                                    Margin="0,4,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Style="{DynamicResource PrimaryButton}"
                                                                    FontSize="11" Cursor="Hand"
                                                                    Command="{Binding AddSourceCommand}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Hint / Help card -->
                    <Border Background="{DynamicResource CardColor}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="💡 Hướng dẫn &amp; Lưu ý"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                            <TextBlock Text="• Nếu tích chọn 'Gom Item': Dữ liệu đầu ra từ từng lượt chạy (iteration) của node trong body sẽ được tự động gom lại thành mảng JSON (e.g. ['val1', 'val2']) tại Target Key của AsyncTask."
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="• Các node phía sau AsyncTask nối từ loopOut có thể chọn Target Key này để đọc mảng dữ liệu tổng hợp sau khi hoàn tất tất cả vòng lặp bất đồng bộ."
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Save / Cancel -->
            <Border Grid.Row="2" Padding="16,12" Background="{DynamicResource HeaderBackground}" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy bỏ" Height="32" Width="90" Margin="0,0,8,0"
                            Style="{DynamicResource SecondaryButton}" Cursor="Hand" Click="CloseButton_Click"/>
                    <Button Content="Lưu cấu hình" Height="32" Width="120"
                            Style="{DynamicResource PrimaryButton}" Cursor="Hand" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</local:BaseNodeDialog>
