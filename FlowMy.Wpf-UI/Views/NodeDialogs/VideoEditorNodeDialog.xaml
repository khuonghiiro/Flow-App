<local:BaseNodeDialog x:Class="FlowMy.Views.Overlays.VideoEditorNodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FlowMy.Controls"
    xmlns:local="clr-namespace:FlowMy.Views.Overlays"
    xmlns:converters="clr-namespace:FlowMy.Converters"
    Title="Chỉnh sửa video"
    WindowStyle="None" ResizeMode="CanResize"
    AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" Topmost="True"
    Width="580" MinWidth="480" MinHeight="480">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>

    <Border CornerRadius="12" Padding="0" Style="{DynamicResource DialogOuterBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Style="{DynamicResource DialogHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleTextBox" Grid.Column="0"
                             Text="{Binding NodeTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BaseTextBoxV2}" FontSize="16"
                             Padding="0,4" VerticalContentAlignment="Center" Cursor="IBeam"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="24" Height="24" Content="▶" FontSize="12" Padding="0" Margin="8,0,0,0"
                                Style="{DynamicResource PrimaryButton}" Cursor="Hand" ToolTip="Chạy logic node này"
                                Command="{Binding RunSingleNodeCommand}"/>
                        <Button x:Name="CloseButton" Width="24" Height="24" Padding="0" Content="✕" FontSize="12"
                                FontWeight="Bold" Margin="8,0,0,0" Cursor="Hand"
                                Style="{DynamicResource DangerButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

                <!-- TAB 1: LOGIC & CHẾ ĐỘ -->
                <TabItem Header="Logic &amp; Kết Nối" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>

                            <!-- Chế độ hiển thị Node -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🖼️ Chế độ Giao diện Node" Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                              ItemsSource="{Binding DisplayModeOptions}"
                                              SelectedValuePath="Key" DisplayMemberPath="Value"
                                              SelectedValue="{Binding DisplayMode, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>

                            <!-- 🎨 Cấu hình hiển thị tiêu đề -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎨 Cấu hình tiêu đề" Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Hiển thị tiêu đề" Foreground="{DynamicResource TextMuted}"
                                                       FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                      ItemsSource="{Binding TitleDisplayModeOptions}"
                                                      SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                                                      SelectedValue="{Binding TitleDisplayMode, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Màu tiêu đề" Foreground="{DynamicResource TextMuted}"
                                                       FontSize="10" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="TitleColorComboBox" Grid.Column="0" Height="32"
                                                          Style="{DynamicResource BaseComboBox}"
                                                          ItemsSource="{Binding TitleColorOptions}"
                                                          SelectedValuePath="Key" DisplayMemberPath="DisplayName"
                                                          SelectedValue="{Binding TitleColorKey, Mode=TwoWay}"
                                                          SelectionChanged="TitleColorComboBox_SelectionChanged"/>
                                                <Border x:Name="TitleColorPreview" Grid.Column="1"
                                                        Width="32" Height="32" CornerRadius="6" Margin="6,0,0,0"
                                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 📍 Input từ node khác -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📍 Input Nguồn Video chính" Foreground="{DynamicResource TextBrush}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Node Nguồn" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <controls:NodeSearchComboBoxUserControl x:Name="SourceNodeCombo" Height="32"
                                                      ItemsSource="{Binding AvailableNodeOptions}"
                                                      SelectedValuePath="NodeId" DisplayMemberPath="Title"
                                                      SelectedValue="{Binding SourceNodeId, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Key Output" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="SourceKeyCombo" Height="32" Style="{DynamicResource BaseComboBox}"
                                                      ItemsSource="{Binding SourceKeyOptions}"
                                                      SelectedValue="{Binding SourceOutputKey, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="🔑 Tên biến (trống = key)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="32" Style="{DynamicResource BaseTextBoxV2}"
                                                     Text="{Binding CustomKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Hoặc Đường Dẫn File Video Tĩnh:" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,4,0,4"/>
                                    <TextBox Height="32" Style="{DynamicResource BaseTextBoxV2}"
                                             Text="{Binding InputVideoUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Border>

                            <!-- Outputs Panel -->
                            <TextBlock Text="Outputs Port" Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Style="{DynamicResource DialogOuterBorder}" CornerRadius="8" Padding="10">
                                <StackPanel x:Name="OutputsPanel"/>
                            </Border>
                            <StackPanel x:Name="InputsPanel" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: CẤU HÌNH FFMPEG -->
                <TabItem Header="⚙️ Cấu hình FFmpeg" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Trim Card -->
                            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox Content="✂️ Bật cắt Video (Trim)" IsChecked="{Binding TrimEnabled, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Thời gian bắt đầu (hh:mm:ss.fff)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="30" Style="{DynamicResource BaseTextBoxV2}" Text="{Binding TrimStartTime, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Thời gian kết thúc (hh:mm:ss.fff)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="30" Style="{DynamicResource BaseTextBoxV2}" Text="{Binding TrimEndTime, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Color & Filter Card -->
                            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎨 Màu sắc &amp; Bộ lọc" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Preset Bộ lọc" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="30" Style="{DynamicResource BaseComboBox}" ItemsSource="{Binding FilterPresetOptions}" SelectedItem="{Binding FilterPreset, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Hue / Tông màu (-180..180)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="30" Style="{DynamicResource BaseTextBoxV2}" Text="{Binding Hue, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Scale & Speed Card -->
                            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox Content="📐 Đổi kích thước (Scale)" IsChecked="{Binding ScaleEnabled, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Width (px)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="30" Style="{DynamicResource BaseTextBoxV2}" Text="{Binding TargetWidth, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Height (px)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="30" Style="{DynamicResource BaseTextBoxV2}" Text="{Binding TargetHeight, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Xoay / Lật" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="30" Style="{DynamicResource BaseComboBox}" ItemsSource="{Binding RotateFlipOptions}" SelectedItem="{Binding RotateFlip, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Export Options -->
                            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="📦 Cấu hình Export Output" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Chế độ Export" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="30" Style="{DynamicResource BaseComboBox}" ItemsSource="{Binding ExportModeOptions}" SelectedItem="{Binding ExportMode, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Format (MP4/GIF/WEBM...)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="30" Style="{DynamicResource BaseComboBox}" ItemsSource="{Binding ExportFormatOptions}" SelectedItem="{Binding ExportFormat, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Tốc độ khung (FPS)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="30" Style="{DynamicResource BaseTextBoxV2}" Text="{Binding ExportFps, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: PORT & LAYOUT -->
                <TabItem Header="Port &amp; Flow" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>

                            <TextBlock Text="Vị trí cổng IN/OUT" Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Port IN" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                              ItemsSource="{Binding PortPositionOptions}"
                                              SelectedItem="{Binding InputPortPosition, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Port OUT" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                              ItemsSource="{Binding PortPositionOptions}"
                                              SelectedItem="{Binding OutputPortPosition, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</local:BaseNodeDialog>
