<local:BaseNodeDialog x:Class="FlowMy.Views.Overlays.MacroRecorderNodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:controls="clr-namespace:FlowMy.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlowMy.Views.Overlays"
        Title="Macro Recorder"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="520"
        MinWidth="420"
        MaxWidth="700"
        MinHeight="420">
    <local:BaseNodeDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </local:BaseNodeDialog.Resources>
    <Border CornerRadius="12" Padding="0" Style="{DynamicResource DialogOuterBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{DynamicResource DialogHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TitleTextBox"
                             Grid.Column="0"
                             Text="{Binding NodeTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BaseTextBoxV2}"
                             FontSize="16"
                             Padding="0,4,0,4"
                             VerticalContentAlignment="Center"
                             MinWidth="150"
                             Cursor="IBeam"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayButton"
                                Padding="0,0,0,0"
                                Width="24"
                                Height="24"
                                Content="▶"
                                FontSize="12"
                                Style="{DynamicResource PrimaryButton}"
                                Cursor="Hand"
                                Margin="8,0,0,0"
                                ToolTip="Chạy logic node này"
                                Command="{Binding RunSingleNodeCommand}"/>

                        <Button x:Name="CloseButton"
                                Padding="0,0,0,0"
                                Width="24"
                                Height="24"
                                Style="{DynamicResource DangerButton}"
                                Content="×"
                                FontSize="12"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Margin="8,0,0,0"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <TabControl Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0">

                <!-- Tab 1: Logic -->
                <TabItem Header="Logic" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>

                            <!-- CARD 1: CẤU HÌNH HIỂN THỊ & OUTPUT -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="🎨 Cấu hình hiển thị &amp; Output" 
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Hiển thị tiêu đề" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="TitleDisplayModeComboBox"
                                                      Height="30"
                                                      Style="{DynamicResource BaseComboBox}"
                                                      ItemsSource="{Binding TitleDisplayModeOptions}"
                                                      SelectedValuePath="Value"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValue="{Binding TitleDisplayMode, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Màu tiêu đề" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="TitleColorComboBox"
                                                          Grid.Column="0"
                                                          Height="30"
                                                          Style="{DynamicResource BaseComboBox}"
                                                          ItemsSource="{Binding TitleColorOptions}"
                                                          SelectedValuePath="Key"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValue="{Binding TitleColorKey, Mode=TwoWay}"
                                                          SelectionChanged="TitleColorComboBox_SelectionChanged"/>
                                                <Border Grid.Column="1"
                                                        x:Name="TitleColorPreview"
                                                        Width="24"
                                                        Height="24"
                                                        CornerRadius="4"
                                                        Margin="6,0,0,0"
                                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                                        BorderThickness="1"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Output Key" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                            <TextBox x:Name="OutputKeyTextBox"
                                                     Height="30"
                                                     Style="{DynamicResource BaseTextBoxV2}"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding OutputKey, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                
                            </StackPanel>
                        </Expander>
                    </Border>

                            <!-- CARD 2: PHẠM VI HOẠT ĐỘNG & GHI THAO TÁC -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="🎯 Ghi lại thao tác" 
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Phạm vi hoạt động" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ExecutionModeComboBox"
                                                      Height="30"
                                                      Style="{DynamicResource BaseComboBox}"
                                                      ItemsSource="{Binding ExecutionModeOptions}"
                                                      SelectedItem="{Binding SelectedExecutionMode, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Visibility="{Binding IsTargetAppVisible, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Chọn ứng dụng đích" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="TargetAppComboBox"
                                                          Grid.Column="0"
                                                          Height="30"
                                                          Style="{DynamicResource BaseComboBox}"
                                                          ItemsSource="{Binding ActiveWindows}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedItem="{Binding SelectedTargetWindow, Mode=TwoWay}"/>
                                                <Button Grid.Column="1"
                                                        Content="↻"
                                                        Height="30"
                                                        Width="30"
                                                        Padding="0"
                                                        Margin="6,0,0,0"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        Command="{Binding LoadWindowsCommand}"
                                                        ToolTip="Tải lại danh sách cửa sổ"
                                                        Cursor="Hand"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Button: Ghi lại thao tác -->
                                    <Button x:Name="RecordButton"
                                            Content="🔴 Ghi lại thao tác"
                                            Height="34"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Style="{DynamicResource PrimaryButton}"
                                            Cursor="Hand"
                                            Margin="0,0,0,10"
                                            Click="RecordButton_Click"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ShowMouseTrailCheckBox"
                                                  Grid.Column="0"
                                                  Content="Hiển thị nét chuột khi ghi"
                                                  IsChecked="{Binding ShowMouseTrail, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextBrush}"
                                                  FontSize="11"
                                                  Cursor="Hand"/>
                                        <CheckBox x:Name="StayOnTargetCheckBox"
                                                  Grid.Column="1"
                                                  Content="Ở lại ứng dụng khi chạy xong"
                                                  IsChecked="{Binding StayOnTargetAfterExecution, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextBrush}"
                                                  FontSize="11"
                                                  Cursor="Hand"/>
                                    </Grid>
                                
                            </StackPanel>
                        </Expander>
                    </Border>

                            <!-- CARD 3: CẤU HÌNH PHÁT LẠI & HIỂN THỊ -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="⚙️ Cấu hình phát lại &amp; Hiển thị" 
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Chế độ phát lại" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="PlaybackModeComboBox"
                                                      Height="30"
                                                      Style="{DynamicResource BaseComboBox}"
                                                      ItemsSource="{Binding PlaybackModeOptions}"
                                                      SelectedItem="{Binding SelectedPlaybackMode, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Đếm ngược trước khi chạy (giây, 0 = không)" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                            <TextBox Height="30"
                                                     Style="{DynamicResource BaseTextBoxV2}"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding CountdownSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Repeat params (lặp lại) -->
                                    <Grid Visibility="{Binding IsRepeatVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Thời gian giữa chu kỳ (ms)" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                            <TextBox x:Name="RepeatIntervalMsTextBox"
                                                     Height="30"
                                                     Style="{DynamicResource BaseTextBoxV2}"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding RepeatIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Số lần lặp" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                            <TextBox x:Name="RepeatCountTextBox"
                                                     Height="30"
                                                     Style="{DynamicResource BaseTextBoxV2}"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Hiển thị khi chạy" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="VisualPlaybackModeComboBox"
                                              Height="30"
                                              Style="{DynamicResource BaseComboBox}"
                                              Margin="0,0,0,6"
                                              ItemsSource="{Binding VisualPlaybackModeOptions}"
                                              SelectedItem="{Binding SelectedVisualPlaybackMode, Mode=TwoWay}"/>
                                    <TextBlock x:Name="VisualModeHint"
                                               FontSize="10"
                                               Opacity="0.65"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}"/>
                                
                            </StackPanel>
                        </Expander>
                    </Border>

                            <!-- CARD 4: TUỲ CHỈNH TỐC ĐỘ & BỎ QUA -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="⏱️ Tùy chỉnh tốc độ &amp; Bỏ qua" 
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    
                                    <TextBlock Text="⏱️ Tuỳ chỉnh tốc độ (ms, -1 = giữ gốc)" 
                                               Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" IsEnabled="{Binding IsMouseMoveDelayEnabled}">
                                            <TextBlock Text="Di chuột" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,2"/>
                                            <TextBox Height="24" Style="{DynamicResource BaseTextBoxV2}" FontSize="10"
                                                     Text="{Binding MouseMoveDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" IsEnabled="{Binding IsKeyPressDelayEnabled}">
                                            <TextBlock Text="Nhấn phím" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,2"/>
                                            <TextBox Height="24" Style="{DynamicResource BaseTextBoxV2}" FontSize="10"
                                                     Text="{Binding KeyPressDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" IsEnabled="{Binding IsMouseClickDelayEnabled}">
                                            <TextBlock Text="Click chuột" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,2"/>
                                            <TextBox Height="24" Style="{DynamicResource BaseTextBoxV2}" FontSize="10"
                                                     Text="{Binding MouseClickDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6" IsEnabled="{Binding IsMouseScrollDelayEnabled}">
                                            <TextBlock Text="Scroll" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,2"/>
                                            <TextBox Height="24" Style="{DynamicResource BaseTextBoxV2}" FontSize="10"
                                                     Text="{Binding MouseScrollDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ⏭️ Bỏ qua thao tác -->
                                    <TextBlock Text="⏭️ Bỏ qua thao tác (không thực thi)" 
                                               Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Di chuột" FontSize="9"
                                                  Foreground="{DynamicResource TextMuted}"
                                                  IsChecked="{Binding SkipMouseMove, Mode=TwoWay}"
                                                  ToolTip="Bỏ qua toàn bộ sự kiện di chuột khi phát lại"
                                                  Cursor="Hand"/>
                                        <CheckBox Grid.Column="1" Content="Nhấn phím" FontSize="9"
                                                  Foreground="{DynamicResource TextMuted}"
                                                  IsChecked="{Binding SkipKeyPress, Mode=TwoWay}"
                                                  ToolTip="Bỏ qua toàn bộ sự kiện nhấn phím khi phát lại"
                                                  Cursor="Hand"/>
                                        <CheckBox Grid.Column="2" Content="Click chuột" FontSize="9"
                                                  Foreground="{DynamicResource TextMuted}"
                                                  IsChecked="{Binding SkipMouseClick, Mode=TwoWay}"
                                                  ToolTip="Bỏ qua toàn bộ sự kiện click chuột khi phát lại"
                                                  Cursor="Hand"/>
                                        <CheckBox Grid.Column="3" Content="Scroll" FontSize="9"
                                                  Foreground="{DynamicResource TextMuted}"
                                                  IsChecked="{Binding SkipMouseScroll, Mode=TwoWay}"
                                                  ToolTip="Bỏ qua toàn bộ sự kiện cuộn chuột khi phát lại"
                                                  Cursor="Hand"/>
                                    </Grid>
                                
                            </StackPanel>
                        </Expander>
                    </Border>

                            <!-- CARD 5: DỮ LIỆU ĐÃ GHI (JSON) -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="📄 Dữ liệu đã ghi (JSON)" 
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    <TextBox x:Name="MacroDataJsonTextBox"
                                             Height="60"
                                             Style="{DynamicResource BaseTextBoxV2}"
                                             FontSize="10"
                                             Padding="8,6,8,6"
                                             VerticalContentAlignment="Top"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             IsReadOnly="True"
                                             Text="{Binding MacroDataJsonSummary, Mode=OneWay}"
                                             Margin="0,0,0,10"/>

                                    <!-- Copy / Paste / Export / Import JSON buttons -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Row 0: Copy & Paste -->
                                        <Button x:Name="CopyJsonButton"
                                                Grid.Row="0" Grid.Column="0"
                                                Content="📋 Copy JSON"
                                                Height="30"
                                                FontSize="12"
                                                Style="{DynamicResource PrimaryButton}"
                                                Cursor="Hand"
                                                IsEnabled="{Binding CanExportJson}"
                                                Click="CopyJsonButton_Click"/>

                                        <Button x:Name="PasteJsonButton"
                                                Grid.Row="0" Grid.Column="2"
                                                Content="📋 Paste JSON"
                                                Height="30"
                                                FontSize="12"
                                                Style="{DynamicResource PrimaryButton}"
                                                Cursor="Hand"
                                                Click="PasteJsonButton_Click"/>

                                        <!-- Row 2: Export & Import -->
                                        <Button x:Name="ExportJsonButton"
                                                Grid.Row="2" Grid.Column="0"
                                                Content="📤 Export JSON"
                                                Height="30"
                                                FontSize="12"
                                                Style="{DynamicResource SecondaryButton}"
                                                Cursor="Hand"
                                                IsEnabled="{Binding CanExportJson}"
                                                Click="ExportJsonButton_Click"/>

                                        <Button x:Name="ImportJsonButton"
                                                Grid.Row="2" Grid.Column="2"
                                                Content="📥 Import JSON"
                                                Height="30"
                                                FontSize="12"
                                                Style="{DynamicResource SecondaryButton}"
                                                Cursor="Hand"
                                                Click="ImportJsonButton_Click"/>
                                    </Grid>
                                
                            </StackPanel>
                        </Expander>
                    </Border>

                            <!-- Inputs Panel -->
                            <StackPanel x:Name="InputsPanel"/>

                            <!-- Outputs Panel -->
                            <StackPanel x:Name="OutputsPanel"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Cấu hình -->
                <TabItem Header="Cấu hình" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Cấu hình vị trí cổng IN/OUT -->
                            <TextBlock Text="Vị trí cổng IN/OUT"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Port IN"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="10"
                                               Margin="0,0,0,4"/>
                                    <ComboBox Height="32"
                                              Style="{DynamicResource BaseComboBox}"
                                              ItemsSource="{Binding PortPositionOptions}"
                                              SelectedItem="{Binding InputPortPosition, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Port OUT"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="10"
                                               Margin="0,0,0,4"/>
                                    <ComboBox Height="32"
                                              Style="{DynamicResource BaseComboBox}"
                                              ItemsSource="{Binding PortPositionOptions}"
                                              SelectedItem="{Binding OutputPortPosition, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding ReuseRoutes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Background="{DynamicResource WindowBackground}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Node IN"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding IncomingNodeTitle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Node OUT"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               Margin="0,0,0,4"/>
                                                    <controls:NodeSearchComboBoxUserControl
                                                              Height="32"
                                                              ItemsSource="{Binding OutgoingOptions}"
                                                              SelectedValuePath="NodeId"
                                                              DisplayMemberPath="Title"
                                                              SelectedValue="{Binding SelectedOutgoingNodeId, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock Text="Kiểu line OUT"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               Margin="0,0,0,4"/>
                                                    <ComboBox Height="32"
                                                              Style="{DynamicResource BaseComboBox}"
                                                              ItemsSource="{Binding DataContext.ConnectionLineStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Key"
                                                              DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding SelectedLineStyleKey, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</local:BaseNodeDialog>
