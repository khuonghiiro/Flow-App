<Window x:Class="FlowMy.Views.NodeDialogs.VideoProcessingStudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FlowMy.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="FlowMy - Video &amp; Audio Processing Studio"
        Width="1160" Height="760"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/Control_News/VideoProcessingStyles.xaml"/>
                <ResourceDictionary Source="../../Themes/Controls/Sliders.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="StudioOuterBorder" Background="{DynamicResource ThemeCardBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. STUDIO TITLE BAR -->
            <Border Grid.Row="0" Background="{DynamicResource ThemePanelHeaderBrush}" BorderBrush="{DynamicResource ThemePanelHeaderBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Padding="16,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:SvgViewboxEx Width="20" Height="20" Margin="0,0,10,0" Fill="{DynamicResource ThemeAccentBrush}"
                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='film-camera-retro duotone-light'}"/>
                        <TextBlock Text="Video &amp; Audio Studio" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Margin="10,0,0,0" Padding="6,2" Background="{DynamicResource ThemeAccentBrush}" CornerRadius="4">
                            <TextBlock Text="CẤU HÌNH ĐỒNG BỘ 2 CHIỀU" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeOnAccentTextBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1" x:Name="StudioVideoPathText" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="16,0" Opacity="0.85"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StudioThemeButton" Width="30" Height="30" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Đổi sáng/tối (Toggle Light/Dark Theme)" Margin="0,0,6,0" Click="StudioThemeButton_Click">
                            <controls:SvgViewboxEx x:Name="StudioThemeIcon" Width="14" Height="14" Fill="{DynamicResource ThemeTextPrimaryBrush}"
                                                   Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='sun-bright duotone-light'}"/>
                        </Button>
                        <Button x:Name="StudioCloseButton" Width="30" Height="30" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Đóng cửa sổ" Click="StudioCloseButton_Click">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. STUDIO WORKSPACE (SPLIT 2 COLUMNS) -->
            <Grid Grid.Row="1" Margin="14,10,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430" MinWidth="350"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="430"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: LIVE VIEWPORT & TRANSPORT CONTROLS -->
                <Border Grid.Column="0" Style="{StaticResource InnerCardStyle}" Padding="10" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Viewport Card -->
                        <Border Grid.Row="0" CornerRadius="8" Background="{DynamicResource ThemeVideoViewportBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <MediaElement x:Name="StudioPreviewMedia" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                                              MediaOpened="StudioPreviewMedia_MediaOpened" MediaEnded="StudioPreviewMedia_MediaEnded"/>
                                <Border x:Name="StudioGradingOverlay" IsHitTestVisible="False" CornerRadius="8" Background="Transparent"/>
                                <TextBlock x:Name="StudioNoVideoText" Text="Chưa chọn video" FontSize="12" Foreground="{DynamicResource ThemeTextSecondaryBrush}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Timeline Scrubber -->
                        <Grid Grid.Row="1" Margin="0,8,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider x:Name="StudioScrubberSlider" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ModernSliderStyle}"
                                    PreviewMouseLeftButtonDown="StudioScrubberSlider_MouseDown"
                                    PreviewMouseLeftButtonUp="StudioScrubberSlider_MouseUp"/>
                            <Grid Grid.Row="1" Margin="2,2,2,0">
                                <TextBlock x:Name="StudioTimeElapsedText" Text="00:00.00" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="StudioTimeTotalText" Text="00:00.00" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <!-- Transport Bar & Quick Actions -->
                        <Border Grid.Row="2" Background="{DynamicResource ThemeActionBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="8,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Controls Row 1 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="StudioPlayPauseButton" Grid.Column="0" Width="34" Height="32" Padding="0" Style="{StaticResource PlayButtonStyle}" Click="StudioPlayPause_Click">
                                        <controls:SvgViewboxEx Width="13" Height="13" Fill="White" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='play regular'}"/>
                                    </Button>
                                    <Button x:Name="StudioStopButton" Grid.Column="2" Width="30" Height="30" Padding="0" Style="{StaticResource IconButtonStyle}" Click="StudioStop_Click" ToolTip="Dừng phát">
                                        <controls:SvgViewboxEx Width="13" Height="13" Fill="{DynamicResource ThemeTextPrimaryBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='stop sharp-regular'}"/>
                                    </Button>
                                    <Button x:Name="StudioMuteButton" Grid.Column="4" Width="30" Height="30" Padding="0" Style="{StaticResource IconButtonStyle}" Click="StudioMute_Click" ToolTip="Bật/Tắt âm">
                                        <controls:SvgViewboxEx Width="13" Height="13" Fill="{DynamicResource ThemeTextPrimaryBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='volume-high duotone-light'}"/>
                                    </Button>

                                    <Slider x:Name="StudioVolumeSlider" Grid.Column="7" Minimum="0" Maximum="1" Value="0.7" VerticalAlignment="Center" Style="{StaticResource ModernSliderStyle}" ValueChanged="StudioVolume_ValueChanged"/>

                                    <ComboBox x:Name="StudioSpeedCombo" Grid.Column="9" Height="26" Width="64" FontSize="10.5" Style="{StaticResource DarkComboBoxStyle}" VerticalAlignment="Center" SelectionChanged="StudioSpeedCombo_SelectionChanged">
                                        <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                        <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                        <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True"/>
                                        <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                        <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                        <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Controls Row 2: DSP Live Preview & FFplay & File -->
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="StudioDspPreviewButton" Grid.Column="0" Height="28" Padding="4,0" Style="{StaticResource ToggleSwitchStyle}" Width="Auto" Click="StudioDspPreviewButton_Click" ToolTip="Bật/Tắt nghe thử âm thanh thời gian thực đã qua bộ lọc DSP (EQ, lọc âm, chuẩn hóa)">
                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                            <TextBlock Text="🎧 Nghe DSP" FontSize="10.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button x:Name="StudioLaunchFfplayButton" Grid.Column="2" Height="28" Padding="4,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="StudioLaunchFfplay_Click" ToolTip="Mở toàn bộ Video + Audio Filter qua cửa sổ phần cứng FFplay">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgViewboxEx Width="11" Height="11" Margin="0,0,4,0" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='play-circle duotone-light'}"/>
                                            <TextBlock Text="🎬 FFplay" FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StudioChooseFileButton" Grid.Column="4" Height="28" Padding="4,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="StudioChooseFile_Click" ToolTip="Chọn file video khác">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:SvgViewboxEx Width="11" Height="11" Margin="0,0,4,0" Fill="{DynamicResource ThemeTextPrimaryBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder-open duotone-light'}"/>
                                            <TextBlock Text="📁 Video..." FontSize="10" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT COLUMN: TABBED STUDIO CONFIGURATION -->
                <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}" Padding="12" ClipToBounds="True">
                    <TabControl Background="Transparent" BorderThickness="0">

                        <!-- TAB 1: AUDIO STUDIO & DSP MIXER -->
                        <TabItem Header="🎵 Âm Thanh (Audio Studio)" Style="{StaticResource HttpTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel>
                                    <!-- 1. Source Audio & Volume -->
                                    <Border Background="{DynamicResource ThemeActionBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="StudioSourceAudioToggle" Content="Âm thanh gốc" FontSize="11" FontWeight="SemiBold" Style="{StaticResource ReadableCheckBoxStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Âm lượng:" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                            <Slider x:Name="StudioSourceAudioVolumeSlider" Grid.Column="3" Minimum="0" Maximum="200" Value="100" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- 2. Audio Trimming -->
                                    <Border Background="{DynamicResource ThemeActionBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="10,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <CheckBox x:Name="StudioAudioTrimToggle" Content="✂️ Cắt phân đoạn âm thanh (Audio Trim)" FontSize="11" FontWeight="Bold" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                                <TextBlock x:Name="StudioAudioTrimDurationLabel" Text="00:00.00 → 00:00.00" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Bắt đầu (Giây)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <Slider x:Name="StudioAudioTrimStartSlider" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Kết thúc (Giây)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <Slider x:Name="StudioAudioTrimEndSlider" Minimum="0" Maximum="100" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Equalizer Presets & Gain Sliders -->
                                    <Border Background="{DynamicResource ThemeActionBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="10,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="🎚️ Cân bằng Âm sắc (EQ Presets)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="StudioDspActiveBadge" Text="⚡ Áp dụng Real-time" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button x:Name="StudioPresetNeutral" Content="Neutral" Style="{StaticResource PresetChipStyle}" Tag="neutral" Click="StudioPreset_Click" Margin="0,0,6,6"/>
                                                <Button x:Name="StudioPresetVocal" Content="🎤 Vocal Boost" Style="{StaticResource PresetChipStyle}" Tag="vocal" Click="StudioPreset_Click" Margin="0,0,6,6"/>
                                                <Button x:Name="StudioPresetBass" Content="🔊 Deep Bass" Style="{StaticResource PresetChipStyle}" Tag="bass" Click="StudioPreset_Click" Margin="0,0,6,6"/>
                                                <Button x:Name="StudioPresetTreble" Content="✨ Treble Clear" Style="{StaticResource PresetChipStyle}" Tag="treble" Click="StudioPreset_Click" Margin="0,0,6,6"/>
                                                <Button x:Name="StudioPresetPodcast" Content="🎙️ Podcast Master" Style="{StaticResource PresetChipStyle}" Tag="podcast" Click="StudioPreset_Click" Margin="0,0,6,6"/>
                                            </WrapPanel>

                                            <!-- Gain Sliders -->
                                            <Grid Margin="0,2,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock Text="Bass Gain" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                        <TextBlock x:Name="StudioBassGainLabel" Text="0dB" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="StudioBassGainSlider" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock Text="Treble Gain" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                        <TextBlock x:Name="StudioTrebleGainLabel" Text="0dB" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="StudioTrebleGainSlider" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Fade Sliders -->
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock Text="Fade In (Giây)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                        <TextBlock x:Name="StudioFadeInLabel" Text="0s" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="StudioFadeInSlider" Minimum="0" Maximum="10" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock Text="Fade Out (Giây)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                        <TextBlock x:Name="StudioFadeOutLabel" Text="0s" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Slider x:Name="StudioFadeOutSlider" Minimum="0" Maximum="10" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Advanced Filters -->
                                    <Border Background="{DynamicResource ThemeActionBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="🛡️ Bộ Lọc Âm Thanh Nâng Cao" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <WrapPanel Margin="0,0,0,6">
                                                <CheckBox x:Name="StudioDenoiseCheckBox" Content="Khử nhiễu nền (Denoise)" FontSize="10.5" Margin="0,0,12,4" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                                <CheckBox x:Name="StudioHighpassCheckBox" Content="Lọc ù gió (HP 80Hz)" FontSize="10.5" Margin="0,0,12,4" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                                <CheckBox x:Name="StudioLowpassCheckBox" Content="Lọc rít chói (LP 12kHz)" FontSize="10.5" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                            </WrapPanel>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="StudioNormalizeCheckBox" Content="Chuẩn hóa EBU R128" FontSize="10.5" Style="{StaticResource ReadableCheckBoxStyle}" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="StudioTargetLufsCombo" Grid.Column="1" Height="24" FontSize="10" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="-14 LUFS (YT/Reels)" Tag="-14" IsSelected="True"/>
                                                    <ComboBoxItem Content="-16 LUFS (Podcast)" Tag="-16"/>
                                                    <ComboBoxItem Content="-23 LUFS (Broad)" Tag="-23"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 2: VIDEO COLOR & FILTERS -->
                        <TabItem Header="🎨 Màu Sắc &amp; Hiệu Ứng" Style="{StaticResource HttpTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel>
                                    <Border Background="{DynamicResource ThemeActionBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="10,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="Chỉnh Màu Sắc Video (Color Grading)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="⚡ Real-time Shader" FontSize="9.5" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Độ sáng" FontSize="10.5" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Slider x:Name="StudioBrightnessSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.05" Style="{StaticResource ModernSliderStyle}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=StudioBrightnessSlider, StringFormat='{}{0:0.##}'}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Tương phản" FontSize="10.5" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Slider x:Name="StudioContrastSlider" Grid.Column="1" Minimum="0" Maximum="3" Value="1" TickFrequency="0.05" Style="{StaticResource ModernSliderStyle}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=StudioContrastSlider, StringFormat='{}{0:0.##}'}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Độ bão hòa" FontSize="10.5" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Slider x:Name="StudioSaturationSlider" Grid.Column="1" Minimum="0" Maximum="3" Value="1" TickFrequency="0.05" Style="{StaticResource ModernSliderStyle}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=StudioSaturationSlider, StringFormat='{}{0:0.##}'}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Flip & Rotation -->
                                    <Border Background="{DynamicResource ThemeActionBarBackgroundBrush}" BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="Xoay &amp; Lật Khung Hình" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <CheckBox x:Name="StudioFlipHCheckBox" Content="Lật ngang (Flip H)" FontSize="10.5" Margin="0,0,16,0" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                                <CheckBox x:Name="StudioFlipVCheckBox" Content="Lật dọc (Flip V)" FontSize="10.5" Margin="0,0,16,0" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- 3. STUDIO FOOTER ACTION BAR -->
            <Border Grid.Row="2" Background="{DynamicResource ThemePanelHeaderBrush}" BorderBrush="{DynamicResource ThemePanelHeaderBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:SvgViewboxEx Width="14" Height="14" Margin="0,0,6,0" Fill="{DynamicResource ThemeAccentBrush}"
                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='circle-check duotone-light'}"/>
                        <TextBlock Text="Mọi thay đổi sẽ tự động đồng bộ 100% về Node trên Canvas sau khi nhấn Áp dụng." FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="StudioCancelButton" Content="Hủy bỏ" Height="30" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="StudioCancelButton_Click"/>
                        <Button x:Name="StudioApplyButton" Content="✓ Áp dụng &amp; Đóng" Height="30" Padding="16,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" Click="StudioApplyButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
