<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  SOFT DARK — Warm charcoal + jade teal                       ║
    ║  Background: #1A1918  Surface: #252320  Accent: #6BBFB0     ║
    ╚══════════════════════════════════════════════════════════════╝
    -->

    <RadialGradientBrush x:Key="CardRadialBackground"
                  RadiusX="1" RadiusY="1"
                  Center="0.5,0.5"
                  GradientOrigin="0.5,0.5">
        <GradientStop Color="#FF161B1B" Offset="0"/>
        <GradientStop Color="#FF202827" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="BorderBrush" Color="#FF33423E"/>
    <SolidColorBrush x:Key="CardColor" Color="#FF202827"/>
    <SolidColorBrush x:Key="BorderColor" Color="#FF465A55"/>

    <!-- Header — warm dark -->
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FF101414"/>

    <!-- Overlay -->
    <SolidColorBrush x:Key="OverlayBackground" Color="#BB161B1B"/>
    <SolidColorBrush x:Key="OverlayBackgroundReverse" Color="#66FFFFFF"/>

    <SolidColorBrush x:Key="BackgroundAll" Color="#FF161B1B"/>

    <!-- ===== PRIMARY — jade teal (more vivid) ===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#66C2A8"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#7AD3BC"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#55AD96"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#0A1E1C"/>

    <!-- ===== SECONDARY ===== -->
    <SolidColorBrush x:Key="SecondaryBrush" Color="#687A74"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#7B8E88"/>
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#566861"/>
    <SolidColorBrush x:Key="TextOnSecondaryBrush" Color="White"/>

    <!-- ===== SUCCESS ===== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4DC880"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#66D898"/>
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="#38B46C"/>
    <SolidColorBrush x:Key="TextOnSuccessBrush" Color="#081A10"/>

    <!-- ===== DANGER ===== -->
    <SolidColorBrush x:Key="DangerBrush" Color="#F07070"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#F88888"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#D85858"/>
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="#FFFFFF"/>

    <!-- ===== WARNING ===== -->
    <SolidColorBrush x:Key="WarningBrush" Color="#E8B84A"/>
    <SolidColorBrush x:Key="WarningHoverBrush" Color="#F0CC6E"/>
    <SolidColorBrush x:Key="WarningPressedBrush" Color="#D4A030"/>
    <SolidColorBrush x:Key="TextOnWarningBrush" Color="#1A1400"/>

    <!-- ===== INFO ===== -->
    <SolidColorBrush x:Key="InfoBrush" Color="#60B0A8"/>
    <SolidColorBrush x:Key="InfoHoverBrush" Color="#78C4BC"/>
    <SolidColorBrush x:Key="InfoPressedBrush" Color="#4C9C94"/>
    <SolidColorBrush x:Key="TextOnInfoBrush" Color="#081C1A"/>

    <!-- ===== LIGHT / DARK variants ===== -->
    <SolidColorBrush x:Key="LightBrush" Color="#293330"/>
    <SolidColorBrush x:Key="LightHoverBrush" Color="#34423E"/>
    <SolidColorBrush x:Key="LightPressedBrush" Color="#202827"/>
    <SolidColorBrush x:Key="TextOnLightBrush" Color="#DCE7E2"/>

    <SolidColorBrush x:Key="DarkBrush" Color="#101414"/>
    <SolidColorBrush x:Key="DarkHoverBrush" Color="#161B1B"/>
    <SolidColorBrush x:Key="DarkPressedBrush" Color="#0B0E0E"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="White"/>

    <!-- ===== WINDOW BACKGROUNDS ===== -->
    <SolidColorBrush x:Key="WindowBodyBackground" Color="#FF202827"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#FF161B1B"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF161B1B"/>

    <!-- ===== TEXT ===== -->
    <SolidColorBrush x:Key="TextBrush" Color="#DCE7E2"/>
    <SolidColorBrush x:Key="TextBrushReverse" Color="#FF161B1B"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TransparentHoverBrush" Color="#26DCE7E2"/>
    <SolidColorBrush x:Key="TransparentPressedBrush" Color="#4DDCE7E2"/>
    <SolidColorBrush x:Key="TransparentFocusBrush" Color="#4DDCE7E2"/>
    <SolidColorBrush x:Key="TextOnTransparentBrush" Color="#FFDCE7E2"/>

    <!-- ===== INPUT BACKGROUNDS ===== -->
    <SolidColorBrush x:Key="TextBoxBackground" Color="#FF202827"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF33423E"/>
    <SolidColorBrush x:Key="TextBoxHoverBackground" Color="#FF293330"/>
    <SolidColorBrush x:Key="TextBoxFocusBackground" Color="#FF2D3935"/>
    <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#FF1A2020"/>
    <SolidColorBrush x:Key="TextBoxReadOnlyBackground" Color="#FF1D2423"/>

    <!-- ===== BORDER COLORS ===== -->
    <SolidColorBrush x:Key="TextBoxHoverBorderBrush" Color="#FF526862"/>
    <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#FF66C2A8"/>

    <!-- ===== TEXT STATES ===== -->
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#8897AAA3"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#8897AAA3"/>
    <SolidColorBrush x:Key="DisabledBackground" Color="#FF1A2020"/>
    <SolidColorBrush x:Key="ReadOnlyTextBrush" Color="#FF97AAA3"/>

    <!-- ===== GLOW EFFECTS ===== -->
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="#4466C2A8"/>
    <SolidColorBrush x:Key="HoverGlowBrush" Color="#2866C2A8"/>

    <!-- ===== READONLY ===== -->
    <SolidColorBrush x:Key="ReadOnlyBackground" Color="#FF1D2423"/>
    <SolidColorBrush x:Key="ReadOnlyForeground" Color="#FF97AAA3"/>
    <SolidColorBrush x:Key="BorderInverseColor">#FFDCE7E2</SolidColorBrush>
    <SolidColorBrush x:Key="ControlBorderColor">#FF33423E</SolidColorBrush>
    <SolidColorBrush x:Key="ReadOnlyBorderBrush" Color="#FF465A55"/>

    <!-- ===== BUTTON BRUSHES ===== -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FF202827"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FF202827"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF293330"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FF161B1B"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF465A55"/>

    <!-- ===== SCROLLBAR ===== -->
    <Color x:Key="ScrollBarThumbColor">#FF4B8276</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#FF66C2A8</Color>
    <Color x:Key="ScrollBarThumbPressedColor">#FF7AD3BC</Color>
    <Color x:Key="ScrollBarTrackColor">Transparent</Color>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="{StaticResource ScrollBarThumbPressedColor}"/>
    <SolidColorBrush x:Key="ScrollBarTrackBackground" Color="{StaticResource ScrollBarTrackColor}"/>

    <!-- ===== PROGRESS ===== -->
    <SolidColorBrush x:Key="ProgressBackground">#FF293330</SolidColorBrush>
    <SolidColorBrush x:Key="ProgressFill">#FF66C2A8</SolidColorBrush>

    <!-- ===== SHADOW ===== -->
    <Color x:Key="ShadowColor">#50000000</Color>
    <Color x:Key="PopupShadowColor">#32000000</Color>
    <Color x:Key="PrimaryShadowColor">#28161B1B</Color>

    <!-- ===== RADIO OPTIONS ===== -->
    <SolidColorBrush x:Key="OptionHoverBrush" Color="#FF293330"/>
    <SolidColorBrush x:Key="OptionSelectedBrush" Color="#FF66C2A8"/>

    <!-- ===== MISC ===== -->
    <SolidColorBrush x:Key="TitleBackgroundBrush" Color="#FF202827"/>
    <SolidColorBrush x:Key="TextNoteBrush" Color="#FF97AAA3"/>

    <!-- ===== DATAGRID ===== -->
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#FFDCE7E2"/>
    <SolidColorBrush x:Key="DataGridRowBackground">Transparent</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridAltRowBackground">#0AFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridHeaderBackground">#FF202827</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridBorderBrush">#FF33423E</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridRowHoverBackground">#3066C2A8</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridSelectionBackground">#6066C2A8</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridSelectedCellBackground">#6066C2A8</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridSelectedTextBrush">#FF0A1E1C</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridHoverCellBackground" Color="#4866C2A8"/>

    <!-- ===== COMBOBOX ===== -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#FF293330"/>
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#FFA9F0DF"/>

    <!-- ComboBox -->
    <SolidColorBrush x:Key="ComboBoxFieldBackground" Color="#FF161B1B"/>
    <SolidColorBrush x:Key="ComboBoxFieldBorderBrush" Color="#FF465A55"/>
    <SolidColorBrush x:Key="ComboBoxFieldHoverBackground" Color="#FF1A2020"/>
    <SolidColorBrush x:Key="ComboBoxFieldHoverBorderBrush" Color="#FF526862"/>
    <SolidColorBrush x:Key="ComboBoxFieldFocusBackground" Color="#FF1A2020"/>
    <SolidColorBrush x:Key="ComboBoxFieldFocusBorderBrush" Color="#FF66C2A8"/>
    <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#FF202827"/>
    <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#FF33423E"/>
    <SolidColorBrush x:Key="ComboBoxGlyphBrush" Color="#FFC6D7D0"/>
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#FF293330"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#FF173A33"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedHoverBrush" Color="#FF1F4A42"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedForegroundBrush" Color="#FFE8F4F0"/>

    <!-- ===== CARD ===== -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF202827"/>

    <!-- ===== SEMANTIC ALIASES ===== -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#FF66C2A8"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#FF7AD3BC"/>
    <SolidColorBrush x:Key="SecondaryColor" Color="#FF4DC880"/>
    <SolidColorBrush x:Key="AccentColor" Color="#FFC8A2C8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC8A2C8"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#FF161B1B"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="#FF202827"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFDCE7E2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FFB3C5BE"/>
    <SolidColorBrush x:Key="TextMuted" Color="#FF97AAA3"/>
    <SolidColorBrush x:Key="DangerColor" Color="#FFF07070"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#FF4DC880"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFE8B84A"/>

    <!-- ===== POPUP ===== -->
    <SolidColorBrush x:Key="PopupHoverBrush" Color="#FF293330"/>
    <SolidColorBrush x:Key="PopupSelectedBackground" Color="#FF202827"/>

    <!-- ===== LAVENDER (list highlight — jade) ===== -->
    <SolidColorBrush x:Key="LavenderHoverBrush"   Color="#3066C2A8"/>
    <SolidColorBrush x:Key="LavenderPressedBrush" Color="#6066C2A8"/>
    <SolidColorBrush x:Key="TextOnLavenderBrush"  Color="#FFE4F4F0"/>

    <!-- ===== LISTVIEW HEADER ===== -->
    <SolidColorBrush x:Key="ListViewHeaderBrush"  Color="#FF161B1B"/>
    <SolidColorBrush x:Key="ListViewItemBrush"    Color="#FFDCE7E2"/>
    <SolidColorBrush x:Key="HoverBackground"      Color="#40293330"/>

    <!-- ===== CANVAS ===== -->
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FF141918"/>
    <SolidColorBrush x:Key="CanvasGridBrush" Color="#905E746E"/>
    <SolidColorBrush x:Key="ExecutionTraceGuideBrush" Color="#AA748E86"/>
    <Color x:Key="NodeShadowColor">#48000000</Color>

    <!-- ===== FOCUS & INTERACTION ===== -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#5566C2A8"/>
    <SolidColorBrush x:Key="CardHoverBackground" Color="#FF293330"/>
    <Color x:Key="ButtonShadowColor">#2466C2A8</Color>
    <SolidColorBrush x:Key="TabIndicatorBrush" Color="#FF66C2A8"/>
    <SolidColorBrush x:Key="DataGridHeaderHoverBackground" Color="#FF293330"/>
    <SolidColorBrush x:Key="MenuItemHoverBackgroundBrush" Color="#FF293330"/>
    <!-- Toolbar / editor header — darkest warm charcoal -->
    <SolidColorBrush x:Key="HeaderBackgroundMainBrush" Color="#FF0C1010"/>

    <!-- Common palette overrides -->
    <SolidColorBrush x:Key="OceanBrush" Color="#60B0C8"/>
    <SolidColorBrush x:Key="OceanHoverBrush" Color="#78C4D8"/>
    <SolidColorBrush x:Key="OceanPressedBrush" Color="#4C9CB4"/>
    <SolidColorBrush x:Key="TextOnOceanBrush" Color="#081820"/>

    <SolidColorBrush x:Key="BrightPowerBrush" Color="#E83060"/>
    <SolidColorBrush x:Key="BrightPowerHoverBrush" Color="#F05080"/>
    <SolidColorBrush x:Key="BrightPowerPressedBrush" Color="#CC2050"/>
    <SolidColorBrush x:Key="TextOnBrightPowerBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="MagentaBloomBrush" Color="#C870C8"/>
    <SolidColorBrush x:Key="MagentaBloomHoverBrush" Color="#D888D8"/>
    <SolidColorBrush x:Key="MagentaBloomPressedBrush" Color="#B45CB4"/>
    <SolidColorBrush x:Key="TextOnMagentaBloomBrush" Color="#200C20"/>

    <SolidColorBrush x:Key="NavyDeepBrush" Color="#6888C0"/>
    <SolidColorBrush x:Key="NavyDeepHoverBrush" Color="#80A0CC"/>
    <SolidColorBrush x:Key="NavyDeepPressedBrush" Color="#5474AC"/>
    <SolidColorBrush x:Key="TextOnNavyDeepBrush" Color="#0C1828"/>

    <SolidColorBrush x:Key="MidnightBlueBrush" Color="#5878B0"/>
    <SolidColorBrush x:Key="MidnightBlueHoverBrush" Color="#7090C0"/>
    <SolidColorBrush x:Key="MidnightBluePressedBrush" Color="#48649C"/>
    <SolidColorBrush x:Key="TextOnMidnightBlueBrush" Color="#0C1828"/>

    <SolidColorBrush x:Key="PrussianBlueBrush" Color="#5070A8"/>
    <SolidColorBrush x:Key="PrussianBlueHoverBrush" Color="#6888BC"/>
    <SolidColorBrush x:Key="PrussianBluePressedBrush" Color="#3C5C94"/>
    <SolidColorBrush x:Key="TextOnPrussianBlueBrush" Color="#0C1828"/>

    <SolidColorBrush x:Key="CharcoalDarkBrush" Color="#607080"/>
    <SolidColorBrush x:Key="CharcoalDarkHoverBrush" Color="#788898"/>
    <SolidColorBrush x:Key="CharcoalDarkPressedBrush" Color="#4C5C6C"/>
    <SolidColorBrush x:Key="TextOnCharcoalDarkBrush" Color="#101820"/>

    <SolidColorBrush x:Key="GraphiteGrayBrush" Color="#686870"/>
    <SolidColorBrush x:Key="GraphiteGrayHoverBrush" Color="#808088"/>
    <SolidColorBrush x:Key="GraphiteGrayPressedBrush" Color="#54545C"/>
    <SolidColorBrush x:Key="TextOnGraphiteGrayBrush" Color="#141418"/>

    <SolidColorBrush x:Key="BerryPurpleBrush" Color="#A880C8"/>
    <SolidColorBrush x:Key="BerryPurpleHoverBrush" Color="#BC98D8"/>
    <SolidColorBrush x:Key="BerryPurplePressedBrush" Color="#946CB4"/>
    <SolidColorBrush x:Key="TextOnBerryPurpleBrush" Color="#1C1028"/>

    <SolidColorBrush x:Key="CobaltBlueBrush" Color="#6090CC"/>
    <SolidColorBrush x:Key="CobaltBlueHoverBrush" Color="#78A8D8"/>
    <SolidColorBrush x:Key="CobaltBluePressedBrush" Color="#4C7CB8"/>
    <SolidColorBrush x:Key="TextOnCobaltBlueBrush" Color="#0C1828"/>

    <SolidColorBrush x:Key="WineRedBrush" Color="#B07880"/>
    <SolidColorBrush x:Key="WineRedHoverBrush" Color="#C09098"/>
    <SolidColorBrush x:Key="WineRedPressedBrush" Color="#9C646C"/>
    <SolidColorBrush x:Key="TextOnWineRedBrush" Color="#281018"/>

    <SolidColorBrush x:Key="EspressoBrownBrush" Color="#A88070"/>
    <SolidColorBrush x:Key="EspressoBrownHoverBrush" Color="#BC9888"/>
    <SolidColorBrush x:Key="EspressoBrownPressedBrush" Color="#946C5C"/>
    <SolidColorBrush x:Key="TextOnEspressoBrownBrush" Color="#201410"/>

    <SolidColorBrush x:Key="AubergineBrush" Color="#987888"/>
    <SolidColorBrush x:Key="AubergineHoverBrush" Color="#AC909C"/>
    <SolidColorBrush x:Key="AuberginePressedBrush" Color="#846474"/>
    <SolidColorBrush x:Key="TextOnAubergineBrush" Color="#201420"/>

    <SolidColorBrush x:Key="BambooGreenBrush" Color="#7C9C68"/>
    <SolidColorBrush x:Key="BambooGreenHoverBrush" Color="#90B07C"/>
    <SolidColorBrush x:Key="BambooGreenPressedBrush" Color="#688854"/>
    <SolidColorBrush x:Key="TextOnBambooGreenBrush" Color="#141E0C"/>

</ResourceDictionary>
