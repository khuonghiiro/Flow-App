<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════════════════╗
    ║  LIGHT THEME — Pro Workflow Light  (Linear / Vercel inspired)       ║
    ║  Background: #F5F7FA  Surface: #FFFFFF  Depth: #EEF1F6             ║
    ║  Accent: #2563EB (Vivid Blue)  Canvas: #ECEEF3                     ║
    ╚══════════════════════════════════════════════════════════════════════╝
    -->

    <RadialGradientBrush x:Key="CardRadialBackground"
                     RadiusX="1" RadiusY="1"
                     Center="0.5,0.5"
                     GradientOrigin="0.5,0.5">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFF1F5F9" Offset="1"/>
    </RadialGradientBrush>

    <SolidColorBrush x:Key="BorderBrush"  Color="#FFD6DEE9"/>
    <SolidColorBrush x:Key="CardColor"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BorderColor"  Color="#FFC3CEDD"/>

    <!-- Header — white with subtle bottom border -->
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFBFCFE"/>

    <!-- Overlay -->
    <SolidColorBrush x:Key="OverlayBackground"        Color="#88FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBackgroundReverse" Color="#88000000"/>
    <SolidColorBrush x:Key="BackgroundAll"             Color="#FFF6F8FB"/>

    <!-- ===== PRIMARY — Vivid Blue ===== -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#2F6FEB"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#1F5FD7"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#184EB8"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush"  Color="#FFFFFF"/>

    <!-- ===== SECONDARY ===== -->
    <SolidColorBrush x:Key="SecondaryBrush"        Color="#5B677A"/>
    <SolidColorBrush x:Key="SecondaryHoverBrush"   Color="#4B5568"/>
    <SolidColorBrush x:Key="SecondaryPressedBrush" Color="#3F4858"/>
    <SolidColorBrush x:Key="TextOnSecondaryBrush"  Color="White"/>

    <!-- ===== SUCCESS ===== -->
    <SolidColorBrush x:Key="SuccessBrush"        Color="#0E9F6E"/>
    <SolidColorBrush x:Key="SuccessHoverBrush"   Color="#047857"/>
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="#036640"/>
    <SolidColorBrush x:Key="TextOnSuccessBrush"  Color="White"/>

    <!-- ===== DANGER ===== -->
    <SolidColorBrush x:Key="DangerBrush"        Color="#E11D48"/>
    <SolidColorBrush x:Key="DangerHoverBrush"   Color="#BE123C"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#9F1239"/>
    <SolidColorBrush x:Key="TextOnDangerBrush"  Color="White"/>

    <!-- ===== WARNING ===== -->
    <SolidColorBrush x:Key="WarningBrush"        Color="#B7791F"/>
    <SolidColorBrush x:Key="WarningHoverBrush"   Color="#975A16"/>
    <SolidColorBrush x:Key="WarningPressedBrush" Color="#7C4A12"/>
    <SolidColorBrush x:Key="TextOnWarningBrush"  Color="White"/>

    <!-- ===== INFO ===== -->
    <SolidColorBrush x:Key="InfoBrush"        Color="#0EA5E9"/>
    <SolidColorBrush x:Key="InfoHoverBrush"   Color="#0284C7"/>
    <SolidColorBrush x:Key="InfoPressedBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="TextOnInfoBrush"  Color="White"/>

    <!-- ===== LIGHT / DARK variants ===== -->
    <SolidColorBrush x:Key="LightBrush"        Color="#F6F8FB"/>
    <SolidColorBrush x:Key="LightHoverBrush"   Color="#F1F5F9"/>
    <SolidColorBrush x:Key="LightPressedBrush" Color="#E8EEF6"/>
    <SolidColorBrush x:Key="TextOnLightBrush"  Color="#111827"/>

    <SolidColorBrush x:Key="DarkBrush"        Color="#111827"/>
    <SolidColorBrush x:Key="DarkHoverBrush"   Color="#1F2937"/>
    <SolidColorBrush x:Key="DarkPressedBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="TextOnDarkBrush"  Color="White"/>

    <!-- ===== WINDOW BACKGROUNDS ===== -->
    <SolidColorBrush x:Key="WindowBodyBackground"  Color="#FFF6F8FB"/>
    <SolidColorBrush x:Key="WindowBackground"      Color="#FFF6F8FB"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF6F8FB"/>

    <!-- ===== TEXT ===== -->
    <SolidColorBrush x:Key="TextBrush"        Color="#FF111827"/>
    <SolidColorBrush x:Key="TextBrushReverse" Color="#FFF8FAFC"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="TransparentHoverBrush" Color="#26111827"/>
    <SolidColorBrush x:Key="TransparentPressedBrush" Color="#4D111827"/>
    <SolidColorBrush x:Key="TransparentFocusBrush" Color="#4D111827"/>
    <SolidColorBrush x:Key="TextOnTransparentBrush" Color="#FF111827"/>

    <!-- ===== INPUT BACKGROUNDS ===== -->
    <SolidColorBrush x:Key="TextBoxBackground"         Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush"        Color="#FFC7D2E0"/>
    <SolidColorBrush x:Key="TextBoxHoverBackground"    Color="#FFFAFBFD"/>
    <SolidColorBrush x:Key="TextBoxFocusBackground"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#FFEEF2F7"/>
    <SolidColorBrush x:Key="TextBoxReadOnlyBackground" Color="#FFF6F8FB"/>

    <!-- ===== BORDER COLORS ===== -->
    <SolidColorBrush x:Key="TextBoxHoverBorderBrush" Color="#FF94A3B8"/>
    <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#FF2F6FEB"/>

    <!-- ===== TEXT STATES ===== -->
    <SolidColorBrush x:Key="PlaceholderBrush"   Color="#FF7C8BA1"/>
    <SolidColorBrush x:Key="DisabledTextBrush"  Color="#FF94A3B8"/>
    <SolidColorBrush x:Key="DisabledBackground" Color="#FFEEF2F7"/>
    <SolidColorBrush x:Key="ReadOnlyTextBrush"  Color="#FF4B5563"/>

    <!-- ===== GLOW EFFECTS ===== -->
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="#1A2F6FEB"/>
    <SolidColorBrush x:Key="HoverGlowBrush"   Color="#102F6FEB"/>

    <!-- ===== READONLY ===== -->
    <SolidColorBrush x:Key="ReadOnlyBackground"  Color="#FFF6F8FB"/>
    <SolidColorBrush x:Key="ReadOnlyForeground"  Color="#FF4B5563"/>
    <SolidColorBrush x:Key="BorderInverseColor">#50344050</SolidColorBrush>
    <SolidColorBrush x:Key="ControlBorderColor">#FFD6DEE9</SolidColorBrush>
    <SolidColorBrush x:Key="ReadOnlyBorderBrush">#407C8BA1</SolidColorBrush>

    <!-- ===== BUTTON BRUSHES ===== -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFF2F5FA"/>
    <SolidColorBrush x:Key="ControlBackground"     Color="#FFF2F5FA"/>
    <SolidColorBrush x:Key="ButtonHoverBrush"      Color="#FFE8EEF6"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"    Color="#FFDDE6F2"/>
    <SolidColorBrush x:Key="ButtonBorderBrush"     Color="#FFC7D2E0"/>

    <!-- ===== SCROLLBAR ===== -->
    <Color x:Key="ScrollBarThumbColor">#882F6FEB</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#AA2F6FEB</Color>
    <Color x:Key="ScrollBarThumbPressedColor">#CC2F6FEB</Color>
    <Color x:Key="ScrollBarTrackColor">Transparent</Color>
    <SolidColorBrush x:Key="ScrollBarThumbBrush"        Color="{StaticResource ScrollBarThumbColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush"   Color="{StaticResource ScrollBarThumbHoverColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="{StaticResource ScrollBarThumbPressedColor}"/>
    <SolidColorBrush x:Key="ScrollBarTrackBackground"   Color="{StaticResource ScrollBarTrackColor}"/>

    <!-- ===== PROGRESS ===== -->
    <SolidColorBrush x:Key="ProgressBackground">#FFE8EEF6</SolidColorBrush>
    <SolidColorBrush x:Key="ProgressFill">#FF2F6FEB</SolidColorBrush>

    <!-- ===== SHADOW ===== -->
    <Color x:Key="ShadowColor">#22000000</Color>
    <Color x:Key="PopupShadowColor">#18000000</Color>
    <Color x:Key="PrimaryShadowColor">#14000000</Color>

    <!-- ===== RADIO OPTIONS ===== -->
    <SolidColorBrush x:Key="OptionHoverBrush"    Color="#FFEAF1FF"/>
    <SolidColorBrush x:Key="OptionSelectedBrush" Color="#FF2F6FEB"/>

    <!-- ===== MISC ===== -->
    <SolidColorBrush x:Key="TitleBackgroundBrush" Color="#FFFBFCFE"/>
    <SolidColorBrush x:Key="TextNoteBrush"        Color="#FF4B5563"/>

    <!-- ===== DATAGRID ===== -->
    <SolidColorBrush x:Key="DataGridHeaderBrush"          Color="#FF111827"/>
    <SolidColorBrush x:Key="DataGridRowBackground">#FFFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridAltRowBackground">#FFF8FAFC</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridHeaderBackground">#FFF1F5F9</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridBorderBrush">#FFD6DEE9</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridRowHoverBackground">#182F6FEB</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridSelectionBackground">#442F6FEB</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridSelectedCellBackground">#442F6FEB</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridSelectedTextBrush">#FFFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridHoverCellBackground" Color="#302F6FEB"/>

    <!-- ===== COMBOBOX ===== -->
    <SolidColorBrush x:Key="SelectionBrush"    Color="#FFEAF1FF"/>
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#FF1F5FD7"/>

    <SolidColorBrush x:Key="ComboBoxFieldBackground"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxFieldBorderBrush"            Color="#FFB8C4D6"/>
    <SolidColorBrush x:Key="ComboBoxFieldHoverBackground"        Color="#FFF8FAFC"/>
    <SolidColorBrush x:Key="ComboBoxFieldHoverBorderBrush"       Color="#FF8EA0B8"/>
    <SolidColorBrush x:Key="ComboBoxFieldFocusBackground"        Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxFieldFocusBorderBrush"       Color="#FF2F6FEB"/>
    <SolidColorBrush x:Key="ComboBoxPopupBackground"             Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ComboBoxPopupBorderBrush"            Color="#FFC7D2E0"/>
    <SolidColorBrush x:Key="ComboBoxGlyphBrush"                  Color="#FF334155"/>
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush"              Color="#FFEAF1FF"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush"           Color="#FFD9E7FF"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedHoverBrush"      Color="#FFC8DAFF"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedForegroundBrush" Color="#FF0B2F6A"/>

    <!-- ===== CARD ===== -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>

    <!-- ===== SEMANTIC ALIASES ===== -->
    <SolidColorBrush x:Key="PrimaryColor"    Color="#FF2F6FEB"/>
    <SolidColorBrush x:Key="PrimaryHover"    Color="#FF1F5FD7"/>
    <SolidColorBrush x:Key="SecondaryColor"  Color="#FF0E9F6E"/>
    <SolidColorBrush x:Key="AccentColor"     Color="#FF7C3AED"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="#FF7C3AED"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#FFF6F8FB"/>
    <SolidColorBrush x:Key="SurfaceColor"    Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextPrimary"     Color="#FF111827"/>
    <SolidColorBrush x:Key="TextSecondary"   Color="#FF374151"/>
    <SolidColorBrush x:Key="TextMuted"       Color="#FF4B5563"/>
    <SolidColorBrush x:Key="DangerColor"     Color="#FFE11D48"/>
    <SolidColorBrush x:Key="SuccessColor"    Color="#FF0E9F6E"/>
    <SolidColorBrush x:Key="WarningColor"    Color="#FFB7791F"/>

    <!-- ===== POPUP ===== -->
    <SolidColorBrush x:Key="PopupHoverBrush"         Color="#FFEEF4FF"/>
    <SolidColorBrush x:Key="PopupSelectedBackground" Color="Transparent"/>

    <!-- ===== LAVENDER (ComboBox selection highlight) ===== -->
    <SolidColorBrush x:Key="LavenderHoverBrush"   Color="#182F6FEB"/>
    <SolidColorBrush x:Key="LavenderPressedBrush" Color="#442F6FEB"/>
    <SolidColorBrush x:Key="TextOnLavenderBrush"  Color="#FF1F5FD7"/>


    <!-- ===== LISTVIEW HEADER ===== -->
    <SolidColorBrush x:Key="ListViewHeaderBrush" Color="#FF2F6FEB"/>
    <SolidColorBrush x:Key="ListViewItemBrush"   Color="#FF111827"/>
    <SolidColorBrush x:Key="HoverBackground"     Color="#FFEEF4FF"/>

    <!-- ===== CANVAS ===== -->
    <!-- Light canvas — clean dot-grid like Figma light mode -->
    <SolidColorBrush x:Key="CanvasBackgroundBrush"    Color="#FFEEF2F7"/>
    <SolidColorBrush x:Key="CanvasGridBrush"          Color="#B8B8C4D4"/>
    <SolidColorBrush x:Key="ExecutionTraceGuideBrush" Color="#A08EA0B6"/>
    <Color x:Key="NodeShadowColor">#1C000000</Color>

    <!-- ===== FOCUS & INTERACTION ===== -->
    <SolidColorBrush x:Key="FocusRingBrush"                Color="#382F6FEB"/>
    <SolidColorBrush x:Key="CardHoverBackground"           Color="#FFF1F5F9"/>
    <Color x:Key="ButtonShadowColor">#162F6FEB</Color>
    <SolidColorBrush x:Key="TabIndicatorBrush"             Color="#FF2F6FEB"/>
    <SolidColorBrush x:Key="ThemeSliderActiveBrush"        Color="#FF2F6FEB"/>
    <SolidColorBrush x:Key="ThemeTrackBackgroundBrush"     Color="#FFD6DEE9"/>
    <SolidColorBrush x:Key="DataGridHeaderHoverBackground" Color="#FFF1F5F9"/>
    <SolidColorBrush x:Key="MenuItemHoverBackgroundBrush"  Color="#FFF1F5F9"/>

    <!-- Toolbar / editor header — deep navy for contrast on light theme -->
    <SolidColorBrush x:Key="HeaderBackgroundMainBrush" Color="#FF162033"/>
    <!-- ===== COMMON PALETTE OVERRIDES ===== -->
    <SolidColorBrush x:Key="OceanBrush"        Color="#0284C7"/>
    <SolidColorBrush x:Key="OceanHoverBrush"   Color="#0174B0"/>
    <SolidColorBrush x:Key="OceanPressedBrush" Color="#016498"/>
    <SolidColorBrush x:Key="TextOnOceanBrush"  Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BrightPowerBrush"        Color="#E0185E"/>
    <SolidColorBrush x:Key="BrightPowerHoverBrush"   Color="#C81452"/>
    <SolidColorBrush x:Key="BrightPowerPressedBrush" Color="#B01046"/>
    <SolidColorBrush x:Key="TextOnBrightPowerBrush"  Color="#FFFFFF"/>

    <SolidColorBrush x:Key="MagentaBloomBrush"        Color="#B820C8"/>
    <SolidColorBrush x:Key="MagentaBloomHoverBrush"   Color="#A01CB0"/>
    <SolidColorBrush x:Key="MagentaBloomPressedBrush" Color="#881898"/>
    <SolidColorBrush x:Key="TextOnMagentaBloomBrush"  Color="#FFFFFF"/>

    <SolidColorBrush x:Key="NavyDeepBrush"        Color="#1E3A8A"/>
    <SolidColorBrush x:Key="NavyDeepHoverBrush"   Color="#1E40AF"/>
    <SolidColorBrush x:Key="NavyDeepPressedBrush" Color="#1E3070"/>
    <SolidColorBrush x:Key="TextOnNavyDeepBrush"  Color="White"/>

    <SolidColorBrush x:Key="MidnightBlueBrush"        Color="#1E3A8A"/>
    <SolidColorBrush x:Key="MidnightBlueHoverBrush"   Color="#1E40AF"/>
    <SolidColorBrush x:Key="MidnightBluePressedBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextOnMidnightBlueBrush"  Color="White"/>

    <SolidColorBrush x:Key="PrussianBlueBrush"        Color="#003153"/>
    <SolidColorBrush x:Key="PrussianBlueHoverBrush"   Color="#004266"/>
    <SolidColorBrush x:Key="PrussianBluePressedBrush" Color="#002040"/>
    <SolidColorBrush x:Key="TextOnPrussianBlueBrush"  Color="White"/>

    <SolidColorBrush x:Key="CharcoalDarkBrush"        Color="#1F2937"/>
    <SolidColorBrush x:Key="CharcoalDarkHoverBrush"   Color="#374151"/>
    <SolidColorBrush x:Key="CharcoalDarkPressedBrush" Color="#111827"/>
    <SolidColorBrush x:Key="TextOnCharcoalDarkBrush"  Color="White"/>

    <SolidColorBrush x:Key="GraphiteGrayBrush"        Color="#424242"/>
    <SolidColorBrush x:Key="GraphiteGrayHoverBrush"   Color="#5A5A5A"/>
    <SolidColorBrush x:Key="GraphiteGrayPressedBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="TextOnGraphiteGrayBrush"  Color="White"/>

    <SolidColorBrush x:Key="BerryPurpleBrush"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="BerryPurpleHoverBrush"   Color="#6D28D9"/>
    <SolidColorBrush x:Key="BerryPurplePressedBrush" Color="#5B21B6"/>
    <SolidColorBrush x:Key="TextOnBerryPurpleBrush"  Color="White"/>

    <SolidColorBrush x:Key="CobaltBlueBrush"        Color="#1D4ED8"/>
    <SolidColorBrush x:Key="CobaltBlueHoverBrush"   Color="#2563EB"/>
    <SolidColorBrush x:Key="CobaltBluePressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="TextOnCobaltBlueBrush"  Color="White"/>

    <SolidColorBrush x:Key="WineRedBrush"        Color="#722F37"/>
    <SolidColorBrush x:Key="WineRedHoverBrush"   Color="#8A3A44"/>
    <SolidColorBrush x:Key="WineRedPressedBrush" Color="#5A242A"/>
    <SolidColorBrush x:Key="TextOnWineRedBrush"  Color="White"/>

    <SolidColorBrush x:Key="EspressoBrownBrush"        Color="#5D4037"/>
    <SolidColorBrush x:Key="EspressoBrownHoverBrush"   Color="#6D4C41"/>
    <SolidColorBrush x:Key="EspressoBrownPressedBrush" Color="#4E342E"/>
    <SolidColorBrush x:Key="TextOnEspressoBrownBrush"  Color="White"/>

    <SolidColorBrush x:Key="AubergineBrush"        Color="#614051"/>
    <SolidColorBrush x:Key="AubergineHoverBrush"   Color="#755168"/>
    <SolidColorBrush x:Key="AuberginePressedBrush" Color="#4D323F"/>
    <SolidColorBrush x:Key="TextOnAubergineBrush"  Color="White"/>

    <SolidColorBrush x:Key="BambooGreenBrush"        Color="#3D7A4A"/>
    <SolidColorBrush x:Key="BambooGreenHoverBrush"   Color="#4A9058"/>
    <SolidColorBrush x:Key="BambooGreenPressedBrush" Color="#2E6038"/>
    <SolidColorBrush x:Key="TextOnBambooGreenBrush"  Color="White"/>

    <!-- ===== MISSING BRUSHES USED IN XAML ===== -->
    <SolidColorBrush x:Key="CharcoalMistBrush"        Color="#64748B"/>
    <SolidColorBrush x:Key="CharcoalMistHoverBrush"   Color="#556070"/>
    <SolidColorBrush x:Key="CharcoalMistPressedBrush" Color="#475260"/>
    <SolidColorBrush x:Key="TextOnCharcoalMistBrush"  Color="White"/>

    <SolidColorBrush x:Key="VioletHazeBrush"        Color="#7C3AED"/>
    <SolidColorBrush x:Key="VioletHazeHoverBrush"   Color="#6D28D9"/>
    <SolidColorBrush x:Key="VioletHazePressedBrush" Color="#5B21B6"/>
    <SolidColorBrush x:Key="TextOnVioletHazeBrush"  Color="White"/>

    <SolidColorBrush x:Key="CantaloupeOrangeBrush"        Color="#D97706"/>
    <SolidColorBrush x:Key="CantaloupeOrangeHoverBrush"   Color="#C06800"/>
    <SolidColorBrush x:Key="CantaloupeOrangePressedBrush" Color="#A85800"/>
    <SolidColorBrush x:Key="TextOnCantaloupeOrangeBrush"  Color="White"/>

    <SolidColorBrush x:Key="SeaFoamBrush"        Color="#0D9488"/>
    <SolidColorBrush x:Key="SeaFoamHoverBrush"   Color="#0F766E"/>
    <SolidColorBrush x:Key="SeaFoamPressedBrush" Color="#115E59"/>
    <SolidColorBrush x:Key="TextOnSeaFoamBrush"  Color="White"/>

</ResourceDictionary>
