<Window x:Class="FlowMy.Views.Overlays.LayerAiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FlowMy.Controls"
        Title="AI Layer Editor"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="920"
        Height="540">
    <Window.Resources>
        <!-- Reusable dark theme brush copies if global ones are not available -->
        <SolidColorBrush x:Key="DialogBg" Color="#111318"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2a2e3d"/>
        <SolidColorBrush x:Key="TextMain" Color="#dde3ef"/>
        <SolidColorBrush x:Key="TextMuted" Color="#788296"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4fffb0"/>

        <!-- Photoshop dark checkered brush for transparency -->
        <VisualBrush x:Key="PsDarkCheckeredBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="16" Height="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="8"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="8"/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#12141c"/>
                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#1b1e29"/>
                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#1b1e29"/>
                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#12141c"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- Photoshop light checkered brush for transparency -->
        <VisualBrush x:Key="PsCheckeredBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="16" Height="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="8"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="8"/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#cbcbcb"/>
                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#ffffff"/>
                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#ffffff"/>
                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#cbcbcb"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- Dynamic themed ComboBox Style for Dialog -->
        <Style x:Key="IpComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#1e222d"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,20,0"
                                              VerticalAlignment="Center"/>
                            <TextBlock Text="▾"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="10"/>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="#1e222d"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                        <Setter Property="Background" Value="#1e222d"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="FontSize" Value="9.5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="2"
                                            Margin="2,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#252a39"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#1a4fffb0"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Image Slot Style -->
        <Style x:Key="SecondaryImageBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#2a2e3d"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#15171e"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Border CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Background="{StaticResource DialogBg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="✨ AI LAYER EDITOR" Foreground="{StaticResource AccentColor}"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Margin="0,0,0,0" x:Name="BtnClose" Padding="0" Height="24" Width="24" Content="✕" FontSize="11" FontWeight="Bold"
                            Style="{DynamicResource DangerButton}" Cursor="Hand" Click="BtnClose_Click"/>
                </Grid>
            </Border>
            <!-- ===== MASTER CONTENT GRID (Globally accessible Tab Headers) ===== -->
            <Grid Grid.Row="1" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColLeft" Width="6*"/>
                    <ColumnDefinition x:Name="ColGap" Width="12"/>
                    <ColumnDefinition x:Name="ColRight" Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL (Column 0): Toggle Normal Layout vs Expanded Layout -->
                <Grid Grid.Column="0">
                    <!-- NORMAL LAYOUT LEFT: Preview (3*) and Secondary Images Grid (3*) -->
                    <Grid x:Name="GridLeftNormal" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Preview (Main Image) -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📸 ẢNH CHÍNH (Preview)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Grid.Row="1" BorderBrush="{StaticResource AccentColor}" BorderThickness="2" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <Rectangle Fill="{StaticResource PsCheckeredBrush}" SnapsToDevicePixels="True"/>
                                     <Image x:Name="ImgPreview" Stretch="Uniform" Margin="0" MouseEnter="ImgPreview_MouseEnter" MouseLeave="ImgPreview_MouseLeave"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Column 2: Secondary Images Grid (4 Slots) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🖼️ ẢNH PHỤ (tối đa 4)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Grid x:Name="SecondaryImagesGrid" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Slot 1 -->
                                <Border x:Name="SlotBorder0" Grid.Row="0" Grid.Column="0" Style="{StaticResource SecondaryImageBorder}" Focusable="True" KeyDown="SlotBorder_KeyDown"
                                        MouseEnter="Slot_MouseEnter" MouseLeave="Slot_MouseLeave" MouseLeftButtonDown="Slot_Click" Tag="0">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PsDarkCheckeredBrush}" SnapsToDevicePixels="True"/>
                                        <Image x:Name="SlotImage0" Stretch="Uniform" Margin="2"/>
                                        <TextBlock x:Name="SlotPlaceholder0" Text="＋" FontSize="24" Foreground="#3a3f52" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Border x:Name="SlotCheck0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#4fffb0" CornerRadius="0,0,6,0" Padding="4,2" Visibility="Collapsed">
                                            <TextBlock Text="✓" Foreground="#111318" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Border x:Name="SlotRemove0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#cc3333" CornerRadius="0,0,0,6" Padding="5,2" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="SlotRemove_Click" Tag="0">
                                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#aa111318" CornerRadius="0,4,0,0" Padding="5,2" IsHitTestVisible="False">
                                            <TextBlock Text="1" Foreground="#dde3ef" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Slot 2 -->
                                <Border x:Name="SlotBorder1" Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryImageBorder}" Focusable="True" KeyDown="SlotBorder_KeyDown"
                                        MouseEnter="Slot_MouseEnter" MouseLeave="Slot_MouseLeave" MouseLeftButtonDown="Slot_Click" Tag="1">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PsDarkCheckeredBrush}" SnapsToDevicePixels="True"/>
                                        <Image x:Name="SlotImage1" Stretch="Uniform" Margin="2"/>
                                        <TextBlock x:Name="SlotPlaceholder1" Text="＋" FontSize="24" Foreground="#3a3f52" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Border x:Name="SlotCheck1" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#4fffb0" CornerRadius="0,0,6,0" Padding="4,2" Visibility="Collapsed">
                                            <TextBlock Text="✓" Foreground="#111318" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Border x:Name="SlotRemove1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#cc3333" CornerRadius="0,0,0,6" Padding="5,2" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="SlotRemove_Click" Tag="1">
                                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#aa111318" CornerRadius="0,4,0,0" Padding="5,2" IsHitTestVisible="False">
                                            <TextBlock Text="2" Foreground="#dde3ef" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Slot 3 -->
                                <Border x:Name="SlotBorder2" Grid.Row="2" Grid.Column="0" Style="{StaticResource SecondaryImageBorder}" Focusable="True" KeyDown="SlotBorder_KeyDown"
                                        MouseEnter="Slot_MouseEnter" MouseLeave="Slot_MouseLeave" MouseLeftButtonDown="Slot_Click" Tag="2">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PsDarkCheckeredBrush}" SnapsToDevicePixels="True"/>
                                        <Image x:Name="SlotImage2" Stretch="Uniform" Margin="2"/>
                                        <TextBlock x:Name="SlotPlaceholder2" Text="＋" FontSize="24" Foreground="#3a3f52" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Border x:Name="SlotCheck2" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#4fffb0" CornerRadius="0,0,6,0" Padding="4,2" Visibility="Collapsed">
                                            <TextBlock Text="✓" Foreground="#111318" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Border x:Name="SlotRemove2" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#cc3333" CornerRadius="0,0,0,6" Padding="5,2" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="SlotRemove_Click" Tag="2">
                                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#aa111318" CornerRadius="0,4,0,0" Padding="5,2" IsHitTestVisible="False">
                                            <TextBlock Text="3" Foreground="#dde3ef" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Slot 4 -->
                                <Border x:Name="SlotBorder3" Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryImageBorder}" Focusable="True" KeyDown="SlotBorder_KeyDown"
                                        MouseEnter="Slot_MouseEnter" MouseLeave="Slot_MouseLeave" MouseLeftButtonDown="Slot_Click" Tag="3">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PsDarkCheckeredBrush}" SnapsToDevicePixels="True"/>
                                        <Image x:Name="SlotImage3" Stretch="Uniform" Margin="2"/>
                                        <TextBlock x:Name="SlotPlaceholder3" Text="＋" FontSize="24" Foreground="#3a3f52" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Border x:Name="SlotCheck3" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#4fffb0" CornerRadius="0,0,6,0" Padding="4,2" Visibility="Collapsed">
                                            <TextBlock Text="✓" Foreground="#111318" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <Border x:Name="SlotRemove3" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#cc3333" CornerRadius="0,0,0,6" Padding="5,2" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="SlotRemove_Click" Tag="3">
                                            <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#aa111318" CornerRadius="0,4,0,0" Padding="5,2" IsHitTestVisible="False">
                                            <TextBlock Text="4" Foreground="#dde3ef" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Add image button and send mode toggle -->
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnAddSecondary" Grid.Column="0" Content="＋ Thêm ảnh phụ" Height="28" Margin="0"
                                        Style="{DynamicResource SecondaryButton}" Cursor="Hand" FontSize="11" Click="BtnAddSecondary_Click"/>
                                <Button x:Name="BtnToggleSendMode" Grid.Column="2" Content="Gửi AI: ON" Width="90" Height="28" Margin="0"
                                        Style="{DynamicResource SuccessButton}" Cursor="Hand" FontSize="11" Click="BtnToggleSendMode_Click"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- EXPANDED LAYOUT LEFT: Compact vertically stacked images (Shared for Tab 2 & Tab 3) -->
                    <Grid x:Name="GridLeftExpanded" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Ảnh chính -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📸 Ảnh chính" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Border Grid.Row="1" BorderBrush="{StaticResource AccentColor}" BorderThickness="2" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <Rectangle Fill="{StaticResource PsCheckeredBrush}" SnapsToDevicePixels="True"/>
                                     <Image x:Name="ImgPreviewWv" Stretch="Uniform" Margin="0" MouseEnter="ImgPreview_MouseEnter" MouseLeave="ImgPreview_MouseLeave"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Row 2: Ảnh phụ (2x2 compact) -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🖼️ Ảnh phụ" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid x:Name="SecondaryImagesGridWv" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 4 compact slots -->
                                <Border x:Name="SlotBorderWv0" Grid.Row="0" Grid.Column="0" Style="{StaticResource SecondaryImageBorder}" Focusable="True" KeyDown="SlotBorder_KeyDown"
                                        MouseEnter="Slot_MouseEnter" MouseLeave="Slot_MouseLeave" MouseLeftButtonDown="Slot_Click" Tag="0">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PsDarkCheckeredBrush}" SnapsToDevicePixels="True"/>
                                        <Image x:Name="SlotImageWv0" Stretch="Uniform" Margin="1"/>
                                        <TextBlock x:Name="SlotPlaceholderWv0" Text="＋" FontSize="16" Foreground="#3a3f52" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Border x:Name="SlotRemoveWv0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#cc3333" CornerRadius="0,0,0,6" Padding="4,1" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="SlotRemove_Click" Tag="0">
                                            <TextBlock Text="✕" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#aa111318" CornerRadius="0,4,0,0" Padding="5,2" IsHitTestVisible="False">
                                            <TextBlock Text="1" Foreground="#dde3ef" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border x:Name="SlotBorderWv1" Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryImageBorder}" Focusable="True" KeyDown="SlotBorder_KeyDown"
                                        MouseEnter="Slot_MouseEnter" MouseLeave="Slot_MouseLeave" MouseLeftButtonDown="Slot_Click" Tag="1">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PsDarkCheckeredBrush}" SnapsToDevicePixels="True"/>
                                        <Image x:Name="SlotImageWv1" Stretch="Uniform" Margin="1"/>
                                        <TextBlock x:Name="SlotPlaceholderWv1" Text="＋" FontSize="16" Foreground="#3a3f52" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Border x:Name="SlotRemoveWv1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#cc3333" CornerRadius="0,0,0,6" Padding="4,1" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="SlotRemove_Click" Tag="1">
                                            <TextBlock Text="✕" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#aa111318" CornerRadius="0,4,0,0" Padding="5,2" IsHitTestVisible="False">
                                            <TextBlock Text="2" Foreground="#dde3ef" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border x:Name="SlotBorderWv2" Grid.Row="2" Grid.Column="0" Style="{StaticResource SecondaryImageBorder}" Focusable="True" KeyDown="SlotBorder_KeyDown"
                                        MouseEnter="Slot_MouseEnter" MouseLeave="Slot_MouseLeave" MouseLeftButtonDown="Slot_Click" Tag="2">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PsDarkCheckeredBrush}" SnapsToDevicePixels="True"/>
                                        <Image x:Name="SlotImageWv2" Stretch="Uniform" Margin="1"/>
                                        <TextBlock x:Name="SlotPlaceholderWv2" Text="＋" FontSize="16" Foreground="#3a3f52" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Border x:Name="SlotRemoveWv2" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#cc3333" CornerRadius="0,0,0,6" Padding="4,1" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="SlotRemove_Click" Tag="2">
                                            <TextBlock Text="✕" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#aa111318" CornerRadius="0,4,0,0" Padding="5,2" IsHitTestVisible="False">
                                            <TextBlock Text="3" Foreground="#dde3ef" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border x:Name="SlotBorderWv3" Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryImageBorder}" Focusable="True" KeyDown="SlotBorder_KeyDown"
                                        MouseEnter="Slot_MouseEnter" MouseLeave="Slot_MouseLeave" MouseLeftButtonDown="Slot_Click" Tag="3">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PsDarkCheckeredBrush}" SnapsToDevicePixels="True"/>
                                        <Image x:Name="SlotImageWv3" Stretch="Uniform" Margin="1"/>
                                        <TextBlock x:Name="SlotPlaceholderWv3" Text="＋" FontSize="16" Foreground="#3a3f52" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Border x:Name="SlotRemoveWv3" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#cc3333" CornerRadius="0,0,0,6" Padding="4,1" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="SlotRemove_Click" Tag="3">
                                            <TextBlock Text="✕" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#aa111318" CornerRadius="0,4,0,0" Padding="5,2" IsHitTestVisible="False">
                                            <TextBlock Text="4" Foreground="#dde3ef" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Row 3: Buttons -->
                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAddSecondaryExpanded" Grid.Column="0" Content="＋ Thêm ảnh phụ" Height="28" Margin="0"
                                    Style="{DynamicResource SecondaryButton}" Cursor="Hand" FontSize="11" Click="BtnAddSecondary_Click"/>
                            <Button x:Name="BtnToggleSendModeExpanded" Grid.Column="2" Content="Gửi AI: ON" Width="90" Height="28" Margin="0"
                                    Style="{DynamicResource SuccessButton}" Cursor="Hand" FontSize="11" Click="BtnToggleSendMode_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- RIGHT PANEL (Column 2): Always visible, contains Tab Headers + active tab's content -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Globally-visible Tab Headers stack panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <Border x:Name="TabHeaderPrompt" Background="#1a4fffb0" BorderBrush="{StaticResource AccentColor}" BorderThickness="1"
                                CornerRadius="4,4,0,0" Padding="10,4" Cursor="Hand" MouseLeftButtonDown="TabPrompt_Click">
                            <TextBlock Text="💬 Prompt" Foreground="{StaticResource AccentColor}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="TabHeaderWebView" Background="Transparent" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" Padding="10,4" Cursor="Hand" Margin="4,0,0,0" MouseLeftButtonDown="TabWebView_Click">
                            <TextBlock x:Name="TabHeaderWebViewText" Text="🌐 UI động" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="TabHeaderWebBrowser" Background="Transparent" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" Padding="10,4" Cursor="Hand" Margin="4,0,0,0" MouseLeftButtonDown="TabWebBrowser_Click">
                            <TextBlock x:Name="TabHeaderWebBrowserText" Text="🌍 Web" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Active tab's content area (Row 1) -->
                    <Grid Grid.Row="1">
                        <!-- Tab 1 content: Prompt (TextBox) -->
                        <Grid x:Name="TabContentPrompt" Visibility="Visible">
                            <Border Background="#1a1c23" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <TextBox x:Name="TxtPrompt" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"
                                             Padding="8,8,38,8" FontSize="11" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" CaretBrush="{StaticResource AccentColor}" TextChanged="TxtPrompt_TextChanged"/>
                                    <Button x:Name="BtnSend" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Cursor="Hand" Click="BtnSend_Click" IsEnabled="False">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#4fffb0"/>
                                                <Setter Property="Foreground" Value="#111318"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#62ffc0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#3ad494"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#2a2e3d"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Data="M 3 2 L 13 8 L 3 14 Z" Fill="#111318" Width="10" Height="10" Stretch="Uniform" Margin="2,0,0,0"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Tab 2 content: WebView2 (UI động layout) -->
                        <Grid x:Name="TabContentWebView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#1a1c23" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#0d0f14" CornerRadius="0,0,6,0" Padding="8,4" Opacity="0.85">
                                        <TextBlock Text="🌐 UI động" Foreground="{StaticResource AccentColor}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <Border x:Name="WebViewContainer" CornerRadius="4" ClipToBounds="True" Margin="0,24,0,0">
                                        <TextBlock Text="🌐 UI động sẽ được render ở đây&#x0a;(Cấu hình trong tab 'Layer AI'&#x0a;của dialog Xử lý ảnh)"
                                                   Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="20"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="💬 Prompt gợi ý" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Border Grid.Row="1" Background="#1a1c23" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <TextBox x:Name="TxtPromptWv" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"
                                                 Padding="8,8,38,8" FontSize="11" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" CaretBrush="{StaticResource AccentColor}" TextChanged="TxtPrompt_TextChanged"/>
                                        <Button x:Name="BtnSendWv" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Cursor="Hand" Click="BtnSend_Click" IsEnabled="False">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#4fffb0"/>
                                                    <Setter Property="Foreground" Value="#111318"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#62ffc0"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#3ad494"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#2a2e3d"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="M 3 2 L 13 8 L 3 14 Z" Fill="#111318" Width="10" Height="10" Stretch="Uniform" Margin="2,0,0,0"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Tab 3 content: Web Browser -->
                        <Grid x:Name="TabContentWebBrowser" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Web Tab Bar (Chrome style) -->
                                <RowDefinition Height="Auto"/> <!-- Row 1: Address/Navigation Bar -->
                                <RowDefinition Height="4*"/>   <!-- Row 2: WebView2 Container (Single or splits) -->
                                <RowDefinition Height="8"/>    <!-- Row 3: Gap -->
                                <RowDefinition Height="1*"/>   <!-- Row 4: Compact Prompt -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: Web Tab Bar (Chrome Style) -->
                            <Grid Grid.Row="0" Margin="0,0,0,6" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tabs List -->
                                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                                    <StackPanel x:Name="WebTabStripStackPanel" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <!-- Tabs dynamically loaded in C# -->
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Right side: Split screen layout controls -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="Chia màn hình:" Foreground="{StaticResource TextMuted}" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    
                                    <!-- Single Layout Button -->
                                    <Button x:Name="BtnSplitSingle" Width="26" Height="22" Margin="1,0" Padding="0" ToolTip="Trang đơn" Style="{DynamicResource SecondaryButton}" Click="BtnSplitSingle_Click">
                                        <Border BorderBrush="{StaticResource TextOnSecondaryBrush}" BorderThickness="1.5" Width="12" Height="10" CornerRadius="1"/>
                                    </Button>
                                    
                                    <!-- Vertical Split Button -->
                                    <Button x:Name="BtnSplitVertical" Width="26" Height="22" Margin="1,0" Padding="0" ToolTip="Chia 2 cột dọc" Style="{DynamicResource SecondaryButton}" Click="BtnSplitVertical_Click">
                                        <Grid Width="12" Height="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource TextOnSecondaryBrush}" BorderThickness="1.5,1.5,0.7,1.5"/>
                                            <Border Grid.Column="2" BorderBrush="{StaticResource TextOnSecondaryBrush}" BorderThickness="0.7,1.5,1.5,1.5"/>
                                        </Grid>
                                    </Button>
                                    
                                    <!-- Horizontal Split Button -->
                                    <Button x:Name="BtnSplitHorizontal" Visibility="Collapsed" Width="26" Height="22" Margin="1,0" Padding="0" ToolTip="Chia 2 hàng ngang" Style="{DynamicResource SecondaryButton}" Click="BtnSplitHorizontal_Click">
                                        <Grid Width="12" Height="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="1"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderBrush="{StaticResource TextMuted}" BorderThickness="1.5,1.5,1.5,0.7"/>
                                            <Border Grid.Row="2" BorderBrush="{StaticResource TextMuted}" BorderThickness="1.5,0.7,1.5,1.5"/>
                                        </Grid>
                                    </Button>
                                    
                                    <!-- Grid/Corner Split Button -->
                                    <Button x:Name="BtnSplitGrid" Width="26" Height="22" Margin="1,0" Padding="0" ToolTip="Chia 4 góc" Style="{DynamicResource SecondaryButton}" Click="BtnSplitGrid_Click">
                                        <Grid Width="12" Height="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource TextOnSecondaryBrush}" BorderThickness="1.5,1.5,0.7,0.7"/>
                                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource TextOnSecondaryBrush}" BorderThickness="0.7,1.5,1.5,0.7"/>
                                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource TextOnSecondaryBrush}" BorderThickness="1.5,0.7,0.7,1.5"/>
                                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource TextOnSecondaryBrush}" BorderThickness="0.7,0.7,1.5,1.5"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>
 
                            <!-- Row 1: Address/Navigation Bar -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Back -->
                                    <ColumnDefinition Width="Auto"/> <!-- Forward -->
                                    <ColumnDefinition Width="Auto"/> <!-- Refresh -->
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Profile Combo -->
                                    <ColumnDefinition Width="Auto"/> <!-- New Profile -->
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>    <!-- URL bar -->
                                    <ColumnDefinition Width="Auto"/> <!-- Go -->
                                </Grid.ColumnDefinitions>
 
                                <!-- Navigation buttons -->
                                <Button x:Name="BtnWebBack" Grid.Column="0" Content="◀" Width="26" Height="28" Padding="0" ToolTip="Quay lại" Style="{DynamicResource SecondaryButton}" Cursor="Hand" Click="BtnWebBack_Click"/>
                                <Button x:Name="BtnWebForward" Grid.Column="1" Content="▶" Width="26" Height="28" Padding="0" Margin="3,0,0,0" ToolTip="Tiến lên" Style="{DynamicResource SecondaryButton}" Cursor="Hand" Click="BtnWebForward_Click"/>
                                <Button x:Name="BtnWebRefresh" Grid.Column="2" Content="↻" Width="26" Height="28" Padding="0" Margin="3,0,0,0" ToolTip="Tải lại trang" Style="{DynamicResource SecondaryButton}" Cursor="Hand" Click="BtnWebRefresh_Click"/>

                                <!-- Profile ComboBox -->
                                <ComboBox x:Name="CmbWebProfile" Grid.Column="4" Width="110" Height="28"
                                          Style="{StaticResource IpComboBoxStyle}" FontSize="10" ToolTip="Chọn profile trình duyệt"
                                          SelectionChanged="CmbWebProfile_SelectionChanged"/>

                                <!-- New Profile button -->
                                <Button x:Name="BtnNewProfile" Grid.Column="5" Content="＋" Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                                        FontSize="14" FontWeight="Bold" ToolTip="Tạo profile mới"
                                        Style="{DynamicResource SecondaryButton}" Cursor="Hand" Click="BtnNewProfile_Click"/>

                                <!-- URL / Search TextBox -->
                                <Border Grid.Column="7" Background="#1e222d" BorderBrush="#2a2e3d" BorderThickness="1.2" CornerRadius="6" Padding="0">
                                    <Grid>
                                        <TextBox x:Name="TxtWebUrl" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"
                                                 Padding="8,4,30,4" FontSize="11" VerticalContentAlignment="Center" CaretBrush="{StaticResource AccentColor}"
                                                 SelectionBrush="#804fffb0" Text="https://google.com" KeyDown="TxtWebUrl_KeyDown" GotFocus="TxtWebUrl_GotFocus"/>
                                        
                                        <!-- Inline Loading Indicator in URL bar -->
                                        <Border x:Name="UrlLoadingIndicator" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center">
                                            <Ellipse Stroke="{StaticResource AccentColor}" StrokeThickness="2" StrokeDashArray="3,1" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform x:Name="UrlSpinnerRotate"/>
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="UrlSpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Go / Navigate button -->
                                <Button x:Name="BtnWebGo" Grid.Column="8" Content="→" Padding="0" Width="28" Height="28" Margin="4,0,0,0"
                                        FontSize="14" FontWeight="Bold" ToolTip="Điều hướng" Style="{DynamicResource SuccessButton}"
                                        Cursor="Hand" Click="BtnWebGo_Click"/>
                            </Grid>

                            <!-- Row 2: WebView2 Browser container -->
                            <Border Grid.Row="2" Background="#1a1c23" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                <Grid x:Name="WebBrowserContainer">
                                    <TextBlock Text="🌍 Nhấn Enter hoặc → để mở trang web&#x0a;Gõ URL hoặc từ khóa tìm kiếm ở thanh trên"
                                               Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="20"/>
                                </Grid>
                            </Border>

                            <!-- Compact Prompt -->
                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="💬 Prompt gợi ý" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Border Grid.Row="1" Background="#1a1c23" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <TextBox x:Name="TxtPromptWeb" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"
                                                 Padding="8,8,38,8" FontSize="11" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" CaretBrush="{StaticResource AccentColor}" TextChanged="TxtPrompt_TextChanged"/>
                                        <Button x:Name="BtnSendWeb" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Cursor="Hand" Click="BtnSend_Click" IsEnabled="False">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#4fffb0"/>
                                                    <Setter Property="Foreground" Value="#111318"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#62ffc0"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#3ad494"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#2a2e3d"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="M 3 2 L 13 8 L 3 14 Z" Fill="#111318" Width="10" Height="10" Stretch="Uniform" Margin="2,0,0,0"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- CONTENT ROW 2: CONFIG & ACTIONS -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,12" Background="#0e1014" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Configurations (Left) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Batch size -->
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Số lượng ảnh" Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbBatchSize" Width="80" Height="28" Style="{StaticResource IpComboBoxStyle}" SelectedIndex="1">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                             </ComboBox>
                        </StackPanel>

                        <!-- Aspect ratio -->
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Tỉ lệ khung hình" Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbAspectRatio" Width="130" Height="28" Style="{StaticResource IpComboBoxStyle}" SelectedIndex="3" SelectionChanged="CmbAspectRatio_SelectionChanged">
                                <ComboBoxItem Content="Tỉ lệ mặc định"/>
                                <ComboBoxItem Content="16:9"/>
                                <ComboBoxItem Content="4:3"/>
                                <ComboBoxItem Content="1:1"/>
                                <ComboBoxItem Content="3:4"/>
                                <ComboBoxItem Content="9:16"/>
                                <ComboBoxItem Content="Tỉ lệ tự do"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Custom width/height (only visible for Free aspect ratio) -->
                        <StackPanel x:Name="PanelCustomSize" Orientation="Horizontal" Visibility="Collapsed">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Rộng (px)" Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCustomWidth" Width="60" Height="28" Padding="6,0" VerticalContentAlignment="Center" Text="512" TextChanged="TxtCustomSize_TextChanged"
                                         Background="#1e222d" Foreground="#dde3ef" BorderBrush="#2a2e3d" BorderThickness="1.2" CaretBrush="#4fffb0" SelectionBrush="#804fffb0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Cao (px)" Foreground="{StaticResource TextMuted}" FontSize="9.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCustomHeight" Width="60" Height="28" Padding="6,0" VerticalContentAlignment="Center" Text="512" TextChanged="TxtCustomSize_TextChanged"
                                         Background="#1e222d" Foreground="#dde3ef" BorderBrush="#2a2e3d" BorderThickness="1.2" CaretBrush="#4fffb0" SelectionBrush="#804fffb0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Secondary images count badge -->
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSecondaryInfo" Text="" Foreground="{StaticResource AccentColor}" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Buttons (Right) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="BtnCancel" Content="Huỷ" Style="{DynamicResource DangerButton}" Width="80" Height="30" Margin="0" Cursor="Hand" Click="BtnCancel_Click"/>
                        <Button x:Name="BtnApply" Content="Áp dụng" Style="{DynamicResource SuccessButton}" Width="90" Height="30" Margin="0" Cursor="Hand" Click="BtnApply_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
