<local:BaseNodeDialog x:Class="FlowMy.Views.Overlays.ActionCanVasNodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FlowMy.Controls"
    xmlns:local="clr-namespace:FlowMy.Views.Overlays"
    xmlns:converters="clr-namespace:FlowMy.Converters"
    Title="Thao tác canvas"
    WindowStyle="None" ResizeMode="CanResize"
    AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" Topmost="True"
    Width="520" MinWidth="420" MinHeight="420">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>

    <Border CornerRadius="12" Padding="0" Style="{DynamicResource DialogOuterBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Style="{DynamicResource DialogHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleTextBox" Grid.Column="0"
                             Text="{Binding NodeTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BaseTextBoxV2}" FontSize="16"
                             Padding="0,4" VerticalContentAlignment="Center" Cursor="IBeam"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="24" Height="24" Content="▶" FontSize="12" Padding="0" Margin="8,0,0,0"
                                Style="{DynamicResource PrimaryButton}" Cursor="Hand" ToolTip="Chạy logic node này"
                                Command="{Binding RunSingleNodeCommand}"/>
                        <Button x:Name="CloseButton" Width="24" Height="24" Padding="0" Content="✕" FontSize="12"
                                FontWeight="Bold" Margin="8,0,0,0" Cursor="Hand"
                                Style="{DynamicResource DangerButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0">

                <!-- TAB: LOGIC -->
                <TabItem Header="Logic" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- 🎯 Danh sách thao tác -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎯 Danh sách thao tác" Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <Button Height="36" Content="🔴 Ghi thao tác mới" 
                                            Style="{DynamicResource DangerButton}" Cursor="Hand"
                                            Click="RecordNewAction_Click" Margin="0,0,0,10"/>

                                    <!-- Danh sách các thao tác đã ghi -->
                                    <ItemsControl ItemsSource="{Binding MacroActions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardColor}"
                                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <!-- Row 1: Name + Buttons -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- ✅ Default indicator -->
                                                            <TextBlock Grid.Column="0" Text="✅" FontSize="14" 
                                                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                                                       Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            
                                                            <!-- Editable name -->
                                                            <TextBox Grid.Column="1" Height="28" 
                                                                     Style="{DynamicResource BaseTextBoxV2}"
                                                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     VerticalContentAlignment="Center" FontSize="11"/>
                                                            
                                                            <!-- Action buttons -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                                                <!-- Chọn (khi 1 route) -->
                                                                <Button Content="⭐" Width="28" Height="28" FontSize="12" Padding="0"
                                                                        Style="{DynamicResource SecondaryButton}" Cursor="Hand"
                                                                        ToolTip="Chọn làm thao tác gốc"
                                                                        Visibility="{Binding DataContext.HasSingleRoute, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Command="{Binding DataContext.SetDefaultMacroActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                                                <!-- Kết nối (khi ≥2 routes) -->
                                                                <Button Content="🔗" Width="28" Height="28" FontSize="12" Padding="0"
                                                                        Style="{DynamicResource PrimaryButton}" Cursor="Hand"
                                                                        ToolTip="Kết nối với luồng flow (chuyển sang tab Cấu hình)"
                                                                        Visibility="{Binding DataContext.HasMultipleRoutes, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Command="{Binding DataContext.ConnectMacroActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                                                <!-- Sửa (ghi lại) -->
                                                                <Button Content="✏️" Width="28" Height="28" FontSize="12" Padding="0"
                                                                        Style="{DynamicResource SecondaryButton}" Cursor="Hand"
                                                                        ToolTip="Ghi lại thao tác"
                                                                        Click="EditMacroAction_Click" Tag="{Binding}" Margin="0,0,4,0"/>
                                                                <!-- Xoá -->
                                                                <Button Content="🗑️" Width="28" Height="28" FontSize="12" Padding="0"
                                                                        Style="{DynamicResource DangerButton}" Cursor="Hand"
                                                                        ToolTip="Xoá thao tác"
                                                                        Command="{Binding DataContext.DeleteMacroActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row 2: Speed Override Settings -->
                                                        <Border Margin="0,8,0,0" Padding="8" CornerRadius="4"
                                                                Background="{DynamicResource WindowBackground}"
                                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                                            <StackPanel>
                                                                <TextBlock Text="⏱️ Tuỳ chỉnh tốc độ (ms, -1 = giữ gốc)" 
                                                                           Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,6"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="6"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" IsEnabled="{Binding IsMouseMoveDelayEnabled}">
                                                                        <TextBlock Text="Di chuột" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,2"/>
                                                                        <TextBox Height="24" Style="{DynamicResource BaseTextBoxV2}" FontSize="10"
                                                                                 Text="{Binding MouseMoveDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" IsEnabled="{Binding IsKeyPressDelayEnabled}">
                                                                        <TextBlock Text="Nhấn phím" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,2"/>
                                                                        <TextBox Height="24" Style="{DynamicResource BaseTextBoxV2}" FontSize="10"
                                                                                 Text="{Binding KeyPressDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="4" IsEnabled="{Binding IsMouseClickDelayEnabled}">
                                                                        <TextBlock Text="Click chuột" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,2"/>
                                                                        <TextBox Height="24" Style="{DynamicResource BaseTextBoxV2}" FontSize="10"
                                                                                 Text="{Binding MouseClickDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="6" IsEnabled="{Binding IsMouseScrollDelayEnabled}">
                                                                        <TextBlock Text="Scroll" Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,0,0,2"/>
                                                                        <TextBox Height="24" Style="{DynamicResource BaseTextBoxV2}" FontSize="10"
                                                                                 Text="{Binding MouseScrollDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <!-- ⏭️ Bỏ qua thao tác -->
                                                                <TextBlock Text="⏭️ Bỏ qua thao tác (không thực thi)" 
                                                                           Foreground="{DynamicResource TextMuted}" FontSize="9" Margin="0,6,0,4"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0" Content="Di chuột" FontSize="9"
                                                                              Foreground="{DynamicResource TextMuted}"
                                                                              IsChecked="{Binding SkipMouseMove, Mode=TwoWay}"
                                                                              ToolTip="Bỏ qua toàn bộ sự kiện di chuột khi phát lại"/>
                                                                    <CheckBox Grid.Column="1" Content="Nhấn phím" FontSize="9"
                                                                              Foreground="{DynamicResource TextMuted}"
                                                                              IsChecked="{Binding SkipKeyPress, Mode=TwoWay}"
                                                                              ToolTip="Bỏ qua toàn bộ sự kiện nhấn phím khi phát lại"/>
                                                                    <CheckBox Grid.Column="2" Content="Click chuột" FontSize="9"
                                                                              Foreground="{DynamicResource TextMuted}"
                                                                              IsChecked="{Binding SkipMouseClick, Mode=TwoWay}"
                                                                              ToolTip="Bỏ qua toàn bộ sự kiện click chuột khi phát lại"/>
                                                                    <CheckBox Grid.Column="3" Content="Scroll" FontSize="9"
                                                                              Foreground="{DynamicResource TextMuted}"
                                                                              IsChecked="{Binding SkipMouseScroll, Mode=TwoWay}"
                                                                              ToolTip="Bỏ qua toàn bộ sự kiện cuộn chuột khi phát lại"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="32" Content="⬇️ Import JSON" 
                                                Style="{DynamicResource SecondaryButton}" Cursor="Hand"
                                                Click="ImportJsonButton_Click"/>
                                        <Button Grid.Column="2" Height="32" Content="⬆️ Export JSON" 
                                                Style="{DynamicResource SecondaryButton}" Cursor="Hand"
                                                Click="ExportJsonButton_Click" IsEnabled="{Binding CanExportJson}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ⚙️ Cấu hình phát lại -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="⚙️ Cấu hình phát lại" Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Chế độ phát lại" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                      ItemsSource="{Binding PlaybackModeOptions}"
                                                      SelectedValue="{Binding SelectedPlaybackMode, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Đếm ngược (giây)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="32" Style="{DynamicResource BaseTextBoxV2}"
                                                     Text="{Binding CountdownSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8" Visibility="{Binding IsRepeatVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Số lần lặp" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="32" Style="{DynamicResource BaseTextBoxV2}"
                                                     Text="{Binding RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Delay mỗi vòng (ms)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="32" Style="{DynamicResource BaseTextBoxV2}"
                                                     Text="{Binding RepeatIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Hiển thị thao tác khi chạy" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                        <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding VisualPlaybackModeOptions}"
                                                  SelectedValue="{Binding SelectedVisualPlaybackMode, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Outputs" Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Style="{DynamicResource DialogOuterBorder}" CornerRadius="8" Padding="10">
                                <StackPanel x:Name="OutputsPanel"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB: HIỂN THỊ / BORDER -->
                <TabItem Header="Vùng hiển thị" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Kích thước Vùng thao tác" Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Chiều rộng (px)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="32" Style="{DynamicResource BaseTextBoxV2}"
                                                     Text="{Binding BodyWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Chiều cao (px)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Height="32" Style="{DynamicResource BaseTextBoxV2}"
                                                     Text="{Binding BodyHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 🎨 Màu nền body -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎨 Màu nền body"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="BodyBackgroundColorComboBox"
                                                  Grid.Column="0"
                                                  Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding BodyColorOptions}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValue="{Binding BodyBackgroundColorKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1"
                                                Content="🎨"
                                                Width="32"
                                                Height="32"
                                                Padding ="0"
                                                Margin="8,0,0,0"
                                                ToolTip="Chọn màu tuỳ ý"
                                                Click="PickBodyBackgroundColor_Click"/>
                                    </Grid>
                                    <Border x:Name="BodyBackgroundColorPreview"
                                            Height="18"
                                            CornerRadius="4"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- 🖼️ Màu viền body -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🖼️ Màu viền body"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="BodyBorderColorComboBox"
                                                  Grid.Column="0"
                                                  Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding BodyColorOptions}"
                                                  SelectedValuePath="Key"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValue="{Binding BodyBorderColorKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1"
                                                Content="🎨"
                                                Width="32"
                                                Height="32"
                                                Padding ="0"
                                                Margin="8,0,0,0"
                                                ToolTip="Chọn màu tuỳ ý"
                                                Click="PickBodyBorderColor_Click"/>
                                    </Grid>
                                    <Border x:Name="BodyBorderColorPreview"
                                            Height="18"
                                            CornerRadius="4"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- 🔗 Dùng cùng màu -->
                            <CheckBox x:Name="UseUnifiedColorsCheckBox"
                                      Content="Dùng cùng một màu cho nền và viền"
                                      IsChecked="{Binding UseUnifiedColors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="{DynamicResource TextBrush}"
                                      FontSize="11"
                                      Margin="0,0,0,12"/>

                            <!-- 💧 Độ trong suốt nền -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="💧 Độ trong suốt nền (%)"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BackgroundOpacitySlider"
                                                Grid.Column="0"
                                                Minimum="0" Maximum="100"
                                                Value="{Binding BackgroundOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="False"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="10"
                                                   Text="{Binding BackgroundOpacityPercent, StringFormat='{}{0:F0}%'}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 💧 Độ trong suốt viền -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="💧 Độ trong suốt viền (%)"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BorderOpacitySlider"
                                                Grid.Column="0"
                                                Minimum="0" Maximum="100"
                                                Value="{Binding BorderOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="False"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="10"
                                                   Text="{Binding BorderOpacityPercent, StringFormat='{}{0:F0}%'}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 📏 Độ dày viền -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📏 Độ dày viền"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BorderThicknessSlider"
                                                Grid.Column="0"
                                                Minimum="0.5" Maximum="10"
                                                Value="{Binding BorderThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="False"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="10"
                                                   Text="{Binding BorderThickness, StringFormat='{}{0:F1}px'}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 📐 Khoảng cách nét đứt -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📐 Khoảng cách nét đứt"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BorderDashSpacingSlider"
                                                Grid.Column="0"
                                                Minimum="0" Maximum="20"
                                                Value="{Binding BorderDashSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="False"/>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="10"
                                                   Text="{Binding BorderDashSpacing, StringFormat='{}{0:F0}px'}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 🎨 Dạng nét đứt -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎨 Dạng nét viền"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <ComboBox Height="32"
                                              Style="{DynamicResource BaseComboBox}"
                                              ItemsSource="{Binding BorderDashStyleOptions}"
                                              SelectedValuePath="Style"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValue="{Binding BorderDashStyle, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB: BORDER HIGHLIGHT -->
                <TabItem Header="Border Highlight" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- 🎨 Preview -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12"
                                    HorizontalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="Preview" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                    <Grid Width="200" Height="100">
                                        <!-- Giả lập Window hoặc Desktop -->
                                        <Border Background="#1E1E1E" CornerRadius="4" BorderBrush="#333" BorderThickness="1"/>
                                        <TextBlock Text="FlowMy" Foreground="#888" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                                        
                                        <!-- Effect Preview Border -->
                                        <Border x:Name="EffectPreview" 
                                                BorderThickness="{Binding PlaybackBorderThickness}" 
                                                CornerRadius="4"
                                                Opacity="{Binding PlaybackOpacity}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ⚙️ Cấu hình hiển thị -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="⚙️ Cấu hình hiển thị" Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Màu viền" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Height="32" Style="{DynamicResource BaseTextBoxV2}"
                                                         Text="{Binding PlaybackBorderColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Column="1" Content="🎨" Width="32" Height="32" Padding="0" Margin="4,0,0,0"
                                                        ToolTip="Chọn màu tuỳ ý" Click="PlaybackBorderColorPickerButton_Click"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Hiệu ứng" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                      ItemsSource="{Binding EffectTypeOptions}"
                                                      SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                                                      SelectedValue="{Binding PlaybackEffectType, Mode=TwoWay}"
                                                      SelectionChanged="PlaybackEffectTypeComboBox_SelectionChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Độ dày viền (px)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="1" Maximum="10" Value="{Binding PlaybackBorderThickness, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="10" Text="{Binding PlaybackBorderThickness, StringFormat={}{0} px}"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Gradient vào trong (px)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="5" Maximum="50" Value="{Binding PlaybackGradientSize, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="10" Text="{Binding PlaybackGradientSize, StringFormat={}{0} px}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Độ trong suốt (0.1 - 1.0)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0.1" Maximum="1.0" Value="{Binding PlaybackOpacity, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="10" Text="{Binding PlaybackOpacity, StringFormat={}{0:F1}}"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB: CẤU HÌNH CƠ BẢN -->
                <TabItem Header="Cấu hình cơ bản" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Màu tiêu đề" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="TitleColorComboBox" Grid.Column="0" Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding TitleColorOptions}"
                                                  SelectedValuePath="Key" DisplayMemberPath="DisplayName"
                                                  SelectedValue="{Binding TitleColorKey, Mode=TwoWay}"
                                                  SelectionChanged="TitleColorComboBox_SelectionChanged"/>
                                        <Border x:Name="TitleColorPreview" Grid.Column="1"
                                                Width="32" Height="32" CornerRadius="6" Margin="8,0,0,0"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Vị trí cổng IN/OUT" Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Port IN" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                              ItemsSource="{Binding PortPositionOptions}"
                                              SelectedItem="{Binding InputPortPosition, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Port OUT" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                              ItemsSource="{Binding PortPositionOptions}"
                                              SelectedItem="{Binding OutputPortPosition, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Tái sử dụng flow" Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding ReuseRoutes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Background="{DynamicResource WindowBackground}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Node IN" Foreground="{DynamicResource TextBrush}"
                                                               FontSize="10" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding IncomingNodeTitle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Node OUT" Foreground="{DynamicResource TextBrush}"
                                                               FontSize="10" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <controls:NodeSearchComboBoxUserControl Height="32"
                                                              ItemsSource="{Binding OutgoingOptions}"
                                                              SelectedValuePath="NodeId" DisplayMemberPath="Title"
                                                              SelectedValue="{Binding SelectedOutgoingNodeId, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock Text="Kiểu line OUT" Foreground="{DynamicResource TextBrush}"
                                                               FontSize="10" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                              ItemsSource="{Binding DataContext.ConnectionLineStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Key" DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding SelectedLineStyleKey, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                                    <TextBlock Text="Thao tác chạy" Foreground="{DynamicResource TextBrush}"
                                                               FontSize="10" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                              ItemsSource="{Binding DataContext.MacroActions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Id" DisplayMemberPath="Name"
                                                              SelectedValue="{Binding SelectedMacroActionId, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</local:BaseNodeDialog>
