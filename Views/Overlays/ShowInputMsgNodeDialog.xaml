<local:BaseNodeDialog x:Class="FlowMy.Views.Overlays.ShowInputMsgNodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlowMy.Views.Overlays"
        xmlns:controls="clr-namespace:FlowMy.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:FlowMy.Converters"
        Title="Nhập dữ liệu"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="800"
        MinWidth="500"
        MaxWidth="1200"
        MinHeight="560">
    <local:BaseNodeDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
    </local:BaseNodeDialog.Resources>
    <Border CornerRadius="12" Padding="0" Style="{DynamicResource DialogOuterBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{DynamicResource DialogHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleTextBox" Grid.Column="0"
                             Text="{Binding NodeTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BaseTextBoxV2}" FontSize="16" Padding="0,4,0,4"
                             VerticalContentAlignment="Center" Cursor="IBeam"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Padding="0" Width="24" Height="24" Content="▶" FontSize="12"
                                Style="{DynamicResource PrimaryButton}" Cursor="Hand" Margin="8,0,0,0" ToolTip="Chạy logic node này"
                                Command="{Binding RunSingleNodeCommand}"/>
                        <Button x:Name="CloseButton" Padding="0" Width="24" Height="24"
                                Style="{DynamicResource DangerButton}" Content="✕" FontSize="12" FontWeight="Bold"
                                Cursor="Hand" Margin="8,0,0,0" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <TabControl x:Name="MainTabsControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Logic -->
                <TabItem Header="Logic" Style="{DynamicResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Cấu hình hiển thị -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎨 Cấu hình hiển thị" Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock Text="Hiển thị tiêu đề" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="TitleDisplayModeComboBox" Height="32"
                                              Style="{DynamicResource BaseComboBox}" Margin="0,0,0,8"
                                              ItemsSource="{Binding TitleDisplayModeOptions}"
                                              SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                                              SelectedValue="{Binding TitleDisplayMode, Mode=TwoWay}"/>
                                    <TextBlock Text="Màu tiêu đề" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="TitleColorComboBox" Grid.Column="0" Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding TitleColorOptions}"
                                                  SelectedValuePath="Key" DisplayMemberPath="DisplayName"
                                                  SelectedValue="{Binding TitleColorKey, Mode=TwoWay}"
                                                  SelectionChanged="TitleColorComboBox_SelectionChanged"/>
                                        <Border Grid.Column="1" x:Name="TitleColorPreview"
                                                Width="32" Height="32" CornerRadius="6" Margin="8,0,0,0"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Inputs -->
                            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📍 Inputs (node nguồn + key → biến dùng trong Html/Js)"
                                               Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="160">
                                        <ItemsControl x:Name="InputMappingsItemsControl" ItemsSource="{Binding InputMappingsList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Background="{DynamicResource WindowBackground}" CornerRadius="6" Padding="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Node" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                                                <controls:NodeSearchComboBoxUserControl Height="32"
                                                                          ItemsSource="{Binding DataContext.AvailableNodeOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          SelectedValuePath="NodeId" DisplayMemberPath="Title"
                                                                          SelectedValue="{Binding SourceNodeId, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Key" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                                                <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                                          ItemsSource="{Binding AvailableOutputKeyOptions}"
                                                                          SelectedValuePath="Key" DisplayMemberPath="DisplayName"
                                                                          SelectedValue="{Binding SourceOutputKey, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Text="Biến dùng trong Html/Js" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                                                <TextBox Text="{Binding InputKeyOverride, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{DynamicResource BaseTextBoxV2}" Height="32"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="5" Content="−" Width="26" Height="26" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                                                    Command="{Binding DataContext.RemoveInputMappingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Foreground="{DynamicResource TextBrush}" Background="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <Button Content="+ Thêm input" Height="32" Margin="0,0,0,12"
                                    Command="{Binding AddInputMappingCommand}"
                                    Width="140" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/>

                            <!-- Code editors -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cấu hình HTML UI (Html / Js / Css / Params)"
                                           Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="A−" Width="28" Height="28" Margin="0,0,4,0"
                                            Style="{DynamicResource SecondaryButton}" Command="{Binding DecreaseCodeFontSizeCommand}"
                                            Cursor="Hand" Padding="0" FontSize="14"/>
                                    <Button Content="A+" Width="28" Height="28"
                                            Style="{DynamicResource SecondaryButton}" Command="{Binding IncreaseCodeFontSizeCommand}"
                                            Cursor="Hand" Padding="0" FontSize="14"/>
                                </StackPanel>
                            </Grid>

                            <TabControl x:Name="CodeTabsControl" Margin="0,0,0,8" Background="Transparent" BorderThickness="0">
                                <TabItem Header="HTML" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <controls:SyntaxHighlightCodeEditor x:Name="HtmlEditor"
                                        Text="{Binding HtmlCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        CodeFontSize="{Binding CodeFontSize, Mode=TwoWay}"
                                        SyntaxLanguage="HTML" IsAutoHighlightEnabled="False"
                                        MinHeight="180" MaxHeight="320" Margin="0,4,0,4"/>
                                </TabItem>
                                <TabItem Header="JS" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <Grid Margin="0,4,0,4">
                                        <controls:SyntaxHighlightCodeEditor x:Name="JsEditor"
                                            Text="{Binding JsCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            CodeFontSize="{Binding CodeFontSize, Mode=TwoWay}"
                                            SyntaxLanguage="JavaScript" IsAutoHighlightEnabled="False"
                                            MinHeight="180" MaxHeight="320"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="CSS" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <controls:SyntaxHighlightCodeEditor x:Name="CssEditor"
                                        Text="{Binding CssCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        CodeFontSize="{Binding CodeFontSize, Mode=TwoWay}"
                                        SyntaxLanguage="CSS" IsAutoHighlightEnabled="False"
                                        MinHeight="180" MaxHeight="320" Margin="0,4,0,4"/>
                                </TabItem>
                                <TabItem Header="Params (config)" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <controls:SyntaxHighlightCodeEditor x:Name="ParamsEditor"
                                        Text="{Binding ParamsCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        CodeFontSize="{Binding CodeFontSize, Mode=TwoWay}"
                                        SyntaxLanguage="JavaScript" IsAutoHighlightEnabled="False"
                                        MinHeight="180" MaxHeight="320" Margin="0,4,0,4"/>
                                </TabItem>
                                <TabItem Header="Output keys" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <StackPanel Margin="0,4,0,4">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Output keys (đưa giá trị ra các node khác):"
                                                       Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Params" Height="32" Width="92" Margin="0,0,8,0"
                                                        Command="{Binding SyncOutputKeysFromParamsCommand}" Style="{DynamicResource PrimaryButton}"/>
                                                <Button Content="+ Thêm output key" Height="32" Command="{Binding AddOutputKeyCommand}"
                                                        Width="160" Style="{DynamicResource PrimaryButton}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="160">
                                                <ItemsControl ItemsSource="{Binding OutputKeysList}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{DynamicResource BaseTextBoxV2}" Height="32" FontSize="13"/>
                                                                <Button Grid.Column="1" Content="−" Width="26" Height="26" Margin="8,0,0,0"
                                                                        Command="{Binding DataContext.RemoveOutputKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <!-- Size configuration for the popup window at runtime -->
                            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,12">
                                <StackPanel>
                                    <TextBlock Text="📏 Kích thước cửa sổ popup khi chạy" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Chiều rộng (px)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaseTextBoxV2}" Height="32"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Chiều cao (px)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaseTextBoxV2}" Height="32"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Outputs panel ẩn / InputsPanel ẩn — BaseNodeDialog dùng để inject port rows -->
                            <StackPanel x:Name="OutputsPanel" Visibility="Collapsed"/>
                            <StackPanel x:Name="InputsPanel" Visibility="Collapsed"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Cấu hình -->
                <TabItem Header="Cấu hình" Style="{DynamicResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Vị trí cổng IN/OUT" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Port IN" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}" ItemsSource="{Binding PortPositionOptions}" SelectedItem="{Binding InputPortPosition, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Port OUT" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}" ItemsSource="{Binding PortPositionOptions}" SelectedItem="{Binding OutputPortPosition, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Tái sử dụng flow" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding ReuseRoutes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Node IN" Foreground="{DynamicResource TextBrush}" FontSize="10" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding IncomingNodeTitle}" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Node OUT" Foreground="{DynamicResource TextBrush}" FontSize="10" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <controls:NodeSearchComboBoxUserControl Height="32" ItemsSource="{Binding OutgoingOptions}" SelectedValuePath="NodeId" DisplayMemberPath="Title" SelectedValue="{Binding SelectedOutgoingNodeId, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock Text="Kiểu line OUT" Foreground="{DynamicResource TextBrush}" FontSize="10" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}" ItemsSource="{Binding DataContext.ConnectionLineStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValuePath="Key" DisplayMemberPath="DisplayName" SelectedValue="{Binding SelectedLineStyleKey, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</local:BaseNodeDialog>
