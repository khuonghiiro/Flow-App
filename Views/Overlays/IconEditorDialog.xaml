<Window x:Class="FlowMy.Views.Overlays.IconEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FlowMy.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:FlowMy.Converters"
        mc:Ignorable="d"
        Title="Icon Creator &amp; Editor"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="1180"
        Height="720">

    <Window.Resources>
        <!-- Premium dark theme brushes -->
        <SolidColorBrush x:Key="DialogBg" Color="#111318"/>
        <SolidColorBrush x:Key="CardBg" Color="#161821"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2a2e3d"/>
        <SolidColorBrush x:Key="TextMain" Color="#dde3ef"/>
        <SolidColorBrush x:Key="TextMuted" Color="#788296"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4fffb0"/>
        <SolidColorBrush x:Key="AccentHoverColor" Color="#62ffc0"/>
        <SolidColorBrush x:Key="DangerColor" Color="#ff6b6b"/>

        <!-- Photoshop dark checkered brush for SVG editing area -->
        <VisualBrush x:Key="PsDarkCheckeredBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="16" Height="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="8"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="8"/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#12141c"/>
                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#1b1e29"/>
                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#1b1e29"/>
                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#12141c"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
        
        <!-- Sleek ComboBox Style for Dark Dialog -->
        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="#1e222d"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,24,0"
                                              VerticalAlignment="Center"/>
                            <TextBlock Text="▾"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="11"/>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="#1e222d"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MaxHeight="260"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                        <Setter Property="Background" Value="#1e222d"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="4"
                                            Margin="2,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#252a39"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#1a4fffb0"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom premium styling for simple toolbar buttons -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1e222d"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2a2e3d"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1a4fffb0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.5" Background="{StaticResource DialogBg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🎨 THÀNH LẬP &amp; CHỈNH SỬA BIỂU TƯỢNG (SVG)" Foreground="{StaticResource AccentColor}"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="BtnClose" Content="✕" Width="28" Height="28" FontSize="11" FontWeight="Bold"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}" Cursor="Hand" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#cc3333"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT BODY -->
            <Grid Grid.Row="1" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <!-- COLUMN 1: SVG Path Editor -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Category selection / Properties -->
                        <RowDefinition Height="4*"/>   <!-- Canvas display -->
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="1*"/>   <!-- TextBox path string -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Select Existing or Add New / Info -->
                    <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Biểu tượng:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                <ComboBox Grid.Column="1" x:Name="CmbIconSelector" Style="{StaticResource DialogComboBoxStyle}" SelectionChanged="CmbIconSelector_SelectionChanged" Height="30"/>

                                <TextBlock Grid.Column="3" Text="Tên Key:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                <Border Grid.Column="4" Background="#1e222d" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.2" CornerRadius="6" Height="30" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtIconName" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0" 
                                             Padding="8,4" VerticalAlignment="Center" CaretBrush="{StaticResource AccentColor}"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Màu mặc định:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                <Border Grid.Column="1" Background="#1e222d" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.2" CornerRadius="6" Height="30" VerticalAlignment="Center">
                                    <TextBox x:Name="TxtIconColor" Text="#4fffb0" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0" 
                                             Padding="8,4" VerticalAlignment="Center" CaretBrush="{StaticResource AccentColor}" TextChanged="TxtIconColor_TextChanged"/>
                                </Border>

                                <CheckBox Grid.Column="3" x:Name="ChkOriginalColor" Content="Dùng màu gốc SVG (.color)" Foreground="{StaticResource TextMain}" 
                                          VerticalAlignment="Center" Click="ChkOriginalColor_Click" Cursor="Hand"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 1: Interactive Canvas & Svg Preview -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Svg edit toolbar -->
                            <RowDefinition Height="*"/>    <!-- Canvas viewport -->
                        </Grid.RowDefinitions>

                        <!-- SVG edit toolbar -->
                        <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6,6,0,0" Padding="8,6">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Mode Selector -->
                                <RadioButton x:Name="RadSelectPoint" Content="👉 Chọn điểm" Style="{StaticResource {x:Type ToggleButton}}" 
                                             Width="96" Height="26" IsChecked="True" Cursor="Hand" Margin="0,0,4,0" Padding="0" VerticalAlignment="Center"/>
                                <RadioButton x:Name="RadAddPoint" Content="➕ Thêm điểm" Style="{StaticResource {x:Type ToggleButton}}" 
                                             Width="96" Height="26" Cursor="Hand" Margin="0,0,10,0" Padding="0" VerticalAlignment="Center"/>
                                
                                <Separator Width="1" Height="18" Background="{StaticResource BorderColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <!-- Point commands -->
                                <Button x:Name="BtnDeletePoint" Content="❌ Xóa điểm" Style="{StaticResource ToolButtonStyle}" Height="26" Margin="0,0,4,0" Click="BtnDeletePoint_Click"/>
                                <Button x:Name="BtnMakeLine" Content="⎯ Thẳng" Style="{StaticResource ToolButtonStyle}" Height="26" Margin="0,0,4,0" Click="BtnMakeLine_Click" ToolTip="Chuyển điểm này sang đoạn thẳng (L)"/>
                                <Button x:Name="BtnMakeCurve" Content="∼ Cong" Style="{StaticResource ToolButtonStyle}" Height="26" Margin="0,0,10,0" Click="BtnMakeCurve_Click" ToolTip="Chuyển điểm này sang đoạn cong Bezier (C)"/>

                                <Separator Width="1" Height="18" Background="{StaticResource BorderColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <!-- Transforms -->
                                <Button x:Name="BtnShiftUp" Content="▲" Style="{StaticResource ToolButtonStyle}" Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BtnShiftUp_Click" ToolTip="Dịch lên"/>
                                <Button x:Name="BtnShiftDown" Content="▼" Style="{StaticResource ToolButtonStyle}" Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BtnShiftDown_Click" ToolTip="Dịch xuống"/>
                                <Button x:Name="BtnShiftLeft" Content="◀" Style="{StaticResource ToolButtonStyle}" Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BtnShiftLeft_Click" ToolTip="Dịch trái"/>
                                <Button x:Name="BtnShiftRight" Content="▶" Style="{StaticResource ToolButtonStyle}" Width="26" Height="26" Padding="0" Margin="0,0,4,0" Click="BtnShiftRight_Click" ToolTip="Dịch phải"/>
                                <Button x:Name="BtnScaleUp" Content="➕ Phóng" Style="{StaticResource ToolButtonStyle}" Height="26" Margin="0,0,2,0" Click="BtnScaleUp_Click" ToolTip="Phóng to 1.1x"/>
                                <Button x:Name="BtnScaleDown" Content="➖ Thu" Style="{StaticResource ToolButtonStyle}" Height="26" Margin="0,0,10,0" Click="BtnScaleDown_Click" ToolTip="Thu nhỏ 0.9x"/>

                                <Separator Width="1" Height="18" Background="{StaticResource BorderColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                <!-- Templates -->
                                <TextBlock Text="Mẫu:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                                <Button x:Name="BtnTemplateCircle" Content="◯" Style="{StaticResource ToolButtonStyle}" Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BtnTemplateCircle_Click" ToolTip="Hình tròn"/>
                                <Button x:Name="BtnTemplateSquare" Content="⬜" Style="{StaticResource ToolButtonStyle}" Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BtnTemplateSquare_Click" ToolTip="Hình vuông"/>
                                <Button x:Name="BtnTemplateTriangle" Content="△" Style="{StaticResource ToolButtonStyle}" Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BtnTemplateTriangle_Click" ToolTip="Hình tam giác"/>
                                <Button x:Name="BtnTemplateStar" Content="⭐" Style="{StaticResource ToolButtonStyle}" Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BtnTemplateStar_Click" ToolTip="Hình ngôi sao"/>
                                <Button x:Name="BtnTemplateGear" Content="⚙️" Style="{StaticResource ToolButtonStyle}" Width="26" Height="26" Padding="0" Margin="0,0,2,0" Click="BtnTemplateGear_Click" ToolTip="Hình bánh răng"/>
                            </WrapPanel>
                        </Border>

                        <!-- Canvas area -->
                        <Border Grid.Row="1" Background="{StaticResource PsDarkCheckeredBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" ClipToBounds="True">
                            <Grid x:Name="CanvasContainerGrid" SizeChanged="CanvasContainerGrid_SizeChanged">
                                <!-- Background grid overlay -->
                                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.15" IsHitTestVisible="False">
                                    <!-- A subtle grid pattern can be added programmatically or with CSS/Shapes -->
                                </Canvas>

                                <!-- Actual WPF Path drawing the SVG shape (simple path mode) -->
                                <Path x:Name="SvgPreviewPath" Fill="{StaticResource AccentColor}" StrokeThickness="0" Stroke="Transparent"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" IsHitTestVisible="False"/>

                                <!-- Full SVG preview using SharpVectors (SVG mode) -->
                                <controls:SvgViewboxEx x:Name="SvgFullPreview" Visibility="Collapsed" IsHitTestVisible="False"
                                                    UseOriginalColors="True" Stretch="Uniform" 
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Margin="20"/>

                                <!-- Editing canvas where handles are drawn -->
                                <Canvas x:Name="EditingCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                                        MouseLeftButtonDown="EditingCanvas_MouseLeftButtonDown"
                                        MouseMove="EditingCanvas_MouseMove"
                                        MouseLeftButtonUp="EditingCanvas_MouseLeftButtonUp"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 3: TextBox Path data string -->
                    <Border Grid.Row="3" Background="#1a1c23" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <TextBox x:Name="TxtPathData" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"
                                     Padding="8" FontSize="11" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" CaretBrush="{StaticResource AccentColor}" TextChanged="TxtPathData_TextChanged"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- COLUMN GAP -->
                <Grid Grid.Column="1"/>

                <!-- COLUMN 2: Web Browser -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Address/Navigation Bar -->
                        <RowDefinition Height="*"/>    <!-- WebView2 container -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Address/Navigation Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Back -->
                            <ColumnDefinition Width="Auto"/> <!-- Forward -->
                            <ColumnDefinition Width="Auto"/> <!-- Refresh -->
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/> <!-- Profile Combo -->
                            <ColumnDefinition Width="Auto"/> <!-- New Profile -->
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>    <!-- URL bar -->
                            <ColumnDefinition Width="Auto"/> <!-- Go -->
                        </Grid.ColumnDefinitions>

                        <!-- Navigation buttons -->
                        <Button x:Name="BtnWebBack" Grid.Column="0" Content="◀" Width="26" Height="30" Padding="0" ToolTip="Quay lại" Style="{DynamicResource ToolButtonStyle}" Click="BtnWebBack_Click"/>
                        <Button x:Name="BtnWebForward" Grid.Column="1" Content="▶" Width="26" Height="30" Padding="0" Margin="3,0,0,0" ToolTip="Tiến lên" Style="{DynamicResource ToolButtonStyle}" Click="BtnWebForward_Click"/>
                        <Button x:Name="BtnWebRefresh" Grid.Column="2" Content="↻" Width="26" Height="30" Padding="0" Margin="3,0,0,0" ToolTip="Tải lại trang" Style="{DynamicResource ToolButtonStyle}" Click="BtnWebRefresh_Click"/>

                        <!-- Profile ComboBox -->
                        <ComboBox x:Name="CmbWebProfile" Grid.Column="4" Width="90" Height="30"
                                  Style="{StaticResource DialogComboBoxStyle}" FontSize="10" ToolTip="Chọn profile trình duyệt"
                                  SelectionChanged="CmbWebProfile_SelectionChanged"/>

                        <!-- New Profile button -->
                        <Button x:Name="BtnNewProfile" Grid.Column="5" Content="＋" Width="28" Height="30" Padding="0" Margin="4,0,0,0"
                                FontSize="14" FontWeight="Bold" ToolTip="Tạo profile mới"
                                Style="{DynamicResource ToolButtonStyle}" Click="BtnNewProfile_Click"/>

                        <!-- URL / Search TextBox -->
                        <Border Grid.Column="7" Background="#1e222d" BorderBrush="#2a2e3d" BorderThickness="1.2" CornerRadius="6" Padding="0">
                            <Grid>
                                <TextBox x:Name="TxtWebUrl" Background="Transparent" Foreground="{StaticResource TextMain}" BorderThickness="0"
                                         Padding="8,4,30,4" FontSize="11" VerticalContentAlignment="Center" CaretBrush="{StaticResource AccentColor}"
                                         SelectionBrush="#804fffb0" Text="https://google.com" KeyDown="TxtWebUrl_KeyDown" GotFocus="TxtWebUrl_GotFocus"/>

                                <!-- Inline Loading Indicator in URL bar -->
                                <Border x:Name="UrlLoadingIndicator" Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource AccentColor}" StrokeThickness="2" StrokeDashArray="3,1" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="UrlSpinnerRotate"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="UrlSpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Go / Navigate button -->
                        <Button x:Name="BtnWebGo" Grid.Column="8" Content="→" Padding="0" Width="28" Height="30" Margin="4,0,0,0"
                                FontSize="14" FontWeight="Bold" ToolTip="Điều hướng" Style="{DynamicResource ToolButtonStyle}"
                                Background="{StaticResource AccentColor}" Foreground="#111318" Click="BtnWebGo_Click"/>
                    </Grid>

                    <!-- Row 1: WebView2 Browser container -->
                    <Border Grid.Row="1" Background="#1a1c23" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Grid x:Name="WebBrowserContainer">
                            <TextBlock Text="🌍 WebView2 loading..."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="20"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- BOTTOM BAR -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Status/Validation Message -->
                    <TextBlock Grid.Column="0" x:Name="TxtStatus" Text="Chọn hoặc bắt đầu chỉnh sửa path để thiết kế biểu tượng mới." 
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="12"/>

                    <!-- Right: Save / Cancel buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnSave" Content="Thêm" Width="90" Height="32" FontWeight="SemiBold"
                                Background="{StaticResource AccentColor}" Foreground="#111318" Cursor="Hand" Click="BtnSave_Click" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentHoverColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="BtnCancel" Content="Huỷ" Width="90" Height="32" FontWeight="SemiBold"
                                Background="Transparent" Foreground="{StaticResource TextMain}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1.2"
                                Cursor="Hand" Click="BtnCancel_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1e222d"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource TextMuted}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
