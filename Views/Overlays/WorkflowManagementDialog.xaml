<Window x:Class="FlowMy.Views.Overlays.WorkflowManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FlowMy.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:FlowMy.Converters"
        mc:Ignorable="d"
        Title="Quản lý Workflows"
        Height="620"
        Width="780"
        MinHeight="440"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="CanResize">
    <Window.Resources>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
        <conv:FileSizeToStringConverter x:Key="FileSizeToStringConverter"/>
        <conv:RelativeTimeConverter x:Key="RelativeTimeConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Search + Sort -->
            <RowDefinition Height="*"/>     <!-- Card list -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════
             HEADER BAR
             ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                Padding="20,14"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:SvgViewboxEx Width="20" Height="20"
                                           Fill="{DynamicResource PrimaryBrush}"
                                           Margin="0,0,10,0"
                                           Source="{Binding Source={x:Static sys:String.Empty}, 
                                                    Converter={StaticResource IconKeyToPathConverter}, 
                                                    ConverterParameter='gear chisel-regular'}"/>
                    <TextBlock Text="Quản lý Workflows"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource PrimaryGlowBrush}"
                        CornerRadius="10"
                        Padding="10,4">
                    <TextBlock x:Name="WorkflowCountText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             SEARCH + SORT BAR
             ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource WindowBodyBackground}"
                Padding="16,10"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <Border Grid.Column="0"
                        Background="{DynamicResource TextBoxBackground}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:SvgViewboxEx Grid.Column="0"
                                               Source="{Binding Source={x:Static sys:String.Empty}, 
                                                        Converter={StaticResource IconKeyToPathConverter}, 
                                                        ConverterParameter='magnifying-glass regular'}"
                                               Width="14" Height="14"
                                               Fill="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 TextChanged="SearchBox_TextChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextBrush}"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource TextBrush}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                                    <TextBlock x:Name="Placeholder"
                                                               Text="Tìm kiếm workflow..."
                                                               Foreground="{DynamicResource PlaceholderBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- Clear search -->
                        <Button x:Name="ClearSearchButton"
                                Grid.Column="2"
                                Click="ClearSearchButton_Click"
                                Visibility="Collapsed"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2"
                                Cursor="Hand"
                                ToolTip="Xóa tìm kiếm">
                            <controls:SvgViewboxEx Width="12" Height="12"
                                                   Fill="{DynamicResource TextMuted}"
                                                   Source="{Binding Source={x:Static sys:String.Empty}, 
                                                            Converter={StaticResource IconKeyToPathConverter}, 
                                                            ConverterParameter='xmark regular'}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Sort buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sắp xếp:"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <Button x:Name="SortByNameButton"
                            Click="SortByName_Click"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            Padding="8,4"
                            Cursor="Hand"
                            ToolTip="Sắp xếp theo tên">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SortBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SortBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                        <Setter TargetName="SortBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tên" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SortArrowName" Text=" ▲" FontSize="9" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SortByDateButton"
                            Click="SortByDate_Click"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            Padding="8,4"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            ToolTip="Sắp xếp theo ngày lưu">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SortBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SortBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                        <Setter TargetName="SortBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ngày" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SortArrowLastModified" Text="" FontSize="9" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SortBySizeButton"
                            Click="SortBySize_Click"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"
                            BorderThickness="1"
                            Padding="8,4"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            ToolTip="Sắp xếp theo kích thước">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SortBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SortBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                        <Setter TargetName="SortBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Size" FontSize="11" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SortArrowFileSize" Text="" FontSize="9" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             CARD-BASED WORKFLOW LIST
             ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Background="{DynamicResource WindowBodyBackground}">
            <!-- Empty state -->
            <Border x:Name="EmptyStateOverlay"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:SvgViewboxEx Width="48" Height="48"
                                           Fill="{DynamicResource TextMuted}"
                                           Opacity="0.4"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"
                                           Source="{Binding Source={x:Static sys:String.Empty}, 
                                                    Converter={StaticResource IconKeyToPathConverter}, 
                                                    ConverterParameter='folder-open duotone'}"/>
                    <TextBlock x:Name="EmptyStateText"
                               Text="Không có workflow nào"
                               FontSize="14"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Tạo workflow mới từ editor để bắt đầu"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card list via ItemsControl in ScrollViewer -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0">
                <ItemsControl x:Name="WorkflowItemsControl"
                              Margin="16,12,16,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ── WORKFLOW CARD ── -->
                            <Border x:Name="CardBorder"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0"
                                    Margin="0,0,0,8"
                                    SnapsToDevicePixels="True"
                                    Cursor="Arrow">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                                      Direction="270"
                                                      ShadowDepth="1"
                                                      BlurRadius="4"
                                                      Opacity="0.12"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Index badge -->
                                        <ColumnDefinition Width="40"/>
                                        <!-- Main content -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Meta info (size + time) -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Separator -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Actions -->
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Index badge (vertical accent bar + number) -->
                                    <Border Grid.Column="0"
                                            CornerRadius="10,0,0,10"
                                            Padding="0"
                                            Background="{DynamicResource SurfaceColor}">
                                        <Grid>
                                            <Rectangle Width="3"
                                                       HorizontalAlignment="Left"
                                                       Fill="{DynamicResource PrimaryBrush}"
                                                       Opacity="0.5"
                                                       RadiusX="1.5" RadiusY="1.5"/>
                                            <TextBlock Text="{Binding Index}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Main content: Name + File path -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="12,12,16,12">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Meta info pills -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                        <!-- File size pill -->
                                        <Border Background="{DynamicResource SurfaceColor}"
                                                CornerRadius="5"
                                                Padding="8,3"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:SvgViewboxEx Width="11" Height="11"
                                                    Fill="{DynamicResource TextMuted}"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Source="{Binding Source={x:Static sys:String.Empty}, 
                                                             Converter={StaticResource IconKeyToPathConverter}, 
                                                             ConverterParameter='file regular'}"/>
                                                <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeToStringConverter}}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Last modified pill -->
                                        <Border Background="{DynamicResource SurfaceColor}"
                                                CornerRadius="5"
                                                Padding="8,3"
                                                ToolTip="{Binding LastModifiedFull}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:SvgViewboxEx Width="11" Height="11"
                                                    Fill="{DynamicResource TextMuted}"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Source="{Binding Source={x:Static sys:String.Empty}, 
                                                             Converter={StaticResource IconKeyToPathConverter}, 
                                                             ConverterParameter='clock regular'}"/>
                                                <TextBlock Text="{Binding LastModified, Converter={StaticResource RelativeTimeConverter}}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Vertical separator -->
                                    <Rectangle Grid.Column="3"
                                               Width="1" Height="28"
                                               Fill="{DynamicResource ControlBorderBrush}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>

                                    <!-- Action buttons -->
                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="6,0,12,0">
                                        <!-- Edit name -->
                                        <Button Click="EditButton_Click"
                                                Tag="{Binding}"
                                                ToolTip="Sửa tên"
                                                Cursor="Hand"
                                                Margin="0,0,2,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder"
                                                            Background="Transparent"
                                                            CornerRadius="6"
                                                            Padding="7,5"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PrimaryGlowBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <controls:SvgViewboxEx Width="14" Height="14"
                                                Fill="{DynamicResource PrimaryBrush}"
                                                Source="{Binding Source={x:Static sys:String.Empty}, 
                                                         Converter={StaticResource IconKeyToPathConverter}, 
                                                         ConverterParameter='pen-to-square duotone'}"/>
                                        </Button>

                                        <!-- Open folder -->
                                        <Button Click="OpenFolderButton_Click"
                                                Tag="{Binding}"
                                                ToolTip="{Binding FolderPath, StringFormat='Mở folder: {0}'}"
                                                Cursor="Hand"
                                                Margin="0,0,2,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder"
                                                            Background="Transparent"
                                                            CornerRadius="6"
                                                            Padding="7,5"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PrimaryGlowBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <controls:SvgViewboxEx Width="14" Height="14"
                                                Fill="{DynamicResource TextSecondary}"
                                                Source="{Binding Source={x:Static sys:String.Empty}, 
                                                         Converter={StaticResource IconKeyToPathConverter}, 
                                                         ConverterParameter='folder-open duotone'}"/>
                                        </Button>

                                        <!-- Delete -->
                                        <Button Click="DeleteButton_Click"
                                                Tag="{Binding}"
                                                ToolTip="Xóa workflow"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder"
                                                            Background="Transparent"
                                                            CornerRadius="6"
                                                            Padding="7,5"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <controls:SvgViewboxEx Width="14" Height="14"
                                                Fill="{DynamicResource DangerBrush}"
                                                Source="{Binding Source={x:Static sys:String.Empty}, 
                                                         Converter={StaticResource IconKeyToPathConverter}, 
                                                         ConverterParameter='trash-can duotone-light'}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════════════════
             FOOTER
             ═══════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource HeaderBackgroundBrush}"
                Padding="16,10"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Folder path info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:SvgViewboxEx Width="13" Height="13"
                                           Fill="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Source="{Binding Source={x:Static sys:String.Empty}, 
                                                    Converter={StaticResource IconKeyToPathConverter}, 
                                                    ConverterParameter='folder regular'}"/>
                    <TextBlock x:Name="WorkflowFolderPathText"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="400"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Button x:Name="OpenWorkflowsFolderButton"
                            Click="OpenWorkflowsFolderButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,2"
                            Margin="4,0,0,0"
                            Cursor="Hand"
                            ToolTip="Mở thư mục chứa workflows">
                        <controls:SvgViewboxEx Width="11" Height="11"
                                               Fill="{DynamicResource PrimaryBrush}"
                                               Source="{Binding Source={x:Static sys:String.Empty}, 
                                                        Converter={StaticResource IconKeyToPathConverter}, 
                                                        ConverterParameter='arrow-up-right-from-square regular'}"/>
                    </Button>
                </StackPanel>

                <!-- Close button -->
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Click="CloseButton_Click"
                        Style="{DynamicResource PrimaryButton}"
                        Padding="20,8"
                        Content="Đóng"
                        MinWidth="80"/>
            </Grid>
        </Border>
    </Grid>
</Window>
