<local:BaseNodeDialog x:Class="FlowMy.Views.Overlays.FlowOverwriteNodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:FlowMy.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlowMy.Views.Overlays"
        Title="Flow Overwrite"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="520"
        MinWidth="420"
        MaxWidth="900"
        MinHeight="420">
    <Border CornerRadius="12" Padding="0" Style="{DynamicResource DialogOuterBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource DialogHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleTextBox" Grid.Column="0"
                             Text="{Binding NodeTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BaseTextBoxV2}"
                             FontSize="16" Padding="0,4,0,4"
                             VerticalContentAlignment="Center" Cursor="IBeam"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Padding="0,0,0,0"  Width="24" Height="24"
                                Content="▶" FontSize="12"
                                Style="{DynamicResource PrimaryButton}" Cursor="Hand"
                                Margin="8,0,0,0" ToolTip="Chạy logic node này"
                                Command="{Binding RunSingleNodeCommand}"/>
                        <Button x:Name="CloseButton" Padding="0,0,0,0"  Width="24" Height="24"
                                Style="{DynamicResource DangerButton}"
                                Content="×" FontSize="12" FontWeight="Bold" Cursor="Hand"
                                Margin="8,0,0,0" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="Logic" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- 💡 Hướng dẫn & Ví dụ minh họa -->
                            <Expander Header="💡 Hướng dẫn &amp; Ví dụ minh họa (Bấm để xem)"
                                      IsExpanded="False"
                                      Foreground="{DynamicResource TextBrush}"
                                      FontSize="12" FontWeight="SemiBold"
                                      Margin="0,0,0,12">
                                <Border Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="18">
                                            <Run Text="1. Khái niệm Append Mode:" FontWeight="Bold"/><LineBreak/>
                                            <Run Text="   • Tắt Append mode (mặc định): Ghi đè - mỗi lần chạy giữ 1 giá trị mới nhất."/><LineBreak/>
                                            <Run Text="   • Bật Append mode: Gom cộng dồn tất cả giá trị qua các lần thực thi thành mảng JSON."/><LineBreak/><LineBreak/>
                                            
                                            <Run Text="2. Ví dụ minh họa khi đặt trong Async Task / Loop:" FontWeight="Bold" Foreground="#E6A23C"/><LineBreak/>
                                            <Run Text="   Giả sử Async Task lặp 4 lần qua mảng ['5', '2', '7', '8']:"/><LineBreak/>
                                            <Run Text="   • " FontWeight="Bold"/><Run Text="Trường hợp BẬT Append mode + KHÔNG chọn Dữ liệu thuộc riêng luồng:"/><LineBreak/>
                                            <Run Text="     - Vòng 1 sinh: ['5'] (1 phần tử)"/><LineBreak/>
                                            <Run Text="     - Vòng 2 sinh: ['5', '2'] (2 phần tử)"/><LineBreak/>
                                            <Run Text="     - Vòng 3 sinh: ['5', '2', '7'] (3 phần tử)"/><LineBreak/>
                                            <Run Text="     - Vòng 4 sinh: ['5', '2', '7', '8'] (4 phần tử)"/><LineBreak/>
                                            <Run Text="     ➔ Async Task gom tổng lại tất cả mảng của 4 vòng = 1 + 2 + 3 + 4 = "/>
                                            <Run Text="10 phần tử" FontWeight="Bold" Foreground="#F56C6C"/><Run Text=" (['5', '5', '2', '5', '2', '7', '5', '2', '7', '8'])."/><LineBreak/><LineBreak/>
                                            
                                            <Run Text="   • " FontWeight="Bold"/><Run Text="Khắc phục (Để lấy đúng 4 phần tử):"/><LineBreak/>
                                            <Run Text="     - Cách A: TẮT Append mode trong Flow Overwrite (Async Task đã tự động gom mảng kết quả của các vòng thành mảng 4 phần tử)."/><LineBreak/>
                                            <Run Text="     - Cách B: BẬT 'Dữ liệu thuộc riêng luồng flow' để cô lập mảng cộng dồn cho riêng từng luồng."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!-- 🔑 Output key -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="🔑 Output key"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    <TextBox Text="{Binding OutputKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource BaseTextBoxV2}" Height="32"
                                             VerticalContentAlignment="Center"/>
                                
                            </StackPanel>
                        </Expander>
                    </Border>

                            <!-- 📝 Append mode -->
                            <CheckBox IsChecked="{Binding AppendMode, Mode=TwoWay}" Margin="0,0,0,12">
                                <TextBlock Text="Append mode (gom thành mảng, mặc định tắt = ghi đè)"
                                           Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </CheckBox>

                            <!-- 🧵 Scope to flow execution -->
                            <CheckBox IsChecked="{Binding ScopeToFlowExecution, Mode=TwoWay}" Margin="0,0,0,12">
                                <TextBlock Text="Dữ liệu thuộc riêng luồng flow (Checked = theo ExecutionId luồng hiện tại, Unchecked = bất kỳ luồng)"
                                           Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </CheckBox>

                            <!-- 🔗 Include indirect sources -->
                            <CheckBox IsChecked="{Binding IncludeIndirectSources, Mode=TwoWay}" Margin="0,0,0,12">
                                <TextBlock Text="Hiển thị cả node upstream gián tiếp (A, B, C, D thay vì chỉ node nối trực tiếp)"
                                           Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </CheckBox>

                            <!-- 📍 Nguồn override -->
                            <TextBlock Text="📍 Nguồn override"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource WindowBackground}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <controls:NodeSearchComboBoxUserControl Grid.Column="0" Height="32" Margin="0,0,6,0"
                                                          ItemsSource="{Binding DataContext.AvailableSourceOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedValuePath="NodeId"
                                                          DisplayMemberPath="Title"
                                                          SelectedValue="{Binding SelectedSourceNodeId, Mode=TwoWay}"/>
                                                <ComboBox Grid.Column="1" Height="32" Margin="0,0,6,0"
                                                          Style="{DynamicResource BaseComboBox}"
                                                          ItemsSource="{Binding AvailableOutputKeys}"
                                                          IsSynchronizedWithCurrentItem="False"
                                                          SelectedValuePath="Key"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValue="{Binding SelectedSourceOutputKey, Mode=TwoWay}"/>
                                                <Button Grid.Column="2" Content="X" Width="28" Height="28"
                                                        Style="{DynamicResource DangerButton}"
                                                        Click="RemoveSource_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Thêm nguồn node/key" Height="32"
                                    Style="{DynamicResource PrimaryButton}" Click="AddSource_Click"/>

                            <!-- 📍 Inputs -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="📍 Inputs"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    <StackPanel x:Name="InputsPanel"/>
                                
                            </StackPanel>
                        </Expander>
                    </Border>

                            <!-- 📤 Outputs -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="📤 Outputs"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    <StackPanel x:Name="OutputsPanel"/>
                                
                            </StackPanel>
                        </Expander>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Cấu hình" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Cấu hình vị trí cổng IN/OUT -->
                            <TextBlock Text="Vị trí cổng IN/OUT"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Port IN"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding PortPositionOptions}"
                                                  SelectedItem="{Binding InputPortPosition, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Port OUT"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding PortPositionOptions}"
                                                  SelectedItem="{Binding OutputPortPosition, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ReuseRoutes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Background="{DynamicResource WindowBackground}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Node IN"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding IncomingNodeTitle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Node OUT"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <controls:NodeSearchComboBoxUserControl Height="32"
                                                              ItemsSource="{Binding OutgoingOptions}"
                                                              SelectedValuePath="NodeId" DisplayMemberPath="Title"
                                                              SelectedValue="{Binding SelectedOutgoingNodeId, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock Text="Kiểu line OUT"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                              ItemsSource="{Binding DataContext.ConnectionLineStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Key" DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding SelectedLineStyleKey, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</local:BaseNodeDialog>
