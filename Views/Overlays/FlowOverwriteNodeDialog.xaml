<local:BaseNodeDialog x:Class="FlowMy.Views.Overlays.FlowOverwriteNodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:FlowMy.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlowMy.Views.Overlays"
        xmlns:conv="clr-namespace:FlowMy.Converters"
        Title="Flow Overwrite"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="520"
        MinWidth="420"
        MaxWidth="900"
        MinHeight="420">
    <local:BaseNodeDialog.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </local:BaseNodeDialog.Resources>
    <Border CornerRadius="12" Padding="0" Style="{DynamicResource DialogOuterBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource DialogHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleTextBox" Grid.Column="0"
                             Text="{Binding NodeTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BaseTextBoxV2}"
                             FontSize="16" Padding="0,4,0,4"
                             VerticalContentAlignment="Center" Cursor="IBeam"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Padding="0,0,0,0"  Width="24" Height="24"
                                Content="▶" FontSize="12"
                                Style="{DynamicResource PrimaryButton}" Cursor="Hand"
                                Margin="8,0,0,0" ToolTip="Chạy logic node này"
                                Command="{Binding RunSingleNodeCommand}"/>
                        <Button x:Name="CloseButton" Padding="0,0,0,0"  Width="24" Height="24"
                                Style="{DynamicResource DangerButton}"
                                Content="×" FontSize="12" FontWeight="Bold" Cursor="Hand"
                                Margin="8,0,0,0" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="Logic" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- 💡 Hướng dẫn & Ví dụ minh họa -->
                            <Expander Header="💡 Hướng dẫn &amp; Ví dụ minh họa (Bấm để xem)"
                                      IsExpanded="False"
                                      Foreground="{DynamicResource TextBrush}"
                                      FontSize="12" FontWeight="SemiBold"
                                      Margin="0,0,0,12">
                                <Border Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="18">
                                            <Run Text="1. Khái niệm Gom mảng (Append Mode):" FontWeight="Bold"/><LineBreak/>
                                            <Run Text="   • Tắt 'Tích để gom mảng' (Mặc định): Ghi đè — mỗi lần chạy chỉ giữ 1 giá trị mới nhất."/><LineBreak/>
                                            <Run Text="   • Bật 'Tích để gom mảng': Cộng dồn tất cả giá trị qua các lần thực thi thành một mảng JSON."/><LineBreak/><LineBreak/>

                                            <Run Text="2. Phạm vi luồng cha / luồng con (Scope to parent flow):" FontWeight="Bold"/><LineBreak/>
                                            <Run Text="   • Tích chọn (Mặc định khi bật gom mảng): Gom tất cả dữ liệu từ các vòng lặp / luồng con về luồng cha chung. Luồng cha thu thập được đầy đủ mảng kết quả của mọi lần lặp."/><LineBreak/>
                                            <Run Text="   • Bỏ tích chọn: Cô lập dữ liệu theo riêng từng luồng/vòng lặp (luồng con nào chỉ thấy mảng cộng dồn của luồng đó)."/><LineBreak/><LineBreak/>

                                            <Run Text="3. Gộp mảng (Flatten array values):" FontWeight="Bold"/><LineBreak/>
                                            <Run Text="   • Tích chọn: Nếu giá trị truyền vào là một mảng JSON (vd: [1, 2]), các phần tử sẽ được gộp phẳng vào mảng chung → [1, 2, 3, 4]."/><LineBreak/>
                                            <Run Text="   • Bỏ tích chọn: Giá trị mảng truyền vào sẽ được giữ nguyên dưới dạng một phần tử mảng con → [[1, 2], [3, 4]]."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Expander>

                            <!-- 🔑 Output key -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="🔑 Output key"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    <TextBox Text="{Binding OutputKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource BaseTextBoxV2}" Height="32"
                                             VerticalContentAlignment="Center"/>
                                
                            </StackPanel>
                        </Expander>
                    </Border>

                            <!-- 📝 Append mode -->
                            <CheckBox IsChecked="{Binding AppendMode, Mode=TwoWay}" Margin="0,0,0,12">
                                <TextBlock Text="Tích để gom mảng (cộng dồn các kết quả thành mảng JSON, mặc định tắt = ghi đè)"
                                           Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </CheckBox>

                            <!-- ⚙️ Sub-options when AppendMode is active -->
                            <StackPanel Visibility="{Binding AppendMode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="16,0,0,12">
                                <!-- 🧵 Scope to flow execution (Gom theo luồng cha) -->
                                <CheckBox IsChecked="{Binding ScopeToFlowExecution, Mode=TwoWay}" Margin="0,0,0,10">
                                    <TextBlock Text="Tích để gom dữ liệu về luồng cha (Checked = gom tất cả kết quả từ luồng con/vòng lặp về luồng cha, Unchecked = cô lập theo từng luồng con)"
                                               Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </CheckBox>

                                <!-- 🔗 Flatten array values (Gộp mảng) -->
                                <CheckBox IsChecked="{Binding FlattenArrayValues, Mode=TwoWay}" Margin="0,0,0,10">
                                    <TextBlock Text="Tích để gộp mảng (nếu value là mảng JSON thì gộp các phần tử vào mảng chung thay vì tạo mảng lồng mảng)"
                                               Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>

                            <!-- 🔗 Include indirect sources -->
                            <CheckBox IsChecked="{Binding IncludeIndirectSources, Mode=TwoWay}" Margin="0,0,0,12">
                                <TextBlock Text="Hiển thị cả node upstream gián tiếp (A, B, C, D thay vì chỉ node nối trực tiếp)"
                                           Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </CheckBox>

                            <!-- 📍 Nguồn override -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <Expander IsExpanded="True" BorderThickness="0">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding SourcesHeader}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding Sources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource WindowBackground}"
                                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <controls:NodeSearchComboBoxUserControl Grid.Column="0" Height="32" Margin="0,0,6,0"
                                                                      ItemsSource="{Binding DataContext.AvailableSourceOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      SelectedValuePath="NodeId"
                                                                      DisplayMemberPath="Title"
                                                                      SelectedValue="{Binding SelectedSourceNodeId, Mode=TwoWay}"/>
                                                            <ComboBox Grid.Column="1" Height="32" Margin="0,0,6,0"
                                                                      Style="{DynamicResource BaseComboBox}"
                                                                      ItemsSource="{Binding AvailableOutputKeys}"
                                                                      IsSynchronizedWithCurrentItem="False"
                                                                      SelectedValuePath="Key"
                                                                      DisplayMemberPath="DisplayName"
                                                                      SelectedValue="{Binding SelectedSourceOutputKey, Mode=TwoWay}"/>
                                                            <Button Grid.Column="2" Content="X" Width="28" Height="28" Padding="0"
                                                                    Style="{DynamicResource DangerButton}"
                                                                    Click="RemoveSource_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="+ Thêm nguồn node/key" Height="32" Margin="0,4,0,0"
                                                Style="{DynamicResource PrimaryButton}" Click="AddSource_Click"/>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <!-- 📍 Inputs -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="📍 Inputs"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    <StackPanel x:Name="InputsPanel"/>
                                
                            </StackPanel>
                        </Expander>
                    </Border>

                            <!-- 📤 Outputs -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12">
                        <Expander IsExpanded="True" BorderThickness="0">
                            <Expander.Header>
                                <TextBlock Text="📤 Outputs"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">

                                    <StackPanel x:Name="OutputsPanel"/>
                                
                            </StackPanel>
                        </Expander>
                    </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Cấu hình" Style="{StaticResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Cấu hình vị trí cổng IN/OUT -->
                            <TextBlock Text="Vị trí cổng IN/OUT"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Port IN"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding PortPositionOptions}"
                                                  SelectedItem="{Binding InputPortPosition, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Port OUT"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding PortPositionOptions}"
                                                  SelectedItem="{Binding OutputPortPosition, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ReuseRoutes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Background="{DynamicResource WindowBackground}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Node IN"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding IncomingNodeTitle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Node OUT"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <controls:NodeSearchComboBoxUserControl Height="32"
                                                              ItemsSource="{Binding OutgoingOptions}"
                                                              SelectedValuePath="NodeId" DisplayMemberPath="Title"
                                                              SelectedValue="{Binding SelectedOutgoingNodeId, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock Text="Kiểu line OUT"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                                                    <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                              ItemsSource="{Binding DataContext.ConnectionLineStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Key" DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding SelectedLineStyleKey, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</local:BaseNodeDialog>
