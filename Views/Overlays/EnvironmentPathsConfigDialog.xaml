<Window x:Class="FlowMy.Views.Overlays.EnvironmentPathsConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FlowMy.Controls"
        xmlns:converters="clr-namespace:FlowMy.Converters"
        Title="Cấu hình Đường dẫn Hệ thống &amp; Thư viện"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        Width="640" MinWidth="520" Height="620" MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>

    <Border CornerRadius="12" Padding="0" Style="{DynamicResource DialogOuterBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- HEADER -->
                <RowDefinition Height="Auto"/>
                <!-- CONTENT -->
                <RowDefinition Height="*"/>
                <!-- FOOTER / ACTION BAR -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════ HEADER ═══════════════════ -->
            <Border Grid.Row="0" Style="{DynamicResource DialogHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource PrimaryGlowBrush}" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                            <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cấu hình Đường dẫn Hệ thống &amp; Thư viện"
                                       Style="{DynamicResource DialogTitleText}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Thiết lập vị trí thực thi ffmpeg, git, python và các công cụ bổ trợ"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="CloseHeaderButton" Grid.Column="1"
                            Width="26" Height="26" Padding="0" Content="✕"
                            FontSize="12" FontWeight="Bold" Cursor="Hand"
                            Style="{DynamicResource DangerButton}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ═══════════════════ CONTENT ═══════════════════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>

                    <!-- 🎬 FFMPEG / FFPROBE CARD -->
                    <Border Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎬 FFmpeg &amp; FFprobe Video Engine"
                                               FontSize="12.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <Button Content="🔍 Tự tìm FFmpeg"
                                        Style="{DynamicResource SecondaryButton}"
                                        Height="24" Padding="8,0" HorizontalAlignment="Right"
                                        FontSize="10.5" Cursor="Hand"
                                        Command="{Binding AutoDetectFfmpegCommand}"/>
                            </Grid>

                            <TextBlock Text="Đường dẫn file ffmpeg.exe hoặc thư mục chứa ffmpeg.exe:"
                                       FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Height="30"
                                         Style="{DynamicResource BaseTextBoxV2}"
                                         Text="{Binding FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>

                                <Button Grid.Column="2" Content="📁 File"
                                        Style="{DynamicResource SecondaryButton}"
                                        Height="30" Padding="8,0" FontSize="11" Cursor="Hand"
                                        Click="BrowseFfmpegFile_Click"/>

                                <Button Grid.Column="4" Content="📂 Thư mục"
                                        Style="{DynamicResource SecondaryButton}"
                                        Height="30" Padding="8,0" FontSize="11" Cursor="Hand"
                                        Click="BrowseFfmpegFolder_Click"/>
                            </Grid>

                            <!-- Status Indicator -->
                            <Border Background="{DynamicResource SurfaceColor}" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding FfmpegStatusText}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 🔀 GIT EXECUTABLE CARD -->
                    <Border Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔀 Git Executable"
                                               FontSize="12.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <Button Content="🔍 Tự tìm Git"
                                        Style="{DynamicResource SecondaryButton}"
                                        Height="24" Padding="8,0" HorizontalAlignment="Right"
                                        FontSize="10.5" Cursor="Hand"
                                        Command="{Binding AutoDetectGitCommand}"/>
                            </Grid>

                            <TextBlock Text="Đường dẫn file git.exe (dùng cho quản lý Git repositories):"
                                       FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Height="30"
                                         Style="{DynamicResource BaseTextBoxV2}"
                                         Text="{Binding GitPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>

                                <Button Grid.Column="2" Content="📁 File git.exe"
                                        Style="{DynamicResource SecondaryButton}"
                                        Height="30" Padding="8,0" FontSize="11" Cursor="Hand"
                                        Click="BrowseGitFile_Click"/>
                            </Grid>

                            <!-- Status Indicator -->
                            <Border Background="{DynamicResource SurfaceColor}" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding GitStatusText}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 🐍 PYTHON EXECUTABLE CARD -->
                    <Border Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🐍 Python Executable"
                                               FontSize="12.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                                <Button Content="🔍 Tự tìm Python"
                                        Style="{DynamicResource SecondaryButton}"
                                        Height="24" Padding="8,0" HorizontalAlignment="Right"
                                        FontSize="10.5" Cursor="Hand"
                                        Command="{Binding AutoDetectPythonCommand}"/>
                            </Grid>

                            <TextBlock Text="Đường dẫn file python.exe (dùng cho Code Node / Scripts):"
                                       FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Height="30"
                                         Style="{DynamicResource BaseTextBoxV2}"
                                         Text="{Binding PythonPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>

                                <Button Grid.Column="2" Content="📁 File python.exe"
                                        Style="{DynamicResource SecondaryButton}"
                                        Height="30" Padding="8,0" FontSize="11" Cursor="Hand"
                                        Click="BrowsePythonFile_Click"/>
                            </Grid>

                            <!-- Status Indicator -->
                            <Border Background="{DynamicResource SurfaceColor}" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding PythonStatusText}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 📦 CUSTOM BINARIES DIRECTORY CARD -->
                    <Border Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="📦 Thư mục Công cụ &amp; File Thực Thi Tùy Chọn"
                                       FontSize="12.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Thư mục chứa các file .exe / dll tùy chỉnh khác cần gọi trong workflow:"
                                       FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Height="30"
                                         Style="{DynamicResource BaseTextBoxV2}"
                                         Text="{Binding CustomBinariesPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>

                                <Button Grid.Column="2" Content="📂 Thư mục"
                                        Style="{DynamicResource SecondaryButton}"
                                        Height="30" Padding="8,0" FontSize="11" Cursor="Hand"
                                        Click="BrowseCustomFolder_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════ FOOTER / ACTION BAR ═══════════════════ -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Button Content="⚡ Tự động tìm kiếm tất cả"
                            Style="{DynamicResource SecondaryButton}"
                            Height="32" Padding="12,0" HorizontalAlignment="Left"
                            FontSize="11.5" Cursor="Hand"
                            Command="{Binding AutoDetectAllCommand}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="💾 Lưu Cấu Hình"
                                Style="{DynamicResource PrimaryButton}"
                                Height="32" Padding="16,0" Margin="0,0,8,0"
                                FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                Click="SaveButton_Click"/>

                        <Button Content="✕ Đóng"
                                Style="{DynamicResource SecondaryButton}"
                                Height="32" Padding="12,0"
                                FontSize="11.5" Cursor="Hand"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
