<local:BaseNodeDialog x:Class="FlowMy.Views.Overlays.DynamicUiNodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:FlowMy.Controls"
    xmlns:local="clr-namespace:FlowMy.Views.Overlays"
    xmlns:converters="clr-namespace:FlowMy.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="Dynamic UI Designer (Sciter.JS)"
    WindowStyle="None" ResizeMode="CanResize"
    AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" Topmost="True"
    Width="850" MinWidth="600" MaxWidth="1200" MinHeight="580" Height="680">

    <!--
    ╔══════════════════════════════════════════════════════════════════════════╗
    ║  📖 Sciter JS ↔ C# Host Functions (Polling Bridge)                     ║
    ╠══════════════════════════════════════════════════════════════════════════╣
    ║  Các hàm JS có thể gọi từ Sciter HTML/JS để giao tiếp với C# Host:    ║
    ║                                                                        ║
    ║  🔄 Submit / Update Form Data:                                          ║
    ║    • sciterUpdate()           - Cập nhật form data lên C# Host         ║
    ║    • sciterSubmitAndClose()   - Submit form data + đóng dialog         ║
    ║    • hostSubmit(data)         - Submit data object lên C# Host         ║
    ║    • hostSubmitAndClose(data) - Submit data + đóng                     ║
    ║                                                                        ║
    ║  ▶ Chạy Node / Workflow:                                               ║
    ║    • sciterRunSingleNode()    - Chạy riêng node này                    ║
    ║    • sciterRunFromNode()      - Chạy workflow từ node này              ║
    ║    • hostStart()              - Bắt đầu workflow test                  ║
    ║                                                                        ║
    ║  ❌ Hủy:                                                                ║
    ║    • hostCancel()             - Hủy form                               ║
    ║                                                                        ║
    ║  📂 File / API:                                                         ║
    ║    • hostResolvePath(path, requestId) - Resolve đường dẫn file        ║
    ║    • hostCurl(rawCurl, fileName, key) - Gọi cURL API                  ║
    ║    • hostPickImages(requestId)        - Chọn ảnh từ file dialog       ║
    ║                                                                        ║
    ║  📡 Live Data (C# → JS):                                               ║
    ║    • hostLive.values           - Object chứa dữ liệu live từ C#       ║
    ║    • hostLive.on(key, callback) - Lắng nghe thay đổi dữ liệu live    ║
    ║                                                                        ║
    ║  🎨 CSS cho Sciter (khác với Browser):                                  ║
    ║    • text-selection-caret-color: #38bdf8;  (thay cho caret-color)     ║
    ║    • vertical-scrollbar: "dark-scrollbar"; (custom scrollbar)          ║
    ╚══════════════════════════════════════════════════════════════════════════╝
    -->
    <local:BaseNodeDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
    </local:BaseNodeDialog.Resources>


    <Border CornerRadius="12" Padding="0" Style="{DynamicResource DialogOuterBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Style="{DynamicResource DialogHeaderBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TitleTextBox" Grid.Column="0"
                             Text="{Binding NodeTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource BaseTextBoxV2}" FontSize="16"
                             Padding="0,4" VerticalContentAlignment="Center" Cursor="IBeam"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="26" Height="26" Content="▶" FontSize="12" Padding="0" Margin="8,0,0,0"
                                Style="{DynamicResource PrimaryButton}" Cursor="Hand" ToolTip="Chạy thử nghiệm Form này"
                                Command="{Binding RunSingleNodeCommand}"/>
                        <Button x:Name="CloseButton" Width="26" Height="26" Padding="0" Content="✕" FontSize="12"
                                FontWeight="Bold" Margin="8,0,0,0" Cursor="Hand"
                                Style="{DynamicResource DangerButton}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY: Main TabControl -->
            <TabControl x:Name="MainTabsControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Logic -->
                <TabItem Header="Logic" Style="{DynamicResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            
                            <!-- 🎨 DISPLAY CONFIGURATION CARD -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎨 Cấu hình hiển thị"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Hiển thị tiêu đề" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                      ItemsSource="{Binding TitleDisplayModeOptions}"
                                                      SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                                                      SelectedValue="{Binding TitleDisplayMode, Mode=TwoWay}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Màu tiêu đề" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="TitleColorComboBox" Grid.Column="0" Height="32"
                                                          Style="{DynamicResource BaseComboBox}"
                                                          ItemsSource="{Binding TitleColorOptions}"
                                                          SelectedValuePath="Key" DisplayMemberPath="DisplayName"
                                                          SelectedValue="{Binding TitleColorKey, Mode=TwoWay}"
                                                          SelectionChanged="TitleColorComboBox_SelectionChanged"/>
                                                <Border Grid.Column="1" x:Name="TitleColorPreview"
                                                        Width="32" Height="32" CornerRadius="6" Margin="8,0,0,0"
                                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 📐 SIZING CONFIGURATION CARD -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📐 Cấu hình kích thước"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Rộng Canvas (Width)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NodeWidth, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaseTextBoxV2}" Height="32"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cao Canvas (Height)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding NodeHeight, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaseTextBoxV2}" Height="32"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Rộng Popup Window" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaseTextBoxV2}" Height="32"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Cao Popup Window" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaseTextBoxV2}" Height="32"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 📍 INPUT MAPPINGS CARD -->
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📍 Inputs (node nguồn + key → biến dùng trong Html/Js)"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="160">
                                        <ItemsControl x:Name="InputMappingsItemsControl" ItemsSource="{Binding InputMappingsList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Background="{DynamicResource WindowBackground}" CornerRadius="6" Padding="6" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Node" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                                                <controls:NodeSearchComboBoxUserControl Height="32"
                                                                          ItemsSource="{Binding DataContext.AvailableNodeOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                          SelectedValuePath="NodeId" DisplayMemberPath="Title"
                                                                          SelectedValue="{Binding SourceNodeId, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Key" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                                                <ComboBox Height="32" Style="{DynamicResource BaseComboBox}"
                                                                          ItemsSource="{Binding AvailableOutputKeyOptions}"
                                                                          SelectedValuePath="Key"
                                                                          DisplayMemberPath="DisplayName"
                                                                          SelectedValue="{Binding SourceOutputKey, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Text="Biến dùng trong Html/Js (trống = dùng key)" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                                                <TextBox Text="{Binding InputKeyOverride, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{DynamicResource BaseTextBoxV2}" Height="32"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="5" Content="−" Width="26" Height="26" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                                                    Command="{Binding DataContext.RemoveInputMappingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Foreground="{DynamicResource TextBrush}" Background="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    
                                    <Button Content="+ Thêm input" Height="32" Margin="0,8,0,0"
                                            Command="{Binding AddInputMappingCommand}"
                                            Width="140" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- 💻 CODE EDITORS TAB CONTROL -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cấu hình HTML UI &amp; Cổng ra (Outputs)"
                                           Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="A−" Width="28" Height="28" Margin="0,0,4,0"
                                            Style="{DynamicResource SecondaryButton}"
                                            Command="{Binding DecreaseCodeFontSizeCommand}"
                                            Cursor="Hand" Padding="0" FontSize="14"/>
                                    <Button Content="A+" Width="28" Height="28"
                                            Style="{DynamicResource SecondaryButton}"
                                            Command="{Binding IncreaseCodeFontSizeCommand}"
                                            Cursor="Hand" Padding="0" FontSize="14"/>
                                </StackPanel>
                            </Grid>
                            
                            <TabControl x:Name="CodeTabsControl" Margin="0,0,0,8" Background="Transparent" BorderThickness="0">
                                <TabItem Header="HTML" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <Grid Margin="0,8,0,0">
                                        <controls:SyntaxHighlightCodeEditor x:Name="HtmlEditor" SyntaxLanguage="HTML" Text="{Binding HtmlCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" CodeFontSize="{Binding CodeFontSize, Mode=TwoWay}" MinHeight="250" Height="250"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="CSS" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <Grid Margin="0,8,0,0">
                                        <controls:SyntaxHighlightCodeEditor x:Name="CssEditor" SyntaxLanguage="CSS" Text="{Binding CssCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" CodeFontSize="{Binding CodeFontSize, Mode=TwoWay}" MinHeight="250" Height="250"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="JavaScript" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <Grid Margin="0,4,0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,10,0">
                                                <Run Text="Tách JS thành nhiều tab con để dễ maintain. Ưu tiên load: số nhỏ chạy trước (ví dụ "/>
                                                <Run Text="#2_common.js" FontFamily="Consolas" Foreground="{DynamicResource PrimaryBrush}"/>
                                                <Run Text=" trước "/>
                                                <Run Text="#5_feature.js" FontFamily="Consolas" Foreground="{DynamicResource PrimaryBrush}"/>
                                                <Run Text="). Dùng chung biến/func qua global namespace (ví dụ: "/>
                                                <Run Text="window.App" FontFamily="Consolas" Foreground="{DynamicResource PrimaryBrush}"/>
                                                <Run Text=")."/>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="MoveJsTabUpButton"
                                                        Width="28"
                                                        Height="26"
                                                        Margin="0,0,6,0"
                                                        Cursor="Hand"
                                                        Click="MoveJsTabUpButton_Click"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        ToolTip="Đẩy tab JS đang chọn lên trên (ưu tiên load sớm hơn)">
                                                    <controls:SvgViewboxEx
                                                        Width="12" Height="12" 
                                                        Source="{Binding Source={x:Static sys:String.Empty}, 
                                                        Converter={StaticResource IconKeyToPathConverter}, 
                                                        ConverterParameter='arrow-up-long-to-line duotone'}"
                                                        Fill="{DynamicResource TextOnSecondaryBrush}"/>
                                                </Button>
                                                <Button x:Name="MoveJsTabDownButton"
                                                        Width="28"
                                                        Height="26"
                                                        Margin="0,0,6,0"
                                                        Cursor="Hand"
                                                        Click="MoveJsTabDownButton_Click"
                                                        Style="{DynamicResource SecondaryButton}"
                                                        ToolTip="Đẩy tab JS đang chọn xuống dưới (ưu tiên load trễ hơn)">
                                                    <controls:SvgViewboxEx
                                                        Width="12" Height="12" 
                                                        Source="{Binding Source={x:Static sys:String.Empty}, 
                                                        Converter={StaticResource IconKeyToPathConverter}, 
                                                        ConverterParameter='arrow-down-long-to-line duotone'}"
                                                        Fill="{DynamicResource TextOnSecondaryBrush}"/>
                                                </Button>
                                                <Button x:Name="AddJsTabButton"
                                                        Content="+ Thêm JS"
                                                        Width="96"
                                                        Height="26"
                                                        Margin="0,0,6,0"
                                                        Cursor="Hand"
                                                        Click="AddJsTabButton_Click"
                                                        Style="{DynamicResource PrimaryButton}"
                                                        ToolTip="Tạo thêm tab JS mới để tách logic nhỏ, dễ maintain"/>
                                                <Button x:Name="DeleteJsTabButton"
                                                        Content="Xóa tab"
                                                        Width="74"
                                                        Height="26"
                                                        Cursor="Hand"
                                                        Click="DeleteJsTabButton_Click"
                                                        Style="{DynamicResource DangerButton}"
                                                        ToolTip="Xóa tab JS đang chọn (không cho xóa nếu chỉ còn 1 tab)"/>
                                            </StackPanel>
                                        </Grid>
                                        <TabControl x:Name="JsSubTabsControl"
                                                    Grid.Row="1"
                                                    Background="Transparent"
                                                    BorderThickness="0">
                                            <TabItem x:Name="JsPrimaryTabItem" Header="JS 1" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                                <controls:SyntaxHighlightCodeEditor x:Name="JsEditor"
                                                    CodeFontSize="{Binding CodeFontSize, Mode=TwoWay}"
                                                    SyntaxLanguage="JavaScript"
                                                    IsAutoHighlightEnabled="False"
                                                    MinHeight="250" Height="250"/>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Params (config)" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <Grid Margin="0,8,0,0">
                                        <controls:SyntaxHighlightCodeEditor x:Name="ParamsEditor" SyntaxLanguage="JavaScript" Text="{Binding ParamsCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" CodeFontSize="{Binding CodeFontSize, Mode=TwoWay}" MinHeight="250" Height="250"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Output keys" Style="{DynamicResource HttpTabItemStyle}" Background="Transparent" BorderThickness="0">
                                    <StackPanel Margin="0,8,0,8">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Output keys (dùng để đưa giá trị từ Sciter DOM ra các node khác):"
                                                       Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Đồng bộ Params" Height="32" Width="120" Margin="0,0,8,0"
                                                        Command="{Binding SyncOutputKeysFromParamsCommand}"
                                                        Style="{DynamicResource PrimaryButton}"/>
                                                <Button Content="+ Thêm output key" Height="32"
                                                        Command="{Binding AddOutputKeyCommand}"
                                                        Width="160"
                                                        Style="{DynamicResource PrimaryButton}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="220">
                                                <ItemsControl ItemsSource="{Binding OutputKeysList}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{DynamicResource BaseTextBoxV2}" Height="32" FontSize="13"/>
                                                                <Button Grid.Column="1" Content="−" Width="26" Height="26" Margin="8,0,0,0"
                                                                        Command="{Binding DataContext.RemoveOutputKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Foreground="{DynamicResource TextBrush}" Background="{DynamicResource DangerBrush}" BorderThickness="0" Cursor="Hand"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: Tái sử dụng flow -->
                <TabItem Header="Tái sử dụng flow" Style="{DynamicResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Cấu hình vị trí cổng IN/OUT -->
                            <TextBlock Text="Vị trí cổng IN/OUT"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Port IN -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Port IN"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding PortPositionOptions}"
                                                  SelectedItem="{Binding InputPortPosition, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- Port OUT -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Port OUT"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox Height="32"
                                                  Style="{DynamicResource BaseComboBox}"
                                                  ItemsSource="{Binding PortPositionOptions}"
                                                  SelectedItem="{Binding OutputPortPosition, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Cấu hình tái sử dụng flow -->
                            <ItemsControl x:Name="ReuseRoutesItemsControl" ItemsSource="{Binding ReuseRoutes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Background="{DynamicResource WindowBackground}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Node IN"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding IncomingNodeTitle}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Node OUT"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               Margin="0,0,0,4"/>
                                                    <controls:NodeSearchComboBoxUserControl Height="32"
                                                              ItemsSource="{Binding OutgoingOptions}"
                                                              SelectedValuePath="NodeId"
                                                              DisplayMemberPath="Title"
                                                              SelectedValue="{Binding SelectedOutgoingNodeId, Mode=TwoWay}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock Text="Kiểu line OUT"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="12"
                                                               Opacity="0.7"
                                                               Margin="0,0,0,4"/>
                                                    <ComboBox Height="32"
                                                              Style="{DynamicResource BaseComboBox}"
                                                              ItemsSource="{Binding DataContext.ConnectionLineStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Key"
                                                              DisplayMemberPath="DisplayName"
                                                              SelectedValue="{Binding SelectedLineStyleKey, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</local:BaseNodeDialog>
