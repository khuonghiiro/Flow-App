                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Content="Copy template" Height="24" Padding="8,0" Cursor="Hand" Click="CopyApiDocRow_Click"
Tag="// HTML gợi ý: &lt;div id='label'&gt;&lt;/div&gt; + &lt;div id='value'&gt;&lt;/div&gt;&#xA;(function(){&#xA;  var label = document.getElementById('label');&#xA;  var value = document.getElementById('value');&#xA;  if (typeof hostLive !== 'undefined' &amp;&amp; typeof hostLive.on === 'function') {&#xA;    hostLive.on('price','datas', function(price,datas){&#xA;      if (label) label.textContent = 'Realtime';&#xA;      if (value) value.textContent = (price != null &amp;&amp; price !== '') ? String(price) : JSON.stringify(datas || {});&#xA;    });&#xA;  }&#xA;})();"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource WarningColor}" FontWeight="SemiBold" TextWrapping="Wrap" Text="Template 2 - Submit + Run"/>
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" Text="Nhập data, submit + chạy workflow."/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Content="Copy template" Height="24" Padding="8,0" Cursor="Hand" Click="CopyApiDocRow_Click"
Tag="// HTML gợi ý: input#noteInput + div#resultBox + button#btnRun&#xA;(function(){&#xA;  var btn = document.getElementById('btnRun');&#xA;  var inp = document.getElementById('noteInput');&#xA;  var out = document.getElementById('resultBox');&#xA;  if (!btn) return;&#xA;  btn.addEventListener('click', function(){&#xA;    if (out &amp;&amp; inp) out.textContent = inp.value || '';&#xA;    if (typeof hostSubmit === 'function') hostSubmit();&#xA;    if (typeof hostStart === 'function') hostStart();&#xA;  });&#xA;})();"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource WarningColor}" FontWeight="SemiBold" TextWrapping="Wrap" Text="Template 3 - Full API demo"/>
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap" Text="Demo đầy đủ: Live data + Async + File API + Submit."/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Content="Copy template" Height="24" Padding="8,0" Cursor="Hand" Click="CopyApiDocRow_Click"
Tag="// FULL SCITER API DEMO&#xA;(function(){&#xA;&#xA;  // 1) Live data từ InputMappings&#xA;  if (typeof hostLive !== 'undefined' &amp;&amp; typeof hostLive.on === 'function') {&#xA;    hostLive.on('datas', function(datas){&#xA;      console.log('live datas', datas);&#xA;    });&#xA;  }&#xA;&#xA;  // 2) Async data từ Async Data tab&#xA;  if (typeof hostAsync !== 'undefined' &amp;&amp; typeof hostAsync.on === 'function') {&#xA;    hostAsync.on('jobResult', function(v){&#xA;      console.log('async jobResult', v);&#xA;    });&#xA;  }&#xA;&#xA;  // 3) Gọi host API&#xA;  if (typeof hostResolvePath === 'function') hostResolvePath('C:\\\\path\\\\video.mp4', 'req1');&#xA;  if (typeof hostCurl === 'function') hostCurl('curl --location &quot;https://example.com/a.mp4&quot;', 'a.mp4', 'k1');&#xA;  if (typeof hostPickImages === 'function') hostPickImages('img_req_1');&#xA;&#xA;  // 4) Submit + chạy&#xA;  if (typeof hostSubmit === 'function') hostSubmit();&#xA;  if (typeof sciterRunSingleNode === 'function') sciterRunSingleNode();&#xA;  if (typeof hostStart === 'function') hostStart();&#xA;})();"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab: 📦 Thư viện offline -->
                <TabItem Header="📦 Thư viện offline" Style="{DynamicResource HttpTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Tiêu đề + hướng dẫn -->
                            <Border Style="{DynamicResource DialogCardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📦 Thư viện JS/CSS offline"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" LineHeight="20">
                                        <Run Text="• Tải thư viện JS/CSS về máy một lần rồi dùng offline (không cần Internet khi chạy node)." Foreground="{DynamicResource TextSecondary}"/>
                                        <LineBreak/>
                                        <Run Text="• Thêm nhanh từ danh sách preset bên dưới, hoặc nhập URL / chọn file thủ công." Foreground="{DynamicResource TextSecondary}"/>
                                        <LineBreak/>
                                        <Run Text="• ☑ bật = tự động inject vào HTML khi node render. ☐ tắt = bỏ qua." Foreground="{DynamicResource TextSecondary}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ===== Preset phổ biến ===== -->
                            <TextBlock Text="⚡ Thêm nhanh từ preset phổ biến:"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Style="{DynamicResource DialogSectionBorder}"
                                    Margin="0,0,0,12"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <!-- ── Hàng JS ── -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{DynamicResource WarningBrush}"
                                                CornerRadius="4" Padding="8,3"
                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="JS" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextOnWarningBrush}"/>
                                        </Border>
                                        <TextBlock Text="JavaScript libraries"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ItemsControl x:Name="JsPresetsItemsControl" ItemsSource="{Binding PopularJsPresets}" Margin="0,0,0,2">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,6,6" MinWidth="148" MaxWidth="200" Padding="0" Click="AddPresetButton_Click" Tag="{Binding}" ToolTip="{Binding Description}" Cursor="Hand">
                                                    <StackPanel Margin="10,7,10,7">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource WarningBrush}">
                                                                <TextBlock Text="+ Thêm preset" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextOnWarningBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,6,0,10" Opacity="0.6"/>

                                    <!-- ── Hàng CSS ── -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="CSS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                                        </Border>
                                        <TextBlock Text="Stylesheet libraries" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ItemsControl x:Name="CssPresetsItemsControl" ItemsSource="{Binding PopularCssPresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,6,6" MinWidth="148" MaxWidth="200" Padding="0" Click="AddPresetButton_Click" Tag="{Binding}" ToolTip="{Binding Description}" Cursor="Hand">
                                                    <StackPanel Margin="10,7,10,7">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource PrimaryBrush}">
                                                                <TextBlock Text="+ Thêm preset" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ===== Thêm thủ công ===== -->
                            <TextBlock Text="✏ Thêm thủ công:" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tên hiển thị (Title)" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBox x:Name="NewAssetTitleBox" Style="{DynamicResource BaseTextBoxV2}" Height="30" FontSize="12" ToolTip="Ví dụ: Chart.js 4.x"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Loại" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="NewAssetTypeCombo" Height="30" Style="{DynamicResource BaseComboBox}" SelectedIndex="0">
                                                    <ComboBoxItem Content="JS"/>
                                                    <ComboBoxItem Content="CSS"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Mô tả (Description)" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NewAssetDescBox" Style="{DynamicResource BaseTextBoxV2}" Height="30" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBlock Text="URL tải về (hoặc để trống nếu chọn file local)" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NewAssetUrlBox" Style="{DynamicResource BaseTextBoxV2}" Height="30" FontSize="12"/>
                                        <TextBlock Text="Tên file lưu local (để trống = tự đặt từ URL)" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,8,0,4"/>
                                        <TextBox x:Name="NewAssetFileNameBox" Style="{DynamicResource BaseTextBoxV2}" Height="30" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button x:Name="AddAssetFromUrlButton" Content="⬇ Tải về" Height="36" Width="90" Margin="0,0,0,8" Style="{DynamicResource PrimaryButton}" Click="AddAssetFromUrl_Click"/>
                                        <Button x:Name="AddAssetFromFileButton" Content="📁 Chọn file" Height="36" Width="90" Style="{DynamicResource SecondaryButton}" Click="AddAssetFromFile_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ===== Danh sách assets ===== -->
                            <TextBlock Text="📋 Danh sách thư viện đã đăng ký:" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                    <ItemsControl x:Name="OfflineAssetsItemsControl" ItemsSource="{Binding OfflineAssetsList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Background="{DynamicResource WindowBackground}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,10,0"/>

                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <Border CornerRadius="4" Padding="5,2" Margin="0,0,6,0" Background="{DynamicResource WarningBrush}">
                                                                    <TextBlock Text="{Binding TypeBadge}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                                </Border>
                                                                <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaseTextBoxV2}" FontSize="13" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="120" MaxWidth="240"/>
                                                            </StackPanel>
                                                            <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaseTextBoxV2}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,4"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="File:" Foreground="{DynamicResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBox Text="{Binding LocalFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource BaseTextBoxV2}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource WarningColor}" Background="Transparent" BorderThickness="0" Padding="0" Width="180"/>
                                                                <TextBlock Text="|" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                                <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0">
                                                            <Button Content="⬇" Width="28" Height="28" Margin="0,0,0,4" Style="{DynamicResource SecondaryButton}" Click="DownloadAsset_Click" Tag="{Binding}"/>
                                                            <Button Content="🗑" Width="28" Height="28" Style="{DynamicResource DangerButton}" Command="{Binding DataContext.RemoveOfflineAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <TextBlock x:Name="AssetStatusText" Text="" Foreground="{DynamicResource WarningColor}" FontSize="12" Margin="0,0,0,8" HorizontalAlignment="Left" TextWrapping="Wrap"/>

                            <!-- Footer -->
                            <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="📁 Thư mục lưu assets:" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="AssetsFolderText" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontFamily="Consolas" ToolTip="Click để copy" Cursor="Hand" MouseDown="AssetsFolderText_MouseDown"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📂 Mở thư mục" Height="32" Width="110" Style="{DynamicResource SecondaryButton}" Click="OpenAssetsFolder_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</local:BaseNodeDialog>
