<UserControl x:Class="FlowMy.Views.NodeControls.ImageProcessingNodeContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:FlowMy.Models.Nodes"
             xmlns:controls="clr-namespace:FlowMy.Controls"
             xmlns:local="clr-namespace:FlowMy.Views.NodeControls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:FlowMy.Converters"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="640"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <local:IntToHashLabelConverter x:Key="IntToHashLabelConverter"/>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
        <sys:Double x:Key="WidgetCropOrderFontSize">10</sys:Double>
        <sys:Double x:Key="WidgetCropCheckFontSize">8</sys:Double>
        <sys:Double x:Key="WidgetCropDeleteFontSize">9</sys:Double>
        <sys:Double x:Key="WidgetRenderGroupTitleFontSize">9</sys:Double>

        <!-- Một dòng trong danh sách crop -->
        <DataTemplate x:Key="CropListItemTemplate" DataType="{x:Type models:ImageCropRegion}">
            <StackPanel Margin="1,0,1,4" Orientation="Horizontal" HorizontalAlignment="Stretch">
                <TextBlock Margin="0,0,4,0"
                           VerticalAlignment="Center" Opacity="0.7"
                           FontSize="{DynamicResource WidgetCropOrderFontSize}" FontWeight="Bold" Foreground="White"
                           Text="{Binding Order}"/>
                <Border Width="64" Margin="0,0,0,1"
                        Cursor="Hand" ToolTip="Click để mở Image Processor"
                        BorderThickness="2" CornerRadius="3"
                        Background="#1E000000"
                        BorderBrush="{Binding StrokeBrush}"
                        MouseLeftButtonDown="CropThumbBorder_MouseLeftButtonDown">
                    <Image MaxHeight="64" Stretch="Uniform" HorizontalAlignment="Left"
                           Source="{Binding Thumbnail}"/>
                </Border>
                <StackPanel Margin="4,0,0,0" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Left">
                    <CheckBox Margin="0,0,3,0" VerticalAlignment="Center"
                              FontSize="{DynamicResource WidgetCropCheckFontSize}" Foreground="Gold" ToolTip="Bật/tắt hiển thị vùng crop"
                              IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
                    <CheckBox Margin="0,0,3,0" VerticalAlignment="Center"
                              FontSize="{DynamicResource WidgetCropCheckFontSize}" Foreground="{DynamicResource PrimaryBrush}"
                              ToolTip="Ẩn nền polygon, đổi viền sang nét đứt"
                              IsChecked="{Binding IsOutlineOnly, Mode=TwoWay}"/>
                    <Button Content="X" Style="{DynamicResource DangerButton}"
                            Width="18" Height="18" FontSize="{DynamicResource WidgetCropDeleteFontSize}" Padding="0" Margin="0"
                            VerticalAlignment="Center" ToolTip="Xoá vùng crop này"
                            PreviewMouseLeftButtonUp="DeleteCropButton_PreviewMouseLeftButtonUp"
                            Click="DeleteCropButton_Click"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Nhóm ảnh render theo crop -->
        <DataTemplate x:Key="RenderGroupTemplate">
            <StackPanel Margin="0,0,0,6" Orientation="Vertical">
                <TextBlock Margin="0,0,0,2" FontSize="{DynamicResource WidgetRenderGroupTitleFontSize}" FontWeight="Bold" Foreground="White"
                           Text="{Binding Order, Converter={StaticResource IntToHashLabelConverter}}"/>
                <ItemsControl ItemsSource="{Binding RenderedImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="55" Margin="0,2,4,2"
                                    BorderBrush="#789CA3B8" BorderThickness="1" CornerRadius="3">
                                <Image MaxHeight="55" Stretch="Uniform" Source="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="6.2*"/>
            <ColumnDefinition Width="3.2*"/>
            <ColumnDefinition x:Name="IpColumnDefinition" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <Border x:Name="TopMenuBorder" Grid.Row="0" Grid.ColumnSpan="4"
                Background="#2DFFFFFF" Padding="8,4,8,4" Panel.ZIndex="10">
            <Border Background="Transparent" IsHitTestVisible="True">
                <DockPanel LastChildFill="True">
                    <Button x:Name="IpToggleButton" DockPanel.Dock="Right"
                            ToolTip="Ẩn/hiện Image Processor"
                            Width="28" Height="22" Padding="0"
                            Cursor="Hand" VerticalAlignment="Center"
                            Style="{DynamicResource DangerButton}"
                            Click="IpToggleButton_Click">
                        <controls:SvgViewboxEx x:Name="IpToggleIcon"
                                                Width="14" Height="14"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Fill="{DynamicResource WhiteBrush}"/>
                    </Button>

                    <!-- Mode toggle: AI | Editor — segment control -->
                    <Border DockPanel.Dock="Right" Margin="6,0,6,0" VerticalAlignment="Center"
                            Background="#18FFFFFF" CornerRadius="5"
                            Padding="2" BorderBrush="#252932"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnModeAI" Content="🤖 AI"
                                    Width="50" Height="20" FontSize="9" Padding="2,0"
                                    Cursor="Hand" ToolTip="Chế độ AI (crop + gửi xử lý)"
                                    BorderThickness="0"
                                    Click="BtnModeAI_Click"/>
                            <Button x:Name="BtnModeEditor" Content="🎨 Editor"
                                    Width="56" Height="20" FontSize="9" Padding="2,0"
                                    Cursor="Hand" ToolTip="Chế độ chỉnh sửa thủ công"
                                    BorderThickness="0"
                                    Click="BtnModeEditor_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ImageTitleTextBlock"
                               Text="Chưa có ảnh"
                               Foreground="{DynamicResource WhiteBrush}"
                               d:Foreground="White"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </DockPanel>
            </Border>
        </Border>

        <!-- Left toolbar -->
        <Border x:Name="LeftMenuBorder" Grid.Row="1" Grid.Column="0"
                Background="#28FFFFFF" Padding="4,0,4,6">
            <Viewbox x:Name="LeftMenuViewbox" Stretch="Uniform" StretchDirection="Both"
                     HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel Width="auto" Orientation="Vertical"
                            HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button x:Name="BtnOpenImage"  ToolTip="Mở ảnh"
                            Width="30" Height="30" Style="{DynamicResource PrimaryButton}"
                            FontSize="16" Padding="0" Margin="0,10,0,10" 
                            BorderBrush="White"
                            BorderThickness="1"
                            MouseLeftButtonDown="CommonButton_StopBubbling_MouseLeftButtonDown"
                            Click="BtnOpenImage_Click">
                        <controls:SvgViewboxEx Height="14"
                            Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder-open sharp-duotone-regular'}"
                            Fill="White"/>
                    </Button>
                    <Border BorderBrush="#78FFFFFF" BorderThickness="1" CornerRadius="4"
                            Padding="2" Margin="4,0,4,6">
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Button x:Name="ColorCropButton" Width="30" Height="30"
                                    Margin="0,0,0,10" BorderThickness="0" Cursor="Hand"
                                    Padding="0" ToolTip="Chọn màu viền/background vùng crop"
                                    Click="ColorCropButton_Click"/>
                            <Button x:Name="CropToolButton" 
                                    ToolTip="Crop ảnh (Alt + click trái trên ảnh để tạo điểm)"
                                    Style="{DynamicResource WarningButton}"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    Width="30" Height="30" FontSize="16" Padding="0"
                                    PreviewMouseLeftButtonDown="CommonButton_StopBubbling_MouseLeftButtonDown"
                                    Click="CropToolButton_Click">
                                <controls:SvgViewboxEx Height="16"
                                    Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='scissors light'}"
                                    Fill="White"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Background="Transparent" Width="22" Height="30" Margin="0,0,0,6"/>
                </StackPanel>
            </Viewbox>
        </Border>

        <!-- Left vertical/horizontal wrap toolbox: Editor mode (Photoshop-style) -->
        <Border x:Name="EditorToolbox" Grid.Row="1" Grid.Column="0"
                Background="#0a0c10" Padding="3,6,3,4"
                Visibility="Collapsed">
            <Border.Resources>
                <!-- ═══ Shared hover/active style cho tất cả FX buttons ═══ -->
                <Style x:Key="FxToolBtnStyle" TargetType="Border">
                    <Setter Property="Width" Value="32"/>
                    <Setter Property="Height" Value="32"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,0,2"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#20FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>

            <ScrollViewer VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="0" Margin="0">
                <!-- WrapPanel với Orientation=Vertical: các nhóm (StackPanel) tự wrap sang cột kế bên khi đầy chiều cao -->
                <WrapPanel Orientation="Vertical">
                    
                    <!-- ══════ GROUP: DRAWING TOOLS ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <Border x:Name="TbxBrush" Tag="Brush" ToolTip="Brush (B)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='paintbrush-fine duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="TbxEraser" Tag="Eraser" ToolTip="Eraser (E)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='eraser duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="TbxFill" Tag="Fill" ToolTip="Fill (G)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='fill-drip duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="TbxEyedropper" Tag="Eyedropper" ToolTip="Eyedropper (I)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='eye-dropper duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="TbxMove" Tag="Move" ToolTip="Move (V)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='arrows-up-down-left-right duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="TbxText" Tag="Text" ToolTip="Text (T)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='font duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="TbxSelection" Tag="Selection" ToolTip="Selection (M)"
                                Style="{StaticResource FxToolBtnStyle}"
                                MouseLeftButtonDown="EditorToolbox_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef"
                                Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='object-group duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Rectangle Height="1" Fill="#252932" Margin="2,4,2,4"/>
                        <Grid Width="32" Height="32" Margin="0,0,0,2">
                            <Border x:Name="TbxBgColor" Width="18" Height="18"
                                    Background="White" CornerRadius="3"
                                    BorderBrush="#252932" BorderThickness="1.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Cursor="Hand" ToolTip="Background color"
                                    MouseLeftButtonDown="EditorToolbox_BgColor_Click"/>
                            <Border x:Name="TbxFgColor" Width="18" Height="18"
                                    Background="Black" CornerRadius="3"
                                    BorderBrush="#dde3ef" BorderThickness="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Cursor="Hand" ToolTip="Foreground color"
                                    MouseLeftButtonDown="EditorToolbox_FgColor_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- ══════ GROUP: BLUR / SHARPEN ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="BLUR" FontSize="7" FontWeight="Bold" Foreground="#5a6072"
                                   HorizontalAlignment="Center" Margin="0,1,0,3"/>
                        <Border Tag="GaussianBlur" ToolTip="Gaussian Blur" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='droplet duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="MotionBlur" ToolTip="Motion Blur" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='wind duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="RadialBlur" ToolTip="Radial Blur" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='arrows-spin duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="AdaptiveBlur" ToolTip="Adaptive Blur" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='cloud duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Sharpen" ToolTip="Sharpen" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='diamond duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="UnsharpMask" ToolTip="Unsharp Mask" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='gem duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="AdaptiveSharpen" ToolTip="Adaptive Sharpen" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='bolt duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>

                    <!-- ══════ GROUP: ARTISTIC ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="ART" FontSize="7" FontWeight="Bold" Foreground="#5a6072"
                                   HorizontalAlignment="Center" Margin="0,1,0,3"/>
                        <Border Tag="OilPaint" ToolTip="Oil Paint" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Charcoal" ToolTip="Charcoal" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='pencil duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Sketch" ToolTip="Sketch" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='pen-nib duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Emboss" ToolTip="Emboss" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='cube duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Vignette" ToolTip="Vignette" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='circle duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Swirl" ToolTip="Swirl" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='hurricane duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Wave" ToolTip="Wave" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='water duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Spread" ToolTip="Spread" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='sparkles duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Implode" ToolTip="Implode" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='compress duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Shade" ToolTip="Shade" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='mountain duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Pixelate" ToolTip="Pixelate" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='grid duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>

                    <!-- ══════ GROUP: EDGE DETECTION ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="EDGE" FontSize="7" FontWeight="Bold" Foreground="#5a6072"
                                   HorizontalAlignment="Center" Margin="0,1,0,3"/>
                        <Border Tag="EdgeDetect" ToolTip="Edge Detect" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='vector-square duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="CannyEdge" ToolTip="Canny Edge" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='bullseye duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>

                    <!-- ══════ GROUP: COLOR ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="COLOR" FontSize="7" FontWeight="Bold" Foreground="#5a6072"
                                   HorizontalAlignment="Center" Margin="0,1,0,3"/>
                        <Border Tag="AutoLevel" ToolTip="Auto Level" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='sliders duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="AutoGamma" ToolTip="Auto Gamma" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='sun duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Equalize" ToolTip="Equalize" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='bars duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Normalize" ToolTip="Normalize" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='chart-bar duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Negate" ToolTip="Negate" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='circle-half duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Posterize" ToolTip="Posterize" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='swatchbook duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Solarize" ToolTip="Solarize" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='explosion duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="SepiaTone" ToolTip="Sepia" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='image duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Grayscale" ToolTip="Grayscale" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='moon duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="BrightnessUp" ToolTip="Brightness +" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='brightness duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="BrightnessDown" ToolTip="Brightness −" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='eclipse duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="GammaCorrect" ToolTip="Gamma" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='adjust duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="SaturationUp" ToolTip="Saturation +" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='rainbow duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="SaturationDown" ToolTip="Saturation −" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='filter duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Tint" ToolTip="Tint" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='feather duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>

                    <!-- ══════ GROUP: NOISE ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="NOISE" FontSize="7" FontWeight="Bold" Foreground="#5a6072"
                                   HorizontalAlignment="Center" Margin="0,1,0,3"/>
                        <Border Tag="AddNoiseGaussian" ToolTip="Noise (Gaussian)" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='signal duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="AddNoiseImpulse" ToolTip="Noise (Impulse)" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='burst duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Denoise" ToolTip="Denoise" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='broom duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="MedianFilter" ToolTip="Median Filter" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='shield duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="ReduceNoise" ToolTip="Reduce Noise" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='wand duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>

                    <!-- ══════ GROUP: MORPH ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="MORPH" FontSize="7" FontWeight="Bold" Foreground="#5a6072"
                                   HorizontalAlignment="Center" Margin="0,1,0,3"/>
                        <Border Tag="Dilate" ToolTip="Dilate" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='expand duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="MorphErode" ToolTip="Erode" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='compress duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Opening" ToolTip="Opening" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='atom duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Closing" ToolTip="Closing" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='fingerprint duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>

                    <!-- ══════ GROUP: XFORM ══════ -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="XFORM" FontSize="7" FontWeight="Bold" Foreground="#5a6072"
                                   HorizontalAlignment="Center" Margin="0,1,0,3"/>
                        <Border Tag="Deskew" ToolTip="Deskew" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='rotate duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="Trim" ToolTip="Trim" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='crop duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <Border Tag="AutoOrient" ToolTip="Auto Orient" Style="{StaticResource FxToolBtnStyle}" MouseLeftButtonDown="MagickEffect_Click">
                            <controls:SvgViewboxEx Width="16" Height="16" Fill="#dde3ef" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='compass duotone'}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>

                </WrapPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ LOADING OVERLAY (during FX processing) ═══ -->
        <Border x:Name="FxLoadingOverlay" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                Background="#B0000000" Panel.ZIndex="200"
                Visibility="Collapsed" IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center"/>
                <TextBlock x:Name="FxLoadingText" Text="Đang xử lý..."
                           Foreground="#dde3ef" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,6,0,4"/>
                <TextBlock Text="Nhấn ESC để huỷ" Foreground="#5a6072" FontSize="10"
                           HorizontalAlignment="Center" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Center: image -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Padding="0" Focusable="True">
            <Grid x:Name="ScrollContentGrid"
                  MinWidth="{Binding ElementName=MainScrollViewer, Path=ViewportWidth}"
                  MinHeight="{Binding ElementName=MainScrollViewer, Path=ViewportHeight}">
                <Grid x:Name="ImageAreaGrid"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="ImageZoomScale" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <Image x:Name="MainImage" Stretch="Uniform"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <TextBlock x:Name="PlaceholderTextBlock"
                               Text="Chưa có ảnh. Mở dialog (chuột phải hoặc nút Mở) để dán link/base64."
                               Foreground="#B0BEC5" FontSize="16" TextWrapping="Wrap"
                               Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Opacity="0.85"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Right panel: AI mode (crops + renders) -->
        <Border x:Name="RightMenuBorder" Grid.Row="1" Grid.Column="2"
                Background="#28000000" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="CropsLabelText" Text="Danh sách ảnh cắt"
                                   Foreground="White" FontSize="11" Opacity="0.7"
                                   Margin="0,0,0,4" HorizontalAlignment="Left"/>
                        <ItemsControl x:Name="CropsListControl"
                                      ItemTemplate="{StaticResource CropListItemTemplate}"
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="RenderLabelText" Text="Ảnh render"
                                   Foreground="White" FontSize="11" Opacity="0.7"
                                   Margin="0,4,0,4" HorizontalAlignment="Left"/>
                        <ItemsControl x:Name="RenderGroupsControl"
                                      ItemTemplate="{StaticResource RenderGroupTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right panel: Editor mode (layers, tools, colors) -->
        <local:ImageEditorPanel x:Name="EditorPanel" Grid.Row="1" Grid.Column="2"
                                Visibility="Collapsed"/>

        <!-- Magnifier (Alt), same cell as image -->
        <Grid x:Name="MagOverlayPanel" Grid.Row="1" Grid.Column="1"
              Width="124" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,8,8" Panel.ZIndex="100"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Width="124" Height="124"
                    BorderBrush="#FFFFD700" BorderThickness="2"
                    Background="#CC1E1E2E" CornerRadius="4"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid Width="120" Height="120" ClipToBounds="True" IsHitTestVisible="False">
                    <Image x:Name="MagZoomImage" Width="120" Height="120"
                           Stretch="Uniform" IsHitTestVisible="False"/>
                    <Line X1="0" Y1="60" X2="120" Y2="60" StrokeThickness="0.8"
                          IsHitTestVisible="False" Stroke="#78FF0000"/>
                    <Line X1="60" Y1="0" X2="60" Y2="120" StrokeThickness="0.8"
                          IsHitTestVisible="False" Stroke="#78FF0000"/>
                    <Ellipse Width="10" Height="10" Stroke="Red" StrokeThickness="1.5"
                             Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <TextBlock x:Name="MagCoordTextBlock" Grid.Row="1"
                       Foreground="White" FontSize="9"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,2" IsHitTestVisible="False"/>
        </Grid>

        <!-- Image Processor (code gán Content từ BuildImageProcessorColumn) -->
        <ContentControl x:Name="IpProcessorHost" Grid.Row="0" Grid.Column="3"
                        Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
