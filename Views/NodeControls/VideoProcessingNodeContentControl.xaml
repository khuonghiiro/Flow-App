                            </Button>
                            <Button x:Name="SkipForwardButton" Grid.Column="4" Width="28" Height="28" Padding="0" Style="{StaticResource IconButtonStyle}" ToolTip="Tiến 5 giây">
                                <controls:SvgViewboxEx Width="14" Height="14"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
