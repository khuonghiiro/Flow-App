                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="RESOLUTION" FontSize="9" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/><TextBlock x:Name="StatResolutionText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/></StackPanel>
