                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="FrameResizeSlider"
                                                    Minimum="0.4"
                                                    Maximum="1.0"
                                                    Value="1.0"
