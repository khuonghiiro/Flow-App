                                                           HorizontalAlignment="Center"
                                                           Text="1920×1080"/>
                                            </Border>
                                        </Grid>
                                        <CheckBox x:Name="ExtractAllFramesCheckBox" Content="Tách tất cả frame" Style="{StaticResource ReadableCheckBoxStyle}" ToolTip="Lấy toàn bộ frame theo FPS gốc của video."/>
