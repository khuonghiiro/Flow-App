<UserControl x:Class="FlowMy.Views.NodeControls.VideoProcessingNodeContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlowMy.Controls"
             xmlns:models="clr-namespace:FlowMy.Models.Nodes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:FlowMy.Converters"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>

        <!-- Spacing tokens (4px grid) -->
        <sys:Double x:Key="space-xs">4</sys:Double>
        <sys:Double x:Key="space-sm">8</sys:Double>
        <sys:Double x:Key="space-md">12</sys:Double>
        <sys:Double x:Key="space-lg">16</sys:Double>
        <sys:Double x:Key="space-xl">24</sys:Double>

        <!-- Modern Dark Color System Tokens -->
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#161722"/>
        <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#28293D"/>
        <SolidColorBrush x:Key="ThemeInnerCardBackgroundBrush" Color="#1C1D2C"/>
        <SolidColorBrush x:Key="ThemeInnerCardBorderBrush" Color="#2E3048"/>
        <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#212234"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#363854"/>
        <SolidColorBrush x:Key="ThemeInputForegroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ThemeOverlayBackgroundBrush" Color="#EE141522"/>
        <SolidColorBrush x:Key="ThemeOverlayBorderBrush" Color="#3F4263"/>
        <SolidColorBrush x:Key="ThemeTimelinePanelBrush" Color="#11121C"/>
        <SolidColorBrush x:Key="ThemeTrackBackgroundBrush" Color="#2D2E45"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="ThemeTabNavBackgroundBrush" Color="#141520"/>
        <SolidColorBrush x:Key="ThemeLogContainerBackgroundBrush" Color="#10111A"/>
        <SolidColorBrush x:Key="ThemeActionBarBackgroundBrush" Color="#141520"/>
        <SolidColorBrush x:Key="ThemeActionBarBorderBrush" Color="#40F59E0B"/>
        <SolidColorBrush x:Key="ThemeWarmAccentBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="ThemeWarmAccentBrushSoft" Color="#50F59E0B"/>
        <SolidColorBrush x:Key="ThemeBottomBarGroupInactiveBorderBrush" Color="#44909AA8"/>
        <SolidColorBrush x:Key="ThemeBottomBarActiveGroupBackgroundBrush" Color="#22F59E0B"/>
        <SolidColorBrush x:Key="ThemeVideoChromePrimaryBgBrush" Color="#2D2E44"/>
        <SolidColorBrush x:Key="ThemeVideoChromePrimaryHoverBgBrush" Color="#3B3C58"/>
        <SolidColorBrush x:Key="ThemeVideoChromePrimaryFgBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ThemeVideoChromePrimaryBorderBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="ThemeVideoChromeSecondaryBgBrush" Color="#222334"/>
        <SolidColorBrush x:Key="ThemeVideoChromeSecondaryHoverBgBrush" Color="#2E3046"/>
        <SolidColorBrush x:Key="ThemeVideoChromeSecondaryFgBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ThemeVideoChromeSecondaryBorderBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="ThemeVideoOpenButtonFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeValueBadgeBackgroundBrush" Color="#25273A"/>
        <SolidColorBrush x:Key="ThemeTransportPlayBgBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="ThemeTransportPlayHoverBgBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="ThemeTransportPlayFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeTransportIconHoverBgBrush" Color="#2A2C42"/>
        <SolidColorBrush x:Key="ThemeQuickOverlayHoverBgBrush" Color="#32344D"/>
        <SolidColorBrush x:Key="ThemePresetChipBgBrush" Color="#212233"/>
        <SolidColorBrush x:Key="ThemePresetChipBorderBrush" Color="#353752"/>
        <SolidColorBrush x:Key="ThemePresetChipHoverBgBrush" Color="#2E3048"/>
        <SolidColorBrush x:Key="ThemePresetChipPressedBgBrush" Color="#27293D"/>
        <SolidColorBrush x:Key="ThemePresetChipResetBgBrush" Color="#252330"/>
        <SolidColorBrush x:Key="ThemePresetChipResetBorderBrush" Color="#4A3B45"/>
        <SolidColorBrush x:Key="ThemeOnAccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeSliderThumbBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeComboPopupBackgroundBrush" Color="#1D1E2C"/>
        <SolidColorBrush x:Key="ThemeComboItemHoverBrush" Color="#31334B"/>
        <SolidColorBrush x:Key="ThemeComboSelectedItemBrush" Color="#446366F1"/>
        <SolidColorBrush x:Key="ThemeTabHoverBrush" Color="#26273B"/>
        <SolidColorBrush x:Key="ThemeTabSelectedBackgroundBrush" Color="#E66366F1"/>
        <SolidColorBrush x:Key="ThemeVideoLogSegmentTrackBrush" Color="#212232"/>
        <SolidColorBrush x:Key="ThemeActionExtractBrush" Color="#262E8FF9"/>
        <SolidColorBrush x:Key="ThemeActionSubtitleBrush" Color="#266366F1"/>
        <SolidColorBrush x:Key="ThemeActionWatermarkBrush" Color="#2614B8A6"/>
        <SolidColorBrush x:Key="ThemeActionConvertBrush" Color="#26A78BFA"/>
        <SolidColorBrush x:Key="ThemeActionTrimBrush" Color="#26EF4444"/>
        <SolidColorBrush x:Key="ThemeActionSnapshotBrush" Color="#26F59E0B"/>
        <SolidColorBrush x:Key="ThemeActionFolderVideoBrush" Color="#264ADE80"/>
        <SolidColorBrush x:Key="ThemeActionFolderFramesBrush" Color="#26F59E0B"/>
        <SolidColorBrush x:Key="ThemeOpenVideoBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="ThemeOpenVideoHoverBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="ThemeOpenVideoPressedBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="ThemeTimelineTrackBrush" Color="#32344A"/>
        <SolidColorBrush x:Key="ThemeTimelineProgressBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="ThemeSliderActiveBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="ThemeTimelineThumbStrokeBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeFrameLabelPreviewBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ThemeFrameLabelPreviewFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="ThemeVideoViewportBrush" Color="#090A10"/>
        <SolidColorBrush x:Key="ThemePanelHeaderBrush" Color="#1E1F30"/>
        <SolidColorBrush x:Key="ThemePanelHeaderBorderBrush" Color="#32354E"/>

        <!-- Reusable Card Styles -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="InnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeInnerCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInnerCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ValueBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeValueBadgeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInnerCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Button Styles -->
        <Style x:Key="VideoOpenPrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource ThemeOpenVideoBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeVideoOpenButtonFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeOpenVideoHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeOpenVideoPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VideoChromePrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeVideoChromePrimaryFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FillBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PrimaryScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="PrimaryTranslate" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBd" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillBd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FillBd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VideoChromeSecondaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource ThemeVideoChromeSecondaryBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeVideoChromeSecondaryFgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInnerCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FillBd2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SecondaryScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="SecondaryTranslate" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBd2" Property="Background" Value="{DynamicResource ThemeVideoChromeSecondaryHoverBgBrush}"/>
                                <Setter TargetName="FillBd2" Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillBd2" Property="Background" Value="#1A1B28"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FillBd2" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VideoChromeResetButtonStyle" TargetType="Button" BasedOn="{StaticResource VideoChromeSecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#4A2528"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FillBdReset"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBdReset" Property="Background" Value="#321D22"/>
                                <Setter TargetName="FillBdReset" Property="BorderBrush" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aspect Ratio Radio Style -->
        <Style x:Key="AspectRadioStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="IbFill"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IbFill" Property="Background" Value="{DynamicResource ThemeTabHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IbFill" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="IbFill" Property="BorderBrush" Value="#818CF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeTransportIconHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E2030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeTransportPlayBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTransportPlayFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="PlayBd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="19"
                                    SnapsToDevicePixels="True"/>
                            <Border x:Name="PlayRing"
                                    BorderBrush="#818CF8"
                                    BorderThickness="2"
                                    CornerRadius="19"
                                    Opacity="0.4"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlayBd" Property="Background" Value="{DynamicResource ThemeTransportPlayHoverBgBrush}"/>
                                <Setter TargetName="PlayRing" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PlayBd" Property="Background" Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickOverlayIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeQuickOverlayHoverBgBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Chip Button Style -->
        <Style x:Key="PresetChipStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{DynamicResource ThemePresetChipBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePresetChipBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ChipBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource ThemePresetChipHoverBgBrush}"/>
                                <Setter TargetName="ChipBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource ThemePresetChipPressedBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetChipResetStyle" TargetType="Button" BasedOn="{StaticResource PresetChipStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemePresetChipResetBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePresetChipResetBorderBrush}"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ChipWarm" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipWarm" Property="Background" Value="#382025"/>
                                <Setter TargetName="ChipWarm" Property="BorderBrush" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Dark Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <controls:SvgViewboxEx Grid.Column="1" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource ThemeTextSecondaryBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='chevron-down duotone-light'}"/>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource ThemeComboPopupBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer Margin="4">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeComboItemHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeComboSelectedItemBrush}"/>
                                <Setter Property="Foreground" Value="#818CF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Red Slider Style with Round Circle Thumb (Material Design 2 Style) -->
        <Style x:Key="SliderDecreaseTrackStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4"
                                Margin="7,0,-14,0"
                                CornerRadius="2"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderIncreaseTrackStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="Transparent" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSliderThumbStyle" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid x:Name="ThumbRoot" Width="28" Height="28" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Material Hover / Active Ripple Halo Ring -->
                            <Ellipse x:Name="HaloRing"
                                     Width="0" Height="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                     Opacity="0"/>

                            <!-- Circular Main Thumb -->
                            <Ellipse x:Name="ThumbCircle"
                                     Width="14" Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                     Stroke="{DynamicResource ThemeSliderThumbStrokeBrush}"
                                     StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HaloRing" Property="Opacity" Value="0.25"/>
                                <Setter TargetName="HaloRing" Property="Width" Value="24"/>
                                <Setter TargetName="HaloRing" Property="Height" Value="24"/>
                                <Setter TargetName="ThumbCircle" Property="Width" Value="16"/>
                                <Setter TargetName="ThumbCircle" Property="Height" Value="16"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="HaloRing" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="HaloRing" Property="Width" Value="28"/>
                                <Setter TargetName="HaloRing" Property="Height" Value="28"/>
                                <Setter TargetName="ThumbCircle" Property="Width" Value="18"/>
                                <Setter TargetName="ThumbCircle" Property="Height" Value="18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource ThemeTrackBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSliderActiveBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="1" Height="28" Background="Transparent" VerticalAlignment="Center" ClipToBounds="True">
                                <Grid VerticalAlignment="Center">
                                    <!-- Inactive Track (Full background bar aligned to circle bounds) -->
                                    <Border x:Name="InactiveTrack"
                                            Height="4"
                                            Margin="7,0,7,0"
                                            CornerRadius="2"
                                            Background="{TemplateBinding Background}"
                                            VerticalAlignment="Center"/>

                                    <!-- Active Track (Decrease) + Inactive Click Target (Increase) + Thumb -->
                                    <Track x:Name="PART_Track" VerticalAlignment="Center">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource SliderDecreaseTrackStyle}" Command="{x:Static Slider.DecreaseLarge}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource SliderIncreaseTrackStyle}" Command="{x:Static Slider.IncreaseLarge}"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb" Style="{StaticResource ModernSliderThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Khi Disabled: đổi màu active track và chấm tròn sang màu đỏ nhạt -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeSliderDisabledBrush}"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Slider" BasedOn="{StaticResource ModernSliderStyle}"/>

        <!-- Pill Tab Navigation Style -->
        <Style x:Key="PillTabNavStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="Margin" Value="0,0,6,6"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemRoot"
                                            Background="{DynamicResource ThemeInnerCardBackgroundBrush}"
                                            BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter x:Name="ContentSite" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ThemeTabHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                            <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#818CF8"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Portrait Tab Style -->
        <Style x:Key="VideoPortraitEqualTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" ClipToBounds="True" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="{DynamicResource ThemeTabNavBackgroundBrush}"/>
                            <Border Grid.Row="1" Background="{DynamicResource ThemeCardBackgroundBrush}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TabItem">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Grid>
                                        <Border x:Name="Bd" Background="Transparent" Padding="16,8">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <Border x:Name="Indicator" Height="2" VerticalAlignment="Bottom" Background="Transparent"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="RootGrid" Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Track"
                                    Width="42" Height="24"
                                    CornerRadius="12"
                                    Background="{DynamicResource ThemeTrackBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeInnerCardBorderBrush}"
                                    BorderThickness="1.5">
                                <Grid VerticalAlignment="Center">
                                    <!-- Glow Ring around Thumb when checked/hovered -->
                                    <Ellipse x:Name="ThumbGlow"
                                             Width="24" Height="24"
                                             HorizontalAlignment="Left"
                                             Margin="0,0,0,0"
                                             Fill="#30818CF8"
                                             Opacity="0"/>

                                    <!-- Circular Thumb -->
                                    <Ellipse x:Name="Thumb"
                                             Width="16" Height="16"
                                             HorizontalAlignment="Left"
                                             Margin="3,0,0,0"
                                             Fill="#94A3B8">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.4"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#818CF8"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="ThumbGlow" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="ThumbGlow" Property="Margin" Value="0,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="18"/>
                                <Setter TargetName="Thumb" Property="Height" Value="14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitchStyle}"/>

        <Style x:Key="ReadableCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="Bd" Width="16" Height="16" CornerRadius="4" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1" Margin="0,0,6,0">
                                <controls:SvgViewboxEx x:Name="CheckMark" Width="10" Height="10" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='check duotone-light'}" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootContentGrid" Margin="12,10,12,14"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True"
          TextOptions.TextHintingMode="Fixed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header Card -->
        <Border Grid.Row="0" x:Name="HeaderCardBorder" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions> 
                <controls:SvgViewboxEx Grid.Column="0" x:Name="IconView" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource ThemeAccentBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="OpenVideoButtonHeader"
                            Height="32"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Style="{StaticResource VideoOpenPrimaryButtonStyle}"
                            Click="OpenVideoButton_Click"
                            ToolTip="Mở video từ máy tính">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="14" Height="14" Margin="0,0,6,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder-open duotone-light'}"/>
                            <TextBlock Text="Mở video" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveEditedVideoButton"
                            Height="32"
                            Padding="14,0"
                            Style="{StaticResource VideoChromePrimaryButtonStyle}"
                            ToolTip="Lưu video đã chỉnh sửa">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="14" Height="14" Margin="0,0,6,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='floppy-disk-pen sharp-duotone-light'}"/>
                            <TextBlock Text="Lưu video" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock x:Name="VideoPathText"
                               FontSize="10"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               Opacity="0.8"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               Margin="0,3,0,0"
                               FontFamily="Segoe UI"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeModeButton" Width="34" Height="32" MinWidth="34" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Đổi sáng/tối" Margin="0,0,6,0">
                        <controls:SvgViewboxEx Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='sun-bright duotone-light'}"/>
                    </Button>
                    <Button x:Name="ToggleNodeSizeButton" Width="34" Height="32" MinWidth="34" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Phóng to/thu nhỏ node video" Margin="0,0,6,0">
                        <controls:SvgViewboxEx Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='expand utility-fill-semibold'}"/>
                    </Button>
                    <Button Visibility="Collapsed" x:Name="RunProcessingButton" Height="32" MinWidth="100" Padding="14,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Chạy xử lý video qua FFmpeg">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='play duotone-light'}"/>
                            <TextBlock Text="Chạy" Margin="6,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320"/>
                <ColumnDefinition Width="3*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Video Viewport & Timeline Scrubber & Log -->
            <Border Grid.Column="0" x:Name="PreviewContainerBorder" Style="{StaticResource GlassCardStyle}" Margin="0,0,10,0" Padding="0" ClipToBounds="True" VerticalAlignment="Stretch">
                <Grid x:Name="PreviewColumnShellGrid">
                    <Grid x:Name="VideoContainerGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Hidden aspect ratio & preview status controls (preserved for C# code-behind compatibility) -->
                <Grid Grid.Row="0" Visibility="Collapsed">
                    <RadioButton x:Name="Aspect169" IsChecked="True"/>
                    <RadioButton x:Name="Aspect916"/>
                    <RadioButton x:Name="Aspect11"/>
                    <RadioButton x:Name="Aspect32"/>
                    <RadioButton x:Name="Aspect23"/>
                    <RadioButton x:Name="AspectAuto"/>
                    <Border x:Name="HwBadge"/>
                    <Ellipse x:Name="LiveDot"/>
                    <Button x:Name="ToggleBeforeAfterButton"/>
                </Grid>

                <!-- Unified Video Player Card (Viewport + Scrubber Timeline + Transport Controls) -->
                <Border Grid.Row="1"
                        x:Name="VideoPlayerCardBorder"
                        Margin="10,10,10,0"
                        CornerRadius="0,0,10,10"
                        Background="{DynamicResource ThemeVideoViewportBrush}"
                        BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Video Display Viewport -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Integrated Timeline Panel & Scrubber Track -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Video Display Viewport -->
                        <Border Grid.Row="0"
                                x:Name="VideoViewportClipBorder"
                                Margin="0"
                                CornerRadius="0"
                                Background="{DynamicResource ThemeVideoViewportBrush}"
                                ClipToBounds="True">
                            <Grid>
                                <Viewbox x:Name="VideoViewbox" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <MediaElement x:Name="PreviewMedia"
                                                  LoadedBehavior="Manual"
                                                  UnloadedBehavior="Manual"
                                                  Stretch="Uniform"
                                                  Width="1280"
                                                  Height="720"
                                                  Volume="0.7"
                                                  ScrubbingEnabled="False"
                                                  Visibility="Collapsed"
                                                  Cursor="Hand"/>
                                </Viewbox>
                                <Grid x:Name="VideoAreaGrid">
                                    <Grid x:Name="PreviewPlaceholder"
                                          Panel.ZIndex="10"
                                          Visibility="Visible">
                                        <Border CornerRadius="12"
                                                BorderThickness="0"
                                                Background="{DynamicResource ThemeOverlayBackgroundBrush}"
                                                Padding="28,20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <Rectangle RadiusX="12" RadiusY="12"
                                                           Stroke="{DynamicResource ThemeAccentBrush}"
                                                           StrokeThickness="1.5"
                                                           StrokeDashArray="5,4"
                                                           Opacity="0.8"/>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                                    <controls:SvgViewboxEx Width="44" Height="44" Margin="0" Opacity="0.8" HorizontalAlignment="Center" Fill="{DynamicResource ThemeAccentBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='cloud-arrow-down duotone-light'}"/>
                                                    <TextBlock Text="Kéo thả video vào đây"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                               Margin="0,10,0,0"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="hoặc nhấn nút Mở video ở trên thanh công cụ"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <Border x:Name="GradingOverlay"
                                        Panel.ZIndex="2"
                                        Background="Transparent"
                                        IsHitTestVisible="False"/>
                                <Image x:Name="WatermarkPreviewImage"
                                       Panel.ZIndex="2"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False"/>
                                <controls:OverlayCanvas x:Name="OverlayCanvasControl"
                                                         Panel.ZIndex="3"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"/>

                                <!-- Quick Color Grade Floating Box -->
                                <Border x:Name="QuickGradingPanel"
                                        Panel.ZIndex="5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="10,0,0,10"
                                        Padding="10,8"
                                        CornerRadius="10"
                                        Background="{DynamicResource ThemeOverlayBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeOverlayBorderBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel Width="170">
                                        <TextBlock Text="Quick Color Grade" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Sáng" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider x:Name="QuickBrightnessSlider" Grid.Column="1" Minimum="-1" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            <TextBlock x:Name="QuickBrightnessLabel" Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Tương phản" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider x:Name="QuickContrastSlider" Grid.Column="1" Minimum="0.1" Maximum="3" Style="{StaticResource ModernSliderStyle}"/>
                                            <TextBlock x:Name="QuickContrastLabel" Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Bão hòa" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider x:Name="QuickSaturationSlider" Grid.Column="1" Minimum="0" Maximum="3" Style="{StaticResource ModernSliderStyle}"/>
                                            <TextBlock x:Name="QuickSaturationLabel" Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Quick Preview Quality Panel -->
                                <Border x:Name="QuickPreviewQualityPanel"
                                        Panel.ZIndex="5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="10,0,0,10"
                                        Padding="10,6"
                                        CornerRadius="10"
                                        Background="{DynamicResource ThemeOverlayBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeOverlayBorderBrush}" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Preview Quality"
                                                   Margin="0,0,8,0"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <ComboBox x:Name="PreviewQualityCombo"
                                                  Width="110"
                                                  Height="24"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  ToolTip="Chất lượng hiển thị preview tại khung video">
                                            <ComboBoxItem Content="Auto" Tag="auto"/>
                                            <ComboBoxItem Content="144p" Tag="144"/>
                                            <ComboBoxItem Content="240p" Tag="240"/>
                                            <ComboBoxItem Content="480p" Tag="480"/>
                                            <ComboBoxItem Content="720p" Tag="720"/>
                                            <ComboBoxItem Content="1080p" Tag="1080"/>
                                            <ComboBoxItem Content="2K" Tag="1440"/>
                                            <ComboBoxItem Content="4K" Tag="2160"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Floating Quick Overlay Actions -->
                                <StackPanel x:Name="QuickOverlayButtonsPanel"
                                            Panel.ZIndex="5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Orientation="Vertical"
                                            Margin="0,0,10,10">
                                    <Button x:Name="ToggleQuickGradeButton" Width="32" Height="32" Padding="0" Style="{StaticResource QuickOverlayIconButtonStyle}" Background="{DynamicResource ThemeOverlayBackgroundBrush}" ToolTip="Quick Color Grade" Margin="0,0,0,6">
                                        <controls:SvgViewboxEx Width="15" Height="15"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='display-code duotone-light'}"/>
                                    </Button>
                                    <Button x:Name="QuickSnapshotButton" Width="32" Height="32" Padding="0" Style="{StaticResource QuickOverlayIconButtonStyle}" Background="{DynamicResource ThemeOverlayBackgroundBrush}" ToolTip="Chụp Snapshot nhanh" Margin="0,0,0,6">
                                        <controls:SvgViewboxEx Width="15" Height="15"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='camera-retro duotone-light'}"/>
                                    </Button>
                                    <Button x:Name="QuickSetTrimButton" Width="32" Height="32" Padding="0" Style="{StaticResource QuickOverlayIconButtonStyle}" Background="{DynamicResource ThemeOverlayBackgroundBrush}" ToolTip="Đánh dấu mốc Trim">
                                        <controls:SvgViewboxEx Width="15" Height="15"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='scissors duotone-light'}"/>
                                    </Button>
                                </StackPanel>

                                <!-- Floating Info overlays -->
                                <Border x:Name="FrameInfoOverlay"
                                        Panel.ZIndex="4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,10,0,0"
                                        Padding="12,5"
                                        CornerRadius="8"
                                        Background="{DynamicResource ThemeOverlayBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                                        BorderThickness="1"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False">
                                    <TextBlock x:Name="FrameInfoText" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                </Border>
                                <Border x:Name="FrameLabelPreviewOverlay"
                                        Panel.ZIndex="5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="12"
                                        Padding="10,6"
                                        CornerRadius="0"
                                        Background="{DynamicResource ThemeFrameLabelPreviewBg}"
                                        BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                                        BorderThickness="0"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False">
                                    <TextBlock x:Name="FrameLabelPreviewText"
                                               Text="Frame 0 - 00:00:00"
                                               FontFamily="Segoe UI Semibold"
                                               VerticalAlignment="Top"
                                               HorizontalAlignment="Left"
                                               Margin="0,-1.5,0,0"
                                               TextTrimming="None"
                                               TextWrapping="NoWrap"
                                               Foreground="{DynamicResource ThemeFrameLabelPreviewFg}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Integrated Timeline Panel & Scrubber Track -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource ThemeTimelinePanelBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10"
                                Padding="14,10,14,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TimeCurrentText" Text="00:00" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Grid Grid.Column="1" Height="28" MinHeight="28" Cursor="Hand" x:Name="ProgressBarHitArea"
                                          VerticalAlignment="Center" Background="Transparent" ClipToBounds="True"
                                          PreviewMouseLeftButtonDown="ProgressBarHitArea_MouseDown"
                                          PreviewMouseMove="ProgressBarHitArea_MouseMove"
                                          PreviewMouseLeftButtonUp="ProgressBarHitArea_MouseUp"
                                          MouseEnter="ProgressBarHitArea_MouseEnter"
                                          MouseLeave="ProgressBarHitArea_MouseLeave">
                                        <Border Background="{DynamicResource ThemeTimelineTrackBrush}" CornerRadius="2" Height="4" Margin="7,0,7,0" VerticalAlignment="Center"/>
                                        <Border x:Name="ProgressBarFill" Background="{DynamicResource ThemeSliderActiveBrush}" CornerRadius="2" Height="4" Margin="7,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                                        <Canvas VerticalAlignment="Center" Height="28">
                                            <Ellipse x:Name="ProgressThumb" Width="14" Height="14" Canvas.Top="7" Visibility="Visible"
                                                     Fill="{DynamicResource ThemeSliderActiveBrush}"
                                                     Stroke="{DynamicResource ThemeTimelineThumbStrokeBrush}" StrokeThickness="2">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
                                                </Ellipse.Effect>
                                                <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="ProgressThumbScale" ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Canvas>
                                    </Grid>
                                    <TextBlock x:Name="TimeTotalText" Grid.Column="2" Text="00:00" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="SeekPerfText"
                                           Margin="0,0,0,8"
                                           FontSize="9.5"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           Text="Preview: NORMAL | Seek: -- ms"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SkipBackButton" Grid.Column="0" Width="30" Height="30" Padding="0" Style="{StaticResource IconButtonStyle}" ToolTip="Lùi 5 giây">
                                        <controls:SvgViewboxEx Width="14" Height="14"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='backward regular'}"/>
                                    </Button>
                                    <Button x:Name="PlayPauseButton" Grid.Column="2" Width="36" Height="36" Padding="0" Style="{StaticResource PlayButtonStyle}">
                                        <controls:SvgViewboxEx Width="14" Height="14" Margin="2,0,0,0"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='play regular'}"/>
                                    </Button>
                                    <Button x:Name="SkipForwardButton" Grid.Column="4" Width="30" Height="30" Padding="0" Style="{StaticResource IconButtonStyle}" ToolTip="Tiến 5 giây">
                                        <controls:SvgViewboxEx Width="14" Height="14"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='forward sharp-regular'}"/>
                                    </Button>
                                    <Button x:Name="StopButton" Grid.Column="6" Width="30" Height="30" Padding="0" Style="{StaticResource IconButtonStyle}" ToolTip="Dừng">
                                        <controls:SvgViewboxEx Width="14" Height="14"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='stop sharp-regular'}"/>
                                    </Button>
                                    <Button x:Name="MuteButton" Grid.Column="8" Width="30" Height="30" Padding="0" Style="{StaticResource IconButtonStyle}" FontSize="11" ToolTip="Bật/Tắt âm">
                                        <controls:SvgViewboxEx Width="14" Height="14"
                                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='volume-high duotone-light'}"/>
                                    </Button>
                                    <Slider x:Name="VolumeSlider" Grid.Column="9" Minimum="0" Maximum="1" Value="0.7" VerticalAlignment="Center" Margin="4,0" Style="{StaticResource ModernSliderStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Console & Progress Log Card -->
                <Border x:Name="LogPanelBorder" Grid.Row="3" Margin="10,8,10,10" Background="{DynamicResource ThemeLogContainerBackgroundBrush}" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource ThemePanelHeaderBrush}" CornerRadius="10,10,0,0" Padding="12,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProgressStatusText" Text="Chưa chạy" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock x:Name="ProgressPercentText" Margin="8,0,0,0" FontSize="11" FontFamily="Consolas" Opacity="0.9" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ClearLogButton" Content="Xóa" Height="24" Padding="10,0" FontSize="10" Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                                    <Button x:Name="CopyLogButton" Content="Copy" Height="24" Padding="10,0" FontSize="10" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="2">
                            <Grid>
                                <Border Background="{DynamicResource ThemeTrackBackgroundBrush}"/>
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="{DynamicResource ThemeAccentBrush}" Width="0"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <RichTextBox x:Name="LogRichTextBox"
                                         IsReadOnly="True"
                                         Focusable="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="12,10"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                        </ScrollViewer>
                        <Grid Grid.Row="2" Margin="12,6,12,8">
                            <TextBlock x:Name="ElapsedTimeText" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="Elapsed: --"/>
                            <TextBlock x:Name="EstimatedTimeText" HorizontalAlignment="Right" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="ETA: --"/>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <TabControl x:Name="PortraitVideoLogTabControl"
                            Style="{StaticResource VideoPortraitEqualTabControlStyle}"
                            Visibility="Collapsed"
                            Margin="0">
                    <TabItem Header="Video">
                        <Grid x:Name="PortraitVideoHostPanel" Margin="0,2,0,0"/>
                    </TabItem>
                    <TabItem Header="Log">
                        <Grid x:Name="PortraitLogHostPanel" Margin="0,2,0,0"/>
                    </TabItem>
                </TabControl>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Tab Navigation & Control Panels -->
            <Grid x:Name="RightPanelGrid" Grid.Column="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Horizontal Pill Tabs Navigation Header -->
            <Border Grid.Row="0" x:Name="TabNavBorder" Margin="0,0,0,10" Padding="12,10" Background="{DynamicResource ThemeTabNavBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource ThemeCardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Thiết lập Video &amp; Tiến trình" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    <ListBox x:Name="TabNavList" Margin="0,8,0,0" Style="{StaticResource PillTabNavStyle}" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem Content="Tổng quan" Tag="General"/>
                        <ListBoxItem Content="Bộ lọc" Tag="Grading"/>
                        <ListBoxItem Content="Chèn ảnh video" Tag="Filters"/>
                        <ListBoxItem Content="Audio" Tag="Audio"/>
                        <ListBoxItem Content="Cắt ghép" Tag="TrimConcat"/>
                        <ListBoxItem Content="Đầu ra" Tag="Outputs"/>
                        <ListBoxItem Content="Cài đặt" Tag="Settings"/>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Tab Content Cards Host -->
            <Border Grid.Row="1" x:Name="TabContentBorder" Style="{StaticResource GlassCardStyle}" Padding="16,14">
                <Grid>
                    <!-- TAB 1: TỔNG QUAN (GENERAL) -->
                    <Grid x:Name="GeneralTabContent" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Card 1: Stats summary badges -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="RESOLUTION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <TextBlock x:Name="StatResolutionText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="FPS NGUỒN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <TextBlock x:Name="StatFpsText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="THỜI LƯỢNG" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <TextBlock x:Name="StatDurationText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,10" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock x:Name="CodecInfoText" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                        <TextBlock x:Name="AudioSummaryText" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Hidden: slider removed from UI but kept for code-behind reference -->
                                <Grid Visibility="Collapsed">
                                    <Slider x:Name="SecondsPerFrameSlider" Minimum="1" Maximum="60" Value="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock x:Name="SecondsPerFrameValueText"/>
                                </Grid>

                                <!-- Frame Extraction Control Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Cấu hình Tách Frame" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <TextBlock Text="Số lượng frame cần lấy" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="FpsSlider"
                                                     Minimum="1"
                                                     Maximum="300"
                                                     Value="1"
                                                     Style="{StaticResource ModernSliderStyle}"
                                                     ToolTip="Số lượng frame cần lấy ra (x giây x FPS nguồn)."/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="FpsValueText" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="FrameFormatCombo" Height="28" Margin="0,0,8,0" Style="{StaticResource DarkComboBoxStyle}" ToolTip="PNG: lossless, JPEG: nhẹ hơn, WebP: cân bằng.">
                                                <ComboBoxItem Content="PNG" Tag="png" IsSelected="True"/>
                                                <ComboBoxItem Content="JPEG" Tag="jpg"/>
                                                <ComboBoxItem Content="WebP" Tag="webp"/>
                                            </ComboBox>
                                            <Slider Grid.Column="1" x:Name="JpegQualitySlider" Minimum="0" Maximum="100" Value="100" Style="{StaticResource ModernSliderStyle}" ToolTip="Chất lượng JPEG 0-100. 85-95 phù hợp cho AI vision." VerticalAlignment="Center"/>
                                            <TextBlock x:Name="JpegQualityLabel" Grid.Column="2"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                       Margin="8,4,0,0"
                                                       HorizontalAlignment="Right"
                                                       Visibility="Collapsed"
                                                       Text="Quality: 100/100"/>
                                        </Grid>
                                        
                                        <TextBlock Text="Resize output frames"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   Margin="0,4,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="FrameResizeSlider"
                                                    Minimum="0.4"
                                                    Maximum="1.0"
                                                    Value="1.0"
                                                    Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="FrameResizeLabel"
                                                           FontSize="10"
                                                           FontFamily="Consolas"
                                                           HorizontalAlignment="Center"
                                                           Text="1920×1080"/>
                                            </Border>
                                        </Grid>

                                        <CheckBox x:Name="ExtractAllFramesCheckBox" Content="Tách tất cả frame" Style="{StaticResource ReadableCheckBoxStyle}" Margin="0,2,0,8" ToolTip="Lấy toàn bộ frame theo FPS gốc của video."/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Extract song song" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <ComboBox x:Name="ExtractParallelJobsCombo" Grid.Column="2" Height="26" Style="{StaticResource DarkComboBoxStyle}" ToolTip="Số tiến trình FFmpeg chạy đồng thời khi tách frame.">
                                                <ComboBoxItem Content="1 luồng" Tag="1" IsSelected="True"/>
                                                <ComboBoxItem Content="2 luồng" Tag="2"/>
                                                <ComboBoxItem Content="4 luồng" Tag="4"/>
                                                <ComboBoxItem Content="6 luồng" Tag="6"/>
                                                <ComboBoxItem Content="8 luồng" Tag="8"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Estimation Badges Card -->
                                        <Border Style="{StaticResource InnerCardStyle}" Margin="0,4,0,0" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="FRAME/GIÂY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="EstFramePerSecText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="TỔNG FRAME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="EstimatedFrameCountText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="KHOẢNG CÁCH" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="EstFrameIntervalText" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="FrameIndexPreviewText"
                                                   Margin="0,6,0,0"
                                                   FontSize="10"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Bar Footer -->
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="ExtractFramesBase64Button" Content="Tách Frame (Base64)" Height="30" Padding="14,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Tách frame và trả về kết quả mã hóa Base64 string"/>
                                <Button x:Name="ExtractFramesLinkButton" Content="Tách Frame (Đường dẫn)" Height="30" Padding="14,0" Margin="8,0,0,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Tách frame và xuất ảnh vào thư mục (trả về đường dẫn file)"/>
                                <Button x:Name="SnapshotButton" Content="Chụp Snapshot" Height="30" Padding="12,0" Margin="8,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 2: BỘ LỌC (GRADING) -->
                    <Grid x:Name="GradingTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Preset Chips Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Preset màu sắc (Color Grading)" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <WrapPanel Margin="0,0,0,0">
                                            <Button x:Name="PresetNeutralButton" Content="Trung tính" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetVividButton" Content="Rực rỡ" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetCinematicButton" Content="Điện ảnh" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetBwButton" Content="B&amp;W" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetWarmButton" Content="Tông ấm" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetCoolButton" Content="Tông lạnh" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="PresetFadeButton" Content="Phai màu" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="ResetGradingButton" Content="Đặt lại" Style="{StaticResource PresetChipResetStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="ApplyPreviewEffectButton" Content="👁️ Xem trước" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="ResetPreviewEffectButton" Content="✕ Hủy xem trước" Style="{StaticResource PresetChipResetStyle}" Margin="0,0,6,6"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Cân bằng màu sắc -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Cân bằng ánh sáng &amp; Màu sắc" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        
                                        <!-- Brightness -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Độ sáng" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="BrightnessSlider" Minimum="-1" Maximum="1" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="BrightnessLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Contrast -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Tương phản" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="ContrastSlider" Minimum="0.1" Maximum="3" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="ContrastLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Saturation -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Độ bão hòa" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="SaturationSlider" Minimum="0" Maximum="3" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="SaturationLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Hue -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Dịch Hue" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="HueSlider" Minimum="-180" Maximum="180" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="HueLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Gamma -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Gamma" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" x:Name="GammaSlider" Minimum="0.1" Maximum="3" Value="1" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="GammaLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Hiệu ứng hình ảnh -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Hiệu ứng xử lý hình ảnh" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        
                                        <!-- Sharpen -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Làm nét (Sharpen)" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="SharpenToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SharpenSlider" Minimum="0" Maximum="5" Value="1" IsEnabled="False" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="SharpenLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Denoise -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Khử nhiễu (Denoise hqdn3d)" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="DenoiseToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="10" Value="3" IsEnabled="False" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="DenoiseLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Blur -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Làm mờ (Gaussian Blur)" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="BlurToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="BlurSlider" Minimum="1" Maximum="15" Value="3" IsEnabled="False" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="BlurLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Rotate & Flip -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Xoay &amp; Lật khung hình (Transform)" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <WrapPanel Margin="0,0,0,0">
                                            <Button x:Name="Rotate0Button" Content="0°" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="Rotate90Button" Content="90° ↻" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="Rotate180Button" Content="180°" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="Rotate270Button" Content="270° ↺" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="FlipHButton" Content="Lật ngang ↔" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="FlipVButton" Content="Lật dọc ↕" Style="{StaticResource PresetChipStyle}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Stabilize & Playback speed -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Chống rung &amp; Tốc độ phát (Stabilize &amp; Speed)" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Chống rung video (Stabilize)" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="StabilizeToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        <TextBlock Text="Tốc độ phát (Playback Speed)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="4" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="SpeedLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center" Text="1.0x"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ResetGradingButton2" Content="Đặt lại mặc định" Height="30" Padding="14,0" Style="{StaticResource VideoChromeResetButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 3: CHÈN ẢNH VIDEO (FILTERS & OVERLAY) -->
                    <Grid x:Name="FiltersTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Collapsed Legacy Controls to preserve code-behind bindings -->
                                <Border Visibility="Collapsed">
                                    <StackPanel>
                                        <ToggleButton x:Name="WatermarkToggle"/>
                                        <TextBox x:Name="WatermarkPathText"/>
                                        <Button x:Name="BrowseWatermarkButton"/>
                                        <ComboBox x:Name="WatermarkPositionCombo">
                                            <ComboBoxItem Content="Top Left" Tag="TL"/><ComboBoxItem Content="Top Center" Tag="TC"/><ComboBoxItem Content="Top Right" Tag="TR"/>
                                            <ComboBoxItem Content="Middle Left" Tag="ML"/><ComboBoxItem Content="Middle Center" Tag="MC"/><ComboBoxItem Content="Middle Right" Tag="MR"/>
                                            <ComboBoxItem Content="Bottom Left" Tag="BL"/><ComboBoxItem Content="Bottom Center" Tag="BC"/><ComboBoxItem Content="Bottom Right" Tag="BR" IsSelected="True"/>
                                        </ComboBox>
                                        <TextBlock x:Name="WatermarkPositionHintText"/>
                                        <Slider x:Name="WatermarkOpacitySlider"/>
                                        <TextBlock x:Name="WatermarkOpacityLabel"/>
                                        <Slider x:Name="WatermarkWidthPercentSlider"/>
                                        <TextBlock x:Name="WatermarkWidthPercentLabel"/>
                                        <Slider x:Name="WatermarkInsetPercentSlider"/>
                                        <TextBlock x:Name="WatermarkInsetPercentLabel"/>
                                        <Button x:Name="ApplyWatermarkToVideoButton"/>
                                        <ToggleButton x:Name="TextOverlayToggle"/>
                                        <TextBox x:Name="OverlayTextBox"/>
                                        <ComboBox x:Name="TextFontCombo"><ComboBoxItem Content="Arial"/></ComboBox>
                                        <Slider x:Name="TextSizeSlider"/>
                                        <TextBlock x:Name="TextSizeLabel"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 1: Nhãn Frame / Thời gian -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Nhãn Frame / Thời gian (Frame Label)" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="FrameLabelToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        
                                        <TextBlock Text="Mẫu hiển thị (Template)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FrameLabelTemplateTextBox" Height="28" FontSize="11" Padding="8,4" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="{}Frame {index} - {time}" ToolTip="{}Thẻ thay thế: {index}, {frame}, {time}"/>
                                        <TextBlock Margin="0,4,0,8" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="{}Cú pháp: {index}=thứ tự frame xuất, {frame}=số frame FPS nguồn, {time}=thời gian (MM:SS)"/>

                                        <!-- Position X & Y Sliders -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Vị trí X" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Slider x:Name="FrameLabelXSlider" Minimum="0" Maximum="1" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Vị trí Y" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Slider x:Name="FrameLabelYSlider" Minimum="0" Maximum="1" Value="0" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="FrameLabelPosLabel" Margin="0,0,0,8" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeAccentBrush}" Text="X 0.000 | Y 0.000"/>

                                        <!-- Font Size & Time Format -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Cỡ chữ (Font Size)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                    <TextBlock x:Name="FrameLabelFontSizeLabel" HorizontalAlignment="Right" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Text="18px"/>
                                                </Grid>
                                                <Slider x:Name="FrameLabelFontSizeSlider" Minimum="8" Maximum="60" Value="18" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Định dạng thời gian" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox x:Name="FrameLabelTimeFormatCombo" Height="26" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="MM:SS" Tag="MMSS"/>
                                                    <ComboBoxItem Content="HH:MM:SS" Tag="HHMMSS" IsSelected="True"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Padding 4 direction sliders -->
                                        <TextBlock Text="Khoảng lề Padding (Trái / Trên / Phải / Dưới)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Slider x:Name="FrameLabelPaddingLeftSlider" Minimum="0" Maximum="50" Value="10" Style="{StaticResource ModernSliderStyle}" ToolTip="Trái"/>
                                                <TextBlock x:Name="FrameLabelPaddingLeftLabel" FontSize="9.5" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="10px"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Slider x:Name="FrameLabelPaddingTopSlider" Minimum="0" Maximum="50" Value="6" Style="{StaticResource ModernSliderStyle}" ToolTip="Trên"/>
                                                <TextBlock x:Name="FrameLabelPaddingTopLabel" FontSize="9.5" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="6px"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <Slider x:Name="FrameLabelPaddingRightSlider" Minimum="0" Maximum="50" Value="10" Style="{StaticResource ModernSliderStyle}" ToolTip="Phải"/>
                                                <TextBlock x:Name="FrameLabelPaddingRightLabel" FontSize="9.5" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="10px"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <Slider x:Name="FrameLabelPaddingBottomSlider" Minimum="0" Maximum="50" Value="6" Style="{StaticResource ModernSliderStyle}" ToolTip="Dưới"/>
                                                <TextBlock x:Name="FrameLabelPaddingBottomLabel" FontSize="9.5" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text="6px"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Text & Background Color Input -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="FrameLabelTextColorTextBox" Height="26" FontSize="11" Padding="6,2" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="black" ToolTip="Màu chữ (VD: black, white, #FFFFFF)"/>
                                            <Button Grid.Column="1" Width="26" Height="26" Padding="0" Margin="4,0,0,0" ToolTip="Chọn màu chữ" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="PickFrameLabelTextColor_Click">
                                                <controls:SvgViewboxEx Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone-light'}"/>
                                            </Button>
                                            <TextBox x:Name="FrameLabelBackgroundColorTextBox" Grid.Column="3" Height="26" FontSize="11" Padding="6,2" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="white" ToolTip="Màu nền (VD: white, #00000088)"/>
                                            <Button Grid.Column="4" Width="26" Height="26" Padding="0" Margin="4,0,0,0" ToolTip="Chọn màu nền" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="PickFrameLabelBackgroundColor_Click">
                                                <controls:SvgViewboxEx Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone-light'}"/>
                                            </Button>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border x:Name="FrameLabelTextColorPreview" Height="10" CornerRadius="2" BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"/>
                                            <Border x:Name="FrameLabelBackgroundColorPreview" Grid.Column="2" Height="10" CornerRadius="2" BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"/>
                                        </Grid>
                                        <CheckBox x:Name="FrameLabelDebugSamplesCheckBox"
                                                  Margin="0,4,0,0"
                                                  FontSize="10"
                                                  Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                  Content="Ghi ảnh thẻ nhãn (debug) - lưu trong thư mục xuất frame"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Canvas Overlay Layer List -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Danh sách Layer Canvas Overlay" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="AddTextOverlayItemButton" Content="+ Chữ Text" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="AddImageOverlayItemButton" Content="+ Ảnh/Logo" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="RemoveSelectedOverlayItemButton" Content="Xóa chọn" Style="{StaticResource PresetChipResetStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="MoveOverlayUpButton" Content="Lên ⬆" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="MoveOverlayDownButton" Content="Xuống ⬇" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6"/>
                                            <Button x:Name="ApplyOverlayToVideoButton" Content="Áp dụng Video" Style="{StaticResource PresetChipStyle}"/>
                                        </WrapPanel>
                                        <ListBox x:Name="OverlayLayerList"
                                                 Height="110"
                                                 Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                 BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource ThemeInputForegroundBrush}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                                        <Border Background="#336366F1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold" Foreground="#818CF8"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Source}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Layer Properties -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Thuộc tính Layer đang chọn" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Loại Layer" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <ComboBox x:Name="OverlayTypeCombo" Grid.Column="1" Height="26" Style="{StaticResource DarkComboBoxStyle}">
                                                <ComboBoxItem Content="text" Tag="text"/>
                                                <ComboBoxItem Content="image" Tag="image"/>
                                                <ComboBoxItem Content="logo" Tag="logo"/>
                                            </ComboBox>
                                        </Grid>

                                        <StackPanel x:Name="OverlayImageSourcePanel" Margin="0,0,0,6">
                                            <TextBlock Text="Đường dẫn ảnh" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="OverlaySourcePathTextBox" Height="26" FontSize="11" Padding="6,3" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" ToolTip="Đường dẫn file ảnh (image/logo)"/>
                                        </StackPanel>

                                        <StackPanel x:Name="OverlayTextPropsPanel" Margin="0,0,0,6">
                                            <TextBlock Text="Nội dung chữ Text" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBox x:Name="OverlaySourceTextArea"
                                                     Height="64"
                                                     FontSize="11"
                                                     Padding="6,4"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="{DynamicResource ThemeInputBackgroundBrush}"
                                                     BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                                     Foreground="{DynamicResource ThemeInputForegroundBrush}"
                                                     ToolTip="Nội dung text overlay"/>

                                            <Grid x:Name="OverlayTextAlignRow" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Căn lề" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <RadioButton x:Name="OverlayAlignLeftRadio" Content="Trái" GroupName="OverlayTextAlign" Margin="0,0,12,0" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                    <RadioButton x:Name="OverlayAlignCenterRadio" Content="Giữa" GroupName="OverlayTextAlign" Margin="0,0,12,0" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                    <RadioButton x:Name="OverlayAlignRightRadio" Content="Phải" GroupName="OverlayTextAlign" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Font chữ" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="OverlayFontFamilyCombo" Height="26" IsEditable="False" IsTextSearchEnabled="True" Style="{StaticResource DarkComboBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Màu chữ" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="OverlayFontColorTextBox" Height="26" FontSize="11" Padding="4,2" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}"/>
                                                        <Button x:Name="PickOverlayFontColorButton" Grid.Column="1" Width="26" Height="26" Padding="0" Margin="4,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="PickOverlayFontColor_Click">
                                                            <controls:SvgViewboxEx Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='palette duotone-light'}"/>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,6,0,0">
                                                <TextBlock Text="Cỡ chữ (Font Size)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <Slider x:Name="OverlayFontSizeSlider" Minimum="8" Maximum="200" Style="{StaticResource ModernSliderStyle}" Margin="0,16,0,0"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Position X & Y -->
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Vị trí X (0.0 - 1.0)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayXSlider" Minimum="0" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Vị trí Y (0.0 - 1.0)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayYSlider" Minimum="0" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Size W & H -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Chiều rộng W" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayWidthSlider" Minimum="0.01" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Chiều cao H" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayHeightSlider" Minimum="0.01" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Opacity & Rotation -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Độ trong suốt Opacity" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayOpacitySlider" Minimum="0" Maximum="1" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Góc xoay Rotation (°)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                <Slider x:Name="OverlayRotationSlider" Minimum="-180" Maximum="180" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <CheckBox x:Name="OverlayVisibleCheckBox" Content="Hiển thị (Visible)" Margin="0,0,16,0" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                            <CheckBox x:Name="OverlayLockedCheckBox" Content="Khóa vị trí (Locked)" Style="{StaticResource ReadableCheckBoxStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ResetFiltersTabButton" Content="Đặt lại cài đặt" Height="30" Padding="14,0" Style="{StaticResource VideoChromeResetButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 4: AUDIO -->
                    <Grid x:Name="AudioTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Source Audio -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Audio nguồn từ video" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="SourceAudioToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" ToolTip="Bật/tắt âm thanh gốc từ video"/>
                                        </Grid>
                                        <Grid x:Name="SourceAudioVolumeGrid" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Âm lượng gốc" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="2" x:Name="SourceAudioVolumeSlider" Minimum="0" Maximum="300" Value="100" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center" ToolTip="Âm lượng video gốc (0% = tắt âm, 100% = gốc, >100% = tăng âm thanh)"/>
                                            <Border Grid.Column="3" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                <TextBlock x:Name="SourceAudioVolumeLabel" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="100%"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Audio Effects -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Xử lý &amp; Hiệu ứng Audio" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Fade In (Giây)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="AudioFadeInSlider" Minimum="0" Maximum="10" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="4,0,0,0">
                                                        <TextBlock x:Name="AudioFadeInLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center" Text="0s"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Fade Out (Giây)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                    <Slider x:Name="AudioFadeOutSlider" Minimum="0" Maximum="10" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="4,0,0,0">
                                                        <TextBlock x:Name="AudioFadeOutLabel" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center" Text="0s"/>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,8,0,0">
                                            <CheckBox x:Name="AudioNormalizeCheckBox" Content="Normalize âm lượng (EBU R128)" FontSize="11" Margin="0,0,0,6" Style="{StaticResource ReadableCheckBoxStyle}" ToolTip="Chuẩn hóa âm lượng video đạt mức tiêu chuẩn phát sóng (chống tiếng quá to hoặc quá nhỏ)"/>
                                            <CheckBox x:Name="AudioDenoiseCheckBox" Content="Lọc nhiễu âm thanh (Denoise)" FontSize="11" Style="{StaticResource ReadableCheckBoxStyle}" ToolTip="Tự động loại bỏ tiếng ồn nền, tiếng xè xè hoặc tạp âm dải tần xấu trong video"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- External Audio Tracks -->
                                <ItemsControl x:Name="AudioTracksList" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,6" Padding="12,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                                        <TextBlock Text="Track âm thanh chèn ngoài" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="▶ Nghe lồng nhạc" Height="24" Padding="8,0" FontSize="10" Style="{StaticResource VideoChromePrimaryButtonStyle}" Margin="0,0,6,0" Tag="{Binding}" Click="PreviewMixAudio_Click" ToolTip="Tua video đến vị trí chèn &amp; phát đồng thời audio ngoài để nghe thử"/>
                                                            <Button Content="✕" Width="24" Height="24" Padding="0" FontSize="10" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="RemoveAudioTrack_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Height="28" FontSize="11" Padding="6,4" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="{Binding SourceOutputKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}"/>
                                                        <Button Grid.Column="1" Width="30" Height="28" Padding="0" Margin="4,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="BrowseAudioTrack_Click">
                                                            <controls:SvgViewboxEx Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder-open duotone-light'}"/>
                                                        </Button>
                                                    </Grid>
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Volume %" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="42"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Slider Minimum="0" Maximum="300" Value="{Binding VolumePercent, Mode=TwoWay}" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center"/>
                                                                <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="4,0,0,0">
                                                                    <TextBlock FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource ThemeTextPrimaryBrush}" HorizontalAlignment="Center" Text="{Binding VolumePercent, StringFormat='{}{0:0}%'}"/>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Nếu ngắn hơn" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <ComboBox Height="26" FontSize="11" SelectedValue="{Binding ShorterMode, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource DarkComboBoxStyle}">
                                                                <ComboBoxItem Content="Loop" Tag="{x:Static models:AudioSyncMode.Loop}"/>
                                                                <ComboBoxItem Content="Pad Silence" Tag="{x:Static models:AudioSyncMode.PadSilence}"/>
                                                                <ComboBoxItem Content="Stretch" Tag="{x:Static models:AudioSyncMode.Stretch}"/>
                                                                <ComboBoxItem Content="Trim" Tag="{x:Static models:AudioSyncMode.Trim}"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddAudioTrackButton" Height="32" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Content="+ Thêm track nhạc chèn ngoài"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="ExtractAudioTabButton" Content="Trích xuất Audio" Height="30" Padding="14,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Trích xuất file audio từ video (Chỉ xử lý node này)"/>
                                    <Button x:Name="RunFlowAudioTabButton" Content="🚀 Chạy Workflow (Audio)" Height="30" Padding="14,0" Margin="8,0,0,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Trích xuất audio và chạy tiếp Workflow phía sau với key 'linkAudio'"/>
                                </StackPanel>
                                <Button x:Name="ResetAudioTabButton" Content="Đặt lại cài đặt" Height="30" Padding="12,0" HorizontalAlignment="Right" Style="{StaticResource VideoChromeResetButtonStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 5: CẮT GHÉP (TRIM & CONCAT) -->
                    <Grid x:Name="TrimConcatTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Trim Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Cắt ngắn video (Trim)" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="TrimToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource ValueBadgeStyle}" Grid.Column="0">
                                                <TextBlock x:Name="TrimStartText" HorizontalAlignment="Center" FontFamily="Consolas" FontWeight="SemiBold" Text="00:00"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <Border Style="{StaticResource ValueBadgeStyle}" Grid.Column="2">
                                                <TextBlock x:Name="TrimEndText" HorizontalAlignment="Center" FontFamily="Consolas" FontWeight="SemiBold" Text="00:00"/>
                                            </Border>
                                        </Grid>
                                        <CheckBox x:Name="TrimReviewCheckBox"
                                                  Content="Trim Review (dùng slider cắt để xem trước)"
                                                  Style="{StaticResource ReadableCheckBoxStyle}"
                                                  Margin="0,0,0,8"/>
                                        <Grid x:Name="TrimReviewHitArea"
                                               Height="28"
                                               Cursor="Hand"
                                               Visibility="Collapsed"
                                               ToolTip="Kéo để chỉnh Trim. Thả chuột để load ảnh Start/End."
                                               MouseEnter="TrimReviewHitArea_MouseEnter"
                                               MouseLeave="TrimReviewHitArea_MouseLeave"
                                               PreviewMouseLeftButtonDown="TrimReviewHitArea_MouseDown"
                                               PreviewMouseMove="TrimReviewHitArea_MouseMove"
                                               PreviewMouseLeftButtonUp="TrimReviewHitArea_MouseUp"
                                               ClipToBounds="True">
                                             <Border x:Name="TrimReviewTrackBorder"
                                                     Background="{DynamicResource ThemeTrackBackgroundBrush}"
                                                     CornerRadius="2" Height="4" Margin="7,0,7,0" VerticalAlignment="Center"/>
                                             <Border x:Name="TrimReviewRangeFill" Background="#706366F1" CornerRadius="2" Height="4" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                                             <Canvas VerticalAlignment="Stretch">
                                                 <Ellipse x:Name="TrimReviewStartThumb" Width="14" Height="14" Fill="#4ADE80" Stroke="#FFFFFF" StrokeThickness="2" Canvas.Top="7">
                                                     <Ellipse.Effect>
                                                         <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
                                                     </Ellipse.Effect>
                                                 </Ellipse>
                                                 <Ellipse x:Name="TrimReviewEndThumb" Width="14" Height="14" Fill="#FB7185" Stroke="#FFFFFF" StrokeThickness="2" Canvas.Top="7">
                                                     <Ellipse.Effect>
                                                         <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
                                                     </Ellipse.Effect>
                                                 </Ellipse>
                                                 <Ellipse x:Name="TrimReviewPlayheadThumb" Width="14" Height="14" Fill="{DynamicResource ThemeAccentBrush}" Stroke="#FFFFFF" StrokeThickness="2" Canvas.Top="7">
                                                     <Ellipse.Effect>
                                                         <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
                                                     </Ellipse.Effect>
                                                 </Ellipse>
                                             </Canvas>
                                         </Grid>

                                        <Grid x:Name="TrimReviewFramesPanel"
                                              Margin="0,8,0,8"
                                              VerticalAlignment="Stretch"
                                              Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource ThemeOverlayBackgroundBrush}"
                                                    BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    MinHeight="180"
                                                    Padding="8">
                                                <StackPanel>
                                                    <TextBlock Text="Frame Start" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,6"/>
                                                    <Image x:Name="TrimStartFrameImage"
                                                           MinHeight="40"
                                                           MaxHeight="180"
                                                           Stretch="Uniform"
                                                           Visibility="Collapsed"/>
                                                    <TextBlock x:Name="TrimStartFrameHintText" Text="Thả chuột để load..." FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Opacity="0.7" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource ThemeOverlayBackgroundBrush}"
                                                    BorderBrush="{DynamicResource ThemeOverlayBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8"
                                                    MinHeight="180"
                                                    Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="Frame End" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,6"/>
                                                    <Image x:Name="TrimEndFrameImage"
                                                           MinHeight="40"
                                                           MaxHeight="180"
                                                           Stretch="Uniform"
                                                           Visibility="Collapsed"/>
                                                    <TextBlock x:Name="TrimEndFrameHintText" Text="Thả chuột để load..." FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Opacity="0.7" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Concat Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Ghép nối nhiều video (Concatenate)" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="ConcatToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}" ToolTip="Bật/tắt ghép nối nhiều video thành 1 video duy nhất"/>
                                        </Grid>
                                        <ItemsControl x:Name="ConcatVideosList" Margin="0,4,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,6" Padding="8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Height="26" FontSize="11" Padding="6,3" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}" Text="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}"/>
                                                            <Button Grid.Column="1" Width="28" Height="26" Padding="0" Margin="4,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="BrowseConcatVideoItem_Click" ToolTip="Chọn video ghép">
                                                                <controls:SvgViewboxEx Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder-open duotone-light'}"/>
                                                            </Button>
                                                            <Button Grid.Column="2" Width="26" Height="26" Padding="0" Margin="4,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Tag="{Binding}" Click="RemoveConcatVideoItem_Click" Content="✕" ToolTip="Xóa video"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button x:Name="AddConcatVideoButton" Height="30" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Content="+ Thêm video ghép"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LoadTrimConcatPreviewButton" Content="🎬 Load Video Cắt/Ghép lên Preview" Height="30" Padding="14,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Xử lý nhanh video Cắt/Ghép và tải lên Player xem trước thay thế video hiện tại"/>
                                <Button x:Name="SaveTrimConcatTabButton" Content="💾 Lưu Video" Height="30" Padding="14,0" Margin="8,0,0,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Xuất file video theo các cài đặt"/>
                                <Button x:Name="ResetTrimConcatTabButton" Content="Đặt lại cài đặt" Height="30" Padding="14,0" Margin="8,0,0,0" Style="{StaticResource VideoChromeResetButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 6: ĐẦU RA (OUTPUTS) -->
                    <ScrollViewer x:Name="OutputsTabContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,2,0,0">
                            <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Liên kết đầu ra" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Chế độ xuất:" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                        <TextBlock x:Name="OutputModeSummaryText" Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Định dạng video:" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                        <TextBlock x:Name="OutputFormatSummaryText" Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Âm thanh:" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                        <TextBlock x:Name="OutputAudioSummaryText" Grid.Column="1" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ước tính frame:" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                        <TextBlock x:Name="OutputEstimatedFramesText" Grid.Column="1" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    </Grid>

                                    <!-- Video Path Action Row -->
                                    <Grid Margin="0,10,0,0">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                         </Grid.ColumnDefinitions>
                                         <TextBlock x:Name="OutputVideoPathText"
                                                    Text="Chưa có đường dẫn video đầu ra"
                                                    TextTrimming="CharacterEllipsis"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                    VerticalAlignment="Center"/>
                                         <StackPanel Grid.Column="1" Orientation="Horizontal">
                                             <Button x:Name="OpenOutputVideoButton"
                                                     Content="Mở"
                                                     Margin="8,0,0,0"
                                                     Height="26"
                                                     Padding="10,0"
                                                     Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                                             <Button x:Name="OpenOutputVideoActionButton"
                                                     Content="Mở Video"
                                                     Margin="4,0,0,0"
                                                     Height="26"
                                                     Padding="10,0"
                                                     Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                                         </StackPanel>
                                     </Grid>

                                     <!-- Frames Folder Action Row -->
                                     <Grid Margin="0,8,0,0">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                         </Grid.ColumnDefinitions>
                                         <TextBlock x:Name="OutputFramesFolderText"
                                                    Text="Chưa có thư mục frame"
                                                    TextTrimming="CharacterEllipsis"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                    VerticalAlignment="Center"/>
                                         <StackPanel Grid.Column="1" Orientation="Horizontal">
                                             <Button x:Name="OpenFramesFolderButton"
                                                     Content="Mở"
                                                     Margin="8,0,0,0"
                                                     Height="26"
                                                     Padding="10,0"
                                                     Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                                             <Button x:Name="OpenFramesFolderActionButton"
                                                     Content="Mở Folder Frame"
                                                     Margin="4,0,0,0"
                                                     Height="26"
                                                     Padding="10,0"
                                                     Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                                         </StackPanel>
                                     </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerCardStyle}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Kiểm tra cấu hình" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                    <TextBlock x:Name="ConfigMissingSummaryText" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentBrush}"/>
                                    <TextBlock x:Name="ConfigCheckVideoText" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text=""/>
                                    <TextBlock x:Name="ConfigCheckOutputText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text=""/>
                                    <TextBlock x:Name="ConfigCheckSubtitleText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text=""/>
                                    <TextBlock x:Name="ConfigCheckWatermarkText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text=""/>
                                    <TextBlock x:Name="ConfigCheckTextOverlayText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Text=""/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- TAB 7: CÀI ĐẶT (SETTINGS) -->
                    <Grid x:Name="SettingsTabContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,0,0">
                                <!-- Export Encoder Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Định dạng &amp; Mã hoá xuất file Video" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Định dạng Video" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                <ComboBox x:Name="OutputFormatCombo" Height="28" Style="{StaticResource DarkComboBoxStyle}" ToolTip="Chọn định dạng container file xuất">
                                                    <ComboBoxItem Content="MP4 (H.264)" Tag="mp4_h264" IsSelected="True"/>
                                                    <ComboBoxItem Content="MP4 (H.265/HEVC)" Tag="mp4_h265"/>
                                                    <ComboBoxItem Content="WebM (VP9)" Tag="webm_vp9"/>
                                                    <ComboBoxItem Content="MOV (ProRes)" Tag="mov_prores"/>
                                                    <ComboBoxItem Content="AVI" Tag="avi"/>
                                                    <ComboBoxItem Content="GIF" Tag="gif"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Tốc độ nén (Preset)" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                <ComboBox x:Name="EncoderPresetCombo" Height="28" Style="{StaticResource DarkComboBoxStyle}" ToolTip="ultrafast: Nhanh nhất nhưng file to -> slow: Nén nhỏ nhất nhưng tốn CPU">
                                                    <ComboBoxItem Content="ultrafast"/>
                                                    <ComboBoxItem Content="veryfast"/>
                                                    <ComboBoxItem Content="fast"/>
                                                    <ComboBoxItem Content="medium" IsSelected="True"/>
                                                    <ComboBoxItem Content="slow"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- CRF Slider -->
                                        <StackPanel Margin="0,0,0,8">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Chất lượng hình ảnh (CRF)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                                <TextBlock Text="Càng nhỏ = Càng nét (Chuẩn HD: 18-23)" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                                <Slider x:Name="CrfSlider" Minimum="0" Maximum="51" Value="23" Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center" ToolTip="Hệ số chất lượng CRF. Giá trị 0-51 (18-23 là nét chuẩn HD, trên 28 nhẹ dung lượng)"/>
                                                <Border Grid.Column="1" Style="{StaticResource ValueBadgeStyle}" Margin="6,0,0,0">
                                                    <TextBlock x:Name="CrfLabel" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Mã hóa 2 lượt (Two-pass)" FontSize="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" VerticalAlignment="Center" ToolTip="Phân tích lượt 1 để tối ưu bitrate lượt 2 giúp nét hơn ở dung lượng thấp"/>
                                            <ToggleButton x:Name="TwoPassToggle" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitchStyle}"/>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Codec Âm thanh" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                <ComboBox x:Name="AudioCodecCombo" Height="26" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="AAC" Tag="aac" IsSelected="True"/>
                                                    <ComboBoxItem Content="MP3" Tag="mp3"/>
                                                    <ComboBoxItem Content="Opus" Tag="opus"/>
                                                    <ComboBoxItem Content="Copy" Tag="copy"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Bitrate Âm thanh" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                <ComboBox x:Name="AudioBitrateCombo" Height="26" Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="128k"/>
                                                    <ComboBoxItem Content="192k" IsSelected="True"/>
                                                    <ComboBoxItem Content="256k"/>
                                                    <ComboBoxItem Content="320k"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Resolution Scale Card -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Tỉ lệ xuất độ phân giải Video (Resolution Scale)" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <WrapPanel>
                                            <Button x:Name="Scale100Button" Content="100%" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6" ToolTip="Giữ nguyên độ phân giải gốc"/>
                                            <Button x:Name="Scale75Button" Content="75%" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6" ToolTip="Thu nhỏ 75%"/>
                                            <Button x:Name="Scale50Button" Content="50%" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6" ToolTip="Thu nhỏ 50%"/>
                                            <Button x:Name="Scale25Button" Content="25%" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6" ToolTip="Thu nhỏ 25%"/>
                                            <Button x:Name="Scale1080Button" Content="1080p" Style="{StaticResource PresetChipStyle}" Margin="0,0,6,6" ToolTip="Khung chiều cao 1080px"/>
                                            <Button x:Name="Scale720Button" Content="720p" Style="{StaticResource PresetChipStyle}" ToolTip="Khung chiều cao 720px"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Folder Output Paths -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Thư mục &amp; Đường dẫn lưu xuất file" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        
                                        <!-- Video Output Override File Path -->
                                        <TextBlock Text="Đường dẫn file video xuất ghi đè" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="OutputPathText" Height="26" FontSize="11" Padding="6,3" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}"/>
                                            <Button x:Name="BrowseOutputButton" Grid.Column="1" Height="26" Margin="4,0,0,0" Content="..." Padding="8,0" Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                                        </Grid>
                                        <TextBlock x:Name="OutputPathHintText" FontSize="9.5" Foreground="{DynamicResource ThemeAccentBrush}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" Text="Mặc định: Downloads/flow-video/&lt;tên-video&gt;.mp4"/>

                                        <!-- Default Video Output Folder -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Thư mục xuất video mặc định" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <Button Content="📁 Tạo &amp; Mở thư mục mặc định" HorizontalAlignment="Right" FontSize="9.5" Padding="6,0" Height="20" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="OpenDefaultVideoFolder_Click"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="DefaultOutputVideoPathText" Height="26" FontSize="11" Padding="6,3" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}"/>
                                            <Button x:Name="BrowseDefaultOutputVideoButton" Grid.Column="1" Content="..." Width="28" Height="26" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="4,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="DefaultVideoFolderHintText" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" Text="Thư mục mặc định: Downloads/flow-video/&lt;tên-video&gt;"/>

                                        <!-- Frame Output Folder -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Thư mục xuất ảnh frame" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <Button Content="📁 Tạo &amp; Mở thư mục mặc định" HorizontalAlignment="Right" FontSize="9.5" Padding="6,0" Height="20" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="OpenDefaultFrameFolder_Click"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="FrameOutputFolderText" Height="26" FontSize="11" Padding="6,3" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}"/>
                                            <Button x:Name="BrowseFrameOutputFolderButton" Grid.Column="1" Content="..." Width="28" Height="26" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="4,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="DefaultFrameFolderHintText" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" Text="Thư mục mặc định: Downloads/flow-frame/&lt;tên-video&gt;"/>

                                        <!-- Audio Output Folder -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Thư mục xuất audio" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}"/>
                                            <Button Content="📁 Tạo &amp; Mở thư mục mặc định" HorizontalAlignment="Right" FontSize="9.5" Padding="6,0" Height="20" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Click="OpenDefaultAudioFolder_Click"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="AudioOutputFolderText" Height="26" FontSize="11" Padding="6,3" Background="{DynamicResource ThemeInputBackgroundBrush}" BorderBrush="{DynamicResource ThemeInputBorderBrush}" Foreground="{DynamicResource ThemeInputForegroundBrush}"/>
                                            <Button x:Name="BrowseAudioOutputFolderButton" Grid.Column="1" Content="..." Width="28" Height="26" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" Margin="4,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="DefaultAudioFolderHintText" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondaryBrush}" Margin="0,0,0,0" TextTrimming="CharacterEllipsis" Text="Thư mục mặc định: Downloads/flow-audio/&lt;tên-video&gt;"/>
                                    </StackPanel>
                                </Border>

                                <!-- Hardware & System Config -->
                                <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Cấu hình xử lý &amp; Phần cứng" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <CheckBox x:Name="PreferGpuCheckBox" Content="Ưu tiên GPU (CUDA/D3D11)" VerticalAlignment="Center" Style="{StaticResource ReadableCheckBoxStyle}" ToolTip="Ưu tiên tăng tốc card màn hình CUDA/D3D11, tự động chuyển CPU nếu không hỗ trợ."/>
                                            <Border Grid.Column="1" x:Name="OutputModeBadgeBorder" Background="#266366F1" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock x:Name="OutputModeBadgeText" Text="Chế độ: Base64" FontSize="11" FontWeight="Bold" Foreground="#818CF8"/>
                                            </Border>
                                        </Grid>

                                        <ComboBox x:Name="PreviewVisualStrengthCombo" Visibility="Collapsed" Style="{StaticResource DarkComboBoxStyle}">
                                            <ComboBoxItem Content="Fast" Tag="fast"/>
                                            <ComboBoxItem Content="Balanced" Tag="balanced"/>
                                            <ComboBoxItem Content="Strong" Tag="strong"/>
                                        </ComboBox>

                                        <CheckBox x:Name="UseDialogVideoConfigCheckBox"
                                                  Content="Sử dụng cấu hình dialog video (real-time)"
                                                  Style="{StaticResource ReadableCheckBoxStyle}"
                                                  Margin="0,0,0,8"
                                                  IsChecked="True"/>

                                        <Button x:Name="OpenGlobalEnvironmentPathsButton" Content="⚙️ Cấu Hình Đường Dẫn Hệ Thống (FFmpeg)" Height="30" Style="{StaticResource VideoChromeSecondaryButtonStyle}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource InnerCardStyle}" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveSettingsTabButton" Content="Lưu cấu hình" Height="30" Padding="16,0" Style="{StaticResource VideoChromePrimaryButtonStyle}"/>
                                <Button x:Name="ResetSettingsTabButton" Content="Đặt lại cài đặt" Height="30" Padding="14,0" Margin="8,0,0,0" Style="{StaticResource VideoChromeResetButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
