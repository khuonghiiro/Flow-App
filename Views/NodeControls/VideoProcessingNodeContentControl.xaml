<UserControl x:Class="FlowMy.Views.NodeControls.VideoProcessingNodeContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlowMy.Controls"
             xmlns:models="clr-namespace:FlowMy.Models.Nodes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:FlowMy.Converters"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>

        <!-- Spacing tokens (4px grid) -->
        <sys:Double x:Key="space-xs">4</sys:Double>
        <sys:Double x:Key="space-sm">8</sys:Double>
        <sys:Double x:Key="space-md">12</sys:Double>
        <sys:Double x:Key="space-lg">16</sys:Double>
        <sys:Double x:Key="space-xl">24</sys:Double>

        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#ECECF4"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#9CA3B8"/>
        <SolidColorBrush x:Key="ThemeCardBackgroundBrush" Color="#18181F"/>
        <SolidColorBrush x:Key="ThemeCardBorderBrush" Color="#2E2E3D"/>
        <SolidColorBrush x:Key="ThemeInnerCardBackgroundBrush" Color="#1E1E28"/>
        <SolidColorBrush x:Key="ThemeInnerCardBorderBrush" Color="#2A2A38"/>
        <SolidColorBrush x:Key="ThemeInputBackgroundBrush" Color="#22222C"/>
        <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#3A3A4A"/>
        <SolidColorBrush x:Key="ThemeInputForegroundBrush" Color="#F1F5FF"/>
        <SolidColorBrush x:Key="ThemeOverlayBackgroundBrush" Color="#DD1A1A22"/>
        <SolidColorBrush x:Key="ThemeOverlayBorderBrush" Color="#404050"/>
        <SolidColorBrush x:Key="ThemeTimelinePanelBrush" Color="#12121A"/>
        <SolidColorBrush x:Key="ThemeTrackBackgroundBrush" Color="#353545"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="ThemeTabNavBackgroundBrush" Color="#16161E"/>
        <SolidColorBrush x:Key="ThemeLogContainerBackgroundBrush" Color="#12121A"/>
        <SolidColorBrush x:Key="ThemeActionBarBackgroundBrush" Color="#16161E"/>
        <SolidColorBrush x:Key="ThemeActionBarBorderBrush" Color="#5AF59E0B"/>
        <SolidColorBrush x:Key="ThemeWarmAccentBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="ThemeWarmAccentBrushSoft" Color="#66F59E0B"/>
        <SolidColorBrush x:Key="ThemeBottomBarGroupInactiveBorderBrush" Color="#66909AA8"/>
        <SolidColorBrush x:Key="ThemeBottomBarActiveGroupBackgroundBrush" Color="#28F59E0B"/>
        <SolidColorBrush x:Key="ThemeVideoChromePrimaryBgBrush" Color="#303240"/>
        <SolidColorBrush x:Key="ThemeVideoChromePrimaryHoverBgBrush" Color="#3A3D50"/>
        <SolidColorBrush x:Key="ThemeVideoChromePrimaryFgBrush" Color="#F1F5FF"/>
        <SolidColorBrush x:Key="ThemeVideoChromePrimaryBorderBrush" Color="#45FFFFFF"/>
        <SolidColorBrush x:Key="ThemeVideoChromeSecondaryBgBrush" Color="#282A36"/>
        <SolidColorBrush x:Key="ThemeVideoChromeSecondaryHoverBgBrush" Color="#343644"/>
        <SolidColorBrush x:Key="ThemeVideoChromeSecondaryFgBrush" Color="#E8ECF8"/>
        <SolidColorBrush x:Key="ThemeVideoChromeSecondaryBorderBrush" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="ThemeVideoOpenButtonFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeValueBadgeBackgroundBrush" Color="#2A2B38"/>
        <SolidColorBrush x:Key="ThemeTransportPlayBgBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="ThemeTransportPlayHoverBgBrush" Color="#4F52DD"/>
        <SolidColorBrush x:Key="ThemeTransportPlayFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeTransportIconHoverBgBrush" Color="#303240"/>
        <SolidColorBrush x:Key="ThemeQuickOverlayHoverBgBrush" Color="#343644"/>
        <SolidColorBrush x:Key="ThemePresetChipBgBrush" Color="#242530"/>
        <SolidColorBrush x:Key="ThemePresetChipBorderBrush" Color="#3A3C4C"/>
        <SolidColorBrush x:Key="ThemePresetChipHoverBgBrush" Color="#303242"/>
        <SolidColorBrush x:Key="ThemePresetChipPressedBgBrush" Color="#2C2E3C"/>
        <SolidColorBrush x:Key="ThemePresetChipResetBgBrush" Color="#282C38"/>
        <SolidColorBrush x:Key="ThemePresetChipResetBorderBrush" Color="#464A5A"/>
        <SolidColorBrush x:Key="ThemeOnAccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeSliderThumbBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeComboPopupBackgroundBrush" Color="#1E1E2A"/>
        <SolidColorBrush x:Key="ThemeComboItemHoverBrush" Color="#343448"/>
        <SolidColorBrush x:Key="ThemeComboSelectedItemBrush" Color="#554B556A"/>
        <SolidColorBrush x:Key="ThemeTabHoverBrush" Color="#2A2A38"/>
        <SolidColorBrush x:Key="ThemeTabSelectedBackgroundBrush" Color="#CC6366F1"/>
        <SolidColorBrush x:Key="ThemeVideoLogSegmentTrackBrush" Color="#252530"/>
        <SolidColorBrush x:Key="ThemeActionExtractBrush" Color="#262E8FF9"/>
        <SolidColorBrush x:Key="ThemeActionSubtitleBrush" Color="#266366F1"/>
        <SolidColorBrush x:Key="ThemeActionWatermarkBrush" Color="#2614B8A6"/>
        <SolidColorBrush x:Key="ThemeActionConvertBrush" Color="#26A78BFA"/>
        <SolidColorBrush x:Key="ThemeActionTrimBrush" Color="#26EF4444"/>
        <SolidColorBrush x:Key="ThemeActionSnapshotBrush" Color="#26F59E0B"/>
        <SolidColorBrush x:Key="ThemeActionFolderVideoBrush" Color="#264ADE80"/>
        <SolidColorBrush x:Key="ThemeActionFolderFramesBrush" Color="#26F59E0B"/>
        <SolidColorBrush x:Key="ThemeOpenVideoBrush" Color="#DC2626"/>
        <SolidColorBrush x:Key="ThemeOpenVideoHoverBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="ThemeOpenVideoPressedBrush" Color="#B91C1C"/>
        <SolidColorBrush x:Key="ThemeTimelineTrackBrush" Color="#3A3A48"/>
        <SolidColorBrush x:Key="ThemeTimelineProgressBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="ThemeTimelineThumbStrokeBrush" Color="#E2E6EF"/>
        <SolidColorBrush x:Key="ThemeFrameLabelPreviewBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ThemeFrameLabelPreviewFg" Color="#151922"/>
        <SolidColorBrush x:Key="ThemeVideoViewportBrush" Color="#0C0F17"/>
        <SolidColorBrush x:Key="ThemePanelHeaderBrush" Color="#202330"/>
        <SolidColorBrush x:Key="ThemePanelHeaderBorderBrush" Color="#353A4D"/>

        <Style x:Key="VideoOpenPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource ThemeOpenVideoBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeVideoOpenButtonFgBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeOpenVideoHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ThemeOpenVideoPressedBrush}"/>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VideoChromePrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeVideoChromePrimaryFgBrush}"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7C6BF8" Offset="0"/>
                        <GradientStop Color="#6366F1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#8B85FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FillBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PrimaryScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="PrimaryTranslate" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBd" Property="Background" Value="{DynamicResource ThemeVideoChromePrimaryHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillBd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="0.97"/>
                                            <TranslateTransform Y="1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FillBd" Property="Opacity" Value="0.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoChromeSecondaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeVideoChromeSecondaryFgBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FillBd2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SecondaryScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="SecondaryTranslate" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBd2" Property="Background" Value="{DynamicResource ThemeVideoChromeSecondaryHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillBd2" Property="Background" Value="{DynamicResource ThemePresetChipPressedBgBrush}"/>
                                <Setter TargetName="FillBd2" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="0.97"/>
                                            <TranslateTransform Y="1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FillBd2" Property="Opacity" Value="0.48"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VideoChromeResetButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#FDE68A"/>
            <Setter Property="Background" Value="#2A1B14"/>
            <Setter Property="BorderBrush" Value="#B45309"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FillBdReset"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBdReset" Property="Background" Value="#3D2418"/>
                                <Setter TargetName="FillBdReset" Property="BorderBrush" Value="#D97706"/>
                                <Setter Property="Foreground" Value="#FEF3C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FillBdReset" Property="Background" Value="#22140D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FillBdReset" Property="Opacity" Value="0.48"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackgroundBrush}"/>
            <Setter Property="Padding" Value="0"/>
           
        </Style>
        <Style x:Key="InnerCardStyle" TargetType="Border">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInnerCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInnerCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
        </Style>
        <Style x:Key="InspectorSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style x:Key="InspectorFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValueBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeValueBadgeBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="4,4"/>
        </Style>
        <Style x:Key="VideoLogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeInputForegroundBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ThemeInnerCardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ReadableCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
        </Style>
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,28,0"
                                              VerticalAlignment="Center"/>
                            <TextBlock Text="▾"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                       FontSize="10"/>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource ThemeComboPopupBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeComboItemHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource ThemeComboPopupBackgroundBrush}"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeComboItemHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource ThemeComboSelectedItemBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeComboItemHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentTextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}"/>
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeInputForegroundBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}"/>
        <Style TargetType="Slider" x:Key="ModernSliderStyle">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid MinHeight="20">
                            <Border Height="5" CornerRadius="3" Background="{DynamicResource ThemeTrackBackgroundBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton>
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="{DynamicResource ThemeAccentBrush}" Opacity="0.9" Height="5" CornerRadius="3,0,0,3" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton>
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" Height="5" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid x:Name="ThumbRoot" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>
                                                    <Ellipse Fill="{DynamicResource ThemeSliderThumbBrush}"
                                                             Stroke="{DynamicResource ThemeAccentBrush}"
                                                             StrokeThickness="2"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                      
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="600"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IbFill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                                <Setter TargetName="IbFill" Property="Background" Value="{DynamicResource ThemeTransportIconHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IbFill" Property="Background" Value="{DynamicResource ThemeVideoChromeSecondaryHoverBgBrush}"/>
                                <Setter TargetName="IbFill" Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="0.97"/>
                                            <TranslateTransform Y="1"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickOverlayIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeOverlayBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeQuickOverlayHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ThemeVideoChromeSecondaryHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeTransportPlayBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTransportPlayFgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeVideoChromePrimaryBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="PlayBd"
                                    CornerRadius="18"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="PlayRing"
                                    CornerRadius="18"
                                    BorderBrush="{DynamicResource ThemeWarmAccentBrush}"
                                    BorderThickness="1"
                                    Opacity="0"
                                    Margin="-1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlayBd" Property="Background" Value="{DynamicResource ThemeTransportPlayHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PlayBd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PlayBd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PresetChipStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePresetChipBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePresetChipBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="20"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ChipWarm"
                                    CornerRadius="20"
                                    BorderBrush="{DynamicResource ThemeWarmAccentBrush}"
                                    BorderThickness="1"
                                    Opacity="0"
                                    Margin="-1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource ThemePresetChipHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource ThemePresetChipPressedBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                                <Setter TargetName="ChipBd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PresetChipResetStyle" TargetType="Button" BasedOn="{StaticResource PresetChipStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemePresetChipResetBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePresetChipResetBorderBrush}"/>
        </Style>
        <!-- Portrait column: two equal segments (50/50), headers centered in each cell -->
        <Style x:Key="VideoPortraitTabItemStyle" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="ItemRoot"
                                Background="Transparent"
                                CornerRadius="8"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ThemeTabHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ThemeTabSelectedBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VideoPortraitEqualTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource VideoPortraitTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" ClipToBounds="True" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Margin="12,4,12,10"
                                    Padding="3"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="10"
                                    Background="{DynamicResource ThemeVideoLogSegmentTrackBrush}"
                                    BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                    BorderThickness="1">
                                <UniformGrid Rows="1" Columns="2" IsItemsHost="True"/>
                            </Border>
                            <Border Grid.Row="1" Background="Transparent">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="0"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillTabNavStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,4"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="ToolTipService.InitialShowDelay" Value="600"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Bd"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="Indicator"
                                                Height="2"
                                                VerticalAlignment="Bottom"
                                                Margin="12,0,12,4"
                                                CornerRadius="1"
                                                Background="{DynamicResource ThemeAccentBrush}"
                                                Opacity="0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTabSelectedBackgroundBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                            <Setter TargetName="Bd" Property="Padding" Value="12,8"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccentTextBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="False"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTabHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource ThemeTrackBackgroundBrush}" BorderBrush="{DynamicResource ThemeOverlayBorderBrush}" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource ThemeSliderThumbBrush}" Margin="3" HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AspectRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ThemeOnAccentTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemeTabHoverBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootContentGrid" Margin="12,10,12,14"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True"
          TextOptions.TextHintingMode="Fixed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="HeaderCardBorder" Style="{StaticResource GlassCardStyle}" Margin="0,0,0,10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions> 
                <controls:SvgViewboxEx Grid.Column="0" x:Name="IconView" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource ThemeTextPrimaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="OpenVideoButtonHeader"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,6,0"
                            Style="{StaticResource VideoOpenPrimaryButtonStyle}"
                            Click="OpenVideoButton_Click"
                            ToolTip="Mở video">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="14" Height="14" Margin="0,0,6,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='folder-open duotone-light'}"/>
                            <TextBlock Text="Mở video" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveEditedVideoButton"
                            Height="32"
                            Padding="12,0"
                            Style="{StaticResource VideoChromePrimaryButtonStyle}"
                            ToolTip="Lưu video đã chỉnh sửa">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="14" Height="14" Margin="0,0,6,0" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='floppy-disk-pen sharp-duotone-light'}"/>
                            <TextBlock Text="Lưu video" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock x:Name="VideoPathText"
                               FontSize="10"
                               Opacity="0.72"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380"
                               Margin="0,4,0,0"
                               FontFamily="Segoe UI"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeModeButton" Width="34" Height="32" MinWidth="34" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Đổi sáng/tối" Margin="0,0,4,0">
                        <controls:SvgViewboxEx Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='sun-bright duotone-light'}"/>
                    </Button>
                    <Button x:Name="ToggleNodeSizeButton" Width="34" Height="32" MinWidth="34" Padding="0" Style="{StaticResource VideoChromeSecondaryButtonStyle}" ToolTip="Phóng to/thu nhỏ node video" Margin="0,0,4,0">
                        <controls:SvgViewboxEx Width="15" Height="15" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='expand utility-fill-semibold'}"/>
                    </Button>
                    <Button x:Name="RunProcessingButton" Height="32" MinWidth="96" Padding="12,0" Style="{StaticResource VideoChromePrimaryButtonStyle}" ToolTip="Chạy xử lý video qua FFmpeg">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgViewboxEx Width="14" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='play duotone-light'}"/>
                            <TextBlock Text="Chạy" Margin="6,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300"/>
                <ColumnDefinition Width="3*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="PreviewContainerBorder" Style="{StaticResource GlassCardStyle}" Margin="0,0,10,0" Padding="0" ClipToBounds="True" VerticalAlignment="Stretch">
                <Grid x:Name="PreviewColumnShellGrid">
                <Grid x:Name="VideoContainerGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="VideoTopPackGrid" Grid.Row="0" Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Margin="10,10,10,8" Padding="8" Background="{DynamicResource ThemePanelHeaderBrush}" CornerRadius="10" BorderBrush="{DynamicResource ThemePanelHeaderBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0" HorizontalAlignment="Center" Margin ="0,3,0,0">
                            <RadioButton x:Name="Aspect169" Content="16:9" GroupName="AspectRatio" IsChecked="True" Style="{StaticResource AspectRadioStyle}" ToolTip="Ngang chuẩn 16:9"/>
                            <RadioButton x:Name="Aspect916" Content="9:16" GroupName="AspectRatio" Style="{StaticResource AspectRadioStyle}" ToolTip="Dọc 9:16"/>
                            <RadioButton x:Name="Aspect11" Content="1:1" GroupName="AspectRatio" Style="{StaticResource AspectRadioStyle}" ToolTip="Vuông 1:1"/>
                            <RadioButton x:Name="Aspect32" Content="3:2" GroupName="AspectRatio" Style="{StaticResource AspectRadioStyle}" ToolTip="Ngang 3:2"/>
                            <RadioButton x:Name="Aspect23" Content="2:3" GroupName="AspectRatio" Style="{StaticResource AspectRadioStyle}" ToolTip="Dọc 2:3"/>
                            <RadioButton x:Name="AspectAuto" Content="Auto" GroupName="AspectRatio" Style="{StaticResource AspectRadioStyle}" ToolTip="Dùng kích thước video thật"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Margin="8,0,0,0">
                            <Border x:Name="HwBadge"
                                    Background="#10B981"
                                    Width="10" Height="10" CornerRadius="5"
                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                    ToolTip="CUDA"/>
                            <Border Padding="7,8" CornerRadius="8"
                                    Background="{DynamicResource ThemeOverlayBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeOverlayBorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,5,0"  VerticalAlignment="Center" x:Name="LiveDot" Visibility="Collapsed"/>
                                    <TextBlock Text="Preview" FontSize="10" Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="ToggleBeforeAfterButton"
                                    Margin="6,0,0,0"
                                    Height="24"
                                    Padding="8,0"
                                    FontSize="10"
                                    Style="{StaticResource VideoChromeSecondaryButtonStyle}"
                                    Content="Before/After"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1"
                        x:Name="VideoViewportClipBorder"
                        Margin="10,0,10,0"
                        CornerRadius="10"
                        Background="{DynamicResource ThemeVideoViewportBrush}">
                    <Grid>
                <Viewbox x:Name="VideoViewbox" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <MediaElement x:Name="PreviewMedia"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  Stretch="Uniform"
                                  Width="1280"
                                  Height="720"
                                  Volume="0.7"
                                  ScrubbingEnabled="False"
                                  Visibility="Collapsed"
                                  Cursor="Hand"/>
                </Viewbox>
                <Grid x:Name="VideoAreaGrid">
                    <Grid x:Name="PreviewPlaceholder"
                          Panel.ZIndex="10"
                          Visibility="Visible">
                        <Border CornerRadius="12"
                                BorderThickness="0"
                                Background="{DynamicResource ThemeOverlayBackgroundBrush}"
                                Padding="24,18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid>
                                <Rectangle RadiusX="12" RadiusY="12"
                                           Stroke="{DynamicResource ThemeCardBorderBrush}"
                                           StrokeThickness="2"
                                           StrokeDashArray="6,4"
                                           Opacity="0.9"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:SvgViewboxEx Width="42" Height="42" Margin="0" Opacity="0.32" HorizontalAlignment="Center" Fill="{DynamicResource ThemeTextPrimaryBrush}" Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='cloud-arrow-down duotone-light'}"/>
                                <TextBlock Text="Kéo video vào đây"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           Opacity="0.92"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Center"/>
