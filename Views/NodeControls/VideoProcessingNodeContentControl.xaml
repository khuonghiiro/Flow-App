                                    <Ellipse x:Name="ProgressThumb" Width="12" Height="12" Canvas.Top="8" Visibility="Collapsed"
                                             Fill="{DynamicResource ThemeTimelineProgressBrush}"
                                             Stroke="{DynamicResource ThemeTimelineThumbStrokeBrush}" StrokeThickness="2">
                                        <Ellipse.RenderTransformOrigin>0.5,0.5</Ellipse.RenderTransformOrigin>
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="ProgressThumbScale" ScaleX="1" ScaleY="1"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Canvas>
                            </Grid>
                            <TextBlock x:Name="TimeTotalText" Grid.Column="2" Text="00:00" FontSize="10" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontFamily="Consolas" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </Grid>
                        <TextBlock x:Name="SeekPerfText"
                                   Margin="0,0,0,6"
                                   FontSize="9"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                   Text="Preview: NORMAL | Seek: -- ms"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SkipBackButton" Grid.Column="0" Width="28" Height="28" Padding="0" Style="{StaticResource IconButtonStyle}" ToolTip="Lùi 5 giây">
                                <controls:SvgViewboxEx Width="14" Height="14"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       Source="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='backward regular'}"/>
                            </Button>
                            <Button x:Name="PlayPauseButton" Grid.Column="2" Width="38" Height="38" Padding="0" Style="{StaticResource PlayButtonStyle}">
