                                           Visibility="Collapsed"
                                           Text="Quality: 100/100"/>
                                        </Grid>
                                        
                                        <TextBlock Text="Resize output frames"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,6,0,4"/>
