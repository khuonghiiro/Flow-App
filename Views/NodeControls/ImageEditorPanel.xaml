<UserControl x:Class="FlowMy.Views.NodeControls.ImageEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FlowMy.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:FlowMy.Converters"
             mc:Ignorable="d"
             d:DesignWidth="220" d:DesignHeight="600"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <!-- ═══ IP PALETTE ═══ -->
        <SolidColorBrush x:Key="ipBg" Color="#0a0c10"/>
        <SolidColorBrush x:Key="ipSurface" Color="#111318"/>
        <SolidColorBrush x:Key="ipSurface2" Color="#181c24"/>
        <SolidColorBrush x:Key="ipBorder" Color="#252932"/>
        <SolidColorBrush x:Key="ipBorderLight" Color="#2a2e3a"/>
        <SolidColorBrush x:Key="ipText" Color="#dde3ef"/>
        <SolidColorBrush x:Key="ipMuted" Color="#5a6072"/>
        <SolidColorBrush x:Key="ipAccent" Color="#4fffb0"/>
        <SolidColorBrush x:Key="ipAccent2" Color="#00cfff"/>
        <SolidColorBrush x:Key="ipHover" Color="#1e222c"/>
        <SolidColorBrush x:Key="ipActiveItem" Color="#1a4fffb0"/>

        <!-- Checkered brush for transparent thumbnails (Photoshop style) -->
        <VisualBrush x:Key="CheckeredBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="8" Height="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="4"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="4"/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#202020"/>
                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#2d2d2d"/>
                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#2d2d2d"/>
                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#202020"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- ═══ COMBOBOX STYLE ═══ -->
        <Style x:Key="IpComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource ipSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource ipText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,0,20,0"
                                              VerticalAlignment="Center"/>
                            <TextBlock Text="▾"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ipMuted}"
                                       FontSize="10"/>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource ipSurface2}"
                                        BorderBrush="{StaticResource ipBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ipAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource ipText}"/>
                        <Setter Property="Background" Value="{StaticResource ipSurface2}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontSize" Value="9"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource ipHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource ipActiveItem}"/>
                                            <Setter Property="Foreground" Value="{StaticResource ipAccent}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ LAYER ITEM (Photoshop-style) ═══ -->
        <DataTemplate x:Key="LayerItemTemplate">
            <Border x:Name="LayerItemBd" Padding="0" Margin="0,1" CornerRadius="4"
                    Background="Transparent" Cursor="Hand" BorderThickness="0"
                    MouseLeftButtonDown="LayerItem_MouseLeftButtonDown"
                    MouseMove="LayerItem_MouseMove"
                    MouseLeftButtonUp="LayerItem_MouseLeftButtonUp"
                    MouseRightButtonUp="LayerItem_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left active stripe -->
                    <Border x:Name="ActiveStripe" Grid.Column="0" Background="Transparent" CornerRadius="3,0,0,3"/>

                    <Border Grid.Column="1" Padding="6,4">
                        <DockPanel>
                             <!-- Collapse/Expand toggle for parent layers with children (▼/▶) -->
                             <Border x:Name="CollapseToggle" DockPanel.Dock="Left" Width="16" Height="20" Margin="0,0,2,0"
                                     VerticalAlignment="Center" Cursor="Hand" CornerRadius="3"
                                     Background="Transparent" Visibility="Collapsed"
                                     MouseLeftButtonDown="CollapseToggle_Click">
                                 <TextBlock Text="{Binding CollapseIcon}" Foreground="{StaticResource ipMuted}" FontSize="8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False"/>
                             </Border>
                             <!-- Eye toggle (left) -->
                             <Border x:Name="LayerVisibilityToggle" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,4,0"
                                     VerticalAlignment="Center" Cursor="Hand" CornerRadius="3"
                                     Background="Transparent"
                                     MouseLeftButtonDown="LayerVisibilityToggle_Click">
                                 <controls:SvgViewboxEx x:Name="EyeIcon" Width="14" Height="14"
                                     Fill="{StaticResource ipText}"
                                     Source="{Binding Source={x:Static sys:String.Empty},
                                              Converter={StaticResource IconKeyToPathConverter},
                                              ConverterParameter='eye regular'}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsHitTestVisible="False"/>
                             </Border>

                             <!-- Radio indicator for child layer variants -->
                             <Border x:Name="VariantRadioIndicator" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,4,0"
                                     VerticalAlignment="Center" CornerRadius="10"
                                     Background="Transparent" BorderThickness="1.5"
                                     Visibility="Collapsed" IsHitTestVisible="False">
                                 <Border.Style>
                                     <Style TargetType="Border">
                                         <Setter Property="BorderBrush" Value="{StaticResource ipMuted}"/>
                                     </Style>
                                 </Border.Style>
                                 <Ellipse x:Name="VariantRadioDot" Width="8" Height="8" Fill="#00cfff" HorizontalAlignment="Center" VerticalAlignment="Center">
                                     <Ellipse.Style>
                                         <Style TargetType="Ellipse">
                                             <Setter Property="Visibility" Value="Collapsed"/>
                                         </Style>
                                     </Ellipse.Style>
                                 </Ellipse>
                             </Border>
                            <!-- Layer action buttons (right) -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <!-- Copy layer button -->
                                <Border x:Name="BtnCopyLayerInline" Width="20" Height="20" Cursor="Hand" CornerRadius="3"
                                        Background="Transparent" ToolTip="Nhân đôi Layer (Duplicate)"
                                        MouseLeftButtonDown="BtnCopyLayer_Click">
                                    <controls:SvgViewboxEx Width="12" Height="12"
                                        Fill="{StaticResource ipText}"
                                        Source="{Binding Source={x:Static sys:String.Empty},
                                                 Converter={StaticResource IconKeyToPathConverter},
                                                 ConverterParameter='copy sharp-duotone-light'}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                </Border>
                                <!-- Promote variant to standalone layer button (visible only for child layers) -->
                                <Border x:Name="BtnPromoteLayerInline" Width="20" Height="20" Cursor="Hand" CornerRadius="3"
                                        Background="Transparent" ToolTip="Nhân đôi thành Layer mới (Ctrl+J)"
                                        Visibility="Collapsed"
                                        MouseLeftButtonDown="BtnPromoteLayer_Click">
                                    <controls:SvgViewboxEx Width="12" Height="12"
                                        Fill="{StaticResource ipText}"
                                        Source="{Binding Source={x:Static sys:String.Empty},
                                                 Converter={StaticResource IconKeyToPathConverter},
                                                 ConverterParameter='layer-plus sharp-duotone-solid'}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                </Border>
                                <!-- Delete layer button -->
                                <Border x:Name="BtnDeleteLayerInline" Width="20" Height="20" Cursor="Hand" CornerRadius="3"
                                        Background="Transparent" ToolTip="Xoá Layer"
                                        MouseLeftButtonDown="BtnDeleteLayer_Click">
                                    <controls:SvgViewboxEx Width="12" Height="12"
                                        Fill="{StaticResource ipText}"
                                        Source="{Binding Source={x:Static sys:String.Empty},
                                                 Converter={StaticResource IconKeyToPathConverter},
                                                 ConverterParameter='trash-can regular'}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                </Border>
                                <!-- Lock toggle (rightmost) -->
                                <Border x:Name="LayerLockToggle" Width="20" Height="20" Cursor="Hand" CornerRadius="3"
                                        Background="Transparent" ToolTip="Khoá/Mở khoá Layer"
                                        MouseLeftButtonDown="LayerLockToggle_Click">
                                    <controls:SvgViewboxEx x:Name="LockIcon" Width="12" Height="12"
                                        Fill="{StaticResource ipText}"
                                        Source="{Binding Source={x:Static sys:String.Empty},
                                                 Converter={StaticResource IconKeyToPathConverter},
                                                 ConverterParameter='unlock light'}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                </Border>
                            </StackPanel>
                            <!-- Thumbnail + Name (center, horizontal) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Thumbnail with transparent background -->
                                <Border Margin="0,0,6,0"
                                        CornerRadius="3" ClipToBounds="True"
                                        Background="Transparent"
                                        VerticalAlignment="Center" Width="44" Height="32">
                                    <Grid>
                                        <Image Stretch="Uniform" Source="{Binding Thumbnail}"
                                               MaxHeight="30" MaxWidth="42"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- Loading Spinner/Hourglass Overlay with Progress % -->
                                        <Border x:Name="LoadingOverlay" Background="#cc0a0c10" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock x:Name="LoadingText" Foreground="#00cfff" FontSize="9" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Run Text="⏳"/><Run Text=" "/><Run Text="{Binding LoadingProgress, Mode=OneWay}"/><Run Text="%"/>
                                            </TextBlock>
                                        </Border>
                                        <!-- Error overlay (when AI generation failed) -->
                                        <Border x:Name="ErrorOverlay" Background="#cc2a0a0c" Visibility="{Binding IsLoadingError, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="❌" Foreground="#ff6b6b" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Text layer type badge overlay -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="#111318" CornerRadius="2" Width="11" Height="11"
                                                Visibility="{Binding IsTextLayer, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,0,1,1" BorderBrush="#00cfff" BorderThickness="0.8">
                                            <TextBlock Text="T" FontSize="7" FontWeight="Bold" Foreground="#00cfff"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1.5,0,0"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="80">
                                    <!-- TextBlock for standard display -->
                                    <TextBlock x:Name="TxtLayerName" Text="{Binding Name}" Foreground="{StaticResource ipText}"
                                               FontSize="10" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsEditingName, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                               MouseLeftButtonDown="TxtLayerName_MouseLeftButtonDown"/>
                                    <!-- TextBox for renaming -->
                                    <TextBox x:Name="TxtLayerNameEdit" Text="{Binding Name, Mode=OneWay}"
                                             Foreground="Black" Background="White" FontSize="10" VerticalAlignment="Center"
                                             Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibilityConverter}}"
                                             LostFocus="TxtLayerNameEdit_LostFocus"
                                             KeyDown="TxtLayerNameEdit_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Hover effect for layer item -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="LayerItemBd" Property="Background" Value="{StaticResource ipHover}"/>
                </Trigger>
                <!-- Selected layer highlight -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="LayerItemBd" Property="Background" Value="#222e3f"/>
                </DataTrigger>
                <!-- Active layer highlight (Photoshop style) -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="LayerItemBd" Property="Background" Value="#2d3c54"/>
                    <Setter TargetName="ActiveStripe" Property="Background" Value="#00cfff"/>
                </DataTrigger>
                <!-- Error state (AI generation failed) - light red background -->
                <DataTrigger Binding="{Binding IsLoadingError}" Value="True">
                    <Setter TargetName="LayerItemBd" Property="Background" Value="#2a1a1a"/>
                    <Setter TargetName="LayerItemBd" Property="BorderBrush" Value="#4dff4444"/>
                    <Setter TargetName="LayerItemBd" Property="BorderThickness" Value="1"/>
                </DataTrigger>
                <!-- Show collapse toggle for parent layers with children -->
                <DataTrigger Binding="{Binding HasChildren}" Value="True">
                    <Setter TargetName="CollapseToggle" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Triggers for child/variant layers -->
                <DataTrigger Binding="{Binding IsChildLayer}" Value="True">
                    <Setter TargetName="LayerItemBd" Property="Margin" Value="24,1,0,1"/>
                    <Setter TargetName="LayerVisibilityToggle" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="VariantRadioIndicator" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="BtnCopyLayerInline" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BtnPromoteLayerInline" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="LayerLockToggle" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CollapseToggle" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActiveVariant}" Value="True">
                    <Setter TargetName="VariantRadioDot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="VariantRadioIndicator" Property="BorderBrush" Value="#00cfff"/>
                </DataTrigger>
                <!-- Hidden layer opacity -->
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter TargetName="LayerItemBd" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="EyeIcon" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="EyeIcon" Property="Source" Value="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='eye-slash regular'}"/>
                </DataTrigger>
                <!-- Hover visibility toggle (ghost eye) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="False"/>
                        <Condition Binding="{Binding ElementName=LayerVisibilityToggle, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="EyeIcon" Property="Opacity" Value="1.0"/>
                    <Setter TargetName="LayerVisibilityToggle" Property="Background" Value="#15ffffff"/>
                </MultiDataTrigger>
                <!-- Hover visibility when active -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True"/>
                        <Condition Binding="{Binding ElementName=LayerVisibilityToggle, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="LayerVisibilityToggle" Property="Background" Value="#15ffffff"/>
                </MultiDataTrigger>
                <!-- Locked layer triggers -->
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="LockIcon" Property="Source" Value="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='lock light'}"/>
                    <Setter TargetName="LockIcon" Property="Opacity" Value="1.0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLocked}" Value="False">
                    <Setter TargetName="LockIcon" Property="Source" Value="{Binding Source={x:Static sys:String.Empty}, Converter={StaticResource IconKeyToPathConverter}, ConverterParameter='unlock light'}"/>
                    <Setter TargetName="LockIcon" Property="Opacity" Value="0.25"/>
                </DataTrigger>
                <!-- Hover lock toggle when unlocked (ghost lock) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLocked}" Value="False"/>
                        <Condition Binding="{Binding ElementName=LayerLockToggle, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="LockIcon" Property="Opacity" Value="0.8"/>
                    <Setter TargetName="LayerLockToggle" Property="Background" Value="#15ffffff"/>
                </MultiDataTrigger>
                <!-- Hover lock toggle when locked -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLocked}" Value="True"/>
                        <Condition Binding="{Binding ElementName=LayerLockToggle, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="LayerLockToggle" Property="Background" Value="#15ffffff"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ MINI ICON BUTTON (code-behind builds template to avoid theme clash) ═══ -->
        <Style x:Key="IpMiniBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ipMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource ipText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ADJUSTMENT BUTTON STYLE ═══ -->
        <Style x:Key="IpAdjBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Background" Value="{StaticResource ipSurface2}"/>
            <Setter Property="Foreground" Value="{StaticResource ipText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ipAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource ipAccent}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ipAccent2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ipAccent2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SLEEK SLIDER STYLE (Photoshop-style) ═══ -->
        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Top" Height="4" Grid.Row="0"/>
                            <TickBar x:Name="BottomTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Bottom" Height="4" Grid.Row="2"/>

                            <!-- Sleek Track (Thanh trượt mỏng) -->
                            <Border x:Name="TrackBackground" 
                                    Background="#252932" 
                                    Height="4" 
                                    CornerRadius="2"
                                    VerticalAlignment="Center" 
                                    Grid.Row="1"
                                    Margin="5,0"/>

                            <!-- Track Fill (Thanh đã kéo qua) -->
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#00cfff" Height="4" CornerRadius="2" Margin="5,0,0,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <!-- Sleek Thumb (Nút kéo nhỏ gọn) -->
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Focusable="False" Height="10" Width="10">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ellipse" 
                                                         Fill="#dde3ef" 
                                                         Stroke="#00cfff" 
                                                         StrokeThickness="1.5"
                                                         Width="10" Height="10"
                                                         VerticalAlignment="Center" 
                                                         HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ellipse" Property="Fill" Value="#ffffff"/>
                                                        <Setter TargetName="ellipse" Property="Stroke" Value="#4fffb0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ellipse" Property="Fill" Value="#4fffb0"/>
                                                        <Setter TargetName="ellipse" Property="Stroke" Value="#ffffff"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IpListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource ipBg}" BorderBrush="{StaticResource ipBorderLight}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="600">
                <StackPanel Margin="5,4,5,6">

                    <!-- ══════ BRUSH PROPERTIES PANEL ══════ -->
                    <StackPanel x:Name="BrushPropertiesPanel" Visibility="Collapsed">
                        <Border Padding="6,4" CornerRadius="3" Margin="0,2,0,3"
                                Background="{StaticResource ipSurface}">
                            <Border BorderBrush="{StaticResource ipAccent2}"
                                    BorderThickness="2,0,0,0" Padding="5,0,0,0">
                                <TextBlock Text="BRUSH" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource ipMuted}"/>
                            </Border>
                        </Border>

                        <Border Background="{StaticResource ipSurface2}" CornerRadius="4"
                                Padding="6,4" Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26*"/>
                                    <ColumnDefinition Width="109*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Sliders with Tooltips -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Grid.ColumnSpan="2">
                                    <DockPanel Margin="0,0,0,2" ToolTip="Kích thước đầu cọ (Brush Size) - Độ rộng nét vẽ tính theo pixel">
                                        <TextBlock DockPanel.Dock="Left" Text="Size"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="9" Width="32" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="3,1" MinWidth="26">
                                            <TextBlock x:Name="TxtBrushSize" FontSize="9"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="10"/>
                                        </Border>
                                        <Slider x:Name="SliderBrushSize" Minimum="1" Maximum="200" Value="10"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="SliderBrushSize_ValueChanged"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,2" ToolTip="Độ cứng nét vẽ (Hardness) - 0% là viền nhòe mềm mại, 100% là viền sắc cạnh">
                                        <TextBlock DockPanel.Dock="Left" Text="Hard"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="9" Width="32" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="3,1" MinWidth="26">
                                            <TextBlock x:Name="TxtBrushHardness" FontSize="9"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="100%"/>
                                        </Border>
                                        <Slider x:Name="SliderBrushHardness" Minimum="0" Maximum="100" Value="100"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="SliderBrushHardness_ValueChanged"/>
                                    </DockPanel>
                                    <DockPanel ToolTip="Độ phủ màu (Flow) - Tốc độ ra màu/độ đặc sắc khi di chuyển chuột">
                                        <TextBlock DockPanel.Dock="Left" Text="Flow"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="9" Width="32" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="3,1" MinWidth="26">
                                            <TextBlock x:Name="TxtBrushFlow" FontSize="9"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="100%"/>
                                        </Border>
                                        <Slider x:Name="SliderBrushFlow" Minimum="1" Maximum="100" Value="100"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="SliderBrushFlow_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Column 1: Photoshop-style brush tip preview with checkerboard pattern -->
                                <Border Grid.Column="2" Width="56" Height="56" Margin="6,0,0,0"
                                        Background="{StaticResource ipSurface}" BorderBrush="{StaticResource ipBorder}"
                                        BorderThickness="1" CornerRadius="4" VerticalAlignment="Center"
                                        ToolTip="Xem trước đầu cọ (Brush Preview)">
                                    <Grid ClipToBounds="True">
                                        <!-- Checkerboard pattern background -->
                                        <Grid.Background>
                                            <VisualBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                                <VisualBrush.Visual>
                                                    <Grid Width="8" Height="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="4"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="4"/>
                                                            <RowDefinition Height="4"/>
                                                        </Grid.RowDefinitions>
                                                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="#1c202a"/>
                                                        <Rectangle Grid.Row="0" Grid.Column="1" Fill="#111318"/>
                                                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="#111318"/>
                                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#1c202a"/>
                                                    </Grid>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Grid.Background>

                                        <!-- Visual preview of the brush tip -->
                                        <Ellipse x:Name="BrushPreviewEllipse"
                                                 MaxWidth="48" MaxHeight="48"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsHitTestVisible="False"/>

                                        <!-- Crosshair lines (Photoshop center target) -->
                                        <Path Data="M0,8 L16,8 M8,0 L8,16" 
                                              Stroke="#30FFFFFF" 
                                              StrokeThickness="1" 
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ══════ TEXT PROPERTIES PANEL ══════ -->
                    <StackPanel x:Name="TextPropertiesPanel" Visibility="Collapsed">
                        <Border Padding="6,4" CornerRadius="3" Margin="0,2,0,3"
                                Background="{StaticResource ipSurface}">
                            <Border BorderBrush="{StaticResource ipAccent2}"
                                    BorderThickness="2,0,0,0" Padding="5,0,0,0">
                                <TextBlock Text="TEXT" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource ipMuted}"/>
                            </Border>
                        </Border>

                        <Border Background="{StaticResource ipSurface2}" CornerRadius="4"
                                Padding="6,6" Margin="0,0,0,2">
                            <StackPanel Orientation="Vertical">
                                <!-- Font Size -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Size"
                                               Foreground="{StaticResource ipMuted}"
                                               FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                            CornerRadius="2" Padding="3,1" MinWidth="26">
                                        <TextBlock x:Name="TxtPanelFontSize" FontSize="9"
                                                   Foreground="{StaticResource ipAccent2}"
                                                   FontFamily="Consolas" HorizontalAlignment="Center"
                                                   Text="24"/>
                                    </Border>
                                    <Slider x:Name="SliderTextFontSize" Minimum="6" Maximum="200" Value="24"
                                            VerticalAlignment="Center" Margin="4,0"
                                            ValueChanged="SliderTextFontSize_ValueChanged"/>
                                </DockPanel>

                                <!-- Text Color -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Màu"
                                               Foreground="{StaticResource ipMuted}"
                                               FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <Grid Height="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" x:Name="BorderTextColorSwatch" Background="White" BorderBrush="{StaticResource ipBorder}" BorderThickness="1" CornerRadius="2" Height="14" Width="14" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="BtnTextColor" Content="#FFFFFF" FontSize="9" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="4,0,0,0" Height="18" Click="BtnTextColor_Click" Cursor="Hand"/>
                                    </Grid>
                                </DockPanel>

                                <!-- Font Family -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Font"
                                               Foreground="{StaticResource ipMuted}"
                                               FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbFontFamily" Height="20" FontSize="9" SelectionChanged="CmbFontFamily_SelectionChanged"
                                              Style="{StaticResource IpComboBoxStyle}" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Arial" IsSelected="True"/>
                                        <ComboBoxItem Content="Times New Roman"/>
                                        <ComboBoxItem Content="Courier New"/>
                                        <ComboBoxItem Content="Segoe UI"/>
                                        <ComboBoxItem Content="Verdana"/>
                                        <ComboBoxItem Content="Consolas"/>
                                    </ComboBox>
                                </DockPanel>

                                <!-- Font Style -->
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="Style"
                                               Foreground="{StaticResource ipMuted}"
                                               FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbFontStyle" Height="20" FontSize="9" SelectionChanged="CmbFontStyle_SelectionChanged"
                                              Style="{StaticResource IpComboBoxStyle}" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Bold" IsSelected="True"/>
                                        <ComboBoxItem Content="Regular"/>
                                        <ComboBoxItem Content="Italic"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════ COLOR ══════ -->
                    <Border Padding="6,4" CornerRadius="3" Margin="0,6,0,3"
                            Background="{StaticResource ipSurface}" Visibility="Collapsed">
                        <Border BorderBrush="#ff6b6b" BorderThickness="2,0,0,0" Padding="5,0,0,0">
                            <TextBlock Text="COLOR" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource ipMuted}"/>
                        </Border>
                    </Border>

                    <Border Background="{StaticResource ipSurface2}" CornerRadius="4"
                            Padding="6,5" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <!-- FG/BG stacked -->
                                <Grid DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,8,0">
                                    <Border x:Name="BgColorBorder" Width="24" Height="24"
                                            Background="White" CornerRadius="3"
                                            BorderBrush="{StaticResource ipBorder}" BorderThickness="1.5"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Cursor="Hand" ToolTip="Background color"
                                            MouseLeftButtonDown="BgColorBorder_MouseLeftButtonDown"/>
                                    <Border x:Name="FgColorBorder" Width="24" Height="24"
                                            Background="Black" CornerRadius="3"
                                            BorderBrush="{StaticResource ipText}" BorderThickness="2"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Cursor="Hand" ToolTip="Foreground color"
                                            MouseLeftButtonDown="FgColorBorder_MouseLeftButtonDown"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <Button Content="⇄ Swap" ToolTip="Hoán đổi (X)"
                                            Style="{StaticResource IpMiniBtn}"
                                            Width="Auto" Padding="4,0" FontSize="9"
                                            HorizontalContentAlignment="Left"
                                            Click="BtnSwapColors_Click"/>
                                    <Button Content="◻ Reset" ToolTip="Đen/Trắng (D)"
                                            Style="{StaticResource IpMiniBtn}"
                                            Width="Auto" Padding="4,0" FontSize="9"
                                            HorizontalContentAlignment="Left"
                                            Click="BtnResetColors_Click"/>
                                    <Border Background="{StaticResource ipSurface}" CornerRadius="2"
                                            Padding="4,1" Margin="0,2,0,0">
                                        <TextBlock x:Name="TxtColorHex" Text="#000000"
                                                   Foreground="{StaticResource ipAccent}" FontSize="9"
                                                   FontFamily="Consolas"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                        </StackPanel>
                    </Border>

                    <!-- ══════ COLOR ADJUST PANEL ══════ -->
                    <StackPanel x:Name="ColorAdjustPanel" Visibility="Visible">
                        <Border Padding="6,4" CornerRadius="3" Margin="2,6,0,3"
                                Background="{StaticResource ipSurface}" Cursor="Hand"
                                MouseLeftButtonDown="ColorAdjustHeader_Click">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" BorderBrush="#ffb347"
                                        BorderThickness="2,0,0,0" Padding="2,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="☀" FontSize="10" Margin="0,0,4,0"
                                                   Foreground="#ffb347" VerticalAlignment="Center"/>
                                        <TextBlock Text="COLOR ADJUST" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource ipMuted}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <!-- Reset button -->
                                    <Button Content="↺" ToolTip="Reset tất cả về 0"
                                            Style="{StaticResource IpMiniBtn}"
                                            Width="20" Height="18" FontSize="12"
                                            Click="BtnResetColorAdjust_Click"/>
                                    <!-- Collapse toggle -->
                                    <TextBlock x:Name="ColorAdjustCollapseIcon" Text="▶"
                                               FontSize="8" Foreground="{StaticResource ipMuted}"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border x:Name="ColorAdjustBody" Background="{StaticResource ipSurface2}"
                                CornerRadius="4" Padding="6,5" Margin="0,0,0,2"
                                Visibility="Collapsed">
                            <StackPanel>
                                <!-- ═══ Tab Headers ═══ -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Border x:Name="TabHeaderSliders" Padding="6,3" CornerRadius="3,3,0,0"
                                            Background="{StaticResource ipHover}" Cursor="Hand"
                                            MouseLeftButtonDown="ColorAdjustTab_Click" Tag="Sliders">
                                        <TextBlock Text="◉ Sliders" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="{StaticResource ipAccent2}"/>
                                    </Border>
                                    <Border x:Name="TabHeaderCurves" Padding="6,3" CornerRadius="3,3,0,0"
                                            Background="{StaticResource ipSurface}" Cursor="Hand" Margin="2,0,0,0"
                                            MouseLeftButtonDown="ColorAdjustTab_Click" Tag="Curves">
                                        <TextBlock Text="◎ Curves" FontSize="8.5"
                                                   Foreground="{StaticResource ipMuted}"/>
                                    </Border>
                                </StackPanel>

                                <!-- ═══ Tab 1: SLIDERS ═══ -->
                                <StackPanel x:Name="ColorAdjustTabSliders" Visibility="Visible">
                                    <!-- Brightness -->
                                    <DockPanel Margin="0,0,0,3" ToolTip="Brightness — Tăng/giảm độ sáng ảnh (-100 → +100)">
                                        <TextBlock DockPanel.Dock="Left" Text="Bright"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="8.5" Width="36" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="2,1" MinWidth="30">
                                            <TextBlock x:Name="TxtBrightness" FontSize="8.5"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="0"/>
                                        </Border>
                                        <Slider x:Name="SliderBrightness" Minimum="-100" Maximum="100" Value="0"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="ColorAdjustSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="ColorAdjustSlider_PreviewMouseDown"
                                                PreviewMouseLeftButtonUp="ColorAdjustSlider_PreviewMouseUp"/>
                                    </DockPanel>

                                    <!-- Contrast -->
                                    <DockPanel Margin="0,0,0,3" ToolTip="Contrast — Tăng/giảm độ tương phản (-100 → +100)">
                                        <TextBlock DockPanel.Dock="Left" Text="Contra"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="8.5" Width="36" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="2,1" MinWidth="30">
                                            <TextBlock x:Name="TxtContrast" FontSize="8.5"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="0"/>
                                        </Border>
                                        <Slider x:Name="SliderContrast" Minimum="-100" Maximum="100" Value="0"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="ColorAdjustSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="ColorAdjustSlider_PreviewMouseDown"
                                                PreviewMouseLeftButtonUp="ColorAdjustSlider_PreviewMouseUp"/>
                                    </DockPanel>

                                    <!-- Saturation -->
                                    <DockPanel Margin="0,0,0,3" ToolTip="Saturation — Tăng/giảm độ bão hoà màu (-100 → +100)">
                                        <TextBlock DockPanel.Dock="Left" Text="Satur"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="8.5" Width="36" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="2,1" MinWidth="30">
                                            <TextBlock x:Name="TxtSaturation" FontSize="8.5"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="0"/>
                                        </Border>
                                        <Slider x:Name="SliderSaturation" Minimum="-100" Maximum="100" Value="0"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="ColorAdjustSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="ColorAdjustSlider_PreviewMouseDown"
                                                PreviewMouseLeftButtonUp="ColorAdjustSlider_PreviewMouseUp"/>
                                    </DockPanel>

                                    <!-- Hue -->
                                    <DockPanel Margin="0,0,0,3" ToolTip="Hue — Xoay vòng màu (-180° → +180°)">
                                        <TextBlock DockPanel.Dock="Left" Text="Hue"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="8.5" Width="36" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="2,1" MinWidth="30">
                                            <TextBlock x:Name="TxtHue" FontSize="8.5"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="0°"/>
                                        </Border>
                                        <Slider x:Name="SliderHue" Minimum="-180" Maximum="180" Value="0"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="ColorAdjustSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="ColorAdjustSlider_PreviewMouseDown"
                                                PreviewMouseLeftButtonUp="ColorAdjustSlider_PreviewMouseUp"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- ═══ Tab 2: CURVES ═══ -->
                                <StackPanel x:Name="ColorAdjustTabCurves" Visibility="Collapsed">
                                    <!-- Channel selector -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Channel:" FontSize="8.5"
                                                   Foreground="{StaticResource ipMuted}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="CmbCurveChannel" Width="70" Height="20" FontSize="8.5"
                                                  SelectedIndex="0"
                                                  SelectionChanged="CmbCurveChannel_SelectionChanged">
                                            <ComboBoxItem Content="RGB"/>
                                            <ComboBoxItem Content="Red"/>
                                            <ComboBoxItem Content="Green"/>
                                            <ComboBoxItem Content="Blue"/>
                                        </ComboBox>
                                        <Button Content="↺" ToolTip="Reset curve"
                                                Style="{StaticResource IpMiniBtn}"
                                                Width="20" Height="18" FontSize="12" Margin="4,0,0,0"
                                                Click="BtnResetCurve_Click"/>
                                    </StackPanel>

                                    <!-- Curves Canvas with histogram -->
                                    <Border Background="#1a1a2e" CornerRadius="3" Padding="1"
                                            BorderBrush="{StaticResource ipBorder}" BorderThickness="1">
                                        <Canvas x:Name="CurvesCanvas" Width="180" Height="180"
                                                Background="Transparent"
                                                ClipToBounds="True"
                                                MouseLeftButtonDown="CurvesCanvas_MouseLeftButtonDown"
                                                MouseMove="CurvesCanvas_MouseMove"
                                                MouseLeftButtonUp="CurvesCanvas_MouseLeftButtonUp"
                                                MouseRightButtonUp="CurvesCanvas_MouseRightButtonUp">
                                            <!-- Histogram bars (drawn in code-behind) -->
                                            <!-- Grid lines -->
                                            <Line X1="45" Y1="0" X2="45" Y2="180" Stroke="#22ffffff" StrokeThickness="0.5"/>
                                            <Line X1="90" Y1="0" X2="90" Y2="180" Stroke="#22ffffff" StrokeThickness="0.5"/>
                                            <Line X1="135" Y1="0" X2="135" Y2="180" Stroke="#22ffffff" StrokeThickness="0.5"/>
                                            <Line X1="0" Y1="45" X2="180" Y2="45" Stroke="#22ffffff" StrokeThickness="0.5"/>
                                            <Line X1="0" Y1="90" X2="180" Y2="90" Stroke="#22ffffff" StrokeThickness="0.5"/>
                                            <Line X1="0" Y1="135" X2="180" Y2="135" Stroke="#22ffffff" StrokeThickness="0.5"/>
                                            <!-- Identity line (diagonal) -->
                                            <Line X1="0" Y1="180" X2="180" Y2="0" Stroke="#33ffffff" StrokeThickness="0.5"
                                                  StrokeDashArray="3,3"/>
                                            <!-- Curve polyline (drawn in code-behind) -->
                                            <Polyline x:Name="CurvePolyline" Stroke="#4fc3f7" StrokeThickness="1.5"
                                                      IsHitTestVisible="False"/>
                                        </Canvas>
                                    </Border>

                                    <!-- Input/Output display -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="In:" FontSize="8" Foreground="{StaticResource ipMuted}" Margin="0,0,2,0"/>
                                        <TextBlock x:Name="TxtCurveInput" Text="—" FontSize="8"
                                                   Foreground="{StaticResource ipAccent2}" FontFamily="Consolas"
                                                   Width="24"/>
                                        <TextBlock Text="Out:" FontSize="8" Foreground="{StaticResource ipMuted}" Margin="6,0,2,0"/>
                                        <TextBlock x:Name="TxtCurveOutput" Text="—" FontSize="8"
                                                   Foreground="{StaticResource ipAccent2}" FontFamily="Consolas"
                                                   Width="24"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Apply button (shared) -->
                                <Button x:Name="BtnApplyColorAdjust" Content="✓ Apply" 
                                        ToolTip="Áp dụng thay đổi màu vào pixel layer (có thể Undo)"
                                        Style="{StaticResource IpAdjBtn}"
                                        HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                        Click="BtnApplyColorAdjust_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ LAYERS (Row 1 = fill remaining space) ═══ -->
            <Grid Grid.Row="1" Margin="5,0,5,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- LAYERS title header -->
                <Border Grid.Row="0" Padding="6,4" CornerRadius="3,3,0,0"
                        Background="{StaticResource ipSurface}" BorderBrush="{StaticResource ipBorder}" BorderThickness="1,1,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" BorderBrush="{StaticResource ipAccent}"
                                BorderThickness="2,0,0,0" Padding="5,0,0,0">
                            <TextBlock Text="LAYERS" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource ipMuted}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- Add image to layer button (Right aligned) -->
                        <Button x:Name="BtnAddImageLayer" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                Width="20" Height="20" Cursor="Hand" Style="{StaticResource IpMiniBtn}"
                                ToolTip="Thêm ảnh mới vào Layer (Import Image)"
                                Click="BtnAddImageLayer_Click" Margin="0,0,2,0">
                            <controls:SvgViewboxEx Width="18" Height="18"
                                Fill="{StaticResource ipText}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='image-circle-plus light'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Blend Mode & Opacity bar (Photoshop style) -->
                <Border Grid.Row="1" Padding="6,5" Background="{StaticResource ipSurface2}"
                        BorderBrush="{StaticResource ipBorder}" BorderThickness="1,0,1,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <!-- Blend Mode -->
                        <ComboBox x:Name="CmbBlendMode" Grid.Column="0" Height="20" FontSize="8.5"
                                  VerticalContentAlignment="Center" Style="{StaticResource IpComboBoxStyle}"
                                  SelectionChanged="CmbBlendMode_SelectionChanged" Margin="0,0,8,0">
                            <ComboBoxItem Content="Normal" IsSelected="True"/>
                            <ComboBoxItem Content="Multiply"/>
                            <ComboBoxItem Content="Screen"/>
                            <ComboBoxItem Content="Overlay"/>
                            <ComboBoxItem Content="Darken"/>
                            <ComboBoxItem Content="Lighten"/>
                        </ComboBox>

                        <!-- Opacity Slider -->
                        <TextBlock Grid.Column="1" Text="Op:" FontSize="8.5" Foreground="{StaticResource ipMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderLayerOpacity" Grid.Column="0" Minimum="0" Maximum="100" Value="100"
                                    VerticalAlignment="Center" Focusable="False" Height="18"
                                    ValueChanged="SliderLayerOpacity_ValueChanged"/>
                            <TextBlock x:Name="TxtOpacityValue" Grid.Column="1" Foreground="{StaticResource ipAccent}"
                                       FontSize="8.5" FontFamily="Consolas" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Text="100%"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Layer list — fills all remaining height -->
                <Border Grid.Row="2" Background="{StaticResource ipSurface}"
                        BorderBrush="{StaticResource ipBorder}" BorderThickness="1,0,1,0"
                        Padding="2">
                    <ListBox x:Name="LayersList"
                             Style="{StaticResource IpListBoxStyle}"
                             ItemTemplate="{StaticResource LayerItemTemplate}"
                             SelectionChanged="LayersList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Border>
            </Grid>

            <!-- ═══ BOTTOM: UNIFIED ACTION BAR ═══ -->
            <Border Grid.Row="2" Padding="5,2" CornerRadius="0,0,3,3"
                    BorderBrush="{StaticResource ipBorderLight}" BorderThickness="0,1,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#141820" Offset="0"/>
                        <GradientStop Color="#0e1218" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <!-- Right: History status -->
                    <TextBlock x:Name="TxtHistoryStatus" DockPanel.Dock="Right"
                               Foreground="{StaticResource ipMuted}" FontSize="8"
                               VerticalAlignment="Center" FontFamily="Consolas"
                               Text="0 steps" Margin="0,0,4,0"/>
                    <!-- Left: Move Up/Down + Undo/Redo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▲" ToolTip="Lên (Move Up)" Style="{StaticResource IpMiniBtn}"
                                Width="18" Height="18" FontSize="7.5" Click="BtnMoveUp_Click" Margin="0,0,2,0"/>
                        <Button Content="▼" ToolTip="Xuống (Move Down)" Style="{StaticResource IpMiniBtn}"
                                Width="18" Height="18" FontSize="7.5" Click="BtnMoveDown_Click" Margin="0,0,6,0"/>
                        <Border Width="1" Height="14" Background="{StaticResource ipBorder}" Margin="0,0,4,0"/>
                        <Button x:Name="BtnUndo" ToolTip="Undo (Ctrl+Z)"
                                Style="{StaticResource IpMiniBtn}" Width="22" Height="20"
                                IsEnabled="False" Click="BtnUndo_Click">
                            <TextBlock Text="↶" FontSize="12" Foreground="{StaticResource ipAccent}"/>
                        </Button>
                        <Button x:Name="BtnRedo" ToolTip="Redo (Ctrl+Y)"
                                Style="{StaticResource IpMiniBtn}" Width="22" Height="20"
                                IsEnabled="False" Click="BtnRedo_Click">
                            <TextBlock Text="↷" FontSize="12" Foreground="{StaticResource ipAccent}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Layer popup menu (like Selection active toolbox popup style) -->
            <Popup x:Name="LayerActionPopup" StaysOpen="False" AllowsTransparency="True"
                   Placement="MousePoint" PopupAnimation="Fade">
                <Border Background="#12141c" BorderBrush="#2a2e3d" BorderThickness="1.2"
                        CornerRadius="6" Padding="6,4" SnapsToDevicePixels="True" MinWidth="230">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- AI button (shown when 1 layer is selected) -->
                        <Border x:Name="PopupBtnAI" Background="Transparent" CornerRadius="4" 
                                Padding="8,6" Cursor="Hand" Margin="0,1"
                                BorderBrush="Transparent" BorderThickness="0.5"
                                MouseLeftButtonDown="PopupBtnAI_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#202533"/>
                                            <Setter Property="BorderBrush" Value="#404fffb0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <controls:SvgViewboxEx Width="14" Height="14" Fill="#dde3ef" Margin="0,0,10,0" DockPanel.Dock="Left"
                                                      Source="{Binding Source={x:Static sys:String.Empty},
                                                               Converter={StaticResource IconKeyToPathConverter},
                                                               ConverterParameter='robot sharp-regular'}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="AI Chỉnh Sửa" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="Sử dụng AI để sinh hoặc sửa đổi ảnh layer" Foreground="#788296" FontSize="8" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Duplicate button (shown for child/variant layers) -->
                        <Border x:Name="PopupBtnDuplicate" Background="Transparent" CornerRadius="4" 
                                Padding="8,6" Cursor="Hand" Margin="0,1" Visibility="Collapsed"
                                BorderBrush="Transparent" BorderThickness="0.5"
                                MouseLeftButtonDown="PopupBtnDuplicate_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#202533"/>
                                            <Setter Property="BorderBrush" Value="#404fffb0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <controls:SvgViewboxEx Width="14" Height="14" Fill="#dde3ef" Margin="0,0,10,0" DockPanel.Dock="Left"
                                                      Source="{Binding Source={x:Static sys:String.Empty},
                                                               Converter={StaticResource IconKeyToPathConverter},
                                                               ConverterParameter='copy sharp-duotone-light'}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="Nhân bản" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="Nhân bản layer này thành layer mới" Foreground="#788296" FontSize="8" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Delete child layer button -->
                        <Border x:Name="PopupBtnDeleteChild" Background="Transparent" CornerRadius="4" 
                                Padding="8,6" Cursor="Hand" Margin="0,1" Visibility="Collapsed"
                                BorderBrush="Transparent" BorderThickness="0.5"
                                MouseLeftButtonDown="PopupBtnDeleteChild_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2a1a1a"/>
                                            <Setter Property="BorderBrush" Value="#40ff4444"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <controls:SvgViewboxEx Width="14" Height="14" Fill="#ff6b6b" Margin="0,0,10,0" DockPanel.Dock="Left"
                                                      Source="{Binding Source={x:Static sys:String.Empty},
                                                               Converter={StaticResource IconKeyToPathConverter},
                                                               ConverterParameter='trash-can regular'}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="Xoá" Foreground="#ff6b6b" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="Xoá layer này" Foreground="#788296" FontSize="8" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Merge button (shown when multiple layers are selected) -->
                        <Border x:Name="PopupBtnMerge" Background="Transparent" CornerRadius="4" 
                                Padding="8,6" Cursor="Hand" Margin="0,1"
                                BorderBrush="Transparent" BorderThickness="0.5"
                                MouseLeftButtonDown="PopupBtnMerge_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#202533"/>
                                            <Setter Property="BorderBrush" Value="#404fffb0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True">
                                <controls:SvgViewboxEx Width="14" Height="14" Fill="#dde3ef" Margin="0,0,10,0" DockPanel.Dock="Left"
                                                      Source="{Binding Source={x:Static sys:String.Empty},
                                                               Converter={StaticResource IconKeyToPathConverter},
                                                               ConverterParameter='code-merge sharp-light'}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="Gộp các Layer" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="Gộp các layer đang chọn thành một (Ctrl+E)" Foreground="#788296" FontSize="8" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
