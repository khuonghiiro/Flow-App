<UserControl x:Class="FlowMy.Views.NodeControls.ImageEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FlowMy.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:FlowMy.Converters"
             mc:Ignorable="d"
             d:DesignWidth="220" d:DesignHeight="600"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
        <!-- ═══ IP PALETTE ═══ -->
        <SolidColorBrush x:Key="ipBg" Color="#0a0c10"/>
        <SolidColorBrush x:Key="ipSurface" Color="#111318"/>
        <SolidColorBrush x:Key="ipSurface2" Color="#181c24"/>
        <SolidColorBrush x:Key="ipBorder" Color="#252932"/>
        <SolidColorBrush x:Key="ipBorderLight" Color="#2a2e3a"/>
        <SolidColorBrush x:Key="ipText" Color="#dde3ef"/>
        <SolidColorBrush x:Key="ipMuted" Color="#5a6072"/>
        <SolidColorBrush x:Key="ipAccent" Color="#4fffb0"/>
        <SolidColorBrush x:Key="ipAccent2" Color="#00cfff"/>
        <SolidColorBrush x:Key="ipHover" Color="#1e222c"/>
        <SolidColorBrush x:Key="ipActiveItem" Color="#1a4fffb0"/>

        <!-- ═══ LAYER ITEM (Photoshop-style) ═══ -->
        <DataTemplate x:Key="LayerItemTemplate">
            <Border x:Name="LayerItemBd" Padding="4,4" Margin="0,1" CornerRadius="4"
                    Background="Transparent" Cursor="Hand" BorderThickness="1.5"
                    BorderBrush="Transparent"
                    MouseLeftButtonDown="LayerItem_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ipHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <!-- Eye toggle (left) -->
                    <Border DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,4,0"
                            VerticalAlignment="Center" Cursor="Hand" CornerRadius="3"
                            Background="Transparent"
                            MouseLeftButtonDown="LayerVisibilityToggle_Click">
                        <controls:SvgViewboxEx x:Name="EyeIcon" Width="14" Height="14"
                            Fill="{StaticResource ipText}"
                            Source="{Binding Source={x:Static sys:String.Empty},
                                     Converter={StaticResource IconKeyToPathConverter},
                                     ConverterParameter='eye light'}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"/>
                    </Border>
                    <!-- Lock toggle (right) -->
                    <Border DockPanel.Dock="Right" Width="18" Height="18" Margin="4,0,0,0"
                            VerticalAlignment="Center" Cursor="Hand" CornerRadius="3"
                            Background="Transparent"
                            MouseLeftButtonDown="LayerLockToggle_Click">
                        <Grid>
                            <!-- Unlocked icon (default) -->
                            <controls:SvgViewboxEx x:Name="LockOpenIcon" Width="13" Height="13"
                                Fill="{StaticResource ipText}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='lock-open jelly-fill-regular'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Opacity="0.4" IsHitTestVisible="False"/>
                            <!-- Locked icon (hidden by default) -->
                            <controls:SvgViewboxEx x:Name="LockClosedIcon" Width="13" Height="13"
                                Fill="{StaticResource ipAccent}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='lock jelly-fill-regular'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <!-- Thumbnail + Name (center, horizontal) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" Margin="0,0,6,0"
                                BorderBrush="{StaticResource ipBorder}" BorderThickness="1"
                                CornerRadius="3" ClipToBounds="True"
                                Background="{StaticResource ipSurface}">
                            <Image Stretch="Uniform" Source="{Binding Thumbnail}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource ipText}"
                                   FontSize="10" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- Active layer highlight -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="LayerItemBd" Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#4fffb0" Opacity="0.12"/>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="LayerItemBd" Property="BorderBrush">
                        <Setter.Value>
                            <SolidColorBrush Color="#4fffb0" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <!-- Hidden layer -->
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter TargetName="LayerItemBd" Property="Opacity" Value="0.35"/>
                    <Setter TargetName="EyeIcon" Property="Opacity" Value="0.15"/>
                </DataTrigger>
                <!-- Locked layer -->
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="LockOpenIcon" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="LockClosedIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ MINI ICON BUTTON (code-behind builds template to avoid theme clash) ═══ -->
        <Style x:Key="IpMiniBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ipMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource ipText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource ipBg}" BorderBrush="{StaticResource ipBorderLight}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ SCROLLABLE CONTENT ═══ -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="5,4,5,6">

                    <!-- ══════ TOOLS ══════ -->
                    <Border Padding="6,4" CornerRadius="3" Margin="0,6,0,3"
                            Background="{StaticResource ipSurface}">
                        <Border BorderBrush="{StaticResource ipAccent2}"
                                BorderThickness="2,0,0,0" Padding="5,0,0,0">
                            <TextBlock Text="TOOLS" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource ipMuted}"/>
                        </Border>
                    </Border>

                    <WrapPanel x:Name="ToolsPanel" Orientation="Horizontal" Margin="0,0,0,4">
                        <Border x:Name="ToolBrush" Tag="Brush" ToolTip="Brush (B)"
                                Width="30" Height="30" CornerRadius="4" Cursor="Hand"
                                Margin="1" BorderThickness="1.5"
                                MouseLeftButtonDown="ToolBtn_Click">
                            <controls:SvgViewboxEx Width="16" Height="16"
                                Fill="{StaticResource ipText}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='paintbrush-fine duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="ToolEraser" Tag="Eraser" ToolTip="Eraser (E)"
                                Width="30" Height="30" CornerRadius="4" Cursor="Hand"
                                Margin="1" Background="Transparent" BorderThickness="1.5"
                                BorderBrush="Transparent"
                                MouseLeftButtonDown="ToolBtn_Click">
                            <controls:SvgViewboxEx Width="16" Height="16"
                                Fill="{StaticResource ipText}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='eraser duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="ToolFill" Tag="Fill" ToolTip="Fill (G)"
                                Width="30" Height="30" CornerRadius="4" Cursor="Hand"
                                Margin="1" Background="Transparent" BorderThickness="1.5"
                                BorderBrush="Transparent"
                                MouseLeftButtonDown="ToolBtn_Click">
                            <controls:SvgViewboxEx Width="16" Height="16"
                                Fill="{StaticResource ipText}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='fill-drip duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="ToolEyedropper" Tag="Eyedropper" ToolTip="Eyedropper (I)"
                                Width="30" Height="30" CornerRadius="4" Cursor="Hand"
                                Margin="1" Background="Transparent" BorderThickness="1.5"
                                BorderBrush="Transparent"
                                MouseLeftButtonDown="ToolBtn_Click">
                            <controls:SvgViewboxEx Width="16" Height="16"
                                Fill="{StaticResource ipText}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='eye-dropper duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="ToolMove" Tag="Move" ToolTip="Move (V)"
                                Width="30" Height="30" CornerRadius="4" Cursor="Hand"
                                Margin="1" Background="Transparent" BorderThickness="1.5"
                                BorderBrush="Transparent"
                                MouseLeftButtonDown="ToolBtn_Click">
                            <controls:SvgViewboxEx Width="16" Height="16"
                                Fill="{StaticResource ipText}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='arrows-up-down-left-right duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="ToolText" Tag="Text" ToolTip="Text (T)"
                                Width="30" Height="30" CornerRadius="4" Cursor="Hand"
                                Margin="1" Background="Transparent" BorderThickness="1.5"
                                BorderBrush="Transparent"
                                MouseLeftButtonDown="ToolBtn_Click">
                            <controls:SvgViewboxEx Width="16" Height="16"
                                Fill="{StaticResource ipText}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='font duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Border>
                        <Border x:Name="ToolSelection" Tag="Selection" ToolTip="Selection (M)"
                                Width="30" Height="30" CornerRadius="4" Cursor="Hand"
                                Margin="1" Background="Transparent" BorderThickness="1.5"
                                BorderBrush="Transparent"
                                MouseLeftButtonDown="ToolBtn_Click">
                            <controls:SvgViewboxEx Width="16" Height="16"
                                Fill="{StaticResource ipText}"
                                Source="{Binding Source={x:Static sys:String.Empty},
                                         Converter={StaticResource IconKeyToPathConverter},
                                         ConverterParameter='object-group duotone'}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Border>
                    </WrapPanel>

                    <!-- Brush properties -->
                    <Border Background="{StaticResource ipSurface2}" CornerRadius="4"
                            Padding="6,4" Margin="0,0,0,2">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Left" Text="Size"
                                           Foreground="{StaticResource ipMuted}"
                                           FontSize="9" Width="32" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                        CornerRadius="2" Padding="3,1" MinWidth="26">
                                    <TextBlock x:Name="TxtBrushSize" FontSize="9"
                                               Foreground="{StaticResource ipAccent2}"
                                               FontFamily="Consolas" HorizontalAlignment="Center"
                                               Text="10"/>
                                </Border>
                                <Slider x:Name="SliderBrushSize" Minimum="1" Maximum="200" Value="10"
                                        VerticalAlignment="Center" Margin="4,0"
                                        ValueChanged="SliderBrushSize_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Left" Text="Hard"
                                           Foreground="{StaticResource ipMuted}"
                                           FontSize="9" Width="32" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                        CornerRadius="2" Padding="3,1" MinWidth="26">
                                    <TextBlock x:Name="TxtBrushHardness" FontSize="9"
                                               Foreground="{StaticResource ipAccent2}"
                                               FontFamily="Consolas" HorizontalAlignment="Center"
                                               Text="100%"/>
                                </Border>
                                <Slider x:Name="SliderBrushHardness" Minimum="0" Maximum="100" Value="100"
                                        VerticalAlignment="Center" Margin="4,0"
                                        ValueChanged="SliderBrushHardness_ValueChanged"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Flow"
                                           Foreground="{StaticResource ipMuted}"
                                           FontSize="9" Width="32" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                        CornerRadius="2" Padding="3,1" MinWidth="26">
                                    <TextBlock x:Name="TxtBrushFlow" FontSize="9"
                                               Foreground="{StaticResource ipAccent2}"
                                               FontFamily="Consolas" HorizontalAlignment="Center"
                                               Text="100%"/>
                                </Border>
                                <Slider x:Name="SliderBrushFlow" Minimum="1" Maximum="100" Value="100"
                                        VerticalAlignment="Center" Margin="4,0"
                                        ValueChanged="SliderBrushFlow_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Opacity + Blend (compact) + LAYERS -->
                    <Border Background="{StaticResource ipSurface2}" CornerRadius="4"
         Padding="6,4" Margin="0,5,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Left" Text="Opacity"
                        Foreground="{StaticResource ipMuted}"
                        FontSize="9" Width="38" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                     CornerRadius="2" Padding="3,1" MinWidth="30">
                                    <TextBlock x:Name="TxtOpacityValue" Foreground="{StaticResource ipAccent}"
                            FontSize="9" FontFamily="Consolas"
                            HorizontalAlignment="Center" Text="100%"/>
                                </Border>
                                <Slider x:Name="SliderLayerOpacity" Minimum="0" Maximum="100" Value="100"
                     VerticalAlignment="Center" Margin="4,0"
                     ValueChanged="SliderLayerOpacity_ValueChanged"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Blend"
                        Foreground="{StaticResource ipMuted}"
                        FontSize="9" Width="38" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbBlendMode" Height="22" FontSize="9"
                       VerticalContentAlignment="Center"
                       SelectionChanged="CmbBlendMode_SelectionChanged">
                                    <ComboBoxItem Content="Normal" IsSelected="True"/>
                                    <ComboBoxItem Content="Multiply"/>
                                    <ComboBoxItem Content="Screen"/>
                                    <ComboBoxItem Content="Overlay"/>
                                    <ComboBoxItem Content="Darken"/>
                                    <ComboBoxItem Content="Lighten"/>
                                </ComboBox>
                            </DockPanel>

                        </StackPanel>
                    </Border>

                    <!-- ══════ COLOR ══════ -->
                    <Border Padding="6,4" CornerRadius="3" Margin="0,6,0,3"
                            Background="{StaticResource ipSurface}">
                        <Border BorderBrush="#ff6b6b" BorderThickness="2,0,0,0" Padding="5,0,0,0">
                            <TextBlock Text="COLOR" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource ipMuted}"/>
                        </Border>
                    </Border>

                    <Border Background="{StaticResource ipSurface2}" CornerRadius="4"
                            Padding="6,5">
                        <StackPanel>
                            <DockPanel>
                                <!-- FG/BG stacked -->
                                <Grid DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,8,0">
                                    <Border x:Name="BgColorBorder" Width="24" Height="24"
                                            Background="White" CornerRadius="3"
                                            BorderBrush="{StaticResource ipBorder}" BorderThickness="1.5"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Cursor="Hand" ToolTip="Background color"
                                            MouseLeftButtonDown="BgColorBorder_MouseLeftButtonDown"/>
                                    <Border x:Name="FgColorBorder" Width="24" Height="24"
                                            Background="Black" CornerRadius="3"
                                            BorderBrush="{StaticResource ipText}" BorderThickness="2"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Cursor="Hand" ToolTip="Foreground color"
                                            MouseLeftButtonDown="FgColorBorder_MouseLeftButtonDown"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <Button Content="⇄ Swap" ToolTip="Hoán đổi (X)"
                                            Style="{StaticResource IpMiniBtn}"
                                            Width="Auto" Padding="4,0" FontSize="9"
                                            HorizontalContentAlignment="Left"
                                            Click="BtnSwapColors_Click"/>
                                    <Button Content="◻ Reset" ToolTip="Đen/Trắng (D)"
                                            Style="{StaticResource IpMiniBtn}"
                                            Width="Auto" Padding="4,0" FontSize="9"
                                            HorizontalContentAlignment="Left"
                                            Click="BtnResetColors_Click"/>
                                    <Border Background="{StaticResource ipSurface}" CornerRadius="2"
                                            Padding="4,1" Margin="0,2,0,0">
                                        <TextBlock x:Name="TxtColorHex" Text="#000000"
                                                   Foreground="{StaticResource ipAccent}" FontSize="9"
                                                   FontFamily="Consolas"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- ══════ LAYERS ══════ -->
                            <Border Padding="6,4,6,2" CornerRadius="3" Margin="0,6,0,3"
                                    Background="{StaticResource ipSurface}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" BorderBrush="{StaticResource ipAccent}"
                                            BorderThickness="2,0,0,0" Padding="5,0,0,0">
                                        <TextBlock Text="LAYERS" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource ipMuted}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Content="＋" ToolTip="Thêm layer" Style="{StaticResource IpMiniBtn}"
                                                FontSize="13" Click="BtnAddLayer_Click"/>
                                        <Button Content="−" ToolTip="Xoá layer" Style="{StaticResource IpMiniBtn}"
                                                FontSize="14" Click="BtnRemoveLayer_Click"/>
                                        <Rectangle Width="1" Fill="{StaticResource ipBorder}"
                                                   Margin="2,3" VerticalAlignment="Stretch"/>
                                        <Button Content="▲" ToolTip="Lên" Style="{StaticResource IpMiniBtn}"
                                                FontSize="8" Click="BtnMoveUp_Click"/>
                                        <Button Content="▼" ToolTip="Xuống" Style="{StaticResource IpMiniBtn}"
                                                FontSize="8" Click="BtnMoveDown_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Layer list -->
                            <Border Background="{StaticResource ipSurface}" CornerRadius="4"
                                    BorderBrush="{StaticResource ipBorder}" BorderThickness="1"
                                    Padding="2" MinHeight="40" MaxHeight="360">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="LayersList"
                                                  ItemTemplate="{StaticResource LayerItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ BOTTOM: UNDO/REDO ═══ -->
            <Border Grid.Row="1" Padding="5,3"
                    BorderBrush="{StaticResource ipBorderLight}" BorderThickness="0,1,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#141820" Offset="0"/>
                        <GradientStop Color="#0e1218" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <TextBlock x:Name="TxtHistoryStatus" DockPanel.Dock="Right"
                               Foreground="{StaticResource ipMuted}" FontSize="8"
                               VerticalAlignment="Center" FontFamily="Consolas"
                               Text="0 steps"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnUndo" ToolTip="Undo (Ctrl+Z)"
                                Style="{StaticResource IpMiniBtn}" Width="24" Height="22"
                                IsEnabled="False" Click="BtnUndo_Click">
                            <TextBlock Text="↶" FontSize="13" Foreground="{StaticResource ipAccent}"/>
                        </Button>
                        <Button x:Name="BtnRedo" ToolTip="Redo (Ctrl+Y)"
                                Style="{StaticResource IpMiniBtn}" Width="24" Height="22"
                                IsEnabled="False" Click="BtnRedo_Click">
                            <TextBlock Text="↷" FontSize="13" Foreground="{StaticResource ipAccent}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
