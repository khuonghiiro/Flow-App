<UserControl x:Class="FlowMy.Views.NodeControls.ImageEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FlowMy.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:FlowMy.Converters"
             mc:Ignorable="d"
             d:DesignWidth="220" d:DesignHeight="600"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:IconKeyToPathConverter x:Key="IconKeyToPathConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <!-- ═══ IP PALETTE ═══ -->
        <SolidColorBrush x:Key="ipBg" Color="#0a0c10"/>
        <SolidColorBrush x:Key="ipSurface" Color="#111318"/>
        <SolidColorBrush x:Key="ipSurface2" Color="#181c24"/>
        <SolidColorBrush x:Key="ipBorder" Color="#252932"/>
        <SolidColorBrush x:Key="ipBorderLight" Color="#2a2e3a"/>
        <SolidColorBrush x:Key="ipText" Color="#dde3ef"/>
        <SolidColorBrush x:Key="ipMuted" Color="#5a6072"/>
        <SolidColorBrush x:Key="ipAccent" Color="#4fffb0"/>
        <SolidColorBrush x:Key="ipAccent2" Color="#00cfff"/>
        <SolidColorBrush x:Key="ipHover" Color="#1e222c"/>
        <SolidColorBrush x:Key="ipActiveItem" Color="#1a4fffb0"/>

        <!-- Checkered brush for transparent thumbnails (Photoshop style) -->
        <VisualBrush x:Key="CheckeredBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <VisualBrush.Visual>
                <Grid Width="8" Height="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="4"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="4"/>
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#202020"/>
                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#2d2d2d"/>
                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#2d2d2d"/>
                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#202020"/>
                </Grid>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- ═══ COMBOBOX STYLE ═══ -->
        <Style x:Key="IpComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource ipSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource ipText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,0,20,0"
                                              VerticalAlignment="Center"/>
                            <TextBlock Text="▾"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ipMuted}"
                                       FontSize="10"/>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource ipSurface2}"
                                        BorderBrush="{StaticResource ipBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MaxHeight="200"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ipAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource ipText}"/>
                        <Setter Property="Background" Value="{StaticResource ipSurface2}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontSize" Value="9"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource ipHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{StaticResource ipActiveItem}"/>
                                            <Setter Property="Foreground" Value="{StaticResource ipAccent}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ LAYER ITEM (Photoshop-style) ═══ -->
        <DataTemplate x:Key="LayerItemTemplate">
            <Border x:Name="LayerItemBd" Padding="0" Margin="0,1" CornerRadius="4"
                    Background="Transparent" Cursor="Hand" BorderThickness="0"
                    MouseLeftButtonDown="LayerItem_MouseLeftButtonDown"
                    MouseMove="LayerItem_MouseMove"
                    MouseLeftButtonUp="LayerItem_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left active stripe -->
                    <Border x:Name="ActiveStripe" Grid.Column="0" Background="Transparent" CornerRadius="3,0,0,3"/>

                    <Border Grid.Column="1" Padding="6,4">
                        <DockPanel>
                            <!-- Eye toggle (left) -->
                            <Border x:Name="LayerVisibilityToggle" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,4,0"
                                    VerticalAlignment="Center" Cursor="Hand" CornerRadius="3"
                                    Background="Transparent"
                                    MouseLeftButtonDown="LayerVisibilityToggle_Click">
                                <controls:SvgViewboxEx x:Name="EyeIcon" Width="14" Height="14"
                                    Fill="{StaticResource ipText}"
                                    Source="{Binding Source={x:Static sys:String.Empty},
                                             Converter={StaticResource IconKeyToPathConverter},
                                             ConverterParameter='eye light'}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False"/>
                            </Border>
                            <!-- Layer action buttons (right) -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <!-- Copy layer button -->
                                <Border x:Name="BtnCopyLayerInline" Width="20" Height="20" Cursor="Hand" CornerRadius="3"
                                        Background="Transparent" ToolTip="Nhân đôi Layer (Duplicate)"
                                        MouseLeftButtonDown="BtnCopyLayer_Click">
                                    <controls:SvgViewboxEx Width="12" Height="12"
                                        Fill="{StaticResource ipText}"
                                        Source="{Binding Source={x:Static sys:String.Empty},
                                                 Converter={StaticResource IconKeyToPathConverter},
                                                 ConverterParameter='copy duotone-light'}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                </Border>
                                <!-- Delete layer button -->
                                <Border x:Name="BtnDeleteLayerInline" Width="20" Height="20" Cursor="Hand" CornerRadius="3"
                                        Background="Transparent" ToolTip="Xoá Layer"
                                        MouseLeftButtonDown="BtnDeleteLayer_Click">
                                    <controls:SvgViewboxEx Width="12" Height="12"
                                        Fill="{StaticResource ipText}"
                                        Source="{Binding Source={x:Static sys:String.Empty},
                                                 Converter={StaticResource IconKeyToPathConverter},
                                                 ConverterParameter='trash-can regular'}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                </Border>
                            </StackPanel>
                            <!-- Thumbnail + Name (center, horizontal) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Thumbnail with transparent background -->
                                <Border Margin="0,0,6,0"
                                        CornerRadius="3" ClipToBounds="True"
                                        Background="Transparent"
                                        VerticalAlignment="Center" Width="44" Height="32">
                                    <Grid>
                                        <Image Stretch="Uniform" Source="{Binding Thumbnail}"
                                               MaxHeight="30" MaxWidth="42"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- Text layer type badge overlay -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="#111318" CornerRadius="2" Width="11" Height="11"
                                                Visibility="{Binding IsTextLayer, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,0,1,1" BorderBrush="#00cfff" BorderThickness="0.8">
                                            <TextBlock Text="T" FontSize="7" FontWeight="Bold" Foreground="#00cfff"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1.5,0,0"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="80">
                                    <!-- TextBlock for standard display -->
                                    <TextBlock x:Name="TxtLayerName" Text="{Binding Name}" Foreground="{StaticResource ipText}"
                                               FontSize="10" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsEditingName, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                               MouseLeftButtonDown="TxtLayerName_MouseLeftButtonDown"/>
                                    <!-- TextBox for renaming -->
                                    <TextBox x:Name="TxtLayerNameEdit" Text="{Binding Name, Mode=OneWay}"
                                             Foreground="Black" Background="White" FontSize="10" VerticalAlignment="Center"
                                             Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibilityConverter}}"
                                             LostFocus="TxtLayerNameEdit_LostFocus"
                                             KeyDown="TxtLayerNameEdit_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Hover effect for layer item -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="LayerItemBd" Property="Background" Value="{StaticResource ipHover}"/>
                </Trigger>
                <!-- Active layer highlight (Photoshop style) -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="LayerItemBd" Property="Background" Value="#2a3240"/>
                    <Setter TargetName="ActiveStripe" Property="Background" Value="#00cfff"/>
                </DataTrigger>
                <!-- Hidden layer opacity -->
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter TargetName="LayerItemBd" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="EyeIcon" Property="Opacity" Value="0.0"/>
                </DataTrigger>
                <!-- Hover visibility toggle (ghost eye) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="False"/>
                        <Condition Binding="{Binding ElementName=LayerVisibilityToggle, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="EyeIcon" Property="Opacity" Value="0.25"/>
                    <Setter TargetName="LayerVisibilityToggle" Property="Background" Value="#15ffffff"/>
                </MultiDataTrigger>
                <!-- Hover visibility when active -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible}" Value="True"/>
                        <Condition Binding="{Binding ElementName=LayerVisibilityToggle, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="LayerVisibilityToggle" Property="Background" Value="#15ffffff"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══ MINI ICON BUTTON (code-behind builds template to avoid theme clash) ═══ -->
        <Style x:Key="IpMiniBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ipMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource ipText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipSurface2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ADJUSTMENT BUTTON STYLE ═══ -->
        <Style x:Key="IpAdjBtn" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Background" Value="{StaticResource ipSurface2}"/>
            <Setter Property="Foreground" Value="{StaticResource ipText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ipBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ipAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource ipAccent}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ipAccent2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ipBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ipAccent2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ SLEEK SLIDER STYLE (Photoshop-style) ═══ -->
        <Style TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TickBar x:Name="TopTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Top" Height="4" Grid.Row="0"/>
                            <TickBar x:Name="BottomTick" Visibility="Collapsed" Fill="{TemplateBinding Foreground}" Placement="Bottom" Height="4" Grid.Row="2"/>

                            <!-- Sleek Track (Thanh trượt mỏng) -->
                            <Border x:Name="TrackBackground" 
                                    Background="#252932" 
                                    Height="4" 
                                    CornerRadius="2"
                                    VerticalAlignment="Center" 
                                    Grid.Row="1"
                                    Margin="5,0"/>

                            <!-- Track Fill (Thanh đã kéo qua) -->
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#00cfff" Height="4" CornerRadius="2" Margin="5,0,0,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <!-- Sleek Thumb (Nút kéo nhỏ gọn) -->
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Focusable="False" Height="10" Width="10">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ellipse" 
                                                         Fill="#dde3ef" 
                                                         Stroke="#00cfff" 
                                                         StrokeThickness="1.5"
                                                         Width="10" Height="10"
                                                         VerticalAlignment="Center" 
                                                         HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ellipse" Property="Fill" Value="#ffffff"/>
                                                        <Setter TargetName="ellipse" Property="Stroke" Value="#4fffb0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ellipse" Property="Fill" Value="#4fffb0"/>
                                                        <Setter TargetName="ellipse" Property="Stroke" Value="#ffffff"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource ipBg}" BorderBrush="{StaticResource ipBorderLight}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="600">
                <StackPanel Margin="5,4,5,6">

                    <!-- ══════ BRUSH PROPERTIES PANEL ══════ -->
                    <StackPanel x:Name="BrushPropertiesPanel" Visibility="Visible">
                        <Border Padding="6,4" CornerRadius="3" Margin="0,2,0,3"
                                Background="{StaticResource ipSurface}">
                            <Border BorderBrush="{StaticResource ipAccent2}"
                                    BorderThickness="2,0,0,0" Padding="5,0,0,0">
                                <TextBlock Text="BRUSH" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource ipMuted}"/>
                            </Border>
                        </Border>

                        <Border Background="{StaticResource ipSurface2}" CornerRadius="4"
                                Padding="6,4" Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Sliders with Tooltips -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,2" ToolTip="Kích thước đầu cọ (Brush Size) - Độ rộng nét vẽ tính theo pixel">
                                        <TextBlock DockPanel.Dock="Left" Text="Size"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="9" Width="32" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="3,1" MinWidth="26">
                                            <TextBlock x:Name="TxtBrushSize" FontSize="9"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="10"/>
                                        </Border>
                                        <Slider x:Name="SliderBrushSize" Minimum="1" Maximum="200" Value="10"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="SliderBrushSize_ValueChanged"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,2" ToolTip="Độ cứng nét vẽ (Hardness) - 0% là viền nhòe mềm mại, 100% là viền sắc cạnh">
                                        <TextBlock DockPanel.Dock="Left" Text="Hard"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="9" Width="32" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="3,1" MinWidth="26">
                                            <TextBlock x:Name="TxtBrushHardness" FontSize="9"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="100%"/>
                                        </Border>
                                        <Slider x:Name="SliderBrushHardness" Minimum="0" Maximum="100" Value="100"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="SliderBrushHardness_ValueChanged"/>
                                    </DockPanel>
                                    <DockPanel ToolTip="Độ phủ màu (Flow) - Tốc độ ra màu/độ đặc sắc khi di chuyển chuột">
                                        <TextBlock DockPanel.Dock="Left" Text="Flow"
                                                   Foreground="{StaticResource ipMuted}"
                                                   FontSize="9" Width="32" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                                CornerRadius="2" Padding="3,1" MinWidth="26">
                                            <TextBlock x:Name="TxtBrushFlow" FontSize="9"
                                                       Foreground="{StaticResource ipAccent2}"
                                                       FontFamily="Consolas" HorizontalAlignment="Center"
                                                       Text="100%"/>
                                        </Border>
                                        <Slider x:Name="SliderBrushFlow" Minimum="1" Maximum="100" Value="100"
                                                VerticalAlignment="Center" Margin="4,0"
                                                ValueChanged="SliderBrushFlow_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Column 1: Photoshop-style brush tip preview with checkerboard pattern -->
                                <Border Grid.Column="1" Width="56" Height="56" Margin="6,0,0,0"
                                        Background="{StaticResource ipSurface}" BorderBrush="{StaticResource ipBorder}"
                                        BorderThickness="1" CornerRadius="4" VerticalAlignment="Center"
                                        ToolTip="Xem trước đầu cọ (Brush Preview)">
                                    <Grid ClipToBounds="True">
                                        <!-- Checkerboard pattern background -->
                                        <Grid.Background>
                                            <VisualBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                                <VisualBrush.Visual>
                                                    <Grid Width="8" Height="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="4"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="4"/>
                                                            <RowDefinition Height="4"/>
                                                        </Grid.RowDefinitions>
                                                        <Rectangle Grid.Row="0" Grid.Column="0" Fill="#1c202a"/>
                                                        <Rectangle Grid.Row="0" Grid.Column="1" Fill="#111318"/>
                                                        <Rectangle Grid.Row="1" Grid.Column="0" Fill="#111318"/>
                                                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#1c202a"/>
                                                    </Grid>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Grid.Background>

                                        <!-- Visual preview of the brush tip -->
                                        <Ellipse x:Name="BrushPreviewEllipse"
                                                 MaxWidth="48" MaxHeight="48"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 IsHitTestVisible="False"/>

                                        <!-- Crosshair lines (Photoshop center target) -->
                                        <Path Data="M0,8 L16,8 M8,0 L8,16" 
                                              Stroke="#30FFFFFF" 
                                              StrokeThickness="1" 
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ══════ TEXT PROPERTIES PANEL ══════ -->
                    <StackPanel x:Name="TextPropertiesPanel" Visibility="Collapsed">
                        <Border Padding="6,4" CornerRadius="3" Margin="0,2,0,3"
                                Background="{StaticResource ipSurface}">
                            <Border BorderBrush="{StaticResource ipAccent2}"
                                    BorderThickness="2,0,0,0" Padding="5,0,0,0">
                                <TextBlock Text="TEXT" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource ipMuted}"/>
                            </Border>
                        </Border>

                        <Border Background="{StaticResource ipSurface2}" CornerRadius="4"
                                Padding="6,6" Margin="0,0,0,2">
                            <StackPanel Orientation="Vertical">
                                <!-- Font Size -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Size"
                                               Foreground="{StaticResource ipMuted}"
                                               FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource ipSurface}"
                                            CornerRadius="2" Padding="3,1" MinWidth="26">
                                        <TextBlock x:Name="TxtPanelFontSize" FontSize="9"
                                                   Foreground="{StaticResource ipAccent2}"
                                                   FontFamily="Consolas" HorizontalAlignment="Center"
                                                   Text="24"/>
                                    </Border>
                                    <Slider x:Name="SliderTextFontSize" Minimum="6" Maximum="200" Value="24"
                                            VerticalAlignment="Center" Margin="4,0"
                                            ValueChanged="SliderTextFontSize_ValueChanged"/>
                                </DockPanel>

                                <!-- Text Color -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Màu"
                                               Foreground="{StaticResource ipMuted}"
                                               FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <Grid Height="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" x:Name="BorderTextColorSwatch" Background="White" BorderBrush="{StaticResource ipBorder}" BorderThickness="1" CornerRadius="2" Height="14" Width="14" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="BtnTextColor" Content="#FFFFFF" FontSize="9" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="4,0,0,0" Height="18" Click="BtnTextColor_Click" Cursor="Hand"/>
                                    </Grid>
                                </DockPanel>

                                <!-- Font Family -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Font"
                                               Foreground="{StaticResource ipMuted}"
                                               FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbFontFamily" Height="20" FontSize="9" SelectionChanged="CmbFontFamily_SelectionChanged"
                                              Style="{StaticResource IpComboBoxStyle}" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Arial" IsSelected="True"/>
                                        <ComboBoxItem Content="Times New Roman"/>
                                        <ComboBoxItem Content="Courier New"/>
                                        <ComboBoxItem Content="Segoe UI"/>
                                        <ComboBoxItem Content="Verdana"/>
                                        <ComboBoxItem Content="Consolas"/>
                                    </ComboBox>
                                </DockPanel>

                                <!-- Font Style -->
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="Style"
                                               Foreground="{StaticResource ipMuted}"
                                               FontSize="9" Width="36" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbFontStyle" Height="20" FontSize="9" SelectionChanged="CmbFontStyle_SelectionChanged"
                                              Style="{StaticResource IpComboBoxStyle}" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Bold" IsSelected="True"/>
                                        <ComboBoxItem Content="Regular"/>
                                        <ComboBoxItem Content="Italic"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════ COLOR ══════ -->
                    <Border Padding="6,4" CornerRadius="3" Margin="0,6,0,3"
                            Background="{StaticResource ipSurface}">
                        <Border BorderBrush="#ff6b6b" BorderThickness="2,0,0,0" Padding="5,0,0,0">
                            <TextBlock Text="COLOR" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource ipMuted}"/>
                        </Border>
                    </Border>

                    <Border Background="{StaticResource ipSurface2}" CornerRadius="4"
                            Padding="6,5">
                        <StackPanel>
                            <DockPanel>
                                <!-- FG/BG stacked -->
                                <Grid DockPanel.Dock="Left" Width="38" Height="38" Margin="0,0,8,0">
                                    <Border x:Name="BgColorBorder" Width="24" Height="24"
                                            Background="White" CornerRadius="3"
                                            BorderBrush="{StaticResource ipBorder}" BorderThickness="1.5"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Cursor="Hand" ToolTip="Background color"
                                            MouseLeftButtonDown="BgColorBorder_MouseLeftButtonDown"/>
                                    <Border x:Name="FgColorBorder" Width="24" Height="24"
                                            Background="Black" CornerRadius="3"
                                            BorderBrush="{StaticResource ipText}" BorderThickness="2"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Cursor="Hand" ToolTip="Foreground color"
                                            MouseLeftButtonDown="FgColorBorder_MouseLeftButtonDown"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <Button Content="⇄ Swap" ToolTip="Hoán đổi (X)"
                                            Style="{StaticResource IpMiniBtn}"
                                            Width="Auto" Padding="4,0" FontSize="9"
                                            HorizontalContentAlignment="Left"
                                            Click="BtnSwapColors_Click"/>
                                    <Button Content="◻ Reset" ToolTip="Đen/Trắng (D)"
                                            Style="{StaticResource IpMiniBtn}"
                                            Width="Auto" Padding="4,0" FontSize="9"
                                            HorizontalContentAlignment="Left"
                                            Click="BtnResetColors_Click"/>
                                    <Border Background="{StaticResource ipSurface}" CornerRadius="2"
                                            Padding="4,1" Margin="0,2,0,0">
                                        <TextBlock x:Name="TxtColorHex" Text="#000000"
                                                   Foreground="{StaticResource ipAccent}" FontSize="9"
                                                   FontFamily="Consolas"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                        </StackPanel>
                    </Border>


                </StackPanel>
            </ScrollViewer>

            <!-- ═══ LAYERS (Row 1 = fill remaining space) ═══ -->
            <Grid Grid.Row="1" Margin="5,0,5,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- LAYERS title header -->
                <Border Grid.Row="0" Padding="6,4" CornerRadius="3,3,0,0"
                        Background="{StaticResource ipSurface}" BorderBrush="{StaticResource ipBorder}" BorderThickness="1,1,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" BorderBrush="{StaticResource ipAccent}"
                                BorderThickness="2,0,0,0" Padding="5,0,0,0">
                            <TextBlock Text="LAYERS" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource ipMuted}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Blend Mode & Opacity bar (Photoshop style) -->
                <Border Grid.Row="1" Padding="6,5" Background="{StaticResource ipSurface2}"
                        BorderBrush="{StaticResource ipBorder}" BorderThickness="1,0,1,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <!-- Blend Mode -->
                        <ComboBox x:Name="CmbBlendMode" Grid.Column="0" Height="20" FontSize="8.5"
                                  VerticalContentAlignment="Center" Style="{StaticResource IpComboBoxStyle}"
                                  SelectionChanged="CmbBlendMode_SelectionChanged" Margin="0,0,8,0">
                            <ComboBoxItem Content="Normal" IsSelected="True"/>
                            <ComboBoxItem Content="Multiply"/>
                            <ComboBoxItem Content="Screen"/>
                            <ComboBoxItem Content="Overlay"/>
                            <ComboBoxItem Content="Darken"/>
                            <ComboBoxItem Content="Lighten"/>
                        </ComboBox>

                        <!-- Opacity Slider -->
                        <TextBlock Grid.Column="1" Text="Op:" FontSize="8.5" Foreground="{StaticResource ipMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderLayerOpacity" Grid.Column="0" Minimum="0" Maximum="100" Value="100"
                                    VerticalAlignment="Center" Focusable="False" Height="18"
                                    ValueChanged="SliderLayerOpacity_ValueChanged"/>
                            <TextBlock x:Name="TxtOpacityValue" Grid.Column="1" Foreground="{StaticResource ipAccent}"
                                       FontSize="8.5" FontFamily="Consolas" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Text="100%"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Layer list — fills all remaining height -->
                <Border Grid.Row="2" Background="{StaticResource ipSurface}"
                        BorderBrush="{StaticResource ipBorder}" BorderThickness="1,0,1,0"
                        Padding="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LayersList"
                                      ItemTemplate="{StaticResource LayerItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ═══ BOTTOM: UNIFIED ACTION BAR ═══ -->
            <Border Grid.Row="2" Padding="5,2" CornerRadius="0,0,3,3"
                    BorderBrush="{StaticResource ipBorderLight}" BorderThickness="0,1,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#141820" Offset="0"/>
                        <GradientStop Color="#0e1218" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <!-- Right: History status -->
                    <TextBlock x:Name="TxtHistoryStatus" DockPanel.Dock="Right"
                               Foreground="{StaticResource ipMuted}" FontSize="8"
                               VerticalAlignment="Center" FontFamily="Consolas"
                               Text="0 steps" Margin="0,0,4,0"/>
                    <!-- Left: Move Up/Down + Undo/Redo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▲" ToolTip="Lên (Move Up)" Style="{StaticResource IpMiniBtn}"
                                Width="18" Height="18" FontSize="7.5" Click="BtnMoveUp_Click" Margin="0,0,2,0"/>
                        <Button Content="▼" ToolTip="Xuống (Move Down)" Style="{StaticResource IpMiniBtn}"
                                Width="18" Height="18" FontSize="7.5" Click="BtnMoveDown_Click" Margin="0,0,6,0"/>
                        <Border Width="1" Height="14" Background="{StaticResource ipBorder}" Margin="0,0,4,0"/>
                        <Button x:Name="BtnUndo" ToolTip="Undo (Ctrl+Z)"
                                Style="{StaticResource IpMiniBtn}" Width="22" Height="20"
                                IsEnabled="False" Click="BtnUndo_Click">
                            <TextBlock Text="↶" FontSize="12" Foreground="{StaticResource ipAccent}"/>
                        </Button>
                        <Button x:Name="BtnRedo" ToolTip="Redo (Ctrl+Y)"
                                Style="{StaticResource IpMiniBtn}" Width="22" Height="20"
                                IsEnabled="False" Click="BtnRedo_Click">
                            <TextBlock Text="↷" FontSize="12" Foreground="{StaticResource ipAccent}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
