# ==============================================================================
# Git Ignore Configuration for AI_Render_3D (Image-to-Rig Pipeline)
# ==============================================================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
python/

# --- Environment Variables & Secrets ---
.env
.env.local
.env.*.local
*.key
*.pem

# --- AI Models, Weights & Checkpoints (Heavy Binaries: Multi-GB) ---
# Ignore model weight files and caches
models/**
!models/
!models/**/
!models/README.md
!models/**/README.md
!models/**/README.txt
!models/**/.gitkeep
!models/**/config.yaml

# Model weight file formats
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.engine
*.trt
*.mar
*.h5
*.pkl
*.weights
checkpoints/

# HuggingFace, PyTorch Hub & RemBG cache
.cache/
huggingface/
.u2net/
.torch/

# --- Pipeline Runtime, Temp Files & Outputs ---
temp_workspace/
temp/
tmp/
uploads/
*.tmp
*.part
*.log
*.log.*

# Generated 3D Models & Render Outputs (Exclude runtime .glb / .fbx / .obj / .ply / .png)
outputs/
face_scaffolds/
*.glb
*.gltf
*.fbx
*.obj
*.ply
*.stl
!examples/**/*.glb
!examples/**/*.gltf
!examples/**/*.obj
!examples/**/*.png

# Temporary Scratch Files & Test Inputs in AI_Render_3D root
gggg.png
test_*.png
render_*.png
scratch/
scratch_*
temp_*

# --- Unit Testing & Code Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- IDEs, Editors & OS Detritus ---
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.backup
*.old
*.orig
* - Copy*
*-Copy*
.DS_Store
Thumbs.db
