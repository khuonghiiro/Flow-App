# ==============================================================================
# Git Ignore Configuration for AI_Render_3D (Image-to-Rig Pipeline)
# ==============================================================================

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# --- AI Models, Weights & Checkpoints (Heavy Binaries: Multi-GB) ---
# Ignore all model weight binaries but preserve documentation and READMEs
models/**
!models/
!models/**/
!models/README.md
!models/**/README.md
!models/**/README.txt
!models/**/.gitkeep
!models/**/config.yaml

# Model weight file extensions
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.engine
*.trt
checkpoints/

# HuggingFace & RemBG cache
.cache/
huggingface/
.u2net/

# --- Pipeline Runtime, Temp Files & Outputs ---
temp_workspace/
temp/
tmp/
uploads/
*.tmp
*.part
*.log

# Generated 3D & Image Outputs (Exclude generated .glb / .obj / .png from git)
outputs/
face_scaffolds/
*.glb
!examples/**/*.glb
!examples/**/*.gltf

# --- Unit Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# --- IDEs, Editors & OS Trash ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
